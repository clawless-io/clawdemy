# Cloudflare Pages security and cache headers.
# Static Astro/Starlight export, so we set headers here rather than wiring
# middleware. Permissions-Policy disables sensors and payment we never use.
#
# CSP notes (why each non-default source is present):
#   script-src  static.cloudflareinsights.com  -> the cookieless CF Web
#               Analytics beacon (beacon.min.js).
#   script-src  'wasm-unsafe-eval'  -> Pagefind (the Starlight search index)
#               instantiates a WebAssembly module at runtime.
#   style-src / script-src 'unsafe-inline'  -> Starlight/Astro emit inline
#               theme-detection scripts, define:vars, and inline style attrs.
#   img-src  data:  -> inline SVG backgrounds in the built CSS.
#   media-src  audio.clawdemy.org  -> the read-along lesson audio (R2).
#   connect-src  audio.clawdemy.org  -> the read-along download button
#               fetch()es the MP3 into a blob; cloudflareinsights.com -> the
#               analytics beacon report endpoint.
# HSTS is set without includeSubDomains until every clawdemy.org subdomain is
# confirmed HTTPS-only; add includeSubDomains once that is verified.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' https://audio.clawdemy.org; connect-src 'self' https://cloudflareinsights.com https://audio.clawdemy.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Long-cache the hashed Astro bundles (content-addressed, safe to pin).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

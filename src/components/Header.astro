---
/**
 * Custom Starlight Header override.
 *
 * Mirrors Starlight 0.38's default Header (title / search / right group) and
 * adds a small persistent site nav: Mission - Tracks - Podcast - Trust.
 *
 * Why (founder, 2026-07-07): the homepage (splash template) renders no
 * sidebar, so a first-time visitor had NO visible path to orientation pages
 * like /mission/; the only affordances were "Start learning" and scroll.
 * Header links fix that on every page at once, including lessons reached
 * directly from search engines.
 *
 * Responsive behavior: all four links from 50rem up. Below 50rem only
 * Mission and Tracks render (the two orientation-critical links); Podcast
 * and Trust stay reachable via the footer and, on docs pages, the sidebar.
 *
 * Keep this file in sync with node_modules/@astrojs/starlight/components/
 * Header.astro when upgrading Starlight; the grid math below is theirs with
 * one extra `auto` column for the nav.
 */
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const NAV_LINKS = [
	{ href: '/mission/', label: 'Mission', always: true },
	{ href: '/tracks/', label: 'Tracks', always: true },
	{ href: '/podcast/', label: 'Podcast', always: false },
	{ href: '/trust/', label: 'Trust', always: false },
];

const currentPath = Astro.url.pathname;
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<nav class="cw-header-nav print:hidden" aria-label="Site">
		{NAV_LINKS.map((link) => (
			<a
				href={link.href}
				class:list={[{ 'cw-header-nav__md-up': !link.always }]}
				aria-current={currentPath === link.href ? 'page' : undefined}
			>
				{link.label}
			</a>
		))}
	</nav>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			/* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
			overflow: clip;
			/* Avoid clipping focus ring around link inside title wrapper. */
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}
		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		.cw-header-nav {
			display: flex;
			gap: 0.9rem;
			align-items: center;
			white-space: nowrap;
		}
		.cw-header-nav a {
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-sm);
			font-weight: 500;
			text-decoration: none;
		}
		.cw-header-nav a:hover,
		.cw-header-nav a:focus-visible {
			color: var(--sl-color-white);
		}
		.cw-header-nav a[aria-current='page'] {
			color: var(--clawdemy-blue);
		}
		/* Below 50rem, only the orientation-critical links (Mission, Tracks). */
		.cw-header-nav__md-up {
			display: none;
		}
		@media (min-width: 50rem) {
			.cw-header-nav__md-up {
				display: inline;
			}
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
								(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
								var(--sl-content-width)
						) / 2
				);
				display: grid;
				grid-template-columns:
        /* 1 (site title): runs up until the main content column’s left edge or the width of the title, whichever is the largest  */
					minmax(
						calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
						auto
					)
					/* 2 (search box): all free space that is available. */
					1fr
					/* 3 (site nav): use the space it needs. */
					auto
					/* 4 (right items): use the space that these need. */
					auto;
				align-content: center;
			}
		}
	}
</style>

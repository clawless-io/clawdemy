---
/**
 * FlashcardSet — wraps a group of <Flashcard> components and provides:
 *   - a "Print flashcards" button (top-right)
 *   - print-only CSS that:
 *       (a) opens every flashcard in the set so the answer is visible,
 *       (b) hides everything else on the page,
 *       (c) page-breaks between cards so each card prints on its own page.
 *
 * Usage in MDX:
 *   <FlashcardSet>
 *
 *   <Flashcard question="...">
 *
 *   ...answer...
 *
 *   </Flashcard>
 *
 *   ...more flashcards...
 *
 *   </FlashcardSet>
 *
 * The print button toggles all child <details class="flashcard"> open,
 * fires window.print(), and reverts on the afterprint event so the
 * reader's chosen open/closed state is preserved.
 */
---

<section class="flashcards-set">
	<div class="flashcards-set-header">
		<button type="button" class="flashcards-print-btn">Print flashcards</button>
	</div>
	<div class="flashcards-set-body">
		<slot />
	</div>
</section>

<script>
	document.querySelectorAll<HTMLButtonElement>('.flashcards-print-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			const set = btn.closest('.flashcards-set');
			if (!set) return;
			const cards = set.querySelectorAll<HTMLDetailsElement>('details.flashcard');
			const originalStates = Array.from(cards).map((c) => c.open);
			cards.forEach((c) => {
				c.open = true;
			});
			const restore = () => {
				cards.forEach((c, i) => {
					c.open = originalStates[i];
				});
				window.removeEventListener('afterprint', restore);
			};
			window.addEventListener('afterprint', restore);
			window.print();
		});
	});
</script>

<style>
	.flashcards-set {
		margin: 1rem 0;
	}
	.flashcards-set-header {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 0.5rem;
	}
	.flashcards-print-btn {
		background: var(--sl-color-bg-sidebar, transparent);
		border: 1px solid var(--sl-color-gray-5, rgba(127, 127, 127, 0.25));
		border-radius: 6px;
		padding: 0.5rem 0.875rem;
		font-size: 0.875rem;
		font-weight: 500;
		color: inherit;
		cursor: pointer;
		font-family: inherit;
		transition:
			border-color 0.15s ease,
			background 0.15s ease;
	}
	.flashcards-print-btn:hover {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-bg);
	}
	.flashcards-print-btn:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	@media print {
		:global(body) {
			visibility: hidden;
		}
		.flashcards-set,
		.flashcards-set :global(*) {
			visibility: visible;
		}
		.flashcards-set {
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			margin: 0;
		}
		.flashcards-set-header {
			display: none;
		}

		.flashcards-set :global(details.flashcard) {
			page-break-after: always;
			page-break-inside: avoid;
			break-after: page;
			break-inside: avoid;
			border: 2px solid #000 !important;
			border-radius: 0 !important;
			background: #fff !important;
			color: #000 !important;
			box-shadow: none !important;
			margin: 0 !important;
			padding: 2rem !important;
			min-height: 80vh;
			display: flex !important;
			flex-direction: column;
			justify-content: center;
			page-break-before: auto;
		}
		.flashcards-set :global(details.flashcard:last-child) {
			page-break-after: auto;
		}
		.flashcards-set :global(details.flashcard summary) {
			font-size: 1.4rem !important;
			padding: 0 !important;
			list-style: none;
		}
		.flashcards-set :global(.flashcard-toggle) {
			display: none !important;
		}
		.flashcards-set :global(.flashcard-body) {
			margin-top: 2rem;
			padding: 1.5rem 0 0 0 !important;
			border-top: 1px solid #000;
			font-size: 1.05rem;
		}
		.flashcards-set :global(.flashcard-label) {
			color: #000 !important;
		}
	}
</style>

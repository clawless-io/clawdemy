---
/**
 * Curriculum-at-a-glance stat banner for the homepage hero area.
 *
 * Numbers come from the single source of truth in src/data/curriculum-stats.ts
 * (end-state curriculum SCOPE, not current availability). Pure static markup,
 * no client JS. Accessibility: cells whose visible text reads correctly carry
 * no ARIA (visible text is the accessible text); the "1.5M+" shorthand is
 * aria-hidden with a visually-hidden expanded sentence via Starlight's global
 * .sr-only utility.
 */
import { CURRICULUM_STATS } from '../data/curriculum-stats';
---

<section aria-label="Clawdemy curriculum at a glance" class="stat-banner">
	<ul>
		{
			CURRICULUM_STATS.map((stat) => (
				<li>
					{stat.srText ? (
						<>
							<span aria-hidden="true">
								<span class="stat-number">{stat.value}</span>
								<span class="stat-label">{stat.label}</span>
							</span>
							<span class="sr-only">{stat.srText}</span>
						</>
					) : (
						<>
							<span class="stat-number">{stat.value}</span>
							<span class="stat-label">{stat.label}</span>
						</>
					)}
				</li>
			))
		}
	</ul>
</section>

<style>
	.stat-banner {
		margin-block: 2.5rem;
	}
	.stat-banner ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		row-gap: 1.5rem;
	}
	.stat-banner li {
		text-align: center;
		padding-block: 0.25rem;
		/* Thin divider between columns; the leading edge of each row is
		   suppressed below so dividers sit between cells, not outside.
		   NOTE: the suppression math assumes exactly 4 stats (see
		   src/data/curriculum-stats.ts). The desktop rules below are also
		   source-order dependent: :first-child must come after :nth-child(odd)
		   so item 1 stays borderless. Adjust both if the stat count changes. */
		border-inline-start: 1px solid var(--sl-color-gray-5);
	}
	/* 2-up (mobile): left column is the odd-indexed cells. */
	.stat-banner li:nth-child(odd) {
		border-inline-start: none;
	}
	.stat-number {
		display: block;
		/* Brand blue accent (brand-integration spec 2026-06-07); labels stay muted. */
		color: var(--clawdemy-blue);
		font-size: var(--sl-text-3xl);
		font-weight: 700;
		line-height: 1.1;
	}
	.stat-label {
		display: block;
		margin-top: 0.35rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	@media (min-width: 50rem) {
		.stat-banner ul {
			grid-template-columns: repeat(4, 1fr);
			row-gap: 0;
		}
		/* 4-up (desktop): only the first cell is a row-leading edge; restore
		   the divider on the cell that was odd-indexed in the 2-up layout. */
		.stat-banner li:nth-child(odd) {
			border-inline-start: 1px solid var(--sl-color-gray-5);
		}
		.stat-banner li:first-child {
			border-inline-start: none;
		}
	}
</style>

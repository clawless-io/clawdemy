---
/**
 * LessonUpdate: a dated addendum recording something that changed in the world
 * since this lesson was written, WITHOUT touching a word of narrated prose.
 *
 * WHY THIS EXISTS. Clawdemy is free and founder-funded, and editing narrated
 * body text forces a paid ElevenLabs re-render (about 2,600 credits for a
 * typical lesson). Most currency problems are not "this lesson is wrong", they
 * are "a new model shipped since we wrote this". Those deserve a visible,
 * dated note, not a rewrite and a bill.
 *
 * THE COST BOUNDARY IS THIS COMPONENT'S API, AND IT IS LOAD-BEARING.
 * Measured on bayes-theorem, 2026-09-30:
 *   <LessonUpdate note="..." />          prose 6786 chars  (unchanged)  FREE
 *   <LessonUpdate>...</LessonUpdate>     prose 6850 chars  (+64)        PAID
 * `mdxToProse` deletes self-closing JSX components outright but only strips the
 * TAGS of a component with children, keeping the inner text, which then gets
 * narrated and invalidates the audio hash. So the note MUST travel as a prop.
 * That is why this component takes `note` as a string and accepts no children:
 * the expensive mistake is made unavailable rather than left to discipline.
 *
 * READ-ALONG SAFETY. The wrapper carries `data-readalong-skip`, which
 * ReadAlongDim's isSkippable() honors, so the walker skips this whole subtree
 * and DOM-word index N still maps to timing.words[N]. Adding one of these to a
 * narrated lesson cannot desync the highlight.
 *
 * NOT A REVIEW. Adding an update does NOT bump `last_reviewed`, deliberately.
 * `last_reviewed` means a human verified the lesson; this means the lesson has
 * a known addendum. Conflating them would let the freshness gate go quiet
 * without anyone actually re-reading anything.
 *
 * Usage (self-closing, always):
 *   <LessonUpdate
 *     date="2026-09-30"
 *     note="Claude 5.5 shipped since this lesson was written. The reasoning below is unchanged; the model names in the examples are dated."
 *   />
 */

import { Aside } from '@astrojs/starlight/components';

interface Props {
	/** ISO date (YYYY-MM-DD) this addendum was added. */
	date: string;
	/** The addendum itself. A prop, never children. See the cost note above. */
	note: string;
	/** Optional source for the claim. */
	href?: string;
	/** Link text; defaults to a neutral label. */
	linkText?: string;
}

const { date, note, href, linkText } = Astro.props;

function formatDate(input: string): string {
	const d = new Date(input);
	if (Number.isNaN(d.getTime())) return input;
	// UTC, matching LessonFreshness: ISO dates parse as UTC midnight and
	// localizing them would show the prior day west of UTC.
	return d.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
		timeZone: 'UTC',
	});
}
---

<div data-readalong-skip>
	<Aside type="note" title={`Update, ${formatDate(date)}`}>
		<p>{note}</p>
		{href && (
			<p>
				<a href={href}>{linkText ?? 'Source'}</a>
			</p>
		)}
	</Aside>
</div>

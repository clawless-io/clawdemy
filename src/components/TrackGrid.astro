---
// TrackGrid: the full catalog grouped by learning path, on /tracks/.
//
// Redesigned 2026-11-09 to GSD's mock, section 8, which the founder reviewed
// and asked for on today's paper background: each path gets its own heading
// with its icon in its own colour, every other path sits on a light band of
// that colour, and every card carries the path colour (see TrackCard).
//
// Each section has id={theme.key}, which is what the PathJump chips at the
// top of the page link to. Change a theme key in tracks.ts and the chips and
// the anchors move together, because both are generated from THEME_ORDER.
//
// Live tracks first within each path, then planned (Coming soon) ones.
import { THEME_ORDER, TRACKS } from '../data/tracks';
import { THEME_ICON_PATHS } from '../data/theme-icons';
import TrackCard from './TrackCard.astro';

const sections = THEME_ORDER.map((theme) => {
	const live = TRACKS.filter((t) => t.theme === theme.key && t.status === 'live');
	const planned = TRACKS.filter((t) => t.theme === theme.key && t.status === 'planned');
	return { theme, tracks: [...live, ...planned] };
}).filter((s) => s.tracks.length > 0);
---

<section class="track-grid-page not-content" aria-labelledby="learning-paths-heading">
	<header class="track-grid-page__header">
		<h2 id="learning-paths-heading" class="track-grid-page__title">Learning Paths</h2>
		<p class="track-grid-page__lede">
			The same {`${TRACKS.length}`} tracks above, grouped into themed paths. Each path is a
			suggested route through the curriculum: pick the one that matches what you
			want to learn next, or roam freely.
		</p>
	</header>
	{sections.map(({ theme, tracks }) => (
		<section
			class="track-grid-section cw-themed"
			id={theme.key}
			style={`--accent-base: ${theme.accent}`}
			aria-labelledby={`path-${theme.key}`}
		>
			<div class="path-head">
				<span class="path-head__icon" aria-hidden="true">
					<svg
						viewBox="0 0 24 24"
						width="26"
						height="26"
						fill="none"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"
						set:html={THEME_ICON_PATHS[theme.key]}
					/>
				</span>
				<div class="path-head__text">
					<h3 class="track-grid-section__title" id={`path-${theme.key}`}>
						<a href={`/tracks/${theme.key}/`}>{theme.label}</a>
					</h3>
					<p class="track-grid-section__tagline">{theme.tagline}</p>
				</div>
			</div>
			<div class="track-grid">
				{tracks.map((t) => <TrackCard track={t} />)}
			</div>
		</section>
	))}
</section>

<style>
	.track-grid-page {
		display: block;
	}
	.track-grid-page__header {
		margin: 0 0 0.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--fl-line, var(--sl-color-gray-5, #e5e7eb));
	}
	.track-grid-page__title {
		margin: 0 0 0.4rem;
		font-family: var(--fl-display, inherit);
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		font-weight: 800;
		letter-spacing: -0.01em;
		color: var(--fl-ink, inherit);
	}
	.track-grid-page__lede {
		margin: 0;
		font-size: 0.95rem;
		color: var(--sl-color-gray-3, #64748b);
		max-width: 46rem;
		line-height: 1.45;
	}

	.track-grid-section {
		position: relative;
		/* A stacking context of its own, so the band painted behind it with
		   z-index -1 stays inside this section instead of dropping behind the
		   page background. */
		isolation: isolate;
		padding-block: 2.5rem;
		/* The sticky header would otherwise cover the heading a chip jumps to. */
		scroll-margin-top: 5rem;
	}

	/*
	 * THE BANDS. Every other path sits on a light wash of its own colour,
	 * bled to the edges of the window, which is what lets the eye see where
	 * one path ends and the next begins.
	 *
	 * Founder, 2026-11-09: keep today's background, and "if you want to give
	 * it a small shade, like the one we have for the mock, it may give it a
	 * little more life." So the mock's band is kept but mixed into the PAGE
	 * colour rather than laid on as a separate grey, and tinted with the
	 * path's own colour at 5%, which reads as a shade rather than a stripe.
	 *
	 * The ::before reaches the window edges the same way .lp-band does on
	 * the homepage, and the html/body overflow-x: clip in global.css stops it
	 * from causing a sideways scroll.
	 */
	.track-grid-section:nth-of-type(even)::before {
		content: '';
		position: absolute;
		inset: 0 calc(50% - 50vw);
		z-index: -1;
		background: color-mix(in srgb, var(--accent) 5%, var(--sl-color-bg));
		border-block: 1px solid color-mix(in srgb, var(--accent) 14%, var(--fl-line, transparent));
	}

	.path-head {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.4rem;
		flex-wrap: wrap;
	}
	.path-head__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: none;
		width: 52px;
		height: 52px;
		border-radius: 14px;
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 13%, var(--fl-card, transparent));
		border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
	}
	.path-head__text {
		flex: 1;
		min-width: 14rem;
	}
	.track-grid-section__title {
		margin: 0;
		font-size: 1.35rem;
		font-weight: 800;
		line-height: 1.25;
		color: var(--fl-ink, inherit);
	}
	.track-grid-section__title a {
		color: inherit;
		text-decoration: none;
	}
	.track-grid-section__title a:hover {
		color: var(--accent-ink);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.track-grid-section__tagline {
		margin: 0.15rem 0 0;
		font-size: 0.95rem;
		color: var(--sl-color-gray-3, #64748b);
	}
	.track-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 255px), 1fr));
		gap: 1rem;
		align-items: stretch;
	}
</style>

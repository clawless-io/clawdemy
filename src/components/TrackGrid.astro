---
// TrackGrid — the full catalog as a responsive grid, grouped by theme.
// Powers the /tracks browse page (plan §6: "single page rendering the full
// 24-card grid"). Reads the manifest directly (single source of truth).
// Live tracks first within each theme, then any planned (Coming soon) cards.
// Responsive: 1-up on mobile, up to 4-up on desktop via auto-fill.
import { THEME_ORDER, TRACKS } from '../data/tracks';
import TrackCard from './TrackCard.astro';

// Total track count is informational, used in the Learning Paths intro
// paragraph so the heading stays accurate as the catalog grows.
// (The lede below uses TRACKS.length directly via a template literal.)

const sections = THEME_ORDER.map((theme) => {
	const live = TRACKS.filter((t) => t.theme === theme.key && t.status === 'live');
	const planned = TRACKS.filter((t) => t.theme === theme.key && t.status === 'planned');
	return { theme, tracks: [...live, ...planned] };
}).filter((s) => s.tracks.length > 0);
---

<section class="track-grid-page" aria-labelledby="learning-paths-heading">
	<header class="track-grid-page__header">
		<h2 id="learning-paths-heading" class="track-grid-page__title">Learning Paths</h2>
		<p class="track-grid-page__lede">
			The same {`${TRACKS.length}`} tracks above, grouped into themed paths. Each path is a
			suggested route through the curriculum: pick the one that matches what you
			want to learn next, or roam freely.
		</p>
	</header>
	{sections.map(({ theme, tracks }) => (
		<section class="track-grid-section">
			<h3 class="track-grid-section__title">
				<a href={`/tracks/${theme.key}/`}>{theme.label}</a>
			</h3>
			<p class="track-grid-section__tagline">{theme.tagline}</p>
			<div class="track-grid">
				{tracks.map((t) => <TrackCard track={t} />)}
			</div>
		</section>
	))}
</section>

<style>
	.track-grid-page {
		display: block;
	}
	.track-grid-page__header {
		margin: 0 0 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-gray-5, #e5e7eb);
	}
	.track-grid-page__title {
		margin: 0 0 0.4rem;
		font-size: 1.6rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.track-grid-page__lede {
		margin: 0;
		font-size: 0.95rem;
		color: var(--sl-color-gray-3, #64748b);
		max-width: 65ch;
		line-height: 1.45;
	}
	.track-grid-section {
		margin: 0 0 2.5rem;
	}
	.track-grid-section__title a {
		color: inherit;
		text-decoration: none;
	}
	.track-grid-section__title a:hover {
		color: var(--clawdemy-blue);
	}
	.track-grid-section__title {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 700;
	}
	.track-grid-section__tagline {
		margin: 0.25rem 0 1rem;
		font-size: 0.92rem;
		color: var(--sl-color-gray-3, #64748b);
	}
	.track-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(255px, 1fr));
		gap: 1rem;
		align-items: stretch;
	}
</style>

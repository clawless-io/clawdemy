---
/**
 * Freshness signal for the Brief artifact.
 *
 * Reads `last_reviewed` and `published_at` from a lesson's frontmatter and
 * renders one of three states, computed at build time (no client JS):
 *
 *   - Fresh   (updated after publish, <=30 days): green tip, "Recently updated".
 *   - Silent  (new lesson, or 31-180 days):       nothing rendered.
 *   - Stale   (>180 days):                        yellow caution, "Verify…".
 *
 * Why the published_at gate (added 2026-06-03):
 *   The fresh signal is for returning readers, "the body changed since your
 *   last visit". That claim is FALSE on a brand-new lesson nobody has read.
 *   A new lesson has last_reviewed == published_at; a genuinely-revised one has
 *   last_reviewed AFTER published_at. We only show the "recently updated" banner
 *   when last_reviewed is strictly later than published_at, so new lessons stay
 *   silent and only real post-publication revisions flag a re-read. The stale
 *   signal (Doc/lesson-framework.md §5, >6 months) is independent and always
 *   fires regardless of new-vs-updated.
 *
 * Why date format, not relative time:
 *   CDN-cached HTML can outlive its build. "Updated 2 days ago" lies if the
 *   page is served a week later. The actual date does not.
 *
 * Future date handling:
 *   Clamped to "today". If an editor sets a future date by mistake, the lesson
 *   reads as freshly updated rather than crashing the build.
 */

import { Aside } from '@astrojs/starlight/components';

interface Props {
	lastReviewed?: Date | string;
	publishedAt?: Date | string;
}

const { lastReviewed, publishedAt } = Astro.props;

const FRESH_DAYS = 30;
const STALE_DAYS = 180;

function toDate(input: Date | string | undefined): Date | null {
	if (!input) return null;
	const d = input instanceof Date ? input : new Date(input);
	return Number.isNaN(d.getTime()) ? null : d;
}

function dayDiff(a: Date, b: Date): number {
	const ms = a.getTime() - b.getTime();
	return Math.floor(ms / (1000 * 60 * 60 * 24));
}

function formatDate(d: Date): string {
	// Format in UTC. ISO-only frontmatter dates (e.g. "2026-04-24") parse as UTC
	// midnight, and localizing them to the build server's TZ would show the
	// prior day in any zone west of UTC.
	return d.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
		timeZone: 'UTC',
	});
}

const now = new Date();
const reviewed = toDate(lastReviewed);
const published = toDate(publishedAt);
const ageDays = reviewed ? Math.max(0, dayDiff(now, reviewed)) : null;
const formatted = reviewed ? formatDate(reviewed) : null;

// A genuine post-publication revision: reviewed strictly after published.
// A brand-new lesson has reviewed == published (same day) and stays silent.
// If published_at is missing, we conservatively treat it as new (no fresh banner).
const updatedAfterPublish =
	reviewed !== null && published !== null && dayDiff(reviewed, published) > 0;

const showFresh = ageDays !== null && ageDays <= FRESH_DAYS && updatedAfterPublish;
const showStale = ageDays !== null && ageDays > STALE_DAYS;
---

{
	showFresh && (
		<Aside type="tip" title="Recently updated">
			This lesson was last updated on {formatted}. If you've read it before, the
			body has changed since your last visit.
		</Aside>
	)
}

{
	showStale && (
		<Aside type="caution" title="Last reviewed a while ago">
			This lesson was last reviewed on {formatted}. AI moves quickly. Verify
			anything load-bearing before you rely on it.
		</Aside>
	)
}

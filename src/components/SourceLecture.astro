---
/**
 * Source-lecture callout for the Brief artifact.
 *
 * Used at the top of every Brief whose source material is a public lecture
 * video. Surfaces the source up front so a reader who wants to watch the
 * original can do so before reading our breakdown.
 *
 * Why this is its own component:
 *   Clawdemy adapts free public lectures, it does not replace them. The
 *   callout makes that framing visible on every derived Brief: the video
 *   is the primary, our lesson is the breakdown.
 */

import { Aside } from '@astrojs/starlight/components';

interface Props {
	url: string;
	title: string;
	instructor?: string;
	lengthMinutes?: number;
}

const { url, title, instructor, lengthMinutes } = Astro.props;

const metaParts = [
	instructor,
	lengthMinutes ? `${lengthMinutes} min` : null,
].filter(Boolean);
const meta = metaParts.length > 0 ? ` (${metaParts.join(', ')})` : '';
---

<Aside type="note" title="Source lecture">
	<strong>{title}</strong>{meta}. <a href={url} target="_blank" rel="noopener">Watch on YouTube</a>.
</Aside>

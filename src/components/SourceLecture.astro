---
/**
 * Source-lecture callout for the Brief artifact.
 *
 * Used at the top of every Brief whose source material is a public lecture
 * video. Surfaces the source up front so a reader who wants to watch the
 * original can do so before reading our breakdown.
 *
 * Why this is its own component:
 *   Clawdemy adapts free public lectures, it does not replace them. The
 *   callout makes that framing visible on every derived Brief: the video
 *   is the primary, our lesson is the breakdown.
 */

import { Aside } from '@astrojs/starlight/components';

interface Props {
	url: string;
	title: string;
	instructor?: string;
	lengthMinutes?: number;
	/**
	 * Optional start timestamp (in seconds) for a deep-link into the source video.
	 * When set, the rendered link appends `&t=<timestampStart>s` so the viewer
	 * jumps to the relevant segment. Used by lessons that pull from a specific
	 * stretch of the lecture rather than the whole talk.
	 */
	timestampStart?: number;
	/**
	 * Optional end timestamp (in seconds). Currently displayed as context for
	 * the reader (the segment range); YouTube does not honor an end time on
	 * the standard URL. Reserved for future use when we render our own player.
	 */
	timestampEnd?: number;
}

const { url, title, instructor, lengthMinutes, timestampStart, timestampEnd } = Astro.props;

function formatTimestamp(seconds: number): string {
	const hh = Math.floor(seconds / 3600);
	const mm = Math.floor((seconds % 3600) / 60);
	const ss = Math.floor(seconds % 60);
	if (hh > 0) {
		return `${hh}:${mm.toString().padStart(2, '0')}:${ss.toString().padStart(2, '0')}`;
	}
	return `${mm}:${ss.toString().padStart(2, '0')}`;
}

const linkUrl = timestampStart !== undefined
	? `${url}${url.includes('?') ? '&' : '?'}t=${Math.floor(timestampStart)}s`
	: url;

const segmentNote =
	timestampStart !== undefined && timestampEnd !== undefined
		? ` Segment: ${formatTimestamp(timestampStart)} to ${formatTimestamp(timestampEnd)}.`
		: timestampStart !== undefined
			? ` Starts at ${formatTimestamp(timestampStart)}.`
			: '';

const metaParts = [
	instructor,
	lengthMinutes ? `${lengthMinutes} min` : null,
].filter(Boolean);
const meta = metaParts.length > 0 ? ` (${metaParts.join(', ')})` : '';
---

<Aside type="note" title="Source lecture">
	<strong>{title}</strong>{meta}. <a href={linkUrl} target="_blank" rel="noopener">Watch on YouTube</a>.{segmentNote}
</Aside>

---
/**
 * Flashcard component for the Practice artifact.
 *
 * Renders a question/answer pair as a click-to-reveal card. Visually
 * distinct from the self-check collapsibles in the same artifact: card-
 * styled with explicit Q. and A. labels, hover and open states, accent
 * border on reveal. Built on <details> for keyboard accessibility and
 * zero client JS.
 *
 * Usage in MDX:
 *   <Flashcard question="What is tokenization?">
 *
 *   The conversion from raw text into a sequence of integer IDs ...
 *
 *   </Flashcard>
 *
 * The blank lines after the opening tag and before the closing tag are
 * required so MDX parses the children as markdown.
 */

interface Props {
	question: string;
}

const { question } = Astro.props;
---

<details class="flashcard">
	<summary>
		<span class="flashcard-label">Q.</span>
		<span class="flashcard-question">{question}</span>
		<span class="flashcard-toggle" aria-hidden="true"></span>
	</summary>
	<div class="flashcard-body">
		<span class="flashcard-label">A.</span>
		<div class="flashcard-answer"><slot /></div>
	</div>
</details>

<style>
	.flashcard {
		border: 1px solid var(--sl-color-gray-5, rgba(127, 127, 127, 0.25));
		border-radius: 10px;
		margin: 0.625rem 0;
		background: var(--sl-color-bg-sidebar, transparent);
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.15s ease;
	}
	.flashcard:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-1px);
	}
	.flashcard[open] {
		border-color: var(--sl-color-accent);
		box-shadow: 0 0 0 1px var(--sl-color-accent);
	}
	.flashcard summary {
		padding: 0.875rem 1.125rem;
		cursor: pointer;
		list-style: none;
		display: flex;
		align-items: center;
		gap: 0.625rem;
		user-select: none;
		font-weight: 600;
	}
	.flashcard summary::-webkit-details-marker {
		display: none;
	}
	.flashcard-label {
		color: var(--sl-color-accent);
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-weight: 700;
		flex-shrink: 0;
	}
	.flashcard-question {
		flex: 1;
	}
	.flashcard-toggle {
		flex-shrink: 0;
		width: 1rem;
		height: 1rem;
		position: relative;
		opacity: 0.55;
		transition: opacity 0.15s ease;
	}
	.flashcard-toggle::before,
	.flashcard-toggle::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		background: currentColor;
		border-radius: 1px;
	}
	.flashcard-toggle::before {
		width: 0.75rem;
		height: 2px;
		transform: translate(-50%, -50%);
	}
	.flashcard-toggle::after {
		width: 2px;
		height: 0.75rem;
		transform: translate(-50%, -50%);
		transition: transform 0.15s ease;
	}
	.flashcard[open] .flashcard-toggle {
		opacity: 0.85;
	}
	.flashcard[open] .flashcard-toggle::after {
		transform: translate(-50%, -50%) rotate(90deg);
	}
	.flashcard-body {
		padding: 0 1.125rem 1rem 1.125rem;
		display: flex;
		gap: 0.625rem;
		align-items: flex-start;
	}
	.flashcard-answer {
		flex: 1;
	}
	.flashcard-answer > :first-child {
		margin-top: 0;
	}
	.flashcard-answer > :last-child {
		margin-bottom: 0;
	}
</style>

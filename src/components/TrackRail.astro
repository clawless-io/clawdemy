---
// TrackRail — a titled, horizontally-scrolling strip of TrackCards.
// The homepage (Phase B) composes one rail per theme plus the curated
// "Start here" rail. Pure-CSS horizontal scroll with scroll-snap and a
// peek of the next card (plan §8.2 / Finding 2); no JS.
import type { Track } from '../data/tracks';
import TrackCard from './TrackCard.astro';

interface Props {
	title: string;
	tagline?: string;
	tracks: Track[];
	/** Optional "view all" link (e.g. to /tracks). */
	viewAllHref?: string;
	/** Optional anchor id (the hero "Start learning" button scrolls here). */
	id?: string;
}

const { title, tagline, tracks, viewAllHref, id } = Astro.props;
---

<section class="track-rail" id={id}>
	<div class="track-rail__head">
		<div>
			<h2 class="track-rail__title">{title}</h2>
			{tagline && <p class="track-rail__tagline">{tagline}</p>}
		</div>
		{viewAllHref && (
			<a class="track-rail__all" href={viewAllHref}>View all &rarr;</a>
		)}
	</div>

	<ul class="track-rail__scroll">
		{tracks.map((t) => (
			<li class="track-rail__item">
				<TrackCard track={t} />
			</li>
		))}
	</ul>
</section>

<style>
	.track-rail {
		margin: 2.25rem 0;
	}
	.track-rail__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.85rem;
	}
	.track-rail__title {
		margin: 0;
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.2;
	}
	.track-rail__tagline {
		margin: 0.2rem 0 0;
		font-size: 0.9rem;
		color: var(--sl-color-gray-3, #64748b);
	}
	.track-rail__all {
		font-size: 0.85rem;
		font-weight: 600;
		white-space: nowrap;
		text-decoration: none;
		color: var(--sl-color-text-accent, #2563eb);
	}
	.track-rail__scroll {
		display: flex;
		gap: 1rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		list-style: none;
		margin: 0 -0.5rem;
		padding: 0.35rem 0.5rem 1rem;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
	}
	.track-rail__item {
		scroll-snap-align: start;
		flex: 0 0 auto;
		width: 285px;
	}
	@media (min-width: 1024px) {
		.track-rail__item {
			width: 305px;
		}
	}
	/* Mobile: one card with a peek of the next (plan Finding 2). */
	@media (max-width: 480px) {
		.track-rail__item {
			width: 82vw;
			max-width: 320px;
		}
	}
</style>

---
/**
 * Custom Starlight Footer override.
 *
 * Wraps Starlight's default Footer with two added rows:
 *   1. Legal links: Privacy · Terms · Cookies · Disclaimer
 *   2. Parent-company line: "A product of RBJ Global"
 *
 * Both rows render on every page; legal pages exclude themselves from
 * sitemap and carry noindex meta but their links pass authority through
 * to other pages, which is the recommended pattern for legal hygiene.
 */
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
---

<footer class="sl-flex">
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />

	<div class="cw-footer-extras sl-flex">
		<nav class="cw-footer-legal" aria-label="Legal">
			<a href="/legal/privacy/">Privacy</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/legal/terms/">Terms</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/legal/cookies/">Cookies</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/legal/disclaimer/">Disclaimer</a>
		</nav>
		<p class="cw-footer-parent">
			A product of
			{' '}
			<a href="https://rbjglobal.com" target="_blank" rel="noopener noreferrer">
				RBJ Global
			</a>
		</p>
	</div>

	{
		config.credits && (
			<a class="kudos sl-flex" href="https://starlight.astro.build">
				<Icon name={'starlight'} /> {Astro.locals.t('builtWithStarlight.label')}
			</a>
		)
	}
</footer>

<style>
	footer {
		flex-direction: column;
		gap: 1.5rem;
	}
	.meta {
		gap: 0.75rem 3rem;
		justify-content: space-between;
		flex-wrap: wrap;
		margin-top: 3rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.meta > :global(p:only-child) {
		margin-inline-start: auto;
	}
	.cw-footer-extras {
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-gray-5);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.cw-footer-legal {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	.cw-footer-legal a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.cw-footer-legal a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
	}
	.cw-footer-sep {
		opacity: 0.5;
	}
	.cw-footer-parent {
		margin: 0;
	}
	.cw-footer-parent a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.cw-footer-parent a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
	}
	.kudos {
		align-items: center;
		gap: 0.5em;
		margin: 1.5rem auto;
		font-size: var(--sl-text-xs);
		text-decoration: none;
		color: var(--sl-color-gray-3);
	}
	.kudos:hover {
		color: var(--sl-color-white);
	}
	.kudos :global(svg) {
		color: var(--sl-color-orange);
	}
</style>

---
/**
 * Custom Starlight Footer override.
 *
 * Wraps Starlight's default Footer with three added rows:
 *   1. Legal links: Trust · Privacy · Terms · Cookies · Disclaimer · Podcast feed
 *   2. LinkedIn follow link (subtle, icon + label)
 *   3. Parent-company line: "A product of RBJ Global"
 *
 * The LinkedIn link is a plain styled anchor, not an embedded widget. No
 * LinkedIn JS, no platform.linkedin.com fetches, no cookies. One click
 * opens LinkedIn's Clawdemy company page in a new tab. Privacy posture
 * documented in src/content/docs/legal/privacy.mdx under "Follow on
 * LinkedIn link".
 *
 * Legal pages exclude themselves from sitemap and carry noindex meta
 * but their links pass authority through to other pages, which is the
 * recommended pattern for legal hygiene.
 */
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import TrackPathNav from './TrackPathNav.astro';
---

<footer class="sl-flex">
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />

	{/* Learning-path continuity: points to the next track in this track's path. Renders only on lesson pages (Part B, 2026-06-07). */}
	<TrackPathNav />

	<div class="cw-footer-extras sl-flex">
		<nav class="cw-footer-legal" aria-label="Site and legal">
			<a href="/mission/">Mission</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/trust/">Trust</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/legal/privacy/">Privacy</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/legal/terms/">Terms</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/legal/licensing/">Licensing</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/legal/cookies/">Cookies</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/legal/disclaimer/">Disclaimer</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/podcast/feed.xml">Podcast feed (RSS)</a>
		</nav>
		<a
			class="cw-footer-linkedin"
			href="https://www.linkedin.com/company/117114432/"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Follow Clawdemy on LinkedIn. Opens LinkedIn in a new tab."
		>
			<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.44-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
			</svg>
			<span>Follow on LinkedIn</span>
		</a>
		<a
			class="cw-footer-podcast"
			href="https://podcasts.apple.com/us/podcast/clawdemy-lessons/id1896899400"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Listen to Clawdemy Lessons on Apple Podcasts. Opens Apple Podcasts in a new tab."
		>
			<img
				src="/badges/listen-on-apple-podcasts.svg"
				alt="Listen on Apple Podcasts"
				width="129"
				height="41"
			/>
		</a>
		<p class="cw-footer-parent">
			A product of
			{' '}
			<a href="https://rbjglobal.com" target="_blank" rel="noopener noreferrer">
				RBJ Global
			</a>
		</p>
	</div>

	{
		config.credits && (
			<a class="kudos sl-flex" href="https://starlight.astro.build">
				<Icon name={'starlight'} /> {Astro.locals.t('builtWithStarlight.label')}
			</a>
		)
	}
</footer>

<style>
	footer {
		flex-direction: column;
		gap: 1.5rem;
	}
	.meta {
		gap: 0.75rem 3rem;
		justify-content: space-between;
		flex-wrap: wrap;
		margin-top: 3rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.meta > :global(p:only-child) {
		margin-inline-start: auto;
	}
	.cw-footer-extras {
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-gray-5);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.cw-footer-legal {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	.cw-footer-legal a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.cw-footer-legal a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
	}
	.cw-footer-sep {
		opacity: 0.5;
	}
	.cw-footer-linkedin {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.cw-footer-linkedin:hover {
		color: var(--sl-color-accent, #7c3aed);
		text-decoration: underline;
	}
	.cw-footer-linkedin:focus-visible {
		outline: 2px solid var(--sl-color-accent, #7c3aed);
		outline-offset: 2px;
		border-radius: 2px;
	}
	.cw-footer-linkedin svg {
		flex-shrink: 0;
	}
	/* Official Apple Podcasts badge: native colors (no recolor), ~40px tall
	   with clear space, per Apple's identity guidelines. */
	.cw-footer-podcast {
		display: inline-flex;
		margin-block: 0.25rem;
	}
	.cw-footer-podcast img {
		display: block;
		height: 40px;
		width: auto;
	}
	.cw-footer-podcast:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 4px;
		border-radius: 6px;
	}
	.cw-footer-parent {
		margin: 0;
	}
	.cw-footer-parent a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.cw-footer-parent a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
	}
	.kudos {
		align-items: center;
		gap: 0.5em;
		margin: 1.5rem auto;
		font-size: var(--sl-text-xs);
		text-decoration: none;
		color: var(--sl-color-gray-3);
	}
	.kudos:hover {
		color: var(--sl-color-white);
	}
	.kudos :global(svg) {
		color: var(--sl-color-orange);
	}
</style>

---
/**
 * Custom Starlight Footer override.
 *
 * Wraps Starlight's default Footer with one added card:
 *   - top: the Clawdemy wordmark with the parent-company line under it,
 *     then three link groups named for what a visitor wants to do:
 *     About (Mission, Trust), Listen (Apple Podcasts, RSS feed) and
 *     Follow (LinkedIn, X, YouTube, Instagram)
 *   - bottom, under a fine divider: the policy links
 *
 * Every follow link is a plain styled anchor, not an embedded widget: no
 * third-party script, pixel or embed, no request to the platform at page
 * load, and no cookie. One click opens the Clawdemy profile in a new tab.
 * The privacy page (src/content/docs/legal/privacy.mdx) says the same.
 *
 * The icons carry no visible text, so each anchor has an aria-label and a
 * title naming the platform.
 *
 * Legal pages exclude themselves from sitemap and carry noindex meta
 * but their links pass authority through to other pages, which is the
 * recommended pattern for legal hygiene.
 */
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import TrackPathNav from './TrackPathNav.astro';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { Image } from 'astro:assets';
import wordmarkLight from '../assets/brand/Clawdemy-wordmark-color.png';
import wordmarkDark from '../assets/brand/Clawdemy-wordmark-color-white.png';

/*
 * Home page only: the page has no previous page and one two-word next page,
 * so Starlight's half-width pagination card and a date on a line of its own
 * leave a large gap under the closing call to action. There the date and the
 * next link share one compact row instead.
 */
const compactNav = Astro.url.pathname === '/';
const nextPage = Astro.locals.starlightRoute.pagination.next;

const socials = [
	{
		name: 'LinkedIn',
		href: 'https://www.linkedin.com/company/117114432/',
		icon: '<path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.44-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />',
	},
	{
		name: 'X',
		href: 'https://x.com/LearnClawdemy',
		icon: '<path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />',
	},
	{
		name: 'YouTube',
		href: 'https://www.youtube.com/@clawdemy',
		icon: '<path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />',
	},
	{
		name: 'Instagram',
		href: 'https://www.instagram.com/learnclawdemy/',
		icon: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="17.3" cy="6.7" r="1.3" fill="currentColor" />',
	},
];
---

<footer class="sl-flex">
	{
		compactNav ? (
			<div class="meta cw-footer-compact sl-flex">
				<LastUpdated />
				{nextPage && (
					<a class="cw-footer-next" href={nextPage.href} rel="next">
						{Astro.locals.t('page.nextLink')}: <span>{nextPage.label}</span> &rarr;
					</a>
				)}
			</div>
		) : (
			<>
				<div class="meta sl-flex">
					<EditLink />
					<LastUpdated />
				</div>
				<Pagination />
			</>
		)
	}

	{/* Learning-path continuity: points to the next track in this track's path. Renders only on lesson pages (Part B, 2026-06-07). */}
	<TrackPathNav />

	<div class="cw-footer-extras">
		<div class="cw-footer-top">
			<div class="cw-footer-brand">
				<a class="cw-footer-wordmark" href="/" aria-label="Clawdemy home">
					<Image class="cw-footer-wordmark-light" src={wordmarkLight} alt="" height={64} loading="lazy" />
					<Image class="cw-footer-wordmark-dark" src={wordmarkDark} alt="" height={64} loading="lazy" />
				</a>
				<p class="cw-footer-parent">
					A product of
					{' '}
					<a href="https://rbjglobal.com" target="_blank" rel="noopener noreferrer">
						RBJ Global
					</a>
				</p>
			</div>
			<div class="cw-footer-groups">
			<nav class="cw-footer-group" aria-labelledby="cw-footer-about">
				<p class="cw-footer-heading" id="cw-footer-about">About</p>
				<div class="cw-footer-links">
					<a href="/mission/">Mission</a>
					<a href="/trust/">Trust</a>
				</div>
			</nav>
			<nav class="cw-footer-group" aria-labelledby="cw-footer-listen">
				<p class="cw-footer-heading" id="cw-footer-listen">Listen</p>
				<div class="cw-footer-links">
					<a
						href="https://podcasts.apple.com/us/podcast/clawdemy-lessons/id1896899400"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Listen to Clawdemy Lessons on Apple Podcasts. Opens Apple Podcasts in a new tab."
					>Apple Podcasts</a>
					<a href="/podcast/feed.xml">Podcast feed (RSS)</a>
				</div>
			</nav>
			<nav class="cw-footer-group" aria-labelledby="cw-footer-follow-heading">
				<p class="cw-footer-heading" id="cw-footer-follow-heading">Follow</p>
				<div class="cw-footer-social">
					{
						socials.map((social) => (
							<a
								class="cw-footer-follow"
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								title={`Clawdemy on ${social.name}`}
								aria-label={`Follow Clawdemy on ${social.name}. Opens ${social.name} in a new tab.`}
							>
								<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" set:html={social.icon} />
							</a>
						))
					}
				</div>
			</nav>
			</div>
		</div>
		<div class="cw-footer-bottom">
			<nav class="cw-footer-legal" aria-label="Policies">
				<a href="/legal/privacy/">Privacy</a>
				<a href="/legal/terms/">Terms</a>
				<a href="/legal/licensing/">Licensing</a>
				<a href="/legal/cookies/">Cookies</a>
				<a href="/legal/disclaimer/">Disclaimer</a>
			</nav>
			{/*
			 * On a phone the light/dark switch otherwise lives only in Starlight's
			 * menu, and pages without a sidebar (the homepage) have no menu. This
			 * is the same ThemeSelect the header shows on desktop, shown below
			 * 50rem only.
			 */}
			<div class="cw-footer-theme">
				<ThemeSelect />
			</div>
		</div>
	</div>

	{
		config.credits && (
			<a class="kudos sl-flex" href="https://starlight.astro.build">
				<Icon name={'starlight'} /> {Astro.locals.t('builtWithStarlight.label')}
			</a>
		)
	}
</footer>

<style>
	footer {
		flex-direction: column;
		gap: 1.5rem;
	}
	.meta {
		gap: 0.75rem 3rem;
		justify-content: space-between;
		flex-wrap: wrap;
		margin-top: 3rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.meta > :global(p:only-child) {
		margin-inline-start: auto;
	}
	.cw-footer-compact {
		align-items: center;
		margin-top: 1.25rem;
	}
	.cw-footer-compact ~ .cw-footer-extras {
		margin-top: 0;
	}
	.cw-footer-compact :global(p) {
		margin: 0;
	}
	.cw-footer-next {
		margin-inline-start: auto;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		white-space: nowrap;
	}
	.cw-footer-next span {
		font-weight: 700;
		color: var(--fl-ink);
	}
	.cw-footer-next:hover span {
		color: var(--clawdemy-blue);
		text-decoration: underline;
	}
	/*
	 * The extras block is a card with a thin brand-blue rule on top. The top
	 * part is a wrapping flex row: the brand block takes the spare width and
	 * the three link groups sit to its right. The bottom part, under a fine
	 * divider, holds the policy links.
	 */
	.cw-footer-extras {
		margin-top: 2rem;
		padding: 1.5rem 1.6rem 1.1rem;
		border: 1px solid var(--fl-line);
		border-top: 2px solid var(--clawdemy-blue);
		border-radius: var(--fl-radius);
		background: var(--fl-band);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.cw-footer-top,
	.cw-footer-groups {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 1.25rem 2rem;
	}
	/*
	 * The groups are one flex item, so when the row runs out of width the
	 * brand block takes a line and the three groups stay together under it.
	 */
	.cw-footer-brand {
		flex: 1 1 10rem;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
	}
	.cw-footer-wordmark {
		display: inline-flex;
	}
	.cw-footer-wordmark :global(img) {
		display: block;
		height: 32px;
		width: auto;
	}
	.cw-footer-wordmark :global(.cw-footer-wordmark-dark),
	:global([data-theme='dark']) .cw-footer-wordmark :global(.cw-footer-wordmark-light) {
		display: none;
	}
	:global([data-theme='dark']) .cw-footer-wordmark :global(.cw-footer-wordmark-dark) {
		display: block;
	}
	.cw-footer-parent {
		margin: 0;
		white-space: nowrap;
	}
	.cw-footer-parent a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
		font-weight: 700;
	}
	.cw-footer-parent a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
	}
	.cw-footer-heading {
		margin: 0 0 0.5rem;
		font-size: var(--sl-text-xs);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.cw-footer-links {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.cw-footer-links a,
	.cw-footer-legal a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.cw-footer-links a {
		font-weight: 600;
	}
	.cw-footer-links a:hover,
	.cw-footer-legal a:hover {
		color: var(--clawdemy-blue);
		text-decoration: underline;
	}
	.cw-footer-social {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	/* 2.5rem square: a comfortable touch target on a phone. */
	.cw-footer-follow {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--fl-line);
		border-radius: 999px;
		background: var(--fl-card);
		color: var(--clawdemy-blue);
		text-decoration: none;
	}
	.cw-footer-follow:hover {
		border-color: var(--clawdemy-blue);
	}
	.cw-footer-follow:focus-visible {
		outline: 2px solid var(--sl-color-accent, #7c3aed);
		outline-offset: 2px;
	}
	.cw-footer-follow svg {
		flex-shrink: 0;
	}
	.cw-footer-bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		margin-top: 1.25rem;
		padding-top: 0.9rem;
		border-top: 1px solid var(--fl-line);
	}
	.cw-footer-legal {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.1rem;
		font-size: var(--sl-text-xs);
	}
	.cw-footer-theme {
		display: none;
	}
	@media (max-width: 49.99rem) {
		.cw-footer-theme {
			display: flex;
		}
	}
	/*
	 * Phone: the brand block takes a full line, then About, Listen and Follow
	 * each get a row of their own with their links side by side.
	 */
	@media (max-width: 40rem) {
		.cw-footer-extras {
			padding: 1.25rem 1.25rem 1rem;
		}
		.cw-footer-brand,
		.cw-footer-groups,
		.cw-footer-group {
			flex: 0 0 100%;
		}
		.cw-footer-links {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0.35rem 1.1rem;
		}
	}
	.kudos {
		align-items: center;
		gap: 0.5em;
		margin: 1.5rem auto;
		font-size: var(--sl-text-xs);
		text-decoration: none;
		color: var(--sl-color-gray-3);
	}
	.kudos:hover {
		color: var(--sl-color-white);
	}
	.kudos :global(svg) {
		color: var(--sl-color-orange);
	}
</style>

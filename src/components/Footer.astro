---
/**
 * Custom Starlight Footer override.
 *
 * Wraps Starlight's default Footer with two added rows:
 *   1. Site and legal links
 *   2. Follow icons and the podcast badge on the left, the parent-company
 *      line ("A product of RBJ Global") on the right
 *
 * Every follow link is a plain styled anchor, not an embedded widget: no
 * third-party script, pixel or embed, no request to the platform at page
 * load, and no cookie. One click opens the Clawdemy profile in a new tab.
 * The privacy page (src/content/docs/legal/privacy.mdx) says the same.
 *
 * The icons carry no visible text, so each anchor has an aria-label and a
 * title naming the platform.
 *
 * Legal pages exclude themselves from sitemap and carry noindex meta
 * but their links pass authority through to other pages, which is the
 * recommended pattern for legal hygiene.
 */
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import TrackPathNav from './TrackPathNav.astro';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const socials = [
	{
		name: 'LinkedIn',
		href: 'https://www.linkedin.com/company/117114432/',
		icon: '<path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.44-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />',
	},
	{
		name: 'X',
		href: 'https://x.com/LearnClawdemy',
		icon: '<path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />',
	},
	{
		name: 'YouTube',
		href: 'https://www.youtube.com/@clawdemy',
		icon: '<path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />',
	},
	{
		name: 'Instagram',
		href: 'https://www.instagram.com/learnclawdemy/',
		icon: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="17.3" cy="6.7" r="1.3" fill="currentColor" />',
	},
];
---

<footer class="sl-flex">
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />

	{/* Learning-path continuity: points to the next track in this track's path. Renders only on lesson pages (Part B, 2026-06-07). */}
	<TrackPathNav />

	<div class="cw-footer-extras sl-flex">
		<nav class="cw-footer-legal" aria-label="Site and legal">
			<a href="/mission/">Mission</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/trust/">Trust</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/legal/privacy/">Privacy</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/legal/terms/">Terms</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/legal/licensing/">Licensing</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/legal/cookies/">Cookies</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/legal/disclaimer/">Disclaimer</a>
			<span class="cw-footer-sep" aria-hidden="true">·</span>
			<a href="/podcast/feed.xml">Podcast feed (RSS)</a>
		</nav>
		<div class="cw-footer-social">
			<span class="cw-footer-social-label">Follow</span>
			{
				socials.map((social) => (
					<a
						class="cw-footer-follow"
						href={social.href}
						target="_blank"
						rel="noopener noreferrer"
						title={`Clawdemy on ${social.name}`}
						aria-label={`Follow Clawdemy on ${social.name}. Opens ${social.name} in a new tab.`}
					>
						<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" set:html={social.icon} />
					</a>
				))
			}
		</div>
		<a
			class="cw-footer-podcast"
			href="https://podcasts.apple.com/us/podcast/clawdemy-lessons/id1896899400"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Listen to Clawdemy Lessons on Apple Podcasts. Opens Apple Podcasts in a new tab."
		>
			<img
				src="/badges/listen-on-apple-podcasts.svg"
				alt="Listen on Apple Podcasts"
				width="129"
				height="41"
			/>
		</a>
		{/*
		 * Founder, 2026-11-10: on a phone the light/dark switch lived only in
		 * Starlight's menu, and pages without a sidebar (the homepage) have no
		 * menu, so a phone visitor could not change the theme there at all.
		 * This is the same ThemeSelect the header shows on desktop (our
		 * override, so the light-first default holds), shown below 50rem only.
		 */}
		<div class="cw-footer-theme">
			<ThemeSelect />
		</div>
		<p class="cw-footer-parent">
			A product of
			{' '}
			<a href="https://rbjglobal.com" target="_blank" rel="noopener noreferrer">
				RBJ Global
			</a>
		</p>
	</div>

	{
		config.credits && (
			<a class="kudos sl-flex" href="https://starlight.astro.build">
				<Icon name={'starlight'} /> {Astro.locals.t('builtWithStarlight.label')}
			</a>
		)
	}
</footer>

<style>
	footer {
		flex-direction: column;
		gap: 1.5rem;
	}
	.meta {
		gap: 0.75rem 3rem;
		justify-content: space-between;
		flex-wrap: wrap;
		margin-top: 3rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.meta > :global(p:only-child) {
		margin-inline-start: auto;
	}
	/*
	 * The extras block is a card with two rows. Row one is the site and legal
	 * links. Row two holds the follow icons and the podcast badge on the left
	 * and the parent-company line pushed to the right. It is a wrapping flex
	 * row, so on a narrow screen the items drop onto further lines instead of
	 * overflowing. .sl-flex in the class list is overridden here rather than
	 * removed, so Starlight's utility keeps working everywhere else.
	 */
	.cw-footer-extras {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.9rem 1.25rem;
		margin-top: 2rem;
		padding: 1.25rem 1.6rem;
		border: 1px solid var(--fl-line);
		border-radius: var(--fl-radius);
		background: var(--fl-band);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 40rem) {
		.cw-footer-extras {
			padding: 1.25rem;
		}
	}
	.cw-footer-legal {
		flex: 0 0 100%;
		display: flex;
		gap: 0.35rem 0.9rem;
		flex-wrap: wrap;
	}
	.cw-footer-legal a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
		font-weight: 600;
	}
	.cw-footer-legal a:hover {
		color: var(--clawdemy-blue);
		text-decoration: underline;
	}
	/*
	 * The interpuncts are redundant once the row has real spacing. They are
	 * aria-hidden already, so hiding them removes nothing from a screen
	 * reader. They stay in the markup so the separator returns by deleting
	 * one rule if the spacing ever reads as too loose.
	 */
	.cw-footer-sep {
		display: none;
	}
	.cw-footer-social {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.cw-footer-social-label {
		font-weight: 600;
		margin-inline-end: 0.15rem;
	}
	/* 2.5rem square: a comfortable touch target on a phone. */
	.cw-footer-follow {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--fl-line);
		border-radius: 999px;
		background: var(--fl-card);
		color: var(--clawdemy-blue);
		text-decoration: none;
	}
	.cw-footer-follow:hover {
		border-color: var(--clawdemy-blue);
	}
	.cw-footer-follow:focus-visible {
		outline: 2px solid var(--sl-color-accent, #7c3aed);
		outline-offset: 2px;
	}
	.cw-footer-follow svg {
		flex-shrink: 0;
	}
	/* Official Apple Podcasts badge: native colors (no recolor), ~40px tall
	   with clear space, per Apple's identity guidelines. */
	.cw-footer-podcast {
		display: inline-flex;
	}
	.cw-footer-podcast img {
		display: block;
		height: 40px;
		width: auto;
	}
	.cw-footer-podcast:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 4px;
		border-radius: 6px;
	}
	.cw-footer-theme {
		display: none;
	}
	@media (max-width: 49.99rem) {
		.cw-footer-theme {
			display: flex;
		}
	}
	/* Pushed to the right edge of the row; on its own line it stays right. */
	.cw-footer-parent {
		margin: 0;
		margin-inline-start: auto;
		white-space: nowrap;
	}
	.cw-footer-parent a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
		font-weight: 700;
	}
	.cw-footer-parent a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
	}
	.kudos {
		align-items: center;
		gap: 0.5em;
		margin: 1.5rem auto;
		font-size: var(--sl-text-xs);
		text-decoration: none;
		color: var(--sl-color-gray-3);
	}
	.kudos:hover {
		color: var(--sl-color-white);
	}
	.kudos :global(svg) {
		color: var(--sl-color-orange);
	}
</style>

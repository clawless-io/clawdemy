---
/**
 * Track 11 (Neural Network Intuition), Lesson 2, illustration 4 of 5.
 *
 * The full feedforward network: input 784 (drawn as a compressed stack),
 * two hidden layers of 16, output 10 (labeled 0 to 9). Faint connection
 * lines between layers suggest the dense wiring; a single arrow underneath
 * shows the one-directional flow. 826 neurons in all.
 */
const top = 60;
const bot = 300;
function col(n: number, x: number, t = top, b = bot) {
	const a: { x: number; y: number }[] = [];
	for (let i = 0; i < n; i++) a.push({ x, y: n === 1 ? (t + b) / 2 : t + (i * (b - t)) / (n - 1) });
	return a;
}
const h1 = col(16, 330);
const h2 = col(16, 510);
const out = col(10, 690, 72, 288);
const inStackTop = [68, 90, 112, 134, 156];
const inStackBot = [200, 222, 244, 266, 288];
const inSrc = [90, 156, 222, 288].map((y) => ({ x: 168, y }));

const conn1: any[] = [];
for (const s of inSrc) for (const t of h1) conn1.push({ x1: s.x, y1: s.y, x2: t.x, y2: t.y });
const conn2: any[] = [];
for (const a of h1) for (const b of h2) conn2.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y });
const conn3: any[] = [];
for (const a of h2) for (const b of out) conn3.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y });
---

<figure class="cw-illus">
	<svg viewBox="0 0 800 372" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="nn-ff-title nn-ff-desc">
		<title id="nn-ff-title">The full feedforward network: 784, 16, 16, 10</title>
		<desc id="nn-ff-desc">Four layers drawn left to right. On the left, the input layer of 784 neurons drawn as a compressed vertical stack. Next, two hidden layers of 16 neurons each. On the right, the output layer of 10 neurons labeled 0 through 9. Faint lines connect every layer to the next, suggesting the dense wiring. An arrow along the bottom points left to right, labeled feedforward, numbers flow one direction. The total is 826 neurons.</desc>

		<defs>
			<marker id="nn-ff-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" /></marker>
		</defs>

		<text x="690" y="34" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" fill="#7c3aed" font-weight="600">826 neurons total</text>

		<!-- connections (drawn first, behind nodes) -->
		{conn1.map((l) => <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="currentColor" stroke-width="0.6" opacity="0.1" />)}
		{conn2.map((l) => <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="currentColor" stroke-width="0.6" opacity="0.08" />)}
		{conn3.map((l) => <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="currentColor" stroke-width="0.6" opacity="0.08" />)}

		<!-- input stack -->
		<rect x="96" y="52" width="64" height="256" rx="10" fill="currentColor" opacity="0.05" />
		<rect x="96" y="52" width="64" height="256" rx="10" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.4" />
		{inStackTop.map((y) => <circle cx="128" cy={y} r="6" fill="currentColor" opacity="0.55" />)}
		{inStackBot.map((y) => <circle cx="128" cy={y} r="6" fill="currentColor" opacity="0.55" />)}
		<text x="128" y="172" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="15" fill="currentColor" opacity="0.55">⋮</text>

		<!-- hidden + output nodes -->
		{h1.map((n) => <circle cx={n.x} cy={n.y} r="6.5" fill="currentColor" opacity="0.18" stroke="currentColor" stroke-width="1.25" />)}
		{h2.map((n) => <circle cx={n.x} cy={n.y} r="6.5" fill="currentColor" opacity="0.18" stroke="currentColor" stroke-width="1.25" />)}
		{out.map((n, i) => (
			<g>
				<circle cx={n.x} cy={n.y} r="8" fill={i === 3 ? '#7c3aed' : 'currentColor'} opacity={i === 3 ? 0.85 : 0.18} stroke={i === 3 ? '#7c3aed' : 'currentColor'} stroke-width="1.25" />
				<text x={n.x + 16} y={n.y + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.75">{i}</text>
			</g>
		))}

		<!-- layer labels -->
		<text x="128" y="330" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" fill="currentColor"><tspan font-weight="600">784</tspan> input</text>
		<text x="330" y="330" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" fill="currentColor"><tspan font-weight="600">16</tspan> hidden</text>
		<text x="510" y="330" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" fill="currentColor"><tspan font-weight="600">16</tspan> hidden</text>
		<text x="690" y="330" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" fill="currentColor"><tspan font-weight="600">10</tspan> output</text>

		<!-- feedforward arrow -->
		<line x1="100" y1="352" x2="740" y2="352" stroke="currentColor" stroke-width="2" opacity="0.6" marker-end="url(#nn-ff-arrow)" />
		<text x="420" y="346" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" font-style="italic" fill="currentColor" opacity="0.75">feedforward: numbers flow one direction, input to output</text>
	</svg>
	<figcaption>The whole example network: 784 input neurons (one per pixel), two hidden layers of 16, and 10 output neurons, 826 in all. Each layer feeds the next, always forward, no loops and no going back. A real, working digit recognizer that fits in a number you can say out loud.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 780px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

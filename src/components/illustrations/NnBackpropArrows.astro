---
/**
 * Track 11 (Neural Network Intuition), Lesson 8, illustration 1 of 1.
 *
 * Backpropagation as the backward roll of desires. Each output neuron has a
 * wish (the 3 wants to go up, the 4 wants to come down, etc.). Those competing
 * wishes fan backward and sum, per previous-layer neuron, into a single net
 * wish, which becomes the previous layer's fresh set of desires.
 */
const outX = 560;
const hidX = 200;
const outputs = [
	{ y: 60, d: '3', want: 'up', mag: 30 },
	{ y: 120, d: '4', want: 'down', mag: 30 },
	{ y: 186, d: '0', want: 'down', mag: 14 },
	{ y: 250, d: '7', want: 'ok', mag: 0 },
	{ y: 308, d: '9', want: 'ok', mag: 0 },
];
const hidden = [
	{ y: 110, want: 'up', mag: 22 },
	{ y: 184, want: 'down', mag: 16 },
	{ y: 258, want: 'up', mag: 26 },
];
const lines: any[] = [];
for (const o of outputs) for (const h of hidden) lines.push({ x1: outX - 16, y1: o.y, x2: hidX + 16, y2: h.y });
---

<figure class="cw-illus">
	<svg viewBox="0 0 760 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="nn-bp-title nn-bp-desc">
		<title id="nn-bp-title">Output wishes fan backward into one net wish per previous-layer neuron</title>
		<desc id="nn-bp-desc">Two layers. On the right, output neurons each labeled with a digit and an up or down arrow showing what it wants: the 3 neuron wants to go up, the 4 neuron wants to come down strongly, the 0 wants a small move down, and others are satisfied. Faint arrows fan backward from every output neuron to each neuron in the previous layer on the left. There, all the competing requests sum into a single net up or down arrow per neuron, which becomes the previous layer's own set of desires. This backward roll is backpropagation.</desc>

		<defs>
			<marker id="nn-bp-up" viewBox="0 0 10 10" refX="5" refY="1" markerWidth="7" markerHeight="7" orient="auto"><path d="M 0 10 L 5 0 L 10 10 z" fill="#7c3aed" /></marker>
			<marker id="nn-bp-down" viewBox="0 0 10 10" refX="5" refY="9" markerWidth="7" markerHeight="7" orient="auto"><path d="M 0 0 L 5 10 L 10 0 z" fill="currentColor" /></marker>
			<marker id="nn-bp-back" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M 10 0 L 0 5 L 10 10 z" fill="currentColor" /></marker>
		</defs>

		<text x="400" y="26" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="13" fill="#7c3aed" font-weight="600">backpropagation: wishes roll backward</text>

		<!-- backward fan -->
		{lines.map((l) => <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="currentColor" stroke-width="0.8" opacity="0.13" marker-end="url(#nn-bp-back)" />)}

		<!-- output neurons + desire arrows -->
		{outputs.map((o) => (
			<g>
				<circle cx={outX} cy={o.y} r="15" fill="currentColor" opacity="0.14" stroke="currentColor" stroke-width="1.5" />
				<text x={outX} y={o.y + 4} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor">{o.d}</text>
				{o.want === 'up' && <line x1={outX + 32} y1={o.y + o.mag / 2} x2={outX + 32} y2={o.y - o.mag / 2} stroke="#7c3aed" stroke-width="3" marker-end="url(#nn-bp-up)" />}
				{o.want === 'down' && <line x1={outX + 32} y1={o.y - o.mag / 2} x2={outX + 32} y2={o.y + o.mag / 2} stroke="currentColor" stroke-width="3" opacity="0.7" marker-end="url(#nn-bp-down)" />}
				{o.want === 'ok' && <text x={outX + 32} y={o.y + 4} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.45">ok</text>}
			</g>
		))}

		<!-- previous-layer neurons + net wish -->
		{hidden.map((h) => (
			<g>
				<circle cx={hidX} cy={h.y} r="16" fill="currentColor" opacity="0.16" stroke="currentColor" stroke-width="1.5" />
				{h.want === 'up' && <line x1={hidX - 34} y1={h.y + h.mag / 2} x2={hidX - 34} y2={h.y - h.mag / 2} stroke="#7c3aed" stroke-width="3.5" marker-end="url(#nn-bp-up)" />}
				{h.want === 'down' && <line x1={hidX - 34} y1={h.y - h.mag / 2} x2={hidX - 34} y2={h.y + h.mag / 2} stroke="currentColor" stroke-width="3.5" opacity="0.75" marker-end="url(#nn-bp-down)" />}
			</g>
		))}

		<text x={outX} y="338" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11.5" fill="currentColor" opacity="0.75">output layer: each neuron's wish</text>
		<text x={hidX} y="318" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11.5" fill="currentColor" opacity="0.75">previous layer:</text>
		<text x={hidX} y="334" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11.5" fill="currentColor" opacity="0.75">competing wishes sum to one</text>
	</svg>
	<figcaption>Each output neuron has a wish: the 3 wants to go up, the 4 wants to come down, others are content. Those competing requests fan backward, and for each previous-layer neuron they add up into a single net wish, higher or lower. The output layer's desires have become the previous layer's desires, and the same step repeats all the way to the front. That backward roll is backpropagation.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

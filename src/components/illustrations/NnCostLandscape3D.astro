---
/**
 * Track 11 (Neural Network Intuition), Lesson 6, illustration 1 of 2.
 *
 * The cost landscape for a toy 2-knob network. The cost over the 2D plane of
 * settings is a height, giving a hilly surface with a clear valley. Drawn as
 * a projected wireframe mesh. A "you are here" dot sits on a slope with a
 * downhill arrow toward the valley. (A real network's landscape lives in
 * 13,000 dimensions; this 2-knob version is the one you can actually draw.)
 */
const cos30 = 0.8660254;
const sin30 = 0.5;
const cx = 380;
const cy = 250;
const sXY = 88;
const sZ = 60;
const STEPS = 12;
const LO = -1.4;
const HI = 1.4;
const cost = (u: number, v: number) =>
	0.55 * (u * u + v * v) - 0.95 * Math.exp(-(((u - 0.1) ** 2) + v * v) * 2.5) + 0.13 * Math.sin(3 * u) * Math.cos(2.6 * v);
const proj = (u: number, v: number) => {
	const z = cost(u, v);
	return { X: cx + (u - v) * cos30 * sXY, Y: cy + (u + v) * sin30 * sXY - z * sZ };
};
const grid: { X: number; Y: number }[][] = [];
for (let i = 0; i <= STEPS; i++) {
	const u = LO + ((HI - LO) * i) / STEPS;
	const row: { X: number; Y: number }[] = [];
	for (let j = 0; j <= STEPS; j++) row.push(proj(u, LO + ((HI - LO) * j) / STEPS));
	grid.push(row);
}
const rowPaths = grid.map((r) => r.map((p, j) => `${j === 0 ? 'M' : 'L'} ${p.X.toFixed(1)} ${p.Y.toFixed(1)}`).join(' '));
const colPaths: string[] = [];
for (let j = 0; j <= STEPS; j++) {
	let d = '';
	for (let i = 0; i <= STEPS; i++) d += `${i === 0 ? 'M' : 'L'} ${grid[i][j].X.toFixed(1)} ${grid[i][j].Y.toFixed(1)} `;
	colPaths.push(d.trim());
}
const here = proj(-1.4, 1.0);
const valley = proj(0.1, 0);
const dx = valley.X - here.X;
const dy = valley.Y - here.Y;
const len = Math.hypot(dx, dy);
const aStart = { x: here.X + (dx / len) * 15, y: here.Y + (dy / len) * 15 };
const aEnd = { x: here.X + (dx / len) * 60, y: here.Y + (dy / len) * 60 };
---

<figure class="cw-illus">
	<svg viewBox="0 0 760 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="nn-land-title nn-land-desc">
		<title id="nn-land-title">The cost as a hilly landscape over the plane of knob settings</title>
		<desc id="nn-land-desc">A 3D wireframe surface drawn over a flat base plane whose two axes are the network's two knobs. The height of the surface at each point is the cost for those knob settings, so the surface is hilly, with peaks where the settings are poor and a clear valley where they are good. A dot labeled "you are here" sits high on a slope, with an arrow pointing downhill toward the valley. A real network has 13,000 knobs, so its landscape cannot be drawn, but the idea is identical.</desc>

		<defs>
			<marker id="nn-land-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" fill="#7c3aed" /></marker>
		</defs>

		{colPaths.map((d) => <path d={d} fill="none" stroke="currentColor" stroke-width="0.75" opacity="0.22" />)}
		{rowPaths.map((d) => <path d={d} fill="none" stroke="currentColor" stroke-width="0.75" opacity="0.22" />)}

		<text x={valley.X} y={valley.Y + 22} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.7">a valley (low cost)</text>

		<line x1={aStart.x} y1={aStart.y} x2={aEnd.x} y2={aEnd.y} stroke="#7c3aed" stroke-width="2.5" marker-end="url(#nn-land-arrow)" />
		<text x={(aStart.x + aEnd.x) / 2 + 14} y={(aStart.y + aEnd.y) / 2} font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="#7c3aed" font-weight="600">downhill</text>
		<circle cx={here.X} cy={here.Y} r="6" fill="#7c3aed" />
		<text x={here.X - 6} y={here.Y - 12} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" font-weight="600" fill="#7c3aed">you are here</text>

		<text x="60" y="44" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.6">↑ height = cost</text>
		<text x="700" y="344" text-anchor="end" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.6">base plane = the two knob settings</text>
	</svg>
	<figcaption>Treat every setting of the knobs as a point on a plane, and the cost there as a height. The cost function becomes a terrain: poor settings rise into hills, good settings sink into valleys, and the best setting is the lowest valley floor. "Make the cost small" turns into something almost physical: from wherever you are, walk downhill. A real network's terrain has 13,000 dimensions, but the intuition is exactly this.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

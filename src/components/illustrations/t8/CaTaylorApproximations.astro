---
/**
 * Track 8 (Visual Math: Calculus), Lesson 13, the capstone illustration.
 *
 * Taylor approximations of cos(x) centered at a = 0. The hero curve is
 * cos(x) itself. Over it we overlay three successive Taylor polynomials,
 * each one of higher order and each hugging cos more closely over a wider
 * interval around the center a = 0:
 *
 *   1st order (tangent):  y = 1
 *     cos(0) = 1 and cos'(0) = -sin(0) = 0, so the tangent at 0 is the
 *     flat line y = 1.
 *   2nd order (parabola): y = 1 - x^2/2
 *     cos''(0) = -cos(0) = -1, contributing the -x^2/2! term.
 *   4th order:            y = 1 - x^2/2 + x^4/24
 *     the x^3 term vanishes (odd derivative of an even function), and
 *     cos''''(0) = 1 contributes +x^4/4! = +x^4/24.
 *
 * The teaching point: adding more Taylor terms makes the polynomial match
 * the function over a wider range around the center a. Near 0 all four
 * curves coincide; moving outward, the flat line peels off first, then the
 * parabola dives away, while the 4th-order curve tracks cos far longer.
 */

const cx = 285; // pixel x of the math origin (0, 0)
const cy = 120; // pixel y of the math origin (0, 0)
const SX = 60; // pixels per math unit, horizontal; x in [-3, 3] spans 360 px, clearing the legend column
const SY = 55; // pixels per math unit, vertical

// math (x, y) -> pixel (px, py), with y flipped so math-up is pixel-up
const px = (mx: number) => cx + mx * SX;
const py = (my: number) => cy - my * SY;

const X_MIN = -3;
const X_MAX = 3;
const N_SAMPLES = 160; // sample density for each plotted curve

// the four functions, plotted accurately over [X_MIN, X_MAX]
const fCos = (x: number) => Math.cos(x);
const fOrder1 = (_x: number) => 1; // tangent: y = 1
const fOrder2 = (x: number) => 1 - (x * x) / 2; // parabola
const fOrder4 = (x: number) => 1 - (x * x) / 2 + Math.pow(x, 4) / 24;

// build an SVG path string by sampling a function across the x interval
const buildPath = (f: (x: number) => number): string =>
	Array.from({ length: N_SAMPLES + 1 }, (_, i) => {
		const x = X_MIN + (i / N_SAMPLES) * (X_MAX - X_MIN);
		return `${i === 0 ? 'M' : 'L'} ${px(x).toFixed(2)} ${py(f(x)).toFixed(2)}`;
	}).join(' ');

const cosPath = buildPath(fCos);
const order2Path = buildPath(fOrder2);
const order4Path = buildPath(fOrder4);

// axis half-extents in math units (x to 3, y from -3.6 up to 1.4)
const AX = 3.2;
const Y_TOP = 1.4;
const Y_BOT = -3.6;

// x-axis ticks (skip 0)
const xTicks = [-3, -2, -1, 1, 2, 3];

const TEAL = '#0d9488'; // cos(x), the hero
const ACCENT = '#7c3aed'; // 1st order (tangent), y = 1
const AMBER = '#d97706'; // 2nd order (parabola)
const SKY = '#0284c7'; // 4th order
---

<figure class="cw-illus">
	<svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ca-taylor-title ca-taylor-desc">
		<title id="ca-taylor-title">The curve cos(x) with its Taylor approximations at a = 0: the tangent line y = 1, the parabola 1 minus x squared over 2, and the 4th order curve 1 minus x squared over 2 plus x to the fourth over 24, each hugging cos more closely over a wider range</title>
		<desc id="ca-taylor-desc">A coordinate graph over x from minus 3 to 3, with the center point a = 0 marked on the curve. The function cos(x) is plotted as the hero curve in teal, a smooth wave peaking at 1 above the origin. Three Taylor approximations centered at a = 0 are overlaid. The 1st order approximation, the tangent line, is the flat horizontal line y = 1 in accent purple, matching cos only right near 0. The 2nd order approximation is the downward parabola 1 minus x squared over 2 in amber, which tracks cos near 0 but dives away as x moves outward. The 4th order approximation, 1 minus x squared over 2 plus x to the fourth over 24 in sky blue, hugs cos far more closely over a much wider interval before separating. Near the center a = 0 all four curves coincide. The teaching point: adding more Taylor terms makes the polynomial match the function over a wider range around the center a.</desc>

		<defs>
			<marker id="ca-taylor-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
			</marker>
		</defs>

		{/* axes */}
		<line x1={px(-AX)} y1={cy} x2={px(AX) + 6} y2={cy} stroke="currentColor" stroke-width="1.2" opacity="0.55" marker-end="url(#ca-taylor-arrow)" />
		<line x1={cx} y1={py(Y_BOT)} x2={cx} y2={py(Y_TOP) - 6} stroke="currentColor" stroke-width="1.2" opacity="0.55" marker-end="url(#ca-taylor-arrow)" />

		{/* x-axis tick marks + labels */}
		{xTicks.map((t) => (
			<g>
				<line x1={px(t)} y1={cy - 3} x2={px(t)} y2={cy + 3} stroke="currentColor" stroke-width="0.8" opacity="0.45" />
				<text x={px(t)} y={cy + 16} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.55">{t}</text>
			</g>
		))}

		{/* axis labels */}
		<text x={px(AX) + 10} y={cy + 4} text-anchor="start" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill="currentColor" opacity="0.7">x</text>
		<text x={cx + 8} y={py(Y_TOP) - 8} text-anchor="start" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill="currentColor" opacity="0.7">y</text>

		{/* 2nd order parabola: y = 1 - x^2/2 (drawn first, lowest in the visual stack) */}
		<path d={order2Path} fill="none" stroke={AMBER} stroke-width="2" stroke-dasharray="2 4" opacity="0.9" />

		{/* 4th order: y = 1 - x^2/2 + x^4/24 */}
		<path d={order4Path} fill="none" stroke={SKY} stroke-width="2" stroke-dasharray="6 4" opacity="0.95" />

		{/* 1st order (tangent): the flat line y = 1 */}
		<line x1={px(X_MIN)} y1={py(1)} x2={px(X_MAX)} y2={py(1)} stroke={ACCENT} stroke-width="2" stroke-dasharray="1 5" stroke-linecap="round" opacity="0.95" />

		{/* cos(x), the hero curve, drawn on top so it reads as the function being approximated */}
		<path d={cosPath} fill="none" stroke={TEAL} stroke-width="2.8" />

		{/* center point a = 0 marker, where all approximations meet cos */}
		<circle cx={px(0)} cy={py(1)} r="4.5" fill={TEAL} stroke="#fff" stroke-width="1.4" />
		<text x={px(0) - 8} y={py(1) - 12} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={TEAL}>a = 0</text>

		{/* cos(x) hero label, riding the curve on the left where it is well separated */}
		<text x={px(-2.55)} y={py(fCos(-2.55)) - 10} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={TEAL}>cos(x)</text>

		{/* legend: the function and its three Taylor approximations */}
		<g transform="translate(470, 188)">
			<rect x="0" y="0" width="232" height="164" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="232" height="164" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="116" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">Taylor series at a = 0:</text>

			{/* cos(x) */}
			<line x1="14" y1="42" x2="42" y2="42" stroke={TEAL} stroke-width="2.8" />
			<text x="50" y="46" text-anchor="start" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={TEAL}>cos(x)</text>

			{/* 1st order (tangent) */}
			<line x1="14" y1="66" x2="42" y2="66" stroke={ACCENT} stroke-width="2" stroke-dasharray="1 5" stroke-linecap="round" />
			<text x="50" y="70" text-anchor="start" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={ACCENT}>1st order (tangent)</text>
			<text x="50" y="82" text-anchor="start" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill={ACCENT} opacity="0.85">y = 1</text>

			{/* 2nd order (parabola) */}
			<line x1="14" y1="100" x2="42" y2="100" stroke={AMBER} stroke-width="2" stroke-dasharray="2 4" />
			<text x="50" y="104" text-anchor="start" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={AMBER}>2nd order (parabola)</text>
			<text x="50" y="116" text-anchor="start" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill={AMBER} opacity="0.9">y = 1 - x²/2</text>

			{/* 4th order */}
			<line x1="14" y1="134" x2="42" y2="134" stroke={SKY} stroke-width="2" stroke-dasharray="6 4" />
			<text x="50" y="138" text-anchor="start" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={SKY}>4th order</text>
			<text x="50" y="150" text-anchor="start" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill={SKY} opacity="0.9">y = 1 - x²/2 + x⁴/24</text>
		</g>
	</svg>
	<figcaption>Centered at a = 0, each Taylor polynomial of cos(x) hugs the curve over a wider range than the one before it. The 1st-order term is just the tangent line y = 1 (cos has zero slope at 0). The 2nd-order parabola y = 1 - x²/2 bends downward with the curve near 0, then dives away. The 4th-order polynomial y = 1 - x²/2 + x⁴/24 tracks cos far longer before separating. Add more terms and the polynomial matches the function over an ever wider interval around the center.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 8 (Visual Math: Calculus), Lesson 7, illustration 1 of 1.
 *
 * Why e is special. Three exponential curves, 2^x, e^x, and 3^x, are
 * plotted on one set of axes. All three pass through (0, 1). At that shared
 * point, the tangent line to each curve is drawn. The teaching point: the
 * tangent slope at x = 0 equals the natural log of the base. For 2^x the
 * slope is about 0.69 (less than 1, so the tangent climbs more gently than
 * the curve's own value). For 3^x it is about 1.10 (greater than 1). For
 * e^x it is exactly 1: the slope equals the value at every point, which is
 * what makes e the natural base of growth. e^x is the highlighted hero
 * curve in accent purple; 2^x and 3^x are muted.
 */

const cx = 360; // origin x (x = 0 sits mid-canvas, since x ranges over [-1.5, 1.5])
const cy = 300; // origin y (graph origin, the line y = 0)
const SX = 170; // scale: 1 unit on the x-axis is 170 px
const SY = 44;  // scale: 1 unit on the y-axis is 44 px

const X_MIN = -1.5;
const X_MAX = 1.5;
const Y_MAX = 5.4; // headroom above 3^1.5 ≈ 5.196

const sx = (gx: number) => cx + gx * SX;
const sy = (gy: number) => cy - gy * SY;

// Sample an exponential curve b^x over [X_MIN, X_MAX] into an SVG path d-string.
const N_SAMPLES = 80;
const curvePath = (base: number) => {
	let d = '';
	for (let i = 0; i < N_SAMPLES + 1; i++) {
		const x = X_MIN + (i / N_SAMPLES) * (X_MAX - X_MIN);
		const y = Math.pow(base, x);
		d += `${i === 0 ? 'M' : 'L'} ${sx(x).toFixed(2)} ${sy(y).toFixed(2)} `;
	}
	return d.trim();
};

// Tangent to b^x at x = 0 in math coordinates: y = 1 + slope·x, slope = ln(base).
// Endpoints pushed through the same coordinate map as the curves.
const TAN_HALF = 0.95; // x half-window for drawing each tangent segment
const tangentLine = (slope: number) => ({
	x1: sx(-TAN_HALF),
	y1: sy(1 + slope * -TAN_HALF),
	x2: sx(TAN_HALF),
	y2: sy(1 + slope * TAN_HALF),
});

const slope2 = Math.log(2); // 0.693
const slopeE = 1;           // exactly 1
const slope3 = Math.log(3); // 1.099

const tan2 = tangentLine(slope2);
const tanE = tangentLine(slopeE);
const tan3 = tangentLine(slope3);

// axis ticks
const xTicks = [-1, 0, 1];
const yTicks = [1, 2, 3, 4, 5];

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
const SKY = '#0284c7';
---

<figure class="cw-illus">
	<svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ca-e-title ca-e-desc">
		<title id="ca-e-title">The curves 2^x, e^x, and 3^x with their tangent lines at x = 0, showing the tangent slope equals the natural log of the base</title>
		<desc id="ca-e-desc">A coordinate graph with x on the horizontal axis from negative 1.5 to 1.5 and y on the vertical axis from 0 to about 5.4. Three exponential curves rise from left to right and all pass through the point (0, 1). The curve 2 to the x is muted sky blue, the curve 3 to the x is muted amber, and the curve e to the x is the highlighted hero in accent purple, sitting between the other two. At the shared point (0, 1) a tangent line is drawn to each curve. The tangent to 2 to the x has slope about 0.69, which is less than 1, so it rises more gently than the curve. The tangent to e to the x has slope exactly 1, so it climbs at the same rate as the curve's value. The tangent to 3 to the x has slope about 1.10, which is greater than 1. Each tangent is labeled with its slope at zero.</desc>

		<defs>
			<marker id="ca-e-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
			</marker>
		</defs>

		{/* axes */}
		<line x1={sx(X_MIN) - 20} y1={cy} x2={sx(X_MAX) + 26} y2={cy} stroke="currentColor" stroke-width="1.2" opacity="0.55" marker-end="url(#ca-e-arrow)" />
		<line x1={cx} y1={cy + 14} x2={cx} y2={sy(Y_MAX) - 14} stroke="currentColor" stroke-width="1.2" opacity="0.55" marker-end="url(#ca-e-arrow)" />

		{/* axis tick labels */}
		{xTicks.map((t) => (
			<g>
				<line x1={sx(t)} y1={cy} x2={sx(t)} y2={cy + 5} stroke="currentColor" stroke-width="0.8" opacity="0.5" />
				<text x={sx(t)} y={cy + 18} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">{t}</text>
			</g>
		))}
		{yTicks.map((t) => (
			<g>
				<line x1={cx - 5} y1={sy(t)} x2={cx} y2={sy(t)} stroke="currentColor" stroke-width="0.8" opacity="0.5" />
				<text x={cx - 8} y={sy(t) + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">{t}</text>
			</g>
		))}

		<text x={sx(X_MAX) + 26} y={cy + 22} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill="currentColor" opacity="0.7">x</text>
		<text x={cx - 8} y={sy(Y_MAX) - 18} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill="currentColor" opacity="0.7">y</text>

		{/* tangent lines at (0, 1): drawn under the curves so the curves read on top */}
		<line x1={tan2.x1} y1={tan2.y1} x2={tan2.x2} y2={tan2.y2} stroke={SKY} stroke-width="1.3" stroke-dasharray="5 4" opacity="0.85" />
		<line x1={tan3.x1} y1={tan3.y1} x2={tan3.x2} y2={tan3.y2} stroke={AMBER} stroke-width="1.3" stroke-dasharray="5 4" opacity="0.85" />
		<line x1={tanE.x1} y1={tanE.y1} x2={tanE.x2} y2={tanE.y2} stroke={ACCENT} stroke-width="1.6" stroke-dasharray="5 4" opacity="0.95" />

		{/* the three curves: 2^x and 3^x muted, e^x is the hero */}
		<path d={curvePath(2)} fill="none" stroke={SKY} stroke-width="1.8" opacity="0.7" />
		<path d={curvePath(3)} fill="none" stroke={AMBER} stroke-width="1.8" opacity="0.7" />
		<path d={curvePath(Math.E)} fill="none" stroke={ACCENT} stroke-width="3" />

		{/* the shared point (0, 1) where all three meet */}
		<circle cx={sx(0)} cy={sy(1)} r="3.4" fill={ACCENT} />
		<text x={sx(0) + 8} y={sy(1) + 20} font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">(0, 1)</text>

		{/* curve labels, placed near each curve's right end */}
		<text x={sx(X_MAX) + 4} y={sy(Math.pow(2, X_MAX)) + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={SKY}>2^x</text>
		<text x={sx(X_MAX) + 4} y={sy(Math.pow(Math.E, X_MAX)) + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>e^x</text>
		<text x={sx(X_MAX) + 4} y={sy(Math.pow(3, X_MAX)) + 2} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={AMBER}>3^x</text>

		{/* slope annotations: < and > written as entities to avoid the JSX parse trap */}
		<g transform="translate(40, 70)">
			<rect x="0" y="0" width="214" height="104" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="214" height="104" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="14" y="22" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">tangent slope at x = 0  =  ln(base):</text>

			<line x1="14" y1="38" x2="34" y2="38" stroke={SKY} stroke-width="1.3" stroke-dasharray="5 4" />
			<text x="42" y="42" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={SKY}>2^x: slope 0.69 (&lt; 1)</text>

			<line x1="14" y1="62" x2="34" y2="62" stroke={ACCENT} stroke-width="1.6" stroke-dasharray="5 4" />
			<text x="42" y="66" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={ACCENT}>e^x: slope 1 (= 1, exactly)</text>

			<line x1="14" y1="86" x2="34" y2="86" stroke={AMBER} stroke-width="1.3" stroke-dasharray="5 4" />
			<text x="42" y="90" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={AMBER}>3^x: slope 1.10 (&gt; 1)</text>
		</g>
	</svg>
	<figcaption>Three exponential curves through (0, 1), each with its tangent line at that point. The tangent slope there equals the natural log of the base: about 0.69 for 2^x (less than 1), about 1.10 for 3^x (greater than 1), and exactly 1 for e^x. That last fact is what makes e special. The curve whose slope equals its own value at every point is e^x, so its rate of growth is always its current size.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

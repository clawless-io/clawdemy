---
/**
 * Track 8 (Visual Math: Calculus), Lesson 1, illustration 2 of 2.
 *
 * Plot the ring-area function 2πr on a graph with r on the horizontal
 * axis and 2πr on the vertical. Each disk-ring (width dr, area 2πr·dr)
 * becomes a thin standing rectangle here, of width dr and height 2πr.
 * Summing all those rectangles approximates the area under the line
 * y = 2πr from 0 to R, which is the triangle with base R and height 2πR.
 * Triangle area: ½ · R · 2πR = πR². The unit disk's area is exactly π.
 */

const cx = 130; // origin x
const cy = 305; // origin y (graph origin)
const SX = 460; // scale: full R=1 spans 460 px horizontally
const SY = 35;  // scale: 1 unit on y-axis is 35 px

const R = 1; // unit disk
const Y_TOP = 2 * Math.PI; // y = 2π·R at r = R

const sx = (gx: number) => cx + gx * SX;
const sy = (gy: number) => cy - gy * SY;

const N_STRIPS = 14;
const dr = R / N_STRIPS;
const strips: { r: number; width: number; height: number }[] = [];
for (let i = 0; i < N_STRIPS; i++) {
	const r = i * dr; // left endpoint
	strips.push({ r, width: dr, height: 2 * Math.PI * (r + dr / 2) }); // use midpoint height for visual fairness
}

// axis ticks
const xTicks = [0.25, 0.5, 0.75, 1.0];
const yTicks = [2, 4, 6];

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ca-tri-title ca-tri-desc">
		<title id="ca-tri-title">The line y = 2πr from 0 to R with rectangles summing to the triangle of area πR²</title>
		<desc id="ca-tri-desc">A two-dimensional coordinate graph with the r axis horizontal from 0 to R, and the value 2 pi r on the vertical axis from 0 to 2 pi R. The straight line y equals 2 pi r is plotted in teal, rising from the origin to the point (R, 2 pi R). Fourteen thin standing rectangles below the line (Riemann strips), one per ring, are filled in light accent purple and outlined; each has width d r and height 2 pi r evaluated at its midpoint. The triangle formed by the origin, the point (R, 0), and the point (R, 2 pi R), which has area pi R squared, is outlined in accent and labeled "area = pi R squared".</desc>

		<defs>
			<marker id="ca-tri-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
			</marker>
		</defs>

		{/* axes */}
		<line x1={cx} y1={cy} x2={sx(R) + 30} y2={cy} stroke="currentColor" stroke-width="1.2" opacity="0.55" marker-end="url(#ca-tri-arrow)" />
		<line x1={cx} y1={cy} x2={cx} y2={sy(Y_TOP) - 18} stroke="currentColor" stroke-width="1.2" opacity="0.55" marker-end="url(#ca-tri-arrow)" />

		{/* axis tick labels */}
		{xTicks.map((t) => (
			<g>
				<line x1={sx(t)} y1={cy} x2={sx(t)} y2={cy + 5} stroke="currentColor" stroke-width="0.8" opacity="0.5" />
				<text x={sx(t)} y={cy + 18} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">{t}</text>
			</g>
		))}
		{yTicks.map((t) => (
			<g>
				<line x1={cx - 5} y1={sy(t)} x2={cx} y2={sy(t)} stroke="currentColor" stroke-width="0.8" opacity="0.5" />
				<text x={cx - 8} y={sy(t) + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">{t}</text>
			</g>
		))}

		<text x={sx(R) + 30} y={cy + 22} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill="currentColor" opacity="0.7">r</text>
		<text x={cx - 8} y={sy(Y_TOP) - 22} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={TEAL}>2πr</text>

		{/* The triangle outline (fill) */}
		<path d={`M ${sx(0)} ${sy(0)} L ${sx(R)} ${sy(0)} L ${sx(R)} ${sy(Y_TOP)} Z`} fill={ACCENT} fill-opacity="0.08" stroke={ACCENT} stroke-width="1.6" />

		{/* Riemann strips (drawn on top of triangle, in slightly stronger purple) */}
		{strips.map((s) => (
			<rect x={sx(s.r)} y={sy(s.height)} width={s.width * SX} height={s.height * SY} fill={ACCENT} fill-opacity="0.18" stroke={ACCENT} stroke-width="0.5" opacity="0.85" />
		))}

		{/* the line y = 2πr on top of everything */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(R)} y2={sy(Y_TOP)} stroke={TEAL} stroke-width="2.6" />

		{/* highlighted strip label: pick strip ~6 (~r = 0.4) */}
		{(() => {
			const s = strips[8];
			const xMid = sx(s.r + s.width / 2);
			const yTop = sy(s.height);
			return (
				<g>
					<line x1={xMid} y1={yTop} x2={xMid + 80} y2={yTop - 30} stroke={AMBER} stroke-width="1.1" opacity="0.7" />
					<rect x={xMid + 78} y={yTop - 60} width="110" height="42" rx="4" fill={AMBER} fill-opacity="0.1" stroke={AMBER} stroke-width="1.2" />
					<text x={xMid + 132} y={yTop - 44} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={AMBER}>one strip:</text>
					<text x={xMid + 132} y={yTop - 28} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={AMBER}>2πr · dr</text>
				</g>
			);
		})()}

		{/* triangle area legend */}
		<g transform="translate(420, 90)">
			<rect x="0" y="0" width="260" height="84" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="260" height="84" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="130" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">sum of all strips:</text>
			<text x="130" y="46" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor">
				= triangle area = ½·R·(2πR)
			</text>
			<text x="130" y="70" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" font-weight="700" fill={ACCENT}>
				= πR²
			</text>
		</g>

		{/* labels for the triangle base + height */}
		<text x={sx(R / 2)} y={cy + 34} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={ACCENT}>R</text>
		<text x={sx(R) + 26} y={sy(Y_TOP / 2)} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={ACCENT}>2πR</text>
	</svg>
	<figcaption>Plot the ring area function: each ring of width dr at radius r is a standing rectangle of width dr and height 2πr. As the rings get thinner, those rectangles fill the triangle under the line y = 2πr from 0 to R, with area ½ times R times 2πR, which simplifies to πR². The unit disk has area exactly π.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 8 (Visual Math: Calculus), Lesson 1, illustration 1 of 2.
 *
 * The canonical disk-into-rings construction. A unit disk on the left is
 * carved into concentric annular rings. One thin ring at radius r is
 * highlighted. On the right, that same ring has been "cut along a radius"
 * and unrolled into a thin rectangle: length 2πr (the circumference) by
 * width dr (the thickness). Area of the ring is, to first order in dr,
 * exactly 2πr times dr.
 */

const PANEL_W = 320;
const PANEL_X1 = 30;
const PANEL_X2 = 390;

// Left disk panel
const cyL = 220;
const cxL = PANEL_X1 + PANEL_W / 2;
const R_PX = 110; // disk radius in pixels
const N_RINGS = 10;
const HIGHLIGHT_RING = 6; // 0-indexed; highlight the ring whose outer edge is at index 6

// Right unrolled panel
const cyR = 220;
const cxR = PANEL_X2 + PANEL_W / 2;
const UNROLLED_LEN = 240; // pixels: this represents 2πr
const UNROLLED_W = 16; // pixels: this represents dr (exaggerated for visibility)

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ca-rings-title ca-rings-desc">
		<title id="ca-rings-title">A disk carved into concentric rings, with one ring at radius r unrolled into a thin rectangle of length 2πr and width dr</title>
		<desc id="ca-rings-desc">Two side-by-side panels. The left panel shows a unit disk centered at the origin, drawn as ten concentric circles like a target. One ring near the outer edge, at radius r, is highlighted in accent purple. A small label r marks the radial distance to that ring. The right panel shows the same highlighted ring after being cut along a radius and laid flat: a thin horizontal rectangle of length 2πr (the ring's circumference) and width dr (the ring's thickness). The label reads "ring area ≈ 2πr · dr".</desc>

		<defs>
			<marker id="ca-rings-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
			<marker id="ca-rings-arrow-r" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
		</defs>

		{/* left panel: disk with concentric rings */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={cxL} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.85">unit disk, carved into rings</text>

		{/* rings: from inner to outer; HIGHLIGHT_RING gets filled, others outline only */}
		{Array.from({ length: N_RINGS }, (_, i) => {
			const outerR = ((i + 1) / N_RINGS) * R_PX;
			const innerR = (i / N_RINGS) * R_PX;
			const isHighlight = i === HIGHLIGHT_RING;
			if (isHighlight) {
				return (
					<path d={`M ${cxL + outerR} ${cyL} A ${outerR} ${outerR} 0 1 1 ${cxL - outerR} ${cyL} A ${outerR} ${outerR} 0 1 1 ${cxL + outerR} ${cyL} Z M ${cxL + innerR} ${cyL} A ${innerR} ${innerR} 0 1 0 ${cxL - innerR} ${cyL} A ${innerR} ${innerR} 0 1 0 ${cxL + innerR} ${cyL} Z`} fill-rule="evenodd" fill={ACCENT} fill-opacity="0.45" stroke={ACCENT} stroke-width="1.2" />
				);
			}
			return <circle cx={cxL} cy={cyL} r={outerR} fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.35" />;
		})}

		{/* radius arrow from center to the highlighted ring */}
		{(() => {
			const rMid = ((HIGHLIGHT_RING + 0.5) / N_RINGS) * R_PX;
			const angle = -Math.PI / 4; // 45° upper-right
			const tipX = cxL + rMid * Math.cos(angle);
			const tipY = cyL + rMid * Math.sin(angle);
			return (
				<g>
					<line x1={cxL} y1={cyL} x2={tipX} y2={tipY} stroke={AMBER} stroke-width="2" marker-end="url(#ca-rings-arrow-r)" />
					<text x={(cxL + tipX) / 2 + 8} y={(cyL + tipY) / 2 - 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={AMBER}>r</text>
				</g>
			);
		})()}

		<circle cx={cxL} cy={cyL} r="2.6" fill="currentColor" />

		{/* connector arrow between panels: "unroll" */}
		<line x1={PANEL_X1 + PANEL_W + 8} y1={180} x2={PANEL_X2 - 8} y2={180} stroke={ACCENT} stroke-width="2" marker-end="url(#ca-rings-arrow)" />
		<text x={(PANEL_X1 + PANEL_W + PANEL_X2) / 2} y={170} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>unroll</text>
		<text x={(PANEL_X1 + PANEL_W + PANEL_X2) / 2} y={200} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.6">cut + lay flat</text>

		{/* right panel: unrolled ring as a thin rectangle */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={cxR} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>the ring, unrolled</text>

		{(() => {
			const rectX = cxR - UNROLLED_LEN / 2;
			const rectY = cyR - UNROLLED_W / 2;
			return (
				<g>
					<rect x={rectX} y={rectY} width={UNROLLED_LEN} height={UNROLLED_W} fill={ACCENT} fill-opacity="0.45" stroke={ACCENT} stroke-width="1.4" />

					{/* length bracket (2πr) */}
					<line x1={rectX} y1={rectY - 18} x2={rectX + UNROLLED_LEN} y2={rectY - 18} stroke={TEAL} stroke-width="1.2" />
					<line x1={rectX} y1={rectY - 22} x2={rectX} y2={rectY - 12} stroke={TEAL} stroke-width="1.2" />
					<line x1={rectX + UNROLLED_LEN} y1={rectY - 22} x2={rectX + UNROLLED_LEN} y2={rectY - 12} stroke={TEAL} stroke-width="1.2" />
					<text x={cxR} y={rectY - 26} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>2πr</text>
					<text x={cxR} y={rectY - 44} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.6">(circumference of the ring)</text>

					{/* width bracket (dr) */}
					<line x1={rectX + UNROLLED_LEN + 12} y1={rectY} x2={rectX + UNROLLED_LEN + 12} y2={rectY + UNROLLED_W} stroke={AMBER} stroke-width="1.2" />
					<line x1={rectX + UNROLLED_LEN + 8} y1={rectY} x2={rectX + UNROLLED_LEN + 16} y2={rectY} stroke={AMBER} stroke-width="1.2" />
					<line x1={rectX + UNROLLED_LEN + 8} y1={rectY + UNROLLED_W} x2={rectX + UNROLLED_LEN + 16} y2={rectY + UNROLLED_W} stroke={AMBER} stroke-width="1.2" />
					<text x={rectX + UNROLLED_LEN + 22} y={rectY + UNROLLED_W / 2 + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={AMBER}>dr</text>
				</g>
			);
		})()}

		{/* area formula below */}
		<g transform={`translate(${cxR - 110}, 280)`}>
			<rect x="0" y="0" width="220" height="48" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="220" height="48" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="110" y="20" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">ring area, to first order:</text>
			<text x="110" y="40" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>dA ≈ <tspan fill={TEAL}>2πr</tspan> · <tspan fill={AMBER}>dr</tspan></text>
		</g>
	</svg>
	<figcaption>Carve the disk into very thin concentric rings. Pull one ring, the one at radius r, off the disk and lay it flat. It is essentially a thin rectangle: length 2πr (the circumference it used to be) by width dr (the thickness you chose). Its area, to first order in dr, is 2πr times dr. That is the strip you'll add up to get the disk's area.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

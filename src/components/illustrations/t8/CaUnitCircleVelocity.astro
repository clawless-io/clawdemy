---
/**
 * Track 8 (Visual Math: Calculus), Lesson 4, illustration 2 of 2.
 *
 * The velocity vector along the unit circle. As x increases (you walk
 * counter-clockwise), the point (cos x, sin x) moves with velocity
 * (-sin x, cos x). This vector is tangent to the circle, perpendicular
 * to the radius, has length 1, and points counter-clockwise. Reading
 * its two components off gives d(cos x)/dx = -sin x and d(sin x)/dx = cos x.
 */

const cx = 280;
const cy = 195;
const R_UNIT = 120;

const xAngleDeg = 60;
const xRad = (xAngleDeg * Math.PI) / 180;
const cosX = Math.cos(xRad);
const sinX = Math.sin(xRad);

const ptX = cx + cosX * R_UNIT;
const ptY = cy - sinX * R_UNIT;

// velocity vector at the point: (-sin x, cos x) scaled to display length
const VEL_LEN = R_UNIT; // length 1 unit in graph
const velTipX = ptX + (-sinX) * VEL_LEN;
const velTipY = ptY - cosX * VEL_LEN;

// right-angle marker between radius (from origin to ptr) and velocity
function rightAngle(): string {
	// unit along radius (from origin to point)
	const rx = cosX;
	const ry = sinX;
	// unit along velocity
	const vx = -sinX;
	const vy = cosX;
	const k = 0.13;
	// in svg space, walk from the point
	const aX = ptX + rx * R_UNIT * -k;
	const aY = ptY - ry * R_UNIT * -k;
	const cX = aX + vx * R_UNIT * k;
	const cY = aY - vy * R_UNIT * k;
	const bX = ptX + vx * R_UNIT * k;
	const bY = ptY - vy * R_UNIT * k;
	return `M ${aX} ${aY} L ${cX} ${cY} L ${bX} ${bY}`;
}

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';

// projection of velocity on the axes for component readout
const velCompXend = { X: velTipX, Y: ptY };
const velCompYend = { X: ptX, Y: velTipY };
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ca-ucvel-title ca-ucvel-desc">
		<title id="ca-ucvel-title">The velocity vector at (cos x, sin x) is (negative sin x, cos x): tangent to the circle, perpendicular to the radius, length 1</title>
		<desc id="ca-ucvel-desc">A two-dimensional coordinate scene with x and y axes through a central origin. A unit circle is drawn around the origin. A purple radius line runs from the origin to the point (cos x, sin x) at angle x equals 60 degrees. From that point a teal velocity arrow of length one is drawn tangent to the circle, perpendicular to the radius (with a small right-angle marker), pointing counter-clockwise. The velocity's components, read off the axes, are negative sin x in the horizontal direction (negative because the motion is leftward) and cos x in the vertical direction. The label states "d cos x over dx equals negative sin x" and "d sin x over dx equals cos x".</desc>

		<defs>
			<marker id="ca-ucv-arrow-ax" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
			</marker>
			<marker id="ca-ucv-arrow-v" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
		</defs>

		{/* axes */}
		<line x1={cx - R_UNIT - 30} y1={cy} x2={cx + R_UNIT + 30} y2={cy} stroke="currentColor" stroke-width="1.1" opacity="0.5" marker-end="url(#ca-ucv-arrow-ax)" />
		<line x1={cx} y1={cy + R_UNIT + 30} x2={cx} y2={cy - R_UNIT - 30} stroke="currentColor" stroke-width="1.1" opacity="0.5" marker-end="url(#ca-ucv-arrow-ax)" />

		{/* unit circle */}
		<circle cx={cx} cy={cy} r={R_UNIT} fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5" />

		{/* radius */}
		<line x1={cx} y1={cy} x2={ptX} y2={ptY} stroke={ACCENT} stroke-width="2.2" opacity="0.8" />

		{/* velocity component projections (dashed) */}
		<line x1={velTipX} y1={velTipY} x2={velCompXend.X} y2={velCompXend.Y} stroke={AMBER} stroke-width="1.2" stroke-dasharray="4 4" opacity="0.55" />
		<line x1={velTipX} y1={velTipY} x2={velCompYend.X} y2={velCompYend.Y} stroke={AMBER} stroke-width="1.2" stroke-dasharray="4 4" opacity="0.55" />

		{/* velocity vector itself (bold teal arrow from point) */}
		<line x1={ptX} y1={ptY} x2={velTipX} y2={velTipY} stroke={TEAL} stroke-width="2.8" marker-end="url(#ca-ucv-arrow-v)" />

		{/* right-angle marker at the point between radius and velocity */}
		<path d={rightAngle()} fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.7" />

		{/* the point */}
		<circle cx={ptX} cy={ptY} r="4" fill={ACCENT} />
		<circle cx={cx} cy={cy} r="3" fill="currentColor" />

		{/* labels */}
		<text x={ptX + 8} y={ptY + 16} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>(cos x, sin x)</text>
		<text x={velTipX - 4} y={velTipY - 8} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={TEAL}>velocity</text>
		<text x={velTipX - 4} y={velTipY + 8} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={TEAL}>(-sin x, cos x)</text>

		{/* component labels */}
		<text x={(velTipX + ptX) / 2} y={ptY + 18} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" font-weight="700" fill={AMBER}>-sin x</text>
		<text x={velTipX + 24} y={(velTipY + ptY) / 2 + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" font-weight="700" fill={AMBER}>cos x</text>

		{/* legend */}
		<g transform="translate(500, 80)">
			<rect x="0" y="0" width="220" height="180" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="220" height="180" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="110" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">velocity at angle x:</text>
			<text x="110" y="48" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={TEAL}>(-sin x, cos x)</text>
			<text x="110" y="80" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">read off the components:</text>
			<text x="110" y="106" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>d(cos x)/dx = -sin x</text>
			<text x="110" y="128" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>d(sin x)/dx = cos x</text>
			<text x="110" y="156" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.6">tangent + length 1 + 90° to radius</text>
		</g>
	</svg>
	<figcaption>As x increases, the point (cos x, sin x) moves along the circle. Its velocity vector points along the tangent at right angles to the radius, has length 1 (one unit of angle moves the point one unit of arc), and points counter-clockwise. The two components of that velocity, read off the axes, are -sin x and cos x: exactly the derivatives of cos x and sin x.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 8 (Visual Math: Calculus), Lesson 10, illustration: Riemann sums.
 *
 * Two side-by-side panels showing the same curve y = x squared over the
 * interval [0, 1]. The LEFT panel approximates the area under the curve
 * with a COARSE Riemann sum: five thick rectangles, midpoint heights,
 * soft amber fill. The RIGHT panel uses a FINE Riemann sum: twenty-four
 * thin rectangles whose staircase visibly collapses onto the smooth curve.
 *
 * Teaching point: as the strips get thinner and more numerous, the
 * staircase approximation converges to the true area under the curve,
 * which is the definite integral. Both panels use the midpoint height
 * convention (height = f at the strip's midpoint) for visual fairness,
 * matching the sibling Track 8 strip illustration.
 */

// curve: y = x^2 on [0, 1]
const f = (x: number) => x * x;
const A = 0; // interval start
const B = 1; // interval end

// per-panel framing
const PANEL_W = 320;
const PANEL_X1 = 30;  // left panel x-origin
const PANEL_X2 = 370; // right panel x-origin
const PLOT_W = 240;   // horizontal pixels spanning [A, B] inside a panel
const PLOT_H = 220;   // vertical pixels spanning y in [0, 1]
const PAD_L = 40;     // left inset to the y-axis inside the panel
const BASE_Y = 300;   // pixel y of the x-axis (y = 0) in both panels

// math-to-pixel helper for the LEFT (coarse) panel
const sxL = (x: number) => PANEL_X1 + PAD_L + ((x - A) / (B - A)) * PLOT_W;
const syL = (y: number) => BASE_Y - y * PLOT_H;

// math-to-pixel helper for the RIGHT (fine) panel
const sxR = (x: number) => PANEL_X2 + PAD_L + ((x - A) / (B - A)) * PLOT_W;
const syR = (y: number) => BASE_Y - y * PLOT_H;

const N_COARSE = 5;
const N_FINE = 24;

// sampled smooth-curve path for a panel, using that panel's helpers
const curvePath = (sx: (x: number) => number, sy: (y: number) => number) => {
	const samples = 80;
	let d = '';
	for (let i = 0; i < samples + 1; i++) {
		const x = A + ((B - A) * i) / samples;
		d += `${i === 0 ? 'M' : 'L'} ${sx(x).toFixed(2)} ${sy(f(x)).toFixed(2)} `;
	}
	return d.trim();
};

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
const SKY = '#0284c7';
---

<figure class="cw-illus">
	<svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ca-riemann-title ca-riemann-desc">
		<title id="ca-riemann-title">A coarse Riemann sum and a fine Riemann sum approximating the area under y = x squared on the interval from 0 to 1</title>
		<desc id="ca-riemann-desc">Two side-by-side coordinate panels, each plotting the same smooth curve y equals x squared over the interval from 0 to 1, drawn in teal. The left panel shows a coarse approximation: five thick amber-filled rectangles standing under the curve, each one as tall as the curve at the middle of its strip, leaving visible gaps and overshoots where the staircase misses the smooth curve. The right panel shows a fine approximation: twenty-four thin amber-filled rectangles whose tops hug the curve so closely that the staircase nearly disappears into the smooth area beneath the curve. The left panel is labeled "coarse (few strips)" and the right panel is labeled "fine (many strips, toward the integral)". The teaching point: as the strips become thinner and more numerous, the rectangle sum converges to the true area under the curve, which is the definite integral.</desc>

		{/* ---------- LEFT PANEL: coarse Riemann sum ---------- */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.85">coarse (few strips)</text>

		{/* amber rectangles: width = (B - A)/N, height = f at strip midpoint */}
		{(() => {
			const dx = (B - A) / N_COARSE;
			return Array.from({ length: N_COARSE }, (_, i) => {
				const xLeft = A + i * dx;
				const xMid = xLeft + dx / 2;
				const h = f(xMid);
				return (
					<rect
						x={sxL(xLeft)}
						y={syL(h)}
						width={(dx / (B - A)) * PLOT_W}
						height={h * PLOT_H}
						fill={AMBER}
						fill-opacity="0.22"
						stroke={AMBER}
						stroke-width="1.3"
					/>
				);
			});
		})()}

		{/* axes (drawn over the fill base) */}
		<line x1={sxL(A)} y1={BASE_Y} x2={sxL(B) + 16} y2={BASE_Y} stroke="currentColor" stroke-width="1.2" opacity="0.55" />
		<line x1={sxL(A)} y1={BASE_Y} x2={sxL(A)} y2={syL(1) - 14} stroke="currentColor" stroke-width="1.2" opacity="0.55" />

		{/* smooth curve y = x^2 on top of the rectangles */}
		<path d={curvePath(sxL, syL)} fill="none" stroke={TEAL} stroke-width="2.6" />

		{/* axis end labels */}
		<text x={sxL(B) + 16} y={BASE_Y + 16} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">x</text>
		<text x={sxL(B) + 6} y={syL(1) + 2} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={TEAL}>y = x²</text>
		<text x={sxL(A)} y={BASE_Y + 16} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">0</text>
		<text x={sxL(B)} y={BASE_Y + 16} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">1</text>

		{/* ---------- RIGHT PANEL: fine Riemann sum ---------- */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>fine (many strips, toward the integral)</text>

		{/* many thin amber rectangles: same midpoint-height convention */}
		{(() => {
			const dx = (B - A) / N_FINE;
			return Array.from({ length: N_FINE }, (_, i) => {
				const xLeft = A + i * dx;
				const xMid = xLeft + dx / 2;
				const h = f(xMid);
				return (
					<rect
						x={sxR(xLeft)}
						y={syR(h)}
						width={(dx / (B - A)) * PLOT_W}
						height={h * PLOT_H}
						fill={AMBER}
						fill-opacity="0.28"
						stroke={AMBER}
						stroke-width="0.5"
					/>
				);
			});
		})()}

		{/* axes */}
		<line x1={sxR(A)} y1={BASE_Y} x2={sxR(B) + 16} y2={BASE_Y} stroke="currentColor" stroke-width="1.2" opacity="0.55" />
		<line x1={sxR(A)} y1={BASE_Y} x2={sxR(A)} y2={syR(1) - 14} stroke="currentColor" stroke-width="1.2" opacity="0.55" />

		{/* smooth curve y = x^2 on top of the rectangles */}
		<path d={curvePath(sxR, syR)} fill="none" stroke={TEAL} stroke-width="2.6" />

		{/* axis end labels */}
		<text x={sxR(B) + 16} y={BASE_Y + 16} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">x</text>
		<text x={sxR(B) + 6} y={syR(1) + 2} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={TEAL}>y = x²</text>
		<text x={sxR(A)} y={BASE_Y + 16} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">0</text>
		<text x={sxR(B)} y={BASE_Y + 16} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">1</text>

		{/* the definite-integral target label, under the fine panel area */}
		<text x={sxR(0.5)} y={syR(0.16)} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={SKY}>∫₀¹ x² dx</text>

		{/* convergence connector between panels */}
		<text x={(PANEL_X1 + PANEL_W + PANEL_X2) / 2} y={176} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="15" font-weight="700" fill={ACCENT}>→</text>
		<text x={(PANEL_X1 + PANEL_W + PANEL_X2) / 2} y={196} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="9" fill="currentColor" opacity="0.6">thinner strips</text>
	</svg>
	<figcaption>Approximate the area under y = x² by standing thin rectangles on the interval and adding them up. With a few coarse strips (left) the staircase clearly misses the smooth curve. With many fine strips (right) the rectangle tops hug the curve and the gaps all but vanish. As the strips get thinner and more numerous, the sum converges to the true area under the curve, the definite integral of x² from 0 to 1.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

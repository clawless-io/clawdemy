---
/**
 * Track 8 (Visual Math: Calculus), Lesson 2, illustration 1 of 1.
 *
 * The secant-to-tangent limit. A curve s(t) = t²/4 + 1 is plotted. From
 * the fixed point (t, s(t)) = (2, 2) several secants are drawn to nearby
 * points (t+dt, s(t+dt)) for dt = 2, 1, 0.5. As dt shrinks, the secant
 * line pivots around (2, 2) and approaches the tangent line at that
 * point, which has slope s'(2) = t/2 evaluated at t=2, equal to 1.
 */

const cx = 100; // origin x in svg space
const cy = 305; // origin y (graph baseline)
const SX = 90; // pixels per unit on t axis
const SY = 36; // pixels per unit on y axis

const T_MIN = -0.5;
const T_MAX = 6;
const Y_MIN = -0.5;
const Y_MAX = 7;

const sx = (gx: number) => cx + (gx - T_MIN) * SX;
const sy = (gy: number) => cy - (gy - Y_MIN) * SY;

// curve s(t) = t²/4 + 1
const s = (t: number) => (t * t) / 4 + 1;

const SAMPLES = 60;
const curvePts: { X: number; Y: number }[] = [];
for (let i = 0; i <= SAMPLES; i++) {
	const t = T_MIN + ((T_MAX - T_MIN) * i) / SAMPLES;
	curvePts.push({ X: sx(t), Y: sy(s(t)) });
}
const curvePath = curvePts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.X.toFixed(1)} ${p.Y.toFixed(1)}`).join(' ');

const t0 = 2;
const sAt0 = s(t0); // 2

// secant lines: extend each beyond the two anchor points
type Secant = { dt: number; color: string; opacity: number; label: string };
const secants: Secant[] = [
	{ dt: 2, color: '#d97706', opacity: 0.45, label: 'dt = 2' },
	{ dt: 1, color: '#d97706', opacity: 0.7, label: 'dt = 1' },
	{ dt: 0.5, color: '#d97706', opacity: 0.95, label: 'dt = 0.5' },
];

function secantEnds(t: number, dt: number) {
	const t1 = t;
	const t2 = t + dt;
	const slope = (s(t2) - s(t1)) / (t2 - t1);
	// extend secant from t-0.5 to t+dt+0.5
	const tStart = t - 0.5;
	const tEnd = t + dt + 0.5;
	const yStart = s(t) + slope * (tStart - t);
	const yEnd = s(t) + slope * (tEnd - t);
	return { tStart, tEnd, yStart, yEnd };
}

// tangent at t0: slope = t0/2 = 1
const tanSlope = t0 / 2;
const tanStart = { t: -0.2, y: sAt0 + tanSlope * (-0.2 - t0) };
const tanEnd = { t: 5.5, y: sAt0 + tanSlope * (5.5 - t0) };

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';

void AMBER;
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ca-sectan-title ca-sectan-desc">
		<title id="ca-sectan-title">A curve s(t) with secants through (t, s(t)) and (t+dt, s(t+dt)) rotating into the tangent line as dt shrinks to zero</title>
		<desc id="ca-sectan-desc">A two-dimensional coordinate plot with t on the horizontal axis and s of t on the vertical. The curve s of t equals t squared over 4 plus 1 is drawn in teal from t equals negative half to t equals 6. The fixed point at t equals 2, where s equals 2, is marked with a purple dot. Three secant lines through this point and a second point at t plus dt are drawn in amber, for dt equal to 2, 1, and 0.5, each progressively more opaque, illustrating the secant pivoting toward the tangent as dt shrinks. The tangent line at t equals 2 is drawn in solid purple, with slope 1. A curved arrow on the right indicates the limit "as dt to 0, secant to tangent".</desc>

		<defs>
			<marker id="ca-sectan-arrow-ax" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
			</marker>
			<marker id="ca-sectan-arrow-curve" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		{/* axes */}
		<line x1={cx} y1={cy} x2={sx(T_MAX) + 12} y2={cy} stroke="currentColor" stroke-width="1.1" opacity="0.55" marker-end="url(#ca-sectan-arrow-ax)" />
		<line x1={sx(0)} y1={cy} x2={sx(0)} y2={sy(Y_MAX) - 12} stroke="currentColor" stroke-width="1.1" opacity="0.55" marker-end="url(#ca-sectan-arrow-ax)" />

		<text x={sx(T_MAX) + 14} y={cy + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.65">t</text>
		<text x={sx(0) - 8} y={sy(Y_MAX) - 16} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.65">s(t)</text>

		{/* tick labels at t = 1, 2, 3, 4 */}
		{[1, 2, 3, 4, 5].map((t) => (
			<g>
				<line x1={sx(t)} y1={cy - 3} x2={sx(t)} y2={cy + 3} stroke="currentColor" stroke-width="0.8" opacity="0.5" />
				<text x={sx(t)} y={cy + 16} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.55">{t}</text>
			</g>
		))}

		{/* curve */}
		<path d={curvePath} fill="none" stroke={TEAL} stroke-width="2.4" />

		{/* secants (faintest first, then more opaque) */}
		{secants.map((sec) => {
			const e = secantEnds(t0, sec.dt);
			return (
				<g>
					<line x1={sx(e.tStart)} y1={sy(e.yStart)} x2={sx(e.tEnd)} y2={sy(e.yEnd)} stroke={sec.color} stroke-width="1.6" opacity={sec.opacity} stroke-dasharray={sec.dt > 0.7 ? '6 4' : '0'} />
					<circle cx={sx(t0 + sec.dt)} cy={sy(s(t0 + sec.dt))} r="3.2" fill={sec.color} opacity={sec.opacity} />
				</g>
			);
		})}

		{/* tangent line (bold purple, on top) */}
		<line x1={sx(tanStart.t)} y1={sy(tanStart.y)} x2={sx(tanEnd.t)} y2={sy(tanEnd.y)} stroke={ACCENT} stroke-width="2.6" />

		{/* fixed point (t0, s(t0)) */}
		<circle cx={sx(t0)} cy={sy(sAt0)} r="4" fill={ACCENT} />

		{/* labels */}
		<text x={sx(t0) - 8} y={sy(sAt0) + 18} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={ACCENT}>(t, s(t))</text>
		<text x={sx(tanEnd.t) + 6} y={sy(tanEnd.y) + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>tangent at t (slope 1)</text>

		{/* secants legend */}
		<g transform="translate(450, 200)">
			<rect x="0" y="0" width="260" height="120" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="260" height="120" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="130" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">secants through (t, s(t)) and (t+dt, s(t+dt)):</text>
			{secants.map((sec, idx) => (
				<g>
					<line x1="20" y1={48 + idx * 22} x2="62" y2={48 + idx * 22} stroke={sec.color} stroke-width="2" opacity={sec.opacity} stroke-dasharray={sec.dt > 0.7 ? '5 3' : '0'} />
					<text x="72" y={52 + idx * 22} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={sec.color} opacity={sec.opacity}>{sec.label}, slope = {((s(t0 + sec.dt) - s(t0)) / sec.dt).toFixed(2)}</text>
				</g>
			))}
		</g>

		{/* convergence arrow */}
		<path d="M 695 130 Q 660 150 640 180" fill="none" stroke={ACCENT} stroke-width="2" marker-end="url(#ca-sectan-arrow-curve)" />
		<text x="685" y="120" text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={ACCENT}>as dt → 0,</text>
		<text x="685" y="138" text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={ACCENT}>secant → tangent</text>
	</svg>
	<figcaption>Pick the point (t, s(t)) and a second point a bit further along the curve. The line through them, the secant, has slope equal to the average rate of change over that interval. Shrink dt and the second point slides toward the first; the secant pivots around (t, s(t)) until, in the limit, it becomes the tangent line. The derivative s'(t) is that limiting slope.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

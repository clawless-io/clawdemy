---
/**
 * Track 8 (Visual Math: Calculus), Lesson 3, illustration 2 of 2.
 *
 * The 3D analog: d(t³)/dt = 3t². A cube of side t = 3 is grown by dt = 0.5
 * on three faces. Three thin slabs of area t² and thickness dt are added,
 * with total volume 3t²·dt. Smaller higher-order terms (three dt² edges
 * and one dt³ corner) shrink faster and vanish; the leading-order
 * derivative is 3t².
 */

const cos30 = 0.8660254;
const sin30 = 0.5;
const cx = 240;
const cy = 230;
const sXY = 50;
const sZ = 50;

function proj(x: number, y: number, z: number): { X: number; Y: number } {
	return {
		X: cx + (x - y) * cos30 * sXY,
		Y: cy + (x + y) * sin30 * sXY - z * sZ,
	};
}

const t = 3;
const dt = 0.5;

// cube corners: original at origin, extending t in x, y, z
type C = { x: number; y: number; z: number };
const cubeCorners: C[] = [
	{ x: 0, y: 0, z: 0 }, // 0
	{ x: t, y: 0, z: 0 }, // 1
	{ x: t, y: t, z: 0 }, // 2
	{ x: 0, y: t, z: 0 }, // 3
	{ x: 0, y: 0, z: t }, // 4
	{ x: t, y: 0, z: t }, // 5
	{ x: t, y: t, z: t }, // 6
	{ x: 0, y: t, z: t }, // 7
];

const edges: [number, number][] = [
	[0, 1], [1, 2], [2, 3], [3, 0],
	[4, 5], [5, 6], [6, 7], [7, 4],
	[0, 4], [1, 5], [2, 6], [3, 7],
];

// Three slabs of thickness dt on the three "outer" faces (the ones visible).
// x-slab: at x = t, slab of thickness dt extending in x, full y/z extent
// y-slab: at y = t, slab of thickness dt extending in y, full x/z extent
// z-slab: at z = t, slab of thickness dt extending in z, full x/y extent
function slabCorners(face: 'x' | 'y' | 'z'): C[] {
	if (face === 'x') {
		return [
			{ x: t, y: 0, z: 0 }, { x: t + dt, y: 0, z: 0 }, { x: t + dt, y: t, z: 0 }, { x: t, y: t, z: 0 },
			{ x: t, y: 0, z: t }, { x: t + dt, y: 0, z: t }, { x: t + dt, y: t, z: t }, { x: t, y: t, z: t },
		];
	} else if (face === 'y') {
		return [
			{ x: 0, y: t, z: 0 }, { x: t, y: t, z: 0 }, { x: t, y: t + dt, z: 0 }, { x: 0, y: t + dt, z: 0 },
			{ x: 0, y: t, z: t }, { x: t, y: t, z: t }, { x: t, y: t + dt, z: t }, { x: 0, y: t + dt, z: t },
		];
	} else {
		return [
			{ x: 0, y: 0, z: t }, { x: t, y: 0, z: t }, { x: t, y: t, z: t }, { x: 0, y: t, z: t },
			{ x: 0, y: 0, z: t + dt }, { x: t, y: 0, z: t + dt }, { x: t, y: t, z: t + dt }, { x: 0, y: t, z: t + dt },
		];
	}
}

function projAll(cs: C[]) {
	return cs.map((p) => proj(p.x, p.y, p.z));
}

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';

const slabX = projAll(slabCorners('x'));
const slabY = projAll(slabCorners('y'));
const slabZ = projAll(slabCorners('z'));

const projCube = cubeCorners.map((p) => proj(p.x, p.y, p.z));

function slabPath(s: { X: number; Y: number }[]): string {
	// front face: 0-1-2-3, top face: 4-5-6-7, plus visible edges
	return `M ${s[0].X} ${s[0].Y} L ${s[1].X} ${s[1].Y} L ${s[2].X} ${s[2].Y} L ${s[3].X} ${s[3].Y} Z M ${s[4].X} ${s[4].Y} L ${s[5].X} ${s[5].Y} L ${s[6].X} ${s[6].Y} L ${s[7].X} ${s[7].Y} Z`;
}
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ca-cubeslabs-title ca-cubeslabs-desc">
		<title id="ca-cubeslabs-title">A cube of side t grown by dt on three faces, with three slabs each of volume t squared times dt added</title>
		<desc id="ca-cubeslabs-desc">A 3D scene in axonometric projection. A cube of side t equals 3 is drawn with teal edges and a translucent teal interior, labeled with volume t cubed. Three thin slabs of thickness dt equals 0.5 are added to its three outer faces (the x-, y-, and z-facing sides), drawn in amber. Each slab has area t squared and thickness dt, giving volume t squared times dt. The total added volume is approximately 3 times t squared times dt, with smaller higher-order corner and edge pieces that shrink faster. The legend states that the derivative of t cubed is 3 t squared.</desc>

		{/* original cube edges */}
		{edges.map(([a, b]) => {
			const A = projCube[a];
			const B = projCube[b];
			return <line x1={A.X} y1={A.Y} x2={B.X} y2={B.Y} stroke={TEAL} stroke-width="1.4" opacity="0.85" />;
		})}

		{/* original cube fill (rough back-to-front: floor + back faces lightly) */}
		<path d={`M ${projCube[0].X} ${projCube[0].Y} L ${projCube[1].X} ${projCube[1].Y} L ${projCube[2].X} ${projCube[2].Y} L ${projCube[3].X} ${projCube[3].Y} Z`} fill={TEAL} fill-opacity="0.10" stroke="none" />

		{/* three slabs (amber translucent) */}
		<path d={slabPath(slabX)} fill={AMBER} fill-opacity="0.30" stroke={AMBER} stroke-width="1.2" />
		<path d={slabPath(slabY)} fill={AMBER} fill-opacity="0.30" stroke={AMBER} stroke-width="1.2" />
		<path d={slabPath(slabZ)} fill={AMBER} fill-opacity="0.35" stroke={AMBER} stroke-width="1.2" />

		{/* cube label */}
		<text x={proj(t / 2, t / 2, t / 2).X} y={proj(t / 2, t / 2, t / 2).Y + 6} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="18" font-weight="700" fill={TEAL}>t³</text>

		{/* slab labels (one near each slab center) */}
		<text x={proj(t + dt / 2, t / 2, t / 2).X + 8} y={proj(t + dt / 2, t / 2, t / 2).Y + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={AMBER}>t²·dt</text>
		<text x={proj(t / 2, t + dt / 2, t / 2).X - 8} y={proj(t / 2, t + dt / 2, t / 2).Y + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={AMBER}>t²·dt</text>
		<text x={proj(t / 2, t / 2, t + dt + 0.2).X} y={proj(t / 2, t / 2, t + dt + 0.2).Y} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={AMBER}>t²·dt</text>

		{/* legend */}
		<g transform="translate(450, 100)">
			<rect x="0" y="0" width="280" height="170" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="280" height="170" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="140" y="24" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">added volume when t grows by dt:</text>
			<text x="140" y="54" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" fill="currentColor">
				<tspan fill={AMBER} font-weight="700">3 · (t² · dt)</tspan> + (smaller)
			</text>
			<text x="140" y="82" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">three slabs + three edges + one corner</text>
			<text x="140" y="112" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.7">edges (t·dt²) and corner (dt³) vanish faster</text>
			<text x="140" y="138" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" font-weight="700" fill={ACCENT}>
				d(t³) / dt = 3t²
			</text>
			<text x="140" y="158" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.55">the power rule, one dimension up</text>
		</g>
	</svg>
	<figcaption>One dimension up: a cube of side t grows by dt on three faces, adding three thin slabs of area t² and thickness dt. To leading order, the added volume is 3 times t² times dt, so the derivative of t³ is 3t². The geometric pattern is identical to the square: n thin pieces of one less dimension, where n is the power.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

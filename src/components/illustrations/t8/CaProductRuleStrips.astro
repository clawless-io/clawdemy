---
/**
 * Track 8 (Visual Math: Calculus), Lesson 5, illustration 2 of 2.
 *
 * The product rule, geometric form. The rectangle of width f and height g
 * is grown by a small step dx: width gains f'·dx, height gains g'·dx.
 * Three new pieces appear: a top strip (f wide, g'·dx tall, area f·g'·dx),
 * a right strip (f'·dx wide, g tall, area f'·g·dx), and a tiny corner
 * block (f'·dx by g'·dx). As dx shrinks, the corner vanishes faster than
 * the strips, giving d(f·g)/dx = f·g' + f'·g.
 */

const cx = 110;
const cy = 290;
const SCALE = 50;

const f = 3;
const g = 2.4;
const df = 0.5; // f'·dx (visualized as a finite width)
const dg = 0.5; // g'·dx (visualized as a finite height)

const AMBER = '#d97706';
const ACCENT = '#7c3aed';
const PINK = '#be185d';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ca-prstrips-title ca-prstrips-desc">
		<title id="ca-prstrips-title">The product rule shown as a rectangle grown by f'·dx and g'·dx, producing two strips and a small corner</title>
		<desc id="ca-prstrips-desc">A rectangle of width f and height g is filled in accent purple and labeled f times g. A thin amber strip on top is f wide and g prime times dx tall, labeled f times (g prime dx). A thin amber strip on the right is f prime times dx wide and g tall, labeled (f prime dx) times g. A small pink corner block in the upper right is f prime times dx wide by g prime times dx tall, labeled corner f prime times g prime times dx squared. The legend on the right summarizes the added area as f g prime dx plus f prime g dx plus the higher-order corner that vanishes, giving the product rule d of f g over dx equals f g prime plus f prime g.</desc>

		{/* original rectangle f×g */}
		<rect x={cx} y={cy - g * SCALE} width={f * SCALE} height={g * SCALE} fill={ACCENT} fill-opacity="0.18" stroke={ACCENT} stroke-width="1.6" />
		<text x={cx + (f * SCALE) / 2} y={cy - (g * SCALE) / 2 + 6} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="20" font-weight="700" fill={ACCENT}>f · g</text>

		{/* top strip: f wide × dg tall (sits on top of the original) */}
		<rect x={cx} y={cy - (g + dg) * SCALE} width={f * SCALE} height={dg * SCALE} fill={AMBER} fill-opacity="0.4" stroke={AMBER} stroke-width="1.3" />
		<text x={cx + (f * SCALE) / 2} y={cy - (g + dg / 2) * SCALE + 4} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={AMBER}>f · (g'·dx)</text>

		{/* right strip: df wide × g tall (sits to the right of the original) */}
		<rect x={cx + f * SCALE} y={cy - g * SCALE} width={df * SCALE} height={g * SCALE} fill={AMBER} fill-opacity="0.4" stroke={AMBER} stroke-width="1.3" />
		<text x={cx + (f + df / 2) * SCALE} y={cy - (g * SCALE) / 2 + 4} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={AMBER} transform={`rotate(-90 ${cx + (f + df / 2) * SCALE} ${cy - (g * SCALE) / 2})`}>(f'·dx) · g</text>

		{/* corner: df × dg */}
		<rect x={cx + f * SCALE} y={cy - (g + dg) * SCALE} width={df * SCALE} height={dg * SCALE} fill={PINK} fill-opacity="0.5" stroke={PINK} stroke-width="1.3" />
		<text x={cx + (f + df) * SCALE + 28} y={cy - (g + dg / 2) * SCALE + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={PINK}>(f'·g')·dx²</text>
		<line x1={cx + (f + df / 2) * SCALE} y1={cy - (g + dg / 2) * SCALE} x2={cx + (f + df) * SCALE + 24} y2={cy - (g + dg / 2) * SCALE} stroke={PINK} stroke-width="1" opacity="0.65" />

		{/* dimension brackets along the bottom (f) and the bottom-right (df) */}
		<line x1={cx} y1={cy + 10} x2={cx + f * SCALE} y2={cy + 10} stroke="currentColor" stroke-width="0.9" opacity="0.6" />
		<text x={cx + (f * SCALE) / 2} y={cy + 26} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.7">f</text>
		<line x1={cx + f * SCALE} y1={cy + 10} x2={cx + (f + df) * SCALE} y2={cy + 10} stroke={AMBER} stroke-width="1.2" />
		<text x={cx + (f + df / 2) * SCALE} y={cy + 26} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={AMBER}>f'·dx</text>

		{/* dimension brackets along the left (g) and top (dg) */}
		<line x1={cx - 10} y1={cy} x2={cx - 10} y2={cy - g * SCALE} stroke="currentColor" stroke-width="0.9" opacity="0.6" />
		<text x={cx - 14} y={cy - (g * SCALE) / 2 + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.7">g</text>
		<line x1={cx - 10} y1={cy - g * SCALE} x2={cx - 10} y2={cy - (g + dg) * SCALE} stroke={AMBER} stroke-width="1.2" />
		<text x={cx - 14} y={cy - (g + dg / 2) * SCALE + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={AMBER}>g'·dx</text>

		{/* legend */}
		<g transform="translate(440, 90)">
			<rect x="0" y="0" width="280" height="180" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="280" height="180" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="140" y="24" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">added area when f and g grow:</text>
			<text x="140" y="50" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill={AMBER} font-weight="700">f·(g'·dx) + (f'·dx)·g + (f'·g')·dx²</text>
			<text x="140" y="78" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">two strips + corner</text>
			<text x="140" y="106" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill={PINK}>as dx → 0, corner vanishes</text>
			<text x="140" y="140" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" font-weight="700" fill={ACCENT}>
				d(f·g) / dx = f·g' + f'·g
			</text>
			<text x="140" y="164" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.55">the product rule, geometric form</text>
		</g>
	</svg>
	<figcaption>Grow the rectangle: width gains f'·dx, height gains g'·dx. Three new pieces appear: a top strip area f·(g'·dx), a right strip area (f'·dx)·g, and a small corner area (f'·g')·dx². The corner shrinks faster than the strips when dx shrinks, so the rate of growth is the sum of the strip areas alone: f·g' + f'·g.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 8 (Visual Math: Calculus), Lesson 12, concavity + inflection.
 *
 * What the second derivative tells you about a curve's SHAPE. We plot the
 * cubic y = x^3, sampled over x in [-2, 2], on a centered coordinate plane.
 *
 * For x < 0 the second derivative f''(x) = 6x is negative, so the curve is
 * concave DOWN (it bends downward, like the top of a hill). For x > 0 the
 * second derivative is positive, so the curve is concave UP (it bends
 * upward, like the bottom of a valley). At x = 0 the second derivative is
 * exactly zero and the curvature flips: that point is the inflection point.
 *
 * The concave-down half is tinted amber, the concave-up half teal, and the
 * inflection point at the origin is marked in accent purple. No cartoon
 * faces: just the curve arcs and analytical text labels.
 */

// graph origin (center of the panel) + axis scales
const cx = 360; // origin x (centered)
const cy = 185; // origin y
const SX = 70;  // pixels per x-unit
const SY = 17;  // pixels per y-unit (y ranges over [-8, 8])

const X_MIN = -2;
const X_MAX = 2;

const sx = (gx: number) => cx + gx * SX;
const sy = (gy: number) => cy - gy * SY;

const f = (x: number) => x * x * x; // y = x^3

// Sample the cubic into a path. Split into two arcs so each half can be
// styled with its own concavity color.
const N = 48;
const sampleArc = (xa: number, xb: number) => {
	const pts: string[] = [];
	for (let i = 0; i < N + 1; i++) {
		const x = xa + ((xb - xa) * i) / N;
		pts.push(`${sx(x).toFixed(2)} ${sy(f(x)).toFixed(2)}`);
	}
	return 'M ' + pts.join(' L ');
};

const arcDown = sampleArc(X_MIN, 0); // x < 0: concave down
const arcUp = sampleArc(0, X_MAX);   // x > 0: concave up

const TEAL = '#0d9488';   // concave up (f'' > 0)
const AMBER = '#d97706';  // concave down (f'' < 0)
const ACCENT = '#7c3aed'; // inflection point / marker
---

<figure class="cw-illus">
	<svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ca-conc-title ca-conc-desc">
		<title id="ca-conc-title">The cubic y = x cubed showing a concave-down half, a concave-up half, and the inflection point at the origin where curvature flips</title>
		<desc id="ca-conc-desc">A centered coordinate plane with horizontal x axis and vertical y axis. The S-shaped curve y equals x cubed is plotted from x equals negative two to x equals two. The left half, where x is negative, is drawn in amber: here the second derivative is negative and the curve is concave down, bending downward like the top of a hill. The right half, where x is positive, is drawn in teal: here the second derivative is positive and the curve is concave up, bending upward like the bottom of a valley. At the origin the two halves meet at the inflection point, marked with an accent purple dot, where the second derivative equals zero and the curvature flips from concave down to concave up.</desc>

		<defs>
			<marker id="ca-conc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
			</marker>
		</defs>

		{/* axes */}
		<line x1={sx(X_MIN) - 18} y1={cy} x2={sx(X_MAX) + 18} y2={cy} stroke="currentColor" stroke-width="1.1" opacity="0.5" marker-end="url(#ca-conc-arrow)" />
		<line x1={cx} y1={sy(8.6)} x2={cx} y2={sy(-8.6)} stroke="currentColor" stroke-width="1.1" opacity="0.5" />
		<line x1={cx} y1={sy(8.6)} x2={cx} y2={sy(8.6) - 0.01} stroke="currentColor" stroke-width="1.1" opacity="0.5" marker-end="url(#ca-conc-arrow)" />

		<text x={sx(X_MAX) + 20} y={cy + 16} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill="currentColor" opacity="0.7">x</text>
		<text x={cx + 8} y={sy(8.6) + 2} text-anchor="start" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill="currentColor" opacity="0.7">y = x³</text>

		{/* concave-down region tint (x < 0): faint amber band along the left arc */}
		<path d={`${arcDown} L ${sx(0).toFixed(2)} ${cy} L ${sx(X_MIN).toFixed(2)} ${cy} Z`} fill={AMBER} fill-opacity="0.10" stroke="none" />
		{/* concave-up region tint (x > 0): faint teal band along the right arc */}
		<path d={`${arcUp} L ${sx(X_MAX).toFixed(2)} ${cy} L ${sx(0).toFixed(2)} ${cy} Z`} fill={TEAL} fill-opacity="0.10" stroke="none" />

		{/* the curve, two halves colored by concavity */}
		<path d={arcDown} fill="none" stroke={AMBER} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
		<path d={arcUp} fill="none" stroke={TEAL} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

		{/* concave-down callout (top-left): bends downward, hill crest */}
		{(() => {
			// reference point on the left arc near x = -1.4
			const px = sx(-1.4);
			const py = sy(f(-1.4));
			return (
				<g>
					<line x1={px} y1={py} x2={px - 6} y2={py - 34} stroke={AMBER} stroke-width="1" opacity="0.6" />
					<rect x={px - 132} y={py - 76} width="168" height="42" rx="5" fill={AMBER} fill-opacity="0.10" stroke={AMBER} stroke-width="1.1" />
					<text x={px - 48} y={py - 58} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" font-weight="700" fill={AMBER}>concave down</text>
					<text x={px - 48} y={py - 42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={AMBER}>f'' &lt; 0  (bends down)</text>
				</g>
			);
		})()}

		{/* concave-up callout (bottom-right): bends upward, valley floor */}
		{(() => {
			const px = sx(1.4);
			const py = sy(f(1.4));
			return (
				<g>
					<line x1={px} y1={py} x2={px + 6} y2={py + 34} stroke={TEAL} stroke-width="1" opacity="0.6" />
					<rect x={px - 36} y={py + 34} width="168" height="42" rx="5" fill={TEAL} fill-opacity="0.10" stroke={TEAL} stroke-width="1.1" />
					<text x={px + 48} y={py + 52} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" font-weight="700" fill={TEAL}>concave up</text>
					<text x={px + 48} y={py + 68} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={TEAL}>f'' &gt; 0  (bends up)</text>
				</g>
			);
		})()}

		{/* inflection point at the origin */}
		<circle cx={cx} cy={cy} r="5.5" fill={ACCENT} stroke="#ffffff" stroke-width="1.4" />
		<line x1={cx} y1={cy} x2={cx + 64} y2={cy - 44} stroke={ACCENT} stroke-width="1.1" opacity="0.75" />
		<rect x={cx + 60} y={cy - 86} width="196" height="46" rx="5" fill={ACCENT} fill-opacity="0.08" stroke={ACCENT} stroke-width="1.2" />
		<text x={cx + 158} y={cy - 67} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" font-weight="700" fill={ACCENT}>inflection point</text>
		<text x={cx + 158} y={cy - 50} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={ACCENT}>f'' = 0, curvature flips</text>

		{/* legend strip: what the second derivative reads off */}
		<g transform="translate(40, 300)">
			<rect x="0" y="0" width="640" height="44" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="640" height="44" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.28" />
			<rect x="18" y="14" width="16" height="16" rx="3" fill={AMBER} fill-opacity="0.30" stroke={AMBER} stroke-width="1.2" />
			<text x="42" y="26" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor" opacity="0.85">f'' &lt; 0: concave down</text>
			<rect x="248" y="14" width="16" height="16" rx="3" fill={TEAL} fill-opacity="0.30" stroke={TEAL} stroke-width="1.2" />
			<text x="272" y="26" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor" opacity="0.85">f'' &gt; 0: concave up</text>
			<circle cx="492" cy="22" r="5" fill={ACCENT} stroke="#ffffff" stroke-width="1.2" />
			<text x="504" y="26" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor" opacity="0.85">f'' = 0: inflection</text>
		</g>
	</svg>
	<figcaption>The second derivative reads off a curve's shape. Where it is negative, the curve is concave down, bending like the top of a hill; where it is positive, the curve is concave up, bending like the bottom of a valley. For y = x³ the second derivative is 6x: negative for x &lt; 0, positive for x &gt; 0, and exactly zero at the origin. That crossing is the inflection point, where the curvature flips from one to the other.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

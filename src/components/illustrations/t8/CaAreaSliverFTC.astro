---
/**
 * Track 8 (Visual Math: Calculus), Lesson 11, illustration.
 *
 * Why area equals slope: the Fundamental Theorem of Calculus, made visual.
 *
 * A smooth curve y = f(x) is plotted on axes. The region under the curve
 * from a fixed left endpoint a to a variable point x is shaded amber; that
 * accumulated area IS the area function A(x). At the right edge, at x, a
 * thin vertical sliver of width dx and height f(x) is drawn in highlighted
 * purple. Growing x by one tiny step dx adds exactly that sliver of area,
 * approximately f(x) times dx. So the rate at which the area function grows
 * is A'(x) = f(x): the slope of the accumulated area equals the height of
 * the curve. That is the Fundamental Theorem, read off a single picture.
 */

const cx = 90;  // origin x (graph origin, pixels)
const cy = 300; // origin y (graph origin, pixels)
const SX = 62;  // scale: 1 unit on the x-axis is 62 px
const SY = 70;  // scale: 1 unit on the y-axis is 70 px

// math-to-pixel helpers
const sx = (gx: number) => cx + gx * SX;
const sy = (gy: number) => cy - gy * SY;

// the curve: a smooth, positive, gently undulating f(x)
const f = (gx: number) => 1.15 + 0.85 * Math.sin(0.52 * gx) + 0.05 * gx;

const X_MIN = 0;   // left edge of the plotted domain
const X_MAX = 9;   // right edge of the plotted domain
const A = 1.4;     // fixed left endpoint of the accumulated area
const X = 6.0;     // variable right endpoint (the moving point x)
const DX = 0.55;   // sliver width, exaggerated for visibility

const N_SAMPLES = 96; // curve sampling resolution

// sample the curve across the full plotted domain
const curvePts: { x: number; y: number }[] = [];
for (let i = 0; i < N_SAMPLES + 1; i++) {
	const gx = X_MIN + (i / N_SAMPLES) * (X_MAX - X_MIN);
	curvePts.push({ x: gx, y: f(gx) });
}
const curvePath = curvePts
	.map((p, i) => `${i === 0 ? 'M' : 'L'} ${sx(p.x).toFixed(2)} ${sy(p.y).toFixed(2)}`)
	.join(' ');

// the shaded area under the curve from a to x: trace the x-axis from a to x,
// rise to the curve, follow the curve back, and close
const areaPts: { x: number; y: number }[] = [];
for (let i = 0; i < N_SAMPLES + 1; i++) {
	const gx = A + (i / N_SAMPLES) * (X - A);
	areaPts.push({ x: gx, y: f(gx) });
}
const areaPath =
	`M ${sx(A).toFixed(2)} ${sy(0).toFixed(2)} ` +
	areaPts.map((p) => `L ${sx(p.x).toFixed(2)} ${sy(p.y).toFixed(2)}`).join(' ') +
	` L ${sx(X).toFixed(2)} ${sy(0).toFixed(2)} Z`;

// the sliver: a thin standing rectangle at x, width dx, height f(x)
const sliverX = sx(X);
const sliverTop = sy(f(X));
const sliverW = DX * SX;
const sliverH = f(X) * SY;

// axis ticks
const xTicks = [2, 4, 6, 8];
const yTicks = [1, 2];

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
const SKY = '#0284c7';
---

<figure class="cw-illus">
	<svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="ca-ftc-title ca-ftc-desc">
		<title id="ca-ftc-title">The area under a curve from a to x is the area function A(x); a thin sliver of width dx at x adds area f(x) times dx, so A prime of x equals f(x)</title>
		<desc id="ca-ftc-desc">A coordinate graph. A smooth positive curve y equals f of x is plotted in teal across the horizontal axis. The region under the curve, between a fixed left endpoint labeled a and a variable point labeled x, is shaded in soft amber; this accumulated area is the area function A of x. At the right edge of the shaded region, exactly at x, a thin tall rectangle is drawn in highlighted purple: its width is the small step d x and its height reaches the curve at f of x. The sliver represents the new area A of x plus d x minus A of x, which is approximately f of x times d x. Reading the picture: growing x by one tiny step adds a sliver of area f of x times d x, so the rate of change of the area function is A prime of x equals f of x.</desc>

		<defs>
			<marker id="ca-ftc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
			</marker>
			<marker id="ca-ftc-arrow-dx" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		{/* axes */}
		<line x1={cx} y1={cy} x2={sx(X_MAX) + 24} y2={cy} stroke="currentColor" stroke-width="1.2" opacity="0.55" marker-end="url(#ca-ftc-arrow)" />
		<line x1={cx} y1={cy} x2={cx} y2={sy(3.0) - 12} stroke="currentColor" stroke-width="1.2" opacity="0.55" marker-end="url(#ca-ftc-arrow)" />

		{/* axis tick labels */}
		{xTicks.map((t) => (
			<g>
				<line x1={sx(t)} y1={cy} x2={sx(t)} y2={cy + 5} stroke="currentColor" stroke-width="0.8" opacity="0.5" />
				<text x={sx(t)} y={cy + 18} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.55">{t}</text>
			</g>
		))}
		{yTicks.map((t) => (
			<g>
				<line x1={cx - 5} y1={sy(t)} x2={cx} y2={sy(t)} stroke="currentColor" stroke-width="0.8" opacity="0.5" />
				<text x={cx - 8} y={sy(t) + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.55">{t}</text>
			</g>
		))}

		<text x={sx(X_MAX) + 24} y={cy + 22} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill="currentColor" opacity="0.7">x</text>
		<text x={cx - 8} y={sy(3.0) - 16} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={TEAL}>y = f(x)</text>

		{/* shaded accumulated area A(x), from a to x */}
		<path d={areaPath} fill={AMBER} fill-opacity="0.16" stroke={AMBER} stroke-width="0.8" stroke-opacity="0.45" />

		{/* the highlighted sliver at x: width dx, height f(x) */}
		<rect x={sliverX} y={sliverTop} width={sliverW} height={sliverH} fill={ACCENT} fill-opacity="0.40" stroke={ACCENT} stroke-width="1.3" />

		{/* the curve, on top of the fills */}
		<path d={curvePath} fill="none" stroke={TEAL} stroke-width="2.6" />

		{/* vertical boundary lines at a and at x (left edge of sliver) */}
		<line x1={sx(A)} y1={cy} x2={sx(A)} y2={sy(f(A))} stroke={AMBER} stroke-width="1.1" stroke-dasharray="3 3" opacity="0.75" />
		<line x1={sx(X)} y1={cy} x2={sx(X)} y2={sliverTop} stroke={ACCENT} stroke-width="1.1" opacity="0.7" />

		{/* endpoint labels a and x on the axis */}
		<text x={sx(A)} y={cy + 18} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={AMBER}>a</text>
		<text x={sx(X)} y={cy + 18} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>x</text>

		{/* A(x) label inside the shaded region */}
		<text x={sx((A + X) / 2 - 0.35)} y={sy(0.55)} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="15" font-weight="700" fill={AMBER}>A(x)</text>
		<text x={sx((A + X) / 2 - 0.35)} y={sy(0.55) + 16} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.6">accumulated area</text>

		{/* dx width bracket below the sliver */}
		<line x1={sliverX} y1={cy + 30} x2={sliverX + sliverW} y2={cy + 30} stroke={ACCENT} stroke-width="1.2" />
		<line x1={sliverX} y1={cy + 26} x2={sliverX} y2={cy + 34} stroke={ACCENT} stroke-width="1.2" />
		<line x1={sliverX + sliverW} y1={cy + 26} x2={sliverX + sliverW} y2={cy + 34} stroke={ACCENT} stroke-width="1.2" />
		<text x={sliverX + sliverW / 2} y={cy + 46} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>dx</text>

		{/* f(x) height label, with a tick line from the curve to the y-direction */}
		<line x1={sliverX + sliverW} y1={sliverTop} x2={sliverX + sliverW + 26} y2={sliverTop} stroke={SKY} stroke-width="1.1" opacity="0.8" />
		<text x={sliverX + sliverW + 30} y={sliverTop + 4} text-anchor="start" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={SKY}>f(x)</text>

		{/* sliver-area callout */}
		{(() => {
			const calloutX = sliverX + sliverW + 20;
			const calloutY = sliverTop - 80;
			return (
				<g>
					<line x1={sliverX + sliverW / 2} y1={sliverTop} x2={calloutX + 12} y2={calloutY + 56} stroke={ACCENT} stroke-width="1" opacity="0.6" />
					<rect x={calloutX} y={calloutY} width="186" height="52" rx="5" fill={ACCENT} fill-opacity="0.07" stroke={ACCENT} stroke-width="1.1" />
					<text x={calloutX + 93} y={calloutY + 20} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">the new sliver of area:</text>
					<text x={calloutX + 93} y={calloutY + 40} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={ACCENT}>A(x+dx) - A(x) ≈ f(x)·dx</text>
				</g>
			);
		})()}

		{/* the punchline: A'(x) = f(x) */}
		<g transform={`translate(${sx(0.15)}, 24)`}>
			<rect x="0" y="0" width="250" height="46" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="250" height="46" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="125" y="19" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">rate of change of the area function:</text>
			<text x="125" y="38" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" font-weight="700" fill={ACCENT}>A'(x) = <tspan fill={SKY}>f(x)</tspan></text>
		</g>
	</svg>
	<figcaption>The shaded region is the area function A(x): the area swept out under the curve from the fixed point a up to the moving point x. Nudge x forward by a tiny step dx and you add one thin sliver, of width dx and height f(x), so the new area is approximately f(x) times dx. The area grows at exactly the rate f(x). That is the Fundamental Theorem: A'(x) = f(x), the slope of the accumulated area equals the height of the curve.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

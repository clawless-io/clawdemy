---
/**
 * Track 9 (Statistics & Probability for AI), Lesson 13, illustration 1 of 1.
 *
 * The p-value as a tail area on the null distribution. The null is a
 * standard normal. An observed test statistic of z = 2.6 is marked with
 * a vertical line, and the right tail beyond it (the area more extreme
 * than what was observed, under the null) is shaded as the p-value.
 * For z = 2.6, p one-sided ≈ 0.005, well under any standard threshold.
 */

const cx = 80;
const cy = 270;
const PLOT_W = 580;
const PLOT_H = 200;

const Z_MIN = -4;
const Z_MAX = 4;
const SAMPLES = 200;

function phi(z: number): number {
	return Math.exp(-0.5 * z * z) / Math.sqrt(2 * Math.PI);
}
const PEAK = phi(0);
const sx = (z: number) => cx + ((z - Z_MIN) / (Z_MAX - Z_MIN)) * PLOT_W;
const sy = (d: number) => cy - (d / PEAK) * PLOT_H;

const OBS_Z = 2.6;

// curve as polyline
const curvePath: string[] = [];
for (let i = 0; i < SAMPLES + 1; i++) {
	const z = Z_MIN + ((Z_MAX - Z_MIN) * i) / SAMPLES;
	curvePath.push(`${i === 0 ? 'M' : 'L'} ${sx(z).toFixed(1)} ${sy(phi(z)).toFixed(1)}`);
}

// closed tail shading region (z = OBS_Z to Z_MAX)
const N_TAIL = 60;
const tailPts: { X: number; Y: number }[] = [];
for (let i = 0; i < N_TAIL + 1; i++) {
	const z = OBS_Z + ((Z_MAX - OBS_Z) * i) / N_TAIL;
	tailPts.push({ X: sx(z), Y: sy(phi(z)) });
}
let tailPath = `M ${sx(OBS_Z).toFixed(1)} ${cy.toFixed(1)} `;
for (const p of tailPts) tailPath += `L ${p.X.toFixed(1)} ${p.Y.toFixed(1)} `;
tailPath += `L ${sx(Z_MAX).toFixed(1)} ${cy.toFixed(1)} Z`;

// Approximate one-sided p-value for z = 2.6 (canonical: 0.00466)
const P_VALUE = 0.005;

const ACCENT = '#7c3aed';
const BLUE = '#3b82f6';
const AMBER = '#d97706';

void BLUE;
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="sp-pval-title sp-pval-desc">
		<title id="sp-pval-title">The p-value as the right-tail area of the null distribution beyond an observed test statistic of z equals 2.6</title>
		<desc id="sp-pval-desc">A standard normal bell curve centered at zero with z on the horizontal axis from negative 4 to positive 4. A vertical accent purple line marks the observed test statistic at z equals 2.6, sitting well in the right tail. The region under the curve from z equals 2.6 to z equals 4 is shaded in amber. This shaded tail area is the one-sided p-value, the probability under the null of seeing a test statistic this extreme or more. The legend states the approximate value 0.005, meaning the observed result would be very rare if the null were true.</desc>

		{/* axes */}
		<line x1={cx} y1={cy} x2={cx + PLOT_W + 10} y2={cy} stroke="currentColor" stroke-width="1" opacity="0.55" />

		{/* curve fill (entire bell) */}
		<path d={`${curvePath.join(' ')} L ${sx(Z_MAX).toFixed(1)} ${cy.toFixed(1)} L ${sx(Z_MIN).toFixed(1)} ${cy.toFixed(1)} Z`} fill="currentColor" fill-opacity="0.04" stroke="none" />

		{/* tail shaded amber (the p-value area) */}
		<path d={tailPath} fill={AMBER} fill-opacity="0.55" stroke={AMBER} stroke-width="1" />

		{/* the curve itself */}
		<path d={curvePath.join(' ')} fill="none" stroke={ACCENT} stroke-width="2" />

		{/* observed z line */}
		<line x1={sx(OBS_Z)} y1={cy} x2={sx(OBS_Z)} y2={cy - PLOT_H - 4} stroke={ACCENT} stroke-width="2" stroke-dasharray="6 4" />
		<text x={sx(OBS_Z)} y={cy - PLOT_H - 12} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>z = {OBS_Z}</text>

		{/* axis ticks */}
		{[-3, -2, -1, 0, 1, 2, 3].map((z) => (
			<g>
				<line x1={sx(z)} y1={cy} x2={sx(z)} y2={cy + 5} stroke="currentColor" stroke-width="0.7" opacity="0.5" />
				<text x={sx(z)} y={cy + 18} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.65">{z}</text>
			</g>
		))}

		{/* p-value annotation */}
		<line x1={sx(OBS_Z + 0.4)} y1={cy - 16} x2={sx(OBS_Z) + 60} y2={cy - 70} stroke={AMBER} stroke-width="1" opacity="0.55" />
		<text x={sx(OBS_Z) + 78} y={cy - 70} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={AMBER}>p ≈ {P_VALUE}</text>
		<text x={sx(OBS_Z) + 78} y={cy - 54} font-family="ui-sans-serif, system-ui, sans-serif" font-size="9" fill="currentColor" opacity="0.65">tail area beyond z</text>

		{/* legend */}
		<g transform="translate(50, 50)">
			<rect x="0" y="0" width="300" height="120" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="300" height="120" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="150" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.7">p-value:</text>
			<text x="150" y="46" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor">
				P(Z ≥ z<tspan baseline-shift="sub" font-size="9">obs</tspan> | H<tspan baseline-shift="sub" font-size="9">0</tspan>)
			</text>
			<text x="150" y="70" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.7">
				= shaded right-tail area
			</text>
			<text x="150" y="94" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>
				z = 2.6 → p ≈ {P_VALUE}
			</text>
			<text x="150" y="110" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="9" fill="currentColor" opacity="0.6">
				well below the 0.05 threshold
			</text>
		</g>
	</svg>
	<figcaption>The p-value is the area in the tail of the null distribution beyond the observed test statistic. With z = 2.6, the shaded right tail covers about 0.5 percent of the area under the null. That is the probability of seeing a result this extreme or more if the null hypothesis were true; a small number suggests the data are unlikely under the null.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

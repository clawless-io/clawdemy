---
/**
 * Track 9 (Statistics & Probability for AI), Lesson 4, illustration 2 of 2.
 *
 * The blind spot of the correlation coefficient. A clean U-shape (y = x²
 * plus a touch of noise) is a strong nonlinear relationship: y is
 * completely determined by x's distance from zero. But Pearson r, which
 * measures only straight-line co-movement, comes out near zero because
 * the two halves cancel. The picture is the warning: r = 0 does NOT
 * mean "no relationship", only "no linear relationship".
 */

const cx = 200;
const cy = 200;
const W = 320;
const H = 240;

const N = 36;
const X_MIN = -2;
const X_MAX = 2;

function makeRand(seed: number) {
	let s = seed;
	return () => {
		s = (s * 9301 + 49297) % 233280;
		return s / 233280;
	};
}

const rand = makeRand(13);

type Pt = { x: number; y: number };
const pts: Pt[] = [];
for (let i = 0; i < N; i++) {
	const x = X_MIN + ((X_MAX - X_MIN) * (i + rand() * 0.4 - 0.2)) / N;
	const noise = (rand() - 0.5) * 0.4;
	const y = x * x + noise;
	pts.push({ x, y });
}

// project to svg
const xs = pts.map((p) => p.x);
const ys = pts.map((p) => p.y);
const minX = Math.min(...xs);
const maxX = Math.max(...xs);
const minY = Math.min(...ys);
const maxY = Math.max(...ys);

const sx = (v: number) => cx + ((v - minX) / (maxX - minX)) * (W - 40) + 20;
const sy = (v: number) => cy + H - 20 - ((v - minY) / (maxY - minY)) * (H - 40);

// empirical r
const meanX = xs.reduce((a, b) => a + b, 0) / xs.length;
const meanY = ys.reduce((a, b) => a + b, 0) / ys.length;
let num = 0;
let denX = 0;
let denY = 0;
for (let i = 0; i < xs.length; i++) {
	const dx = xs[i] - meanX;
	const dy = ys[i] - meanY;
	num += dx * dy;
	denX += dx * dx;
	denY += dy * dy;
}
const r = num / Math.sqrt(denX * denY);

const BLUE = '#3b82f6';
const ACCENT = '#7c3aed';
const AMBER = '#d97706';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="sp-nlzero-title sp-nlzero-desc">
		<title id="sp-nlzero-title">A clean U-shape scatterplot with linear correlation coefficient near zero, showing r sees only straight-line relationships</title>
		<desc id="sp-nlzero-desc">A scatterplot inside a framed panel on the left. About 36 blue points trace a clear U-shape: y values are highest at the left and right edges and lowest in the middle, a parabola-like pattern with light noise around it. The empirical Pearson correlation coefficient, computed and shown beneath, is near zero. The legend on the right notes that y is fully determined by x (the relationship is perfectly nonlinear), yet r reports almost no relationship because r only sees straight-line co-movement.</desc>

		{/* panel frame */}
		<rect x={cx} y={cy - 4} width={W} height={H + 8} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={cx + W / 2} y={cy + 14} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>strong U-shape, r ≈ 0</text>

		{/* axes */}
		<line x1={cx + 20} y1={cy + H - 20} x2={cx + W - 20} y2={cy + H - 20} stroke="currentColor" stroke-width="0.7" opacity="0.45" />
		<line x1={cx + 20} y1={cy + 30} x2={cx + 20} y2={cy + H - 20} stroke="currentColor" stroke-width="0.7" opacity="0.45" />

		<text x={cx + W - 18} y={cy + H - 8} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">x</text>
		<text x={cx + 12} y={cy + 40} font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">y</text>

		{/* points */}
		{pts.map((p) => <circle cx={sx(p.x)} cy={sy(p.y)} r="2.8" fill={BLUE} fill-opacity="0.85" />)}

		{/* empirical r note */}
		<text x={cx + W / 2} y={cy + H + 24} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.7">empirical r = {r.toFixed(2)}</text>

		{/* legend */}
		<g transform="translate(550, 80)">
			<rect x="0" y="0" width="170" height="200" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="170" height="200" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="85" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.7">what r sees:</text>
			<text x="85" y="46" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor">only straight</text>
			<text x="85" y="62" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor">line co-movement</text>
			<line x1="14" y1="80" x2="156" y2="80" stroke="currentColor" stroke-width="0.6" opacity="0.3" />
			<text x="85" y="102" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">a perfect U-shape</text>
			<text x="85" y="118" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">means y is determined</text>
			<text x="85" y="134" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">by x...</text>
			<text x="85" y="158" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={AMBER}>...but r ≈ 0</text>
			<text x="85" y="180" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="9" fill="currentColor" opacity="0.6">r=0 ≠ "no relationship"</text>
		</g>
	</svg>
	<figcaption>A clear U-shape: as x moves away from zero in either direction, y rises. The relationship between x and y is strong, just not straight. Pearson's r, which only measures straight-line co-movement, comes out near zero. A correlation of zero is not the same as "no relationship"; it only means "no linear relationship".</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

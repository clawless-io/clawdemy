---
/**
 * Track 9 (Statistics & Probability for AI), Lesson 8, illustration 1 of 1.
 *
 * The expected value as a balance point. A discrete random variable
 * takes values 1 through 5 with probabilities 0.10, 0.20, 0.30, 0.25,
 * 0.15. Expected value E[X] = sum of x · P(X = x) = 3.15. Draw the
 * probability bars on an axis and place a fulcrum (triangular wedge)
 * beneath the value 3.15: the distribution balances there.
 */

const cx = 100;
const cy = 250;
const PLOT_W = 540;
const PLOT_H = 170;

type Bar = { x: number; p: number };
const bars: Bar[] = [
	{ x: 1, p: 0.1 },
	{ x: 2, p: 0.2 },
	{ x: 3, p: 0.3 },
	{ x: 4, p: 0.25 },
	{ x: 5, p: 0.15 },
];

const expectedValue = bars.reduce((sum, b) => sum + b.x * b.p, 0);
const X_MIN = 0;
const X_MAX = 6;
const P_MAX = 0.35;

const sx = (xVal: number) => cx + ((xVal - X_MIN) / (X_MAX - X_MIN)) * PLOT_W;
const sy = (pVal: number) => cy - (pVal / P_MAX) * PLOT_H;

const barWidth = ((PLOT_W / (X_MAX - X_MIN)) * 0.5);

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
const BLUE = '#3b82f6';

void TEAL;
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="sp-evbars-title sp-evbars-desc">
		<title id="sp-evbars-title">A probability distribution bar chart with the expected value marked as the balance point</title>
		<desc id="sp-evbars-desc">A bar chart on a horizontal value axis from 0 to 6 and a vertical probability axis from 0 to 0.35. Five blue bars at values 1, 2, 3, 4, 5 have heights 0.10, 0.20, 0.30, 0.25, 0.15 respectively. A triangular amber fulcrum wedge is drawn beneath the axis at the value 3.15, with a vertical accent purple dashed line rising from it through the bars. The label E of X equals 3.15 sits above the fulcrum. The distribution balances on the wedge: the heavy left bars and the lighter but further-right bars together teeter at 3.15.</desc>

		{/* axis */}
		<line x1={cx} y1={cy} x2={cx + PLOT_W + 10} y2={cy} stroke="currentColor" stroke-width="1.1" opacity="0.55" />
		<line x1={cx} y1={cy} x2={cx} y2={cy - PLOT_H - 10} stroke="currentColor" stroke-width="1.1" opacity="0.55" />

		<text x={cx + PLOT_W + 14} y={cy + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.65">x</text>
		<text x={cx - 6} y={cy - PLOT_H - 12} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.65">probability</text>

		{/* x-axis tick labels */}
		{[1, 2, 3, 4, 5].map((t) => (
			<g>
				<line x1={sx(t)} y1={cy} x2={sx(t)} y2={cy + 5} stroke="currentColor" stroke-width="0.7" opacity="0.5" />
				<text x={sx(t)} y={cy + 18} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.65">{t}</text>
			</g>
		))}

		{/* y-axis tick labels */}
		{[0.1, 0.2, 0.3].map((t) => (
			<g>
				<line x1={cx - 5} y1={sy(t)} x2={cx} y2={sy(t)} stroke="currentColor" stroke-width="0.7" opacity="0.5" />
				<text x={cx - 8} y={sy(t) + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">{t.toFixed(1)}</text>
			</g>
		))}

		{/* bars */}
		{bars.map((b) => (
			<g>
				<rect x={sx(b.x) - barWidth / 2} y={sy(b.p)} width={barWidth} height={cy - sy(b.p)} fill={BLUE} fill-opacity="0.6" stroke={BLUE} stroke-width="1" />
				<text x={sx(b.x)} y={sy(b.p) - 6} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={BLUE} font-weight="700">{b.p.toFixed(2)}</text>
			</g>
		))}

		{/* expected value line (purple dashed, rising through bars) */}
		<line x1={sx(expectedValue)} y1={cy} x2={sx(expectedValue)} y2={cy - PLOT_H - 4} stroke={ACCENT} stroke-width="2" stroke-dasharray="6 4" />

		{/* E[X] label above */}
		<text x={sx(expectedValue)} y={cy - PLOT_H - 12} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>E[X] = {expectedValue.toFixed(2)}</text>

		{/* fulcrum (amber triangular wedge) below the axis at E[X] */}
		<path d={`M ${sx(expectedValue) - 16} ${cy + 30} L ${sx(expectedValue) + 16} ${cy + 30} L ${sx(expectedValue)} ${cy + 6} Z`} fill={AMBER} fill-opacity="0.7" stroke={AMBER} stroke-width="1.4" />
		<text x={sx(expectedValue)} y={cy + 46} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill={AMBER} font-weight="700">balance</text>

		{/* legend */}
		<g transform="translate(440, 50)">
			<rect x="0" y="0" width="280" height="100" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="280" height="100" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="140" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">expected value computation:</text>
			<text x="140" y="50" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor">
				E[X] = Σ x · P(X = x)
			</text>
			<text x="140" y="74" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.8">
				= 1·0.1 + 2·0.2 + 3·0.3 + 4·0.25 + 5·0.15
			</text>
			<text x="140" y="92" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>
				= 3.15
			</text>
		</g>
	</svg>
	<figcaption>The expected value of a random variable is the balance point of its probability distribution. Picture the bars as weights and the value axis as a seesaw: the position that holds it level is E[X], the weighted average of values where each weight is its probability. Here the distribution balances at 3.15.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 9 (Statistics & Probability for AI), Lesson 6, illustration 1 of 1.
 *
 * Two-way table of 1,000 people. Rows = condition (present / absent),
 * columns = test result (positive / negative). Highlights the asymmetry
 * between two conditional probabilities derived from the same table:
 * P(test+ | condition+) = 80/100 = 0.80 (the row-conditional), and
 * P(condition+ | test+) = 80/170 = 0.47 (the column-conditional).
 */

const CELL_W = 110;
const CELL_H = 56;
const TABLE_X = 90;
const TABLE_Y = 60;
const HEADER_OFF = CELL_H;

// 4 data cells + row totals + column totals
// Layout:
//             | test+ | test- | row total
// condition+  | 80    | 20    | 100
// condition-  | 90    | 810   | 900
// col total   | 170   | 830   | 1000

const data: { rowLabel: string; values: [number, number, number] }[] = [
	{ rowLabel: 'condition +', values: [80, 20, 100] },
	{ rowLabel: 'condition -', values: [90, 810, 900] },
	{ rowLabel: 'column total', values: [170, 830, 1000] },
];
const colLabels = ['test +', 'test -', 'row total'];

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';

// Highlighting:
// First conditional probability P(test+ | condition+): row 0, columns 0 (numerator 80) and 2 (denominator 100). Row 0 colored teal.
// Second conditional probability P(condition+ | test+): column 0, rows 0 (numerator 80) and 2 (denominator 170). Column 0 colored amber.
// The intersection cell (row 0, col 0) carries both highlights; we render it as a half-and-half split.

function cellX(col: number) {
	return TABLE_X + col * CELL_W;
}
function cellY(row: number) {
	return TABLE_Y + HEADER_OFF + row * CELL_H;
}
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="sp-ctable-title sp-ctable-desc">
		<title id="sp-ctable-title">A two-way table of 1,000 people showing P(test positive given condition) equals 0.80 differs from P(condition given test positive) equals 0.47</title>
		<desc id="sp-ctable-desc">A two-way contingency table with rows for condition present and condition absent and columns for test positive and test negative, plus row and column totals. Out of 1,000 people, 100 have the condition (80 test positive, 20 test negative) and 900 do not (90 test positive, 810 test negative). The row "condition positive" is highlighted in teal to show the row-conditional P(test positive given condition) equals 80 over 100 equals 0.80. The column "test positive" is highlighted in amber to show the column-conditional P(condition given test positive) equals 80 over 170 equals 0.47. The two conditionals are different despite sharing the cell value 80.</desc>

		{/* row 0 highlight band (teal) */}
		<rect x={cellX(0)} y={cellY(0)} width={3 * CELL_W} height={CELL_H} fill={TEAL} fill-opacity="0.16" />
		{/* col 0 highlight band (amber), drawn second so its mix shows */}
		<rect x={cellX(0)} y={cellY(0)} width={CELL_W} height={3 * CELL_H} fill={AMBER} fill-opacity="0.16" />

		{/* column headers */}
		{colLabels.map((label, c) => (
			<g>
				<rect x={cellX(c)} y={TABLE_Y} width={CELL_W} height={HEADER_OFF} fill="currentColor" fill-opacity="0.04" stroke="currentColor" stroke-width="0.8" opacity="0.5" />
				<text x={cellX(c) + CELL_W / 2} y={TABLE_Y + HEADER_OFF / 2 + 5} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={c === 0 ? AMBER : 'currentColor'} opacity={c === 0 ? 1 : 0.7}>{label}</text>
			</g>
		))}

		{/* row label column (placed to the left of the table) */}
		{data.map((d, r) => (
			<g>
				<rect x={cellX(0) - CELL_W} y={cellY(r)} width={CELL_W} height={CELL_H} fill="currentColor" fill-opacity="0.04" stroke="currentColor" stroke-width="0.8" opacity="0.5" />
				<text x={cellX(0) - CELL_W / 2} y={cellY(r) + CELL_H / 2 + 5} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={r === 0 ? TEAL : 'currentColor'} opacity={r === 0 ? 1 : 0.7}>{d.rowLabel}</text>
			</g>
		))}

		{/* data cells */}
		{data.map((d, r) =>
			d.values.map((v, c) => (
				<g>
					<rect x={cellX(c)} y={cellY(r)} width={CELL_W} height={CELL_H} fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.55" />
					<text x={cellX(c) + CELL_W / 2} y={cellY(r) + CELL_H / 2 + 8} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="18" font-weight="700" fill={r === 0 && c === 0 ? ACCENT : 'currentColor'}>{v.toLocaleString()}</text>
				</g>
			))
		)}

		{/* legend */}
		<g transform="translate(20, 270)">
			<rect x="0" y="0" width="700" height="80" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="700" height="80" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />

			<rect x="14" y="14" width="20" height="20" fill={TEAL} fill-opacity="0.4" />
			<text x="40" y="28" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={TEAL} font-weight="700">P(test+ | condition+) = 80 / 100 = 0.80</text>

			<rect x="360" y="14" width="20" height="20" fill={AMBER} fill-opacity="0.4" />
			<text x="386" y="28" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={AMBER} font-weight="700">P(condition+ | test+) = 80 / 170 = 0.47</text>

			<text x="350" y="62" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>
				same 80, different denominators → very different probabilities
			</text>
		</g>
	</svg>
	<figcaption>Two conditional probabilities live in the same table, share the same numerator (80 people who have the condition AND test positive), but use different denominators. P(test positive given the condition) divides by the 100 condition-positive people: 0.80. P(condition given a positive test) divides by the 170 test-positive people: 0.47. The "given" word picks which row or column you stay inside.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 9 (Statistics & Probability for AI), Lesson 2, illustration 1 of 1.
 *
 * Mean is dragged, median is robust. Nine salaries cluster at $50,000 and
 * one outlier sits at $2,000,000. The mean = (9·50,000 + 2,000,000)/10 =
 * $245,000, pulled far right by the lone outlier. The median, the middle
 * value when sorted, is $50,000, sitting calmly at the cluster. The
 * picture shows both vertical markers on a histogram of the data.
 */

const cx = 60;
const cy = 280;
const PLOT_W = 580;
const PLOT_H = 200;

const X_MIN_K = 0;
const X_MAX_K = 2200; // salaries in thousands of dollars
const Y_MAX = 10;

const sx = (kVal: number) => cx + ((kVal - X_MIN_K) / (X_MAX_K - X_MIN_K)) * PLOT_W;
const sy = (count: number) => cy - (count / Y_MAX) * PLOT_H;

// Histogram bins: 100k wide
const BIN_W = 100;
const bins: { k: number; count: number }[] = [];
for (let k = X_MIN_K; k < X_MAX_K; k += BIN_W) {
	bins.push({ k, count: 0 });
}
// 9 salaries at 50k → bin 0 (0..100)
bins[0].count = 9;
// 1 salary at 2M → bin 19 (1900..2000)
bins[19].count = 1;

const meanK = (9 * 50 + 2000) / 10; // 245
const medianK = 50;

const xTicks = [0, 500, 1000, 1500, 2000];
const yTicks = [2, 4, 6, 8];

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
const BLUE = '#3b82f6';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="sp-skewmm-title sp-skewmm-desc">
		<title id="sp-skewmm-title">A skewed salary distribution where the mean is dragged far right by a single outlier while the median stays at the cluster</title>
		<desc id="sp-skewmm-desc">A histogram with salary in thousands of dollars on the horizontal axis from 0 to 2200 and count on the vertical axis up to 10. A tall blue bar of height 9 sits at the leftmost bin (0 to 100 thousand) representing 9 salaries clustered at 50 thousand. A short blue bar of height 1 sits at the far right (1900 to 2000 thousand) for the one 2 million dollar outlier. A vertical amber dashed line at 50 thousand is labeled "median". A vertical accent purple dashed line at 245 thousand is labeled "mean", visibly pulled rightward by the outlier. A legend on the right gives the values and notes that the median is robust to the outlier while the mean is dragged.</desc>

		{/* axes */}
		<line x1={cx} y1={cy} x2={cx + PLOT_W + 10} y2={cy} stroke="currentColor" stroke-width="1.1" opacity="0.55" />
		<line x1={cx} y1={cy} x2={cx} y2={cy - PLOT_H - 10} stroke="currentColor" stroke-width="1.1" opacity="0.55" />

		{/* x-axis tick labels (in thousands of dollars) */}
		{xTicks.map((k) => (
			<g>
				<line x1={sx(k)} y1={cy} x2={sx(k)} y2={cy + 5} stroke="currentColor" stroke-width="0.8" opacity="0.5" />
				<text x={sx(k)} y={cy + 18} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">{k === 0 ? '0' : `${k}k`}</text>
			</g>
		))}
		<text x={cx + PLOT_W + 14} y={cy + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.65">salary ($)</text>

		{/* y-axis tick labels */}
		{yTicks.map((c) => (
			<g>
				<line x1={cx - 5} y1={sy(c)} x2={cx} y2={sy(c)} stroke="currentColor" stroke-width="0.8" opacity="0.5" />
				<text x={cx - 8} y={sy(c) + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.6">{c}</text>
			</g>
		))}
		<text x={cx - 8} y={cy - PLOT_H - 14} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.65">count</text>

		{/* histogram bars */}
		{bins.map((b) => {
			if (b.count === 0) return null;
			const barX = sx(b.k);
			const barW = sx(b.k + BIN_W) - sx(b.k) - 1;
			return <rect x={barX} y={sy(b.count)} width={barW} height={cy - sy(b.count)} fill={BLUE} fill-opacity="0.55" stroke={BLUE} stroke-width="1" />;
		})}

		{/* median line (amber, at 50k) */}
		<line x1={sx(medianK)} y1={cy} x2={sx(medianK)} y2={cy - PLOT_H - 4} stroke={AMBER} stroke-width="2" stroke-dasharray="6 4" />
		<text x={sx(medianK)} y={cy - PLOT_H - 10} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={AMBER}>median = $50k</text>

		{/* mean line (accent purple, at 245k) */}
		<line x1={sx(meanK)} y1={cy} x2={sx(meanK)} y2={cy - PLOT_H - 4} stroke={ACCENT} stroke-width="2" stroke-dasharray="6 4" />
		<text x={sx(meanK) + 8} y={cy - PLOT_H + 16} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={ACCENT}>mean = $245k</text>

		{/* arrow showing the mean was pulled toward the outlier */}
		<defs>
			<marker id="sp-smm-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>
		<path d={`M ${sx(medianK) + 8} ${cy - PLOT_H / 2} Q ${sx(meanK) - 20} ${cy - PLOT_H / 2 + 22} ${sx(meanK) - 4} ${cy - PLOT_H / 2 + 4}`} fill="none" stroke={ACCENT} stroke-width="1.6" opacity="0.7" marker-end="url(#sp-smm-arrow)" />
		<text x={sx(medianK) + 80} y={cy - PLOT_H / 2 - 8} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" font-weight="700" fill={ACCENT}>outlier drags mean right</text>

		{/* legend */}
		<g transform="translate(540, 60)">
			<rect x="0" y="0" width="180" height="140" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="180" height="140" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="90" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.7">ten salaries:</text>
			<text x="90" y="42" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor">9 × $50k + 1 × $2M</text>
			<line x1="16" y1="58" x2="164" y2="58" stroke="currentColor" stroke-width="0.6" opacity="0.3" />
			<text x="90" y="78" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={AMBER}>median: <tspan font-weight="700">$50k</tspan></text>
			<text x="90" y="98" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={ACCENT}>mean: <tspan font-weight="700">$245k</tspan></text>
			<text x="90" y="122" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.6">median is robust to outliers</text>
		</g>

		{/* mute teal in case eslint flags unused */}
		<text x="-100" y="-100" fill={TEAL} opacity="0">.</text>
	</svg>
	<figcaption>Nine modest salaries cluster at $50,000 and one outlier earns $2,000,000. The median, the middle value when sorted, stays at $50,000 right at the cluster. The mean shoots up to $245,000, dragged rightward by the single outlier. When data is skewed, the median is the better summary of "typical".</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 9 (Statistics & Probability for AI), Lesson 7, illustration 1 of 1.
 *
 * Natural-frequency tree of 10,000 people. First split by disease status
 * (100 sick / 9,900 healthy), then by test result inside each branch
 * (99 true-positive + 1 false-negative under sick; 99 false-positive +
 * 9,801 true-negative under healthy). Of the 198 test-positives, 99
 * actually have the disease: posterior P(disease | test+) = 99/198 = 50%.
 * Same numbers as L1 SpBaseRateGrid, different visual form (tree vs grid).
 */

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
const BLUE = '#3b82f6';

type Node = { x: number; y: number; label: string; sub?: string; color?: string };

const root: Node = { x: 80, y: 180, label: '10,000', sub: 'people' };

const lev1: Node[] = [
	{ x: 250, y: 80, label: '100 disease', sub: '1%', color: AMBER },
	{ x: 250, y: 280, label: '9,900 healthy', sub: '99%', color: TEAL },
];

const lev2: Node[] = [
	{ x: 460, y: 50, label: '99 test +', sub: '99% sensitivity', color: AMBER },
	{ x: 460, y: 110, label: '1 test -', sub: '1% miss', color: AMBER },
	{ x: 460, y: 250, label: '99 test +', sub: '1% false alarm', color: BLUE },
	{ x: 460, y: 310, label: '9,801 test -', sub: '99% specificity', color: TEAL },
];

type Edge = { from: Node; to: Node; label: string };
const edges: Edge[] = [
	{ from: root, to: lev1[0], label: '0.01' },
	{ from: root, to: lev1[1], label: '0.99' },
	{ from: lev1[0], to: lev2[0], label: '0.99' },
	{ from: lev1[0], to: lev2[1], label: '0.01' },
	{ from: lev1[1], to: lev2[2], label: '0.01' },
	{ from: lev1[1], to: lev2[3], label: '0.99' },
];
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="sp-bayest-title sp-bayest-desc">
		<title id="sp-bayest-title">A natural-frequency tree of 10,000 people branching by disease status and test result</title>
		<desc id="sp-bayest-desc">A horizontal tree diagram starting at a root node labeled 10,000 people. The root splits into two amber-colored branches: 100 with the disease (1 percent base rate) and 9,900 healthy (99 percent). Each first-level node splits into two further branches by test result. The 100 sick branch yields 99 true positives and 1 false negative. The 9,900 healthy branch yields 99 false positives in blue and 9,801 true negatives in teal. Edge labels show conditional probabilities. A summary at the bottom states that of 99 plus 99 equals 198 positive tests, only 99 actually have the disease, so P(disease given test positive) equals 99 divided by 198 equals 50 percent.</desc>

		<defs>
			<marker id="sp-bt-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" opacity="0.55" />
			</marker>
		</defs>

		{/* edges */}
		{edges.map((e) => (
			<g>
				<line x1={e.from.x + 36} y1={e.from.y} x2={e.to.x - 56} y2={e.to.y} stroke="currentColor" stroke-width="1.2" opacity="0.55" marker-end="url(#sp-bt-arrow)" />
				<text x={(e.from.x + e.to.x) / 2 - 6} y={(e.from.y + e.to.y) / 2 - 4} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.7">{e.label}</text>
			</g>
		))}

		{/* root */}
		<rect x={root.x - 30} y={root.y - 22} width="80" height="44" rx="6" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-width="1" opacity="0.6" />
		<text x={root.x + 10} y={root.y + 2} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" font-weight="700" fill="currentColor">{root.label}</text>
		<text x={root.x + 10} y={root.y + 16} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="9" fill="currentColor" opacity="0.6">{root.sub}</text>

		{/* level 1 */}
		{lev1.map((n) => (
			<g>
				<rect x={n.x - 50} y={n.y - 22} width="100" height="44" rx="6" fill={n.color} fill-opacity="0.15" stroke={n.color} stroke-width="1.2" />
				<text x={n.x} y={n.y + 2} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={n.color}>{n.label}</text>
				<text x={n.x} y={n.y + 16} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="9" fill="currentColor" opacity="0.6">{n.sub}</text>
			</g>
		))}

		{/* level 2 */}
		{lev2.map((n) => (
			<g>
				<rect x={n.x - 56} y={n.y - 16} width="112" height="34" rx="5" fill={n.color} fill-opacity="0.2" stroke={n.color} stroke-width="1.1" />
				<text x={n.x} y={n.y + 1} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={n.color}>{n.label}</text>
				<text x={n.x} y={n.y + 13} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="9" fill="currentColor" opacity="0.6">{n.sub}</text>
			</g>
		))}

		{/* posterior summary */}
		<g transform="translate(580, 60)">
			<rect x="0" y="0" width="140" height="120" rx="6" fill={ACCENT} fill-opacity="0.06" stroke={ACCENT} stroke-width="1" opacity="0.7" />
			<text x="70" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill={ACCENT} opacity="0.8">positive tests:</text>
			<text x="70" y="44" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" fill="currentColor">
				<tspan fill={AMBER} font-weight="700">99</tspan> + <tspan fill={BLUE} font-weight="700">99</tspan> = <tspan font-weight="700">198</tspan>
			</text>
			<text x="70" y="66" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="9" fill="currentColor" opacity="0.65">of these, 99 actually sick</text>
			<text x="70" y="92" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>P(sick | +)</text>
			<text x="70" y="108" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" font-weight="700" fill={ACCENT}>= 99/198 = 50%</text>
		</g>
	</svg>
	<figcaption>Pour 10,000 people through the tree. One percent (100) have the disease; of those, 99 test positive. Of the 9,900 healthy people, 1 percent (99) test positive too. So 198 positive tests total, half from each branch. A positive test alone is only a 50-50 signal. Same answer as the L1 grid; the tree route emphasizes how the probabilities multiply at each branch.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

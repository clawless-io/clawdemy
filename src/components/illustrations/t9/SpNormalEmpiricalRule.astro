---
/**
 * Track 9 (Statistics & Probability for AI), Lesson 9, illustration 1 of 2.
 *
 * The 68-95-99.7 rule on a standard normal curve. The total area under
 * the bell is 1. Within ±1 sigma the area is 68 percent, within ±2 sigma
 * 95 percent, and within ±3 sigma 99.7 percent. The picture nests three
 * shaded bands and labels each with its percentage of the area.
 */

const cx = 80; // origin x of plot
const cy = 270; // baseline y
const PLOT_W = 580;
const PLOT_H = 200;

const Z_MIN = -4;
const Z_MAX = 4;
const SAMPLES = 200;

// standard normal density (unscaled), normalized for display below
function phi(z: number): number {
	return Math.exp(-0.5 * z * z) / Math.sqrt(2 * Math.PI);
}

const PEAK = phi(0);
const sx = (z: number) => cx + ((z - Z_MIN) / (Z_MAX - Z_MIN)) * PLOT_W;
const sy = (d: number) => cy - (d / PEAK) * PLOT_H;

const curvePath: string[] = [];
for (let i = 0; i <= SAMPLES; i++) {
	const z = Z_MIN + ((Z_MAX - Z_MIN) * i) / SAMPLES;
	curvePath.push(`${i === 0 ? 'M' : 'L'} ${sx(z).toFixed(1)} ${sy(phi(z)).toFixed(1)}`);
}

// build a closed shaded path for [-zLim, +zLim] using same samples
function shadedPath(zLim: number): string {
	const pts: { X: number; Y: number }[] = [];
	const N = 80;
	for (let i = 0; i <= N; i++) {
		const z = -zLim + (2 * zLim * i) / N;
		pts.push({ X: sx(z), Y: sy(phi(z)) });
	}
	let d = `M ${sx(-zLim).toFixed(1)} ${cy.toFixed(1)} `;
	for (const p of pts) d += `L ${p.X.toFixed(1)} ${p.Y.toFixed(1)} `;
	d += `L ${sx(zLim).toFixed(1)} ${cy.toFixed(1)} Z`;
	return d;
}

const BLUE = '#3b82f6';
const ACCENT = '#7c3aed';
const AMBER = '#d97706';

void AMBER;
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="sp-empr-title sp-empr-desc">
		<title id="sp-empr-title">The standard normal curve with the 68-95-99.7 empirical rule: 68 percent of the area within one sigma, 95 percent within two, 99.7 percent within three</title>
		<desc id="sp-empr-desc">A bell-shaped standard normal density curve centered at zero. Below the curve, three nested shaded regions in blue mark plus or minus one sigma containing 68 percent of the area, plus or minus two sigma containing 95 percent, and plus or minus three sigma containing 99.7 percent. Vertical dashed lines at z equals negative 3, negative 2, negative 1, 1, 2, 3 separate the bands. Labels above each band call out the percentages of the area under the curve.</desc>

		{/* axes */}
		<line x1={cx} y1={cy} x2={cx + PLOT_W + 10} y2={cy} stroke="currentColor" stroke-width="1" opacity="0.55" />
		<line x1={sx(0)} y1={cy} x2={sx(0)} y2={cy - PLOT_H - 6} stroke="currentColor" stroke-width="0.6" opacity="0.35" stroke-dasharray="3 3" />

		{/* nested shaded regions, outermost (lightest) first */}
		<path d={shadedPath(3)} fill={BLUE} fill-opacity="0.10" stroke="none" />
		<path d={shadedPath(2)} fill={BLUE} fill-opacity="0.18" stroke="none" />
		<path d={shadedPath(1)} fill={BLUE} fill-opacity="0.30" stroke="none" />

		{/* boundary verticals */}
		{[-3, -2, -1, 1, 2, 3].map((z) => (
			<line x1={sx(z)} y1={cy} x2={sx(z)} y2={sy(phi(z))} stroke={BLUE} stroke-width="0.9" stroke-dasharray="3 3" opacity="0.55" />
		))}

		{/* the curve on top */}
		<path d={curvePath.join(' ')} fill="none" stroke={ACCENT} stroke-width="2" />

		{/* tick labels along x */}
		{[-3, -2, -1, 0, 1, 2, 3].map((z) => (
			<g>
				<line x1={sx(z)} y1={cy} x2={sx(z)} y2={cy + 5} stroke="currentColor" stroke-width="0.7" opacity="0.55" />
				<text x={sx(z)} y={cy + 18} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.65">{z === 0 ? 'μ' : z > 0 ? `+${z}σ` : `${z}σ`}</text>
			</g>
		))}

		{/* area-percentage labels above the curve */}
		<text x={sx(0)} y={cy - PLOT_H + 18} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" font-weight="700" fill={ACCENT}>68%</text>
		<text x={sx(-1.5)} y={cy - PLOT_H / 2 - 12} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={BLUE}>95%</text>
		<text x={sx(-2.5)} y={cy - PLOT_H / 3 - 4} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={BLUE}>99.7%</text>

		{/* legend */}
		<g transform="translate(560, 60)">
			<rect x="0" y="0" width="160" height="120" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="160" height="120" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="80" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.7">empirical rule:</text>
			<text x="80" y="46" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor">±1σ → 68%</text>
			<text x="80" y="66" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor">±2σ → 95%</text>
			<text x="80" y="86" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor">±3σ → 99.7%</text>
			<text x="80" y="108" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.6">of the total area</text>
		</g>
	</svg>
	<figcaption>The standard normal curve carries its own ruler. About 68 percent of all values fall within one standard deviation of the mean, 95 percent within two, and 99.7 percent within three. The picture is the rule: three nested regions whose areas read off as the familiar 68 / 95 / 99.7 percentages.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

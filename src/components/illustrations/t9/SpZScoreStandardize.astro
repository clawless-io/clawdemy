---
/**
 * Track 9 (Statistics & Probability for AI), Lesson 9, illustration 2 of 2.
 *
 * Standardization. A raw normal N(μ=500, σ=100) is reshaped by z = (x - μ)/σ
 * into the standard normal N(0, 1). The shape is identical; only the
 * horizontal axis changes labels. A sample point at x = 650 in the raw
 * scale maps to z = 1.5 in the standard scale: same percentile, same
 * place on the curve, different number.
 */

const PANEL_W = 320;
const PANEL_X1 = 20;
const PANEL_X2 = 400;
const PANEL_Y = 70;
const PANEL_H = 200;

const SAMPLES = 140;
const ACCENT = '#7c3aed';
const BLUE = '#3b82f6';
const AMBER = '#d97706';

function phi(z: number): number {
	return Math.exp(-0.5 * z * z) / Math.sqrt(2 * Math.PI);
}

// raw panel uses x in [200, 800], μ = 500, σ = 100
const RAW_MU = 500;
const RAW_SIG = 100;
const RAW_X_MIN = 200;
const RAW_X_MAX = 800;

// standard panel uses z in [-3, 3]
const STD_Z_MIN = -3;
const STD_Z_MAX = 3;

const cyP = PANEL_Y + PANEL_H;
const yScale = 200;

function curvePath(xMin: number, xMax: number, panelX: number, isStandard: boolean): string {
	let d = '';
	for (let i = 0; i <= SAMPLES; i++) {
		const xVal = xMin + ((xMax - xMin) * i) / SAMPLES;
		const z = isStandard ? xVal : (xVal - RAW_MU) / RAW_SIG;
		const density = phi(z);
		const X = panelX + 20 + ((xVal - xMin) / (xMax - xMin)) * (PANEL_W - 40);
		const Y = cyP - density * yScale;
		d += `${i === 0 ? 'M' : 'L'} ${X.toFixed(1)} ${Y.toFixed(1)} `;
	}
	return d.trim();
}

// sample point: raw x = 650 → z = 1.5
const sampleRawX = 650;
const sampleZ = (sampleRawX - RAW_MU) / RAW_SIG;

const sxRaw = (xVal: number) => PANEL_X1 + 20 + ((xVal - RAW_X_MIN) / (RAW_X_MAX - RAW_X_MIN)) * (PANEL_W - 40);
const sxStd = (zVal: number) => PANEL_X2 + 20 + ((zVal - STD_Z_MIN) / (STD_Z_MAX - STD_Z_MIN)) * (PANEL_W - 40);

const sampleRawXPx = sxRaw(sampleRawX);
const sampleRawYPx = cyP - phi(sampleZ) * yScale;
const sampleStdXPx = sxStd(sampleZ);
const sampleStdYPx = cyP - phi(sampleZ) * yScale;
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="sp-zsc-title sp-zsc-desc">
		<title id="sp-zsc-title">Standardization: a raw normal with mean 500 and standard deviation 100 becomes the standard normal under z equals x minus mu over sigma</title>
		<desc id="sp-zsc-desc">Two side-by-side bell curves. The left panel shows a normal density labeled N with mean 500 and standard deviation 100, with the horizontal axis from 200 to 800; a marked point at x equals 650 sits on the curve at height phi of 1.5. An arrow labeled z equals x minus mu over sigma points to the right panel, which shows the standard normal N with mean 0 and standard deviation 1, axis from negative 3 to positive 3; the corresponding marked point sits at z equals 1.5, the same height on an identically-shaped bell. The two bells have the same shape; standardization is a relabeling of the horizontal axis.</desc>

		<defs>
			<marker id="sp-zsc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		{/* left panel: raw */}
		<rect x={PANEL_X1} y={PANEL_Y - 30} width={PANEL_W} height={PANEL_H + 50} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={PANEL_Y - 14} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.85">N(500, 100²): raw</text>

		<line x1={PANEL_X1 + 20} y1={cyP} x2={PANEL_X1 + PANEL_W - 20} y2={cyP} stroke="currentColor" stroke-width="0.9" opacity="0.5" />
		<path d={curvePath(RAW_X_MIN, RAW_X_MAX, PANEL_X1, false)} fill={BLUE} fill-opacity="0.15" stroke={ACCENT} stroke-width="2" />

		{/* raw axis tick labels */}
		{[300, 400, 500, 600, 700].map((t) => (
			<g>
				<line x1={sxRaw(t)} y1={cyP} x2={sxRaw(t)} y2={cyP + 4} stroke="currentColor" stroke-width="0.6" opacity="0.45" />
				<text x={sxRaw(t)} y={cyP + 16} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="9" fill="currentColor" opacity="0.6">{t}</text>
			</g>
		))}

		{/* sample point on raw */}
		<line x1={sampleRawXPx} y1={cyP} x2={sampleRawXPx} y2={sampleRawYPx} stroke={AMBER} stroke-width="1.4" stroke-dasharray="4 3" />
		<circle cx={sampleRawXPx} cy={sampleRawYPx} r="4" fill={AMBER} />
		<text x={sampleRawXPx} y={sampleRawYPx - 8} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" font-weight="700" fill={AMBER}>x = 650</text>

		{/* connector */}
		<line x1={PANEL_X1 + PANEL_W + 8} y1={cyP - PANEL_H / 2} x2={PANEL_X2 - 8} y2={cyP - PANEL_H / 2} stroke={ACCENT} stroke-width="2" marker-end="url(#sp-zsc-arrow)" />
		<text x={(PANEL_X1 + PANEL_W + PANEL_X2) / 2} y={cyP - PANEL_H / 2 - 10} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>z = (x - μ) / σ</text>

		{/* right panel: standard */}
		<rect x={PANEL_X2} y={PANEL_Y - 30} width={PANEL_W} height={PANEL_H + 50} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={PANEL_Y - 14} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>N(0, 1): standard</text>

		<line x1={PANEL_X2 + 20} y1={cyP} x2={PANEL_X2 + PANEL_W - 20} y2={cyP} stroke="currentColor" stroke-width="0.9" opacity="0.5" />
		<path d={curvePath(STD_Z_MIN, STD_Z_MAX, PANEL_X2, true)} fill={BLUE} fill-opacity="0.15" stroke={ACCENT} stroke-width="2" />

		{/* standard axis tick labels */}
		{[-2, -1, 0, 1, 2].map((t) => (
			<g>
				<line x1={sxStd(t)} y1={cyP} x2={sxStd(t)} y2={cyP + 4} stroke="currentColor" stroke-width="0.6" opacity="0.45" />
				<text x={sxStd(t)} y={cyP + 16} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="9" fill="currentColor" opacity="0.6">{t}</text>
			</g>
		))}

		{/* sample point on standard */}
		<line x1={sampleStdXPx} y1={cyP} x2={sampleStdXPx} y2={sampleStdYPx} stroke={AMBER} stroke-width="1.4" stroke-dasharray="4 3" />
		<circle cx={sampleStdXPx} cy={sampleStdYPx} r="4" fill={AMBER} />
		<text x={sampleStdXPx} y={sampleStdYPx - 8} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" font-weight="700" fill={AMBER}>z = 1.5</text>

		<text x={(PANEL_X1 + PANEL_X2 + PANEL_W) / 2} y={cyP + 50} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">same shape, same percentile; only the axis units change</text>
	</svg>
	<figcaption>To standardize is to relabel the x-axis. The raw curve N(500, 100²) and the standard normal N(0, 1) have exactly the same shape. The transformation z = (x - μ)/σ slides and rescales the axis so the mean lands at 0 and the standard deviation at 1. A value at x = 650 in the raw scale lands at z = 1.5 in the standard scale: same height, same percentile, different number.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 9 (Statistics & Probability for AI), Lesson 1, illustration 1 of 1.
 *
 * Natural-frequency grid of 10,000 people. The first row (100 cells) is
 * the sick population: 99 test-positive cells in amber (true positives)
 * plus 1 test-negative in faded amber (false negative). The second row
 * carries the 99 false-positive cells in distribution-blue (healthy
 * people whose test came back positive). The remaining 9,801 cells fill
 * the rest of the grid in faint teal: true negatives. Of the 198
 * positive tests (99 amber + 99 blue), only 99 are actually sick, so
 * the posterior P(sick | positive) = 99/198 = 50 percent.
 */

const GRID_X = 40;
const GRID_Y = 40;
const CELLS_PER_ROW = 100;
const ROWS = 100;
const CELL = 2.8;

const TP_COUNT = 99;
const FN_COUNT = 1;
const FP_COUNT = 99;

const SICK_TOTAL = TP_COUNT + FN_COUNT;
const POSITIVE_TOTAL = TP_COUNT + FP_COUNT;
const POSTERIOR_PCT = Math.round((TP_COUNT / POSITIVE_TOTAL) * 100);

const TEAL = '#0d9488';
const AMBER = '#d97706';
const BLUE = '#3b82f6';
const ACCENT = '#7c3aed';

type Cell = { i: number; row: number; col: number; x: number; y: number; cls: 'tp' | 'fn' | 'fp' | 'tn' };
const cells: Cell[] = [];
for (let i = 0; i < CELLS_PER_ROW * ROWS; i++) {
	const row = Math.floor(i / CELLS_PER_ROW);
	const col = i % CELLS_PER_ROW;
	let cls: Cell['cls'];
	if (i < TP_COUNT) cls = 'tp';
	else if (i < TP_COUNT + FN_COUNT) cls = 'fn';
	else if (i < TP_COUNT + FN_COUNT + FP_COUNT) cls = 'fp';
	else cls = 'tn';
	cells.push({ i, row, col, x: GRID_X + col * CELL, y: GRID_Y + row * CELL, cls });
}

function color(cls: Cell['cls']): { fill: string; opacity: number } {
	switch (cls) {
		case 'tp':
			return { fill: AMBER, opacity: 1 };
		case 'fn':
			return { fill: AMBER, opacity: 0.35 };
		case 'fp':
			return { fill: BLUE, opacity: 1 };
		case 'tn':
			return { fill: TEAL, opacity: 0.15 };
	}
}
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="sp-bg-title sp-bg-desc">
		<title id="sp-bg-title">A natural-frequency grid of 10,000 people: 99 true positives, 99 false positives, posterior 50 percent</title>
		<desc id="sp-bg-desc">A 100-by-100 grid of small squares, each representing one of 10,000 people in a hypothetical population. The first row, 100 squares, represents the sick: 99 amber squares are true positives (sick and test-positive) and 1 faded-amber square is a false negative (sick but test-negative). The first 99 squares of the second row are blue: these are false positives, healthy people whose test came back positive. The remaining 9,801 squares are faint teal, true negatives. A bracket marks the 100 sick at top, and a second bracket marks the 99 false positives in row 2. The legend computes 99 true positives plus 99 false positives equals 198 positive tests, of which only 99 are actually sick: posterior 99 divided by 198 equals 50 percent.</desc>

		<rect x={GRID_X - 2} y={GRID_Y - 2} width={CELLS_PER_ROW * CELL + 4} height={ROWS * CELL + 4} fill="currentColor" opacity="0.03" />

		{cells.map((c) => {
			const col = color(c.cls);
			return <rect x={c.x} y={c.y} width={CELL - 0.3} height={CELL - 0.3} fill={col.fill} opacity={col.opacity} />;
		})}

		<line x1={GRID_X - 8} y1={GRID_Y} x2={GRID_X - 8} y2={GRID_Y + CELL} stroke={AMBER} stroke-width="2" />
		<line x1={GRID_X - 12} y1={GRID_Y} x2={GRID_X - 4} y2={GRID_Y} stroke={AMBER} stroke-width="2" />
		<line x1={GRID_X - 12} y1={GRID_Y + CELL} x2={GRID_X - 4} y2={GRID_Y + CELL} stroke={AMBER} stroke-width="2" />
		<text x={GRID_X - 16} y={GRID_Y + CELL / 2 + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" font-weight="700" fill={AMBER}>{SICK_TOTAL} sick</text>

		<line x1={GRID_X} y1={GRID_Y + CELL + CELL + 6} x2={GRID_X + FP_COUNT * CELL} y2={GRID_Y + CELL + CELL + 6} stroke={BLUE} stroke-width="1.6" />
		<line x1={GRID_X} y1={GRID_Y + CELL + CELL + 2} x2={GRID_X} y2={GRID_Y + CELL + CELL + 10} stroke={BLUE} stroke-width="1.6" />
		<line x1={GRID_X + FP_COUNT * CELL} y1={GRID_Y + CELL + CELL + 2} x2={GRID_X + FP_COUNT * CELL} y2={GRID_Y + CELL + CELL + 10} stroke={BLUE} stroke-width="1.6" />
		<text x={GRID_X + (FP_COUNT * CELL) / 2} y={GRID_Y + CELL + CELL + 24} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" font-weight="700" fill={BLUE}>99 false positives</text>

		<text x={GRID_X + (CELLS_PER_ROW * CELL) / 2} y={GRID_Y - 8} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">10,000 people</text>

		<g transform="translate(380, 70)">
			<rect x="0" y="0" width="330" height="240" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="330" height="240" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />

			<text x="165" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.7">how to read the grid:</text>

			<rect x="16" y="36" width="14" height="14" fill={AMBER} />
			<text x="38" y="48" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor">true positive (sick + test +): <tspan fill={AMBER} font-weight="700">99</tspan></text>

			<rect x="16" y="56" width="14" height="14" fill={AMBER} opacity="0.35" />
			<text x="38" y="68" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor">false negative (sick + test -): <tspan fill={AMBER} font-weight="700">1</tspan></text>

			<rect x="16" y="76" width="14" height="14" fill={BLUE} />
			<text x="38" y="88" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor">false positive (healthy + test +): <tspan fill={BLUE} font-weight="700">99</tspan></text>

			<rect x="16" y="96" width="14" height="14" fill={TEAL} opacity="0.15" />
			<text x="38" y="108" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor">true negative (healthy + test -): <tspan fill={TEAL} font-weight="700">9,801</tspan></text>

			<line x1="16" y1="124" x2="314" y2="124" stroke="currentColor" stroke-width="0.6" opacity="0.3" />

			<text x="165" y="146" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor">
				positives = <tspan fill={AMBER} font-weight="700">{TP_COUNT}</tspan> + <tspan fill={BLUE} font-weight="700">{FP_COUNT}</tspan> = <tspan font-weight="700">{POSITIVE_TOTAL}</tspan>
			</text>
			<text x="165" y="168" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.8">of these, only <tspan fill={AMBER} font-weight="700">{TP_COUNT}</tspan> are actually sick</text>

			<text x="165" y="204" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="15" font-weight="700" fill={ACCENT}>
				P(sick | test +) = {TP_COUNT} / {POSITIVE_TOTAL} = {POSTERIOR_PCT}%
			</text>
			<text x="165" y="226" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.6">a positive test only means a 50/50 chance of being sick</text>
		</g>
	</svg>
	<figcaption>Imagine 10,000 people. The 100 sick are a single row at the top. A good test catches 99 of them, missing 1. But among the 9,900 healthy people, 1 percent (99 more) also test positive. That is 198 positive results total, only 99 of whom are actually sick. The posterior probability of being sick given a positive test is exactly half.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 9 (Statistics & Probability for AI), Lesson 3, illustration 2 of 2.
 *
 * The same bimodal dataset rendered three ways. Left: too few bins, the
 * two peaks merge into one fat bar, the shape is mis-read. Middle: a
 * sensible bin width reveals the two peaks. Right: too many bins, every
 * bar becomes noisy spikes and the shape is lost. The picture's point:
 * bin width is a choice, and it can hide or fabricate apparent structure.
 */

const PANEL_W = 220;
const PANEL_GAP = 16;
const PANEL_X = (i: number) => 30 + i * (PANEL_W + PANEL_GAP);
const PANEL_Y = 70;
const PANEL_H = 200;

type Panel = {
	idx: 0 | 1 | 2;
	title: string;
	bins: number[];
	note: string;
};

// Bimodal source data: two peaks (e.g., around indices 3 and 13 in a 20-bin space)
// Coarse: 4 bins
// Good: 16 bins
// Fine: 32 bins

const coarse = [22, 16, 18, 24];
const good = [3, 6, 10, 14, 12, 7, 4, 3, 4, 7, 12, 14, 10, 6, 4, 3];
const fine = [1, 2, 3, 4, 5, 6, 8, 7, 6, 5, 4, 3, 2, 2, 1, 1, 2, 3, 4, 5, 6, 7, 7, 6, 5, 4, 3, 2, 1, 1, 1, 1];

const panels: Panel[] = [
	{ idx: 0, title: 'too few bins', bins: coarse, note: 'hides the bimodality' },
	{ idx: 1, title: 'good bin width', bins: good, note: 'two peaks visible' },
	{ idx: 2, title: 'too many bins', bins: fine, note: 'noise, shape lost' },
];

const MAX_BAR = 25;
const ACCENT = '#7c3aed';
const BLUE = '#3b82f6';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="sp-bimo-title sp-bimo-desc">
		<title id="sp-bimo-title">A bimodal dataset binned three ways: too few bins hides the bimodality, a good bin width reveals two peaks, too many bins becomes noise</title>
		<desc id="sp-bimo-desc">Three small histograms side by side, each derived from the same bimodal dataset but binned differently. The left histogram uses only 4 wide bins, producing a roughly even-looking flat shape that hides the underlying two peaks. The middle uses about 16 bins and clearly shows two distinct peaks separated by a valley, the true bimodal shape. The right uses 32 narrow bins, producing a jagged spiky pattern where the shape is lost in noise. Captions below each panel name the failure mode or success.</desc>

		{panels.map((p) => {
			const px = PANEL_X(p.idx);
			const cxP = px + PANEL_W / 2;
			const yBase = PANEL_Y + PANEL_H;
			const innerW = PANEL_W - 30;
			const binW = innerW / p.bins.length;
			return (
				<g>
					<rect x={px} y={PANEL_Y - 24} width={PANEL_W} height={PANEL_H + 50} rx="6" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.22" />
					<text x={cxP} y={PANEL_Y - 8} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={p.idx === 1 ? ACCENT : 'currentColor'} opacity={p.idx === 1 ? 1 : 0.65}>{p.title}</text>
					<line x1={px + 12} y1={yBase} x2={px + PANEL_W - 12} y2={yBase} stroke="currentColor" stroke-width="0.9" opacity="0.5" />
					{p.bins.map((c, i) => (
						<rect x={px + 15 + i * binW} y={yBase - (c / MAX_BAR) * (PANEL_H - 20)} width={binW - 0.6} height={(c / MAX_BAR) * (PANEL_H - 20)} fill={BLUE} fill-opacity={p.idx === 1 ? 0.65 : 0.4} stroke={BLUE} stroke-width="0.5" />
					))}
					<text x={cxP} y={yBase + 20} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill={p.idx === 1 ? ACCENT : 'currentColor'} opacity={p.idx === 1 ? 0.9 : 0.65}>{p.note}</text>

					{p.idx === 0 ? <text x={px + 4} y={PANEL_Y + 8} font-family="ui-monospace, SFMono-Regular, monospace" font-size="9" fill="currentColor" opacity="0.55">count</text> : null}
				</g>
			);
		})}
	</svg>
	<figcaption>The same underlying dataset, binned three ways. Too few bins blur the two peaks into a single mass, hiding the bimodal story. A sensible bin width reveals the two peaks separated by a valley. Too many bins fracture the shape into spiky noise where any pattern gets lost. Bin width is a choice; choose poorly and the histogram lies.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

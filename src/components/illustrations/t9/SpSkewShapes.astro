---
/**
 * Track 9 (Statistics & Probability for AI), Lesson 3, illustration 1 of 2.
 *
 * Three histograms side by side, showing how skewness moves the mean
 * relative to the median. Left panel: right-skewed (long tail right),
 * mean dragged above median. Middle: left-skewed (tail left), mean
 * below median. Right: symmetric, mean equals median. Tail direction
 * and mean-vs-median marker placement are the entire pedagogical point.
 */

const PANEL_W = 220;
const PANEL_GAP = 16;
const PANEL_X = (i: number) => 30 + i * (PANEL_W + PANEL_GAP);
const PANEL_Y = 70;
const PANEL_H = 220;

const BIN_COUNT = 9;
const BIN_W = (PANEL_W - 30) / BIN_COUNT;

type ShapeDef = {
	idx: 0 | 1 | 2;
	title: string;
	tail: string;
	bins: number[];
};

const shapes: ShapeDef[] = [
	{ idx: 0, title: 'right-skewed', tail: 'tail →', bins: [12, 18, 14, 10, 7, 5, 3, 2, 1] },
	{ idx: 1, title: 'left-skewed', tail: '← tail', bins: [1, 2, 3, 5, 7, 10, 14, 18, 12] },
	{ idx: 2, title: 'symmetric', tail: 'no tail', bins: [2, 5, 10, 14, 16, 14, 10, 5, 2] },
];

const MAX_BAR = 20;

// Compute mean (weighted by bin index) and median for each shape.
function statsFor(bins: number[]): { mean: number; median: number } {
	let total = 0;
	let weighted = 0;
	for (let i = 0; i < bins.length; i++) {
		total += bins[i];
		weighted += i * bins[i];
	}
	const mean = weighted / total;
	const half = total / 2;
	let cum = 0;
	let medianIdx = 0;
	for (let i = 0; i < bins.length; i++) {
		cum += bins[i];
		if (cum >= half) {
			medianIdx = i;
			break;
		}
	}
	return { mean, median: medianIdx };
}

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
const BLUE = '#3b82f6';

void TEAL;
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="sp-skewsh-title sp-skewsh-desc">
		<title id="sp-skewsh-title">Three histograms showing right-skewed, left-skewed, and symmetric shapes with mean and median markers</title>
		<desc id="sp-skewsh-desc">Three small histograms side by side, each with blue bars and a count axis. The left histogram is right-skewed: most of the data is on the left with a long tail to the right; a purple mean line sits to the right of the amber median line. The middle is left-skewed: the tail runs left, with the mean line to the left of the median line. The right histogram is symmetric, bell-shaped, with mean and median coinciding at the center. Tail labels describe the direction of the tail in each.</desc>

		{shapes.map((shape) => {
			const px = PANEL_X(shape.idx);
			const cxP = px + PANEL_W / 2;
			const yBase = PANEL_Y + PANEL_H;
			const stats = statsFor(shape.bins);
			const binX = (i: number) => px + 15 + i * BIN_W;
			const meanX = px + 15 + stats.mean * BIN_W + BIN_W / 2;
			const medianX = px + 15 + stats.median * BIN_W + BIN_W / 2;
			return (
				<g>
					<rect x={px} y={PANEL_Y - 24} width={PANEL_W} height={PANEL_H + 50} rx="6" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.22" />
					<text x={cxP} y={PANEL_Y - 8} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>{shape.title}</text>

					{/* axis baseline */}
					<line x1={px + 12} y1={yBase} x2={px + PANEL_W - 12} y2={yBase} stroke="currentColor" stroke-width="0.9" opacity="0.5" />

					{/* bars */}
					{shape.bins.map((c, i) => (
						<rect x={binX(i)} y={yBase - (c / MAX_BAR) * (PANEL_H - 20)} width={BIN_W - 1.2} height={(c / MAX_BAR) * (PANEL_H - 20)} fill={BLUE} fill-opacity="0.55" stroke={BLUE} stroke-width="0.6" />
					))}

					{/* mean and median markers */}
					<line x1={medianX} y1={yBase} x2={medianX} y2={yBase - (PANEL_H - 14)} stroke={AMBER} stroke-width="1.8" stroke-dasharray="4 3" />
					<line x1={meanX} y1={yBase} x2={meanX} y2={yBase - (PANEL_H - 14)} stroke={ACCENT} stroke-width="1.8" stroke-dasharray="4 3" />

					{/* marker labels */}
					<text x={medianX} y={yBase - (PANEL_H - 4)} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="9" font-weight="700" fill={AMBER}>med</text>
					<text x={meanX} y={yBase - (PANEL_H - 18)} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="9" font-weight="700" fill={ACCENT}>mean</text>

					{/* tail direction caption */}
					<text x={cxP} y={yBase + 20} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">{shape.tail}</text>

					{/* "count" axis label only on first panel */}
					{shape.idx === 0 ? <text x={px + 4} y={PANEL_Y + 8} font-family="ui-monospace, SFMono-Regular, monospace" font-size="9" fill="currentColor" opacity="0.55">count</text> : null}
				</g>
			);
		})}
	</svg>
	<figcaption>Three shapes, three relationships. When the tail trails right, the few large values pull the mean above the median (right-skew). When the tail trails left, the mean drops below the median (left-skew). When the distribution is symmetric, the two coincide at the center. The mean leans toward the long tail; the median holds steady.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

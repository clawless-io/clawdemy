---
/**
 * Track 11 (Neural Network Intuition), Lesson 2, illustration 2 of 5.
 *
 * The input layer. The 28x28 image (the same distance-field 3 from lesson 1)
 * becomes a tall column of 784 neurons, one per pixel, each neuron's
 * activation set to its pixel's brightness. The lesson's worked example,
 * pixel row 10 column 14 = neuron 294 holding 0.7, is highlighted.
 */
const N = 28;
const HW = 0.07;
type Pt = { x: number; y: number };
const skel: Pt[] = [];
function arc(cx: number, cy: number, r: number, f: number, t: number, steps: number) {
	for (let i = 0; i <= steps; i++) {
		const a = ((f + ((t - f) * i) / steps) * Math.PI) / 180;
		skel.push({ x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) });
	}
}
arc(0.46, 0.7, 0.22, 150, -75, 60);
arc(0.46, 0.3, 0.24, 75, -150, 60);
function val(ux: number, uy: number) {
	let b = Infinity;
	for (const p of skel) {
		const d = Math.hypot(ux - p.x, uy - p.y);
		if (d < b) b = d;
	}
	return Math.max(0, Math.min(1, 1 - b / HW));
}
const gx0 = 44;
const gy0 = 86;
const cell = 5;
type Cell = { x: number; y: number; v: number };
const grid: Cell[] = [];
for (let r = 0; r < N; r++)
	for (let c = 0; c < N; c++) grid.push({ x: gx0 + c * cell, y: gy0 + r * cell, v: val((c + 0.5) / N, 1 - (r + 0.5) / N) });

// Representative neurons in the 784-tall column (most are blank outlines).
const colX = 600;
const neurons = [
	{ y: 60, v: 0.0 }, { y: 82, v: 0.0 }, { y: 104, v: 0.06 }, { y: 126, v: 0.0 },
	{ y: 200, v: 0.12 }, { y: 222, v: 0.0 }, { y: 244, v: 0.0 }, { y: 266, v: 0.0 },
];
---

<figure class="cw-illus">
	<svg viewBox="0 0 800 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="nn-input-title nn-input-desc">
		<title id="nn-input-title">A 28 by 28 image becomes an input layer of 784 neurons</title>
		<desc id="nn-input-desc">On the left, the 28 by 28 grayscale image of a 3. An arrow labeled "784 brightness values" points right to a tall column of neurons drawn as small circles, the input layer. Most are empty outlines (dark pixels near 0), some are shaded (brighter pixels). One neuron partway down is highlighted in violet and labeled neuron 294 equals 0.7, the example pixel at row 10 column 14. The column is bracketed and labeled input layer, 784 neurons, one per pixel.</desc>

		<defs>
			<marker id="nn-input-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" /></marker>
		</defs>

		{grid.map((c) => <rect x={c.x} y={c.y} width={cell} height={cell} fill="currentColor" opacity={c.v < 0.02 ? 0 : c.v} />)}
		<rect x={gx0} y={gy0} width={N * cell} height={N * cell} fill="none" stroke="currentColor" stroke-width="1" opacity="0.25" />
		<text x={gx0 + (N * cell) / 2} y={gy0 + N * cell + 22} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" fill="currentColor" opacity="0.7">28 <tspan font-family="ui-monospace, SFMono-Regular, monospace">x</tspan> 28 image</text>

		<text x="300" y="142" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" fill="currentColor" opacity="0.7">784 brightness</text>
		<text x="300" y="158" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" fill="currentColor" opacity="0.7">values</text>
		<line x1="250" y1="176" x2="346" y2="176" stroke="currentColor" stroke-width="2" marker-end="url(#nn-input-arrow)" />

		<!-- the 784-neuron column (representative) -->
		{neurons.map((n) => (
			<g>
				<circle cx={colX} cy={n.y} r="9" fill="currentColor" opacity={n.v < 0.02 ? 0 : n.v} />
				<circle cx={colX} cy={n.y} r="9" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.4" />
			</g>
		))}
		<text x={colX} y="152" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="16" fill="currentColor" opacity="0.5">.</text>
		<text x={colX} y="158" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="16" fill="currentColor" opacity="0.5">.</text>
		<text x={colX} y="164" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="16" fill="currentColor" opacity="0.5">.</text>
		<text x={colX} y="296" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="16" fill="currentColor" opacity="0.5">.</text>
		<text x={colX} y="302" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="16" fill="currentColor" opacity="0.5">.</text>
		<text x={colX} y="308" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="16" fill="currentColor" opacity="0.5">.</text>

		<!-- highlighted neuron 294 -->
		<circle cx={colX} cy="176" r="13" fill="#7c3aed" opacity="0.7" />
		<circle cx={colX} cy="176" r="13" fill="none" stroke="#7c3aed" stroke-width="2" />
		<line x1={colX + 14} y1="176" x2="664" y2="176" stroke="#7c3aed" stroke-width="1.25" opacity="0.8" />
		<text x="672" y="172" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="#7c3aed">neuron 294 = 0.7</text>
		<text x="672" y="190" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.7">pixel row 10, col 14</text>

		<text x={colX} y="332" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" fill="currentColor"><tspan font-weight="600">input layer:</tspan> 784 neurons (one per pixel)</text>
	</svg>
	<figcaption>The thing your eye reads instantly as "a 3" enters the network as 784 numbers sitting in 784 boxes, nothing more. Each input neuron holds one pixel's brightness, 0 for black up to 1 for white. The example pixel at row 10, column 14 lands in neuron 10 times 28 plus 14, neuron 294, holding 0.7.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 780px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

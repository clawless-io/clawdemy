---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 3, illustration 3 of 3.
 *
 * The unit square at the origin becomes a parallelogram under a linear
 * transformation; the parallelogram's two sides are exactly the columns
 * of the matrix. With L = [[2, 1], [0, 2]], L(i-hat) = [2, 0] and
 * L(j-hat) = [1, 2], so the unit square's corners (0, 0), (1, 0), (1, 1),
 * (0, 1) become (0, 0), (2, 0), (3, 2), (1, 2). The shape is the same
 * info as the matrix in pictures.
 */

const PANEL_W = 340;
const PANEL_X1 = 20;
const PANEL_X2 = 380;
const cyP = 240;
const u = 44;

const Lx = (x: number, y: number) => 2 * x + 1 * y;
const Ly = (x: number, y: number) => 0 * x + 2 * y;

const Li = { x: Lx(1, 0), y: Ly(1, 0) }; // [2, 0]
const Lj = { x: Lx(0, 1), y: Ly(0, 1) }; // [1, 2]

const X_MIN = -1;
const X_MAX_BEFORE = 3;
const Y_MIN = -1;
const Y_MAX_BEFORE = 3;

const xsBefore: number[] = [];
for (let i = X_MIN; i <= X_MAX_BEFORE; i++) xsBefore.push(i);
const ysBefore: number[] = [];
for (let j = Y_MIN; j <= Y_MAX_BEFORE; j++) ysBefore.push(j);

const X_MAX_AFTER = 4;
const Y_MAX_AFTER = 3;
const xsAfter: number[] = [];
for (let i = X_MIN; i <= X_MAX_AFTER; i++) xsAfter.push(i);
const ysAfter: number[] = [];
for (let j = Y_MIN; j <= Y_MAX_AFTER; j++) ysAfter.push(j);

function panelOrigin(idx: 0 | 1) {
	const px = idx === 0 ? PANEL_X1 : PANEL_X2;
	return { X: px + 60, Y: cyP };
}

const o0 = panelOrigin(0);
const o1 = panelOrigin(1);
const sx0 = (gx: number) => o0.X + gx * u;
const sy0 = (gy: number) => o0.Y - gy * u;
const sx1 = (gx: number) => o1.X + gx * u;
const sy1 = (gy: number) => o1.Y - gy * u;

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-sq2par-title la-sq2par-desc">
		<title id="la-sq2par-title">The unit square becomes a parallelogram, whose two sides are the columns of the matrix</title>
		<desc id="la-sq2par-desc">Two side-by-side panels. The left panel shows the unit square at the origin with corners at (0, 0), (1, 0), (1, 1), and (0, 1), filled in light accent purple, with a teal i-hat along the bottom and an amber j-hat along the left side. The right panel shows the parallelogram after applying the matrix L = [[2, 1], [0, 2]]. The parallelogram has corners at (0, 0), (2, 0), (3, 2), (1, 2). The teal L of i-hat runs along its bottom edge to (2, 0) and the amber L of j-hat runs along its left edge to (1, 2). The columns of the matrix are exactly the two arrows.</desc>

		<defs>
			<marker id="la-sq2par-arrow-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-sq2par-arrow-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
		</defs>

		{/* panel 1: before */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.85">BEFORE: unit square</text>

		{ysBefore.map((j) => (
			<line x1={sx0(X_MIN)} y1={sy0(j)} x2={sx0(X_MAX_BEFORE)} y2={sy0(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
		))}
		{xsBefore.map((i) => (
			<line x1={sx0(i)} y1={sy0(Y_MIN)} x2={sx0(i)} y2={sy0(Y_MAX_BEFORE)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
		))}
		<line x1={sx0(X_MIN)} y1={sy0(0)} x2={sx0(X_MAX_BEFORE)} y2={sy0(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx0(0)} y1={sy0(Y_MIN)} x2={sx0(0)} y2={sy0(Y_MAX_BEFORE)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		<rect x={sx0(0)} y={sy0(1)} width={u} height={u} fill={ACCENT} opacity="0.14" />
		<rect x={sx0(0)} y={sy0(1)} width={u} height={u} fill="none" stroke={ACCENT} stroke-width="1.2" opacity="0.8" />

		<line x1={sx0(0)} y1={sy0(0)} x2={sx0(1)} y2={sy0(0)} stroke={TEAL} stroke-width="3" marker-end="url(#la-sq2par-arrow-t)" />
		<line x1={sx0(0)} y1={sy0(0)} x2={sx0(0)} y2={sy0(1)} stroke={AMBER} stroke-width="3" marker-end="url(#la-sq2par-arrow-a)" />
		<circle cx={sx0(0)} cy={sy0(0)} r="2.6" fill="currentColor" />

		<text x={sx0(1) + 6} y={sy0(0) + 16} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={TEAL}>î</text>
		<text x={sx0(0) - 16} y={sy0(1) + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={AMBER}>ĵ</text>

		{/* panel 2: after */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>AFTER L: parallelogram</text>

		{ysAfter.map((j) => (
			<line x1={sx1(X_MIN)} y1={sy1(j)} x2={sx1(X_MAX_AFTER)} y2={sy1(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
		))}
		{xsAfter.map((i) => (
			<line x1={sx1(i)} y1={sy1(Y_MIN)} x2={sx1(i)} y2={sy1(Y_MAX_AFTER)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
		))}
		<line x1={sx1(X_MIN)} y1={sy1(0)} x2={sx1(X_MAX_AFTER)} y2={sy1(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx1(0)} y1={sy1(Y_MIN)} x2={sx1(0)} y2={sy1(Y_MAX_AFTER)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		{/* parallelogram corners (0, 0), L(i-hat), L(i-hat)+L(j-hat), L(j-hat) */}
		<path d={`M ${sx1(0)} ${sy1(0)} L ${sx1(Li.x)} ${sy1(Li.y)} L ${sx1(Li.x + Lj.x)} ${sy1(Li.y + Lj.y)} L ${sx1(Lj.x)} ${sy1(Lj.y)} Z`} fill={ACCENT} fill-opacity="0.14" stroke={ACCENT} stroke-width="1.2" opacity="0.85" />

		<line x1={sx1(0)} y1={sy1(0)} x2={sx1(Li.x)} y2={sy1(Li.y)} stroke={TEAL} stroke-width="3" marker-end="url(#la-sq2par-arrow-t)" />
		<line x1={sx1(0)} y1={sy1(0)} x2={sx1(Lj.x)} y2={sy1(Lj.y)} stroke={AMBER} stroke-width="3" marker-end="url(#la-sq2par-arrow-a)" />
		<circle cx={sx1(0)} cy={sy1(0)} r="2.6" fill="currentColor" />

		<text x={sx1(Li.x) + 6} y={sy1(Li.y) + 16} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={TEAL}>L(î) = [2, 0]</text>
		<text x={sx1(Lj.x) - 6} y={sy1(Lj.y) - 6} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={AMBER}>L(ĵ) = [1, 2]</text>

		{/* matrix label centered below */}
		<text x={PANEL_X2 + PANEL_W / 2} y={328} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor" opacity="0.8">
			L = <tspan font-weight="700"><tspan fill={TEAL}>[2</tspan> <tspan fill={AMBER}>1]</tspan></tspan>, <tspan font-weight="700"><tspan fill={TEAL}>[0</tspan> <tspan fill={AMBER}>2]</tspan></tspan> (columns)
		</text>
	</svg>
	<figcaption>The unit square at the origin becomes a parallelogram under any linear transformation. The two side vectors of that parallelogram are exactly the columns of the matrix: L(î) and L(ĵ). The matrix and the parallelogram are the same picture in two notations.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

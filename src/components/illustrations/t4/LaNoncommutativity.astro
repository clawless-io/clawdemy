---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 4, illustration 3 of 3.
 *
 * Matrix multiplication is not commutative: SR (rotate first, then shear)
 * is a different transformation than RS (shear first, then rotate). Both
 * panels start from the same unit square and apply the same two matrices,
 * in opposite orders. The two output parallelograms are visibly different,
 * proof that order matters.
 */

const PANEL_W = 340;
const PANEL_X1 = 20;
const PANEL_X2 = 380;
const cyP = 235;
const u = 50;

// R = 90 degree counter-clockwise rotation: [[0, -1], [1, 0]].
// S = horizontal shear by 0.5: [[1, 0.5], [0, 1]].
// SR = S·R: rotate first, then shear. SR = [[0.5, -1], [1, 0]].
// RS = R·S: shear first, then rotate. RS = [[0, -1], [1, 0.5]].
//
// Unit-square corners (0,0), (1,0), (1,1), (0,1) become:
// SR-square: (0,0), (0.5, 1), (-0.5, 1), (-1, 0)
// RS-square: (0,0), (0, 1), (-1, 1.5), (-1, 0.5)

const SR_corners = [
	{ x: 0, y: 0 },
	{ x: 0.5, y: 1 },
	{ x: -0.5, y: 1 },
	{ x: -1, y: 0 },
];
const RS_corners = [
	{ x: 0, y: 0 },
	{ x: 0, y: 1 },
	{ x: -1, y: 1.5 },
	{ x: -1, y: 0.5 },
];

const SR_i = SR_corners[1];
const SR_j = SR_corners[3];
const RS_i = RS_corners[1];
const RS_j = RS_corners[3];

const X_MIN = -2;
const X_MAX = 2;
const Y_MIN = -1;
const Y_MAX = 2;

const xs: number[] = [];
for (let i = X_MIN; i <= X_MAX; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j <= Y_MAX; j++) ys.push(j);

function panelOrigin(idx: 0 | 1) {
	const px = idx === 0 ? PANEL_X1 : PANEL_X2;
	return { X: px + PANEL_W / 2 + 20, Y: cyP };
}

const o0 = panelOrigin(0);
const o1 = panelOrigin(1);
const sx0 = (gx: number) => o0.X + gx * u;
const sy0 = (gy: number) => o0.Y - gy * u;
const sx1 = (gx: number) => o1.X + gx * u;
const sy1 = (gy: number) => o1.Y - gy * u;

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
const ACCENT_ALT = '#be185d'; // distinct accent for the second panel's parallelogram
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-noncomm-title la-noncomm-desc">
		<title id="la-noncomm-title">Matrix multiplication is not commutative: rotate-then-shear and shear-then-rotate produce visibly different parallelograms</title>
		<desc id="la-noncomm-desc">Two side-by-side panels. The left panel applies SR, rotating the unit square 90 degrees counter-clockwise first and then shearing horizontally by 0.5, producing a parallelogram with corners at the origin, [0.5, 1], [negative 0.5, 1], and [negative 1, 0]. The right panel applies RS, shearing first and then rotating, producing a parallelogram with corners at the origin, [0, 1], [negative 1, 1.5], and [negative 1, 0.5]. The two parallelograms are visibly different shapes, showing that order matters.</desc>

		<defs>
			<marker id="la-noncomm-arrow-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-noncomm-arrow-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
		</defs>

		{/* panel 1: SR */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>SR: rotate then shear</text>

		{xs.map((i) => <line x1={sx0(i)} y1={sy0(Y_MIN)} x2={sx0(i)} y2={sy0(Y_MAX)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
		{ys.map((j) => <line x1={sx0(X_MIN)} y1={sy0(j)} x2={sx0(X_MAX)} y2={sy0(j)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
		<line x1={sx0(X_MIN)} y1={sy0(0)} x2={sx0(X_MAX)} y2={sy0(0)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />
		<line x1={sx0(0)} y1={sy0(Y_MIN)} x2={sx0(0)} y2={sy0(Y_MAX)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />

		<path d={`M ${sx0(SR_corners[0].x)} ${sy0(SR_corners[0].y)} L ${sx0(SR_corners[1].x)} ${sy0(SR_corners[1].y)} L ${sx0(SR_corners[2].x)} ${sy0(SR_corners[2].y)} L ${sx0(SR_corners[3].x)} ${sy0(SR_corners[3].y)} Z`} fill={ACCENT} fill-opacity="0.14" stroke={ACCENT} stroke-width="1.4" opacity="0.85" />

		<line x1={sx0(0)} y1={sy0(0)} x2={sx0(SR_i.x)} y2={sy0(SR_i.y)} stroke={TEAL} stroke-width="2.6" marker-end="url(#la-noncomm-arrow-t)" />
		<line x1={sx0(0)} y1={sy0(0)} x2={sx0(SR_j.x)} y2={sy0(SR_j.y)} stroke={AMBER} stroke-width="2.6" marker-end="url(#la-noncomm-arrow-a)" />
		<circle cx={sx0(0)} cy={sy0(0)} r="2.4" fill="currentColor" />

		<text x={PANEL_X1 + PANEL_W / 2} y={325} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.75">SR(î) = [0.5, 1], SR(ĵ) = [-1, 0]</text>

		{/* panel 2: RS */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT_ALT}>RS: shear then rotate</text>

		{xs.map((i) => <line x1={sx1(i)} y1={sy1(Y_MIN)} x2={sx1(i)} y2={sy1(Y_MAX)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
		{ys.map((j) => <line x1={sx1(X_MIN)} y1={sy1(j)} x2={sx1(X_MAX)} y2={sy1(j)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
		<line x1={sx1(X_MIN)} y1={sy1(0)} x2={sx1(X_MAX)} y2={sy1(0)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />
		<line x1={sx1(0)} y1={sy1(Y_MIN)} x2={sx1(0)} y2={sy1(Y_MAX)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />

		<path d={`M ${sx1(RS_corners[0].x)} ${sy1(RS_corners[0].y)} L ${sx1(RS_corners[1].x)} ${sy1(RS_corners[1].y)} L ${sx1(RS_corners[2].x)} ${sy1(RS_corners[2].y)} L ${sx1(RS_corners[3].x)} ${sy1(RS_corners[3].y)} Z`} fill={ACCENT_ALT} fill-opacity="0.14" stroke={ACCENT_ALT} stroke-width="1.4" opacity="0.85" />

		<line x1={sx1(0)} y1={sy1(0)} x2={sx1(RS_i.x)} y2={sy1(RS_i.y)} stroke={TEAL} stroke-width="2.6" marker-end="url(#la-noncomm-arrow-t)" />
		<line x1={sx1(0)} y1={sy1(0)} x2={sx1(RS_j.x)} y2={sy1(RS_j.y)} stroke={AMBER} stroke-width="2.6" marker-end="url(#la-noncomm-arrow-a)" />
		<circle cx={sx1(0)} cy={sy1(0)} r="2.4" fill="currentColor" />

		<text x={PANEL_X2 + PANEL_W / 2} y={325} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.75">RS(î) = [0, 1], RS(ĵ) = [-1, 0.5]</text>
	</svg>
	<figcaption>Apply two transformations in one order and you get one parallelogram; apply them in the other order and you get a different one. SR is not the same as RS. That is matrix multiplication being non-commutative: AB and BA almost never agree.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 4, illustration 2 of 3.
 *
 * Matrix multiplication, column by column. AB is built by applying A to
 * each column of B in turn: column k of AB equals A times column k of B.
 * Left mini-panel: B's two columns as arrows. Right mini-panel: A applied
 * to each, giving AB's two columns. Equation across the top spells out
 * AB = [A · col1(B) | A · col2(B)].
 */

const PANEL_W = 280;
const PANEL_GAP = 80;
const PANEL_Y = 90;
const PANEL_H = 220;
const u = 32;

// A = [[2, 0], [0, 1]] (horizontal stretch by 2).
// B = [[1, 0], [1, 1]] (column 1 = [1, 1], column 2 = [0, 1]).
// AB column 1 = A · [1, 1] = [2, 1].
// AB column 2 = A · [0, 1] = [0, 1].
const b1 = { x: 1, y: 1 };
const b2 = { x: 0, y: 1 };
const ab1 = { x: 2, y: 1 };
const ab2 = { x: 0, y: 1 };

const RANGE_L = 2;
const RANGE_R = 3;

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';

function panelX(idx: 0 | 1) {
	return 30 + idx * (PANEL_W + PANEL_GAP);
}
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-prodcol-title la-prodcol-desc">
		<title id="la-prodcol-title">Matrix multiplication column by column: AB equals A applied to each column of B</title>
		<desc id="la-prodcol-desc">The equation AB equals the matrix whose columns are A times column 1 of B and A times column 2 of B is shown at the top. Below, two mini-panels. The left mini-panel shows B's two columns as a teal arrow at [1, 1] and an amber arrow at [0, 1]. An arrow labeled "apply A" points from the left to the right mini-panel. The right mini-panel shows AB's two columns as a teal arrow at [2, 1] and an amber arrow at [0, 1], A having stretched the first column horizontally by 2 and left the second column unchanged.</desc>

		<defs>
			<marker id="la-prodcol-arrow-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-prodcol-arrow-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
			<marker id="la-prodcol-arrow-step" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" opacity="0.75" />
			</marker>
		</defs>

		{/* top equation */}
		<text x="370" y="36" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor">
			AB = [ <tspan fill={ACCENT}>A · </tspan><tspan fill={TEAL}>col<tspan baseline-shift="sub" font-size="10">1</tspan>(B)</tspan> <tspan fill="currentColor" opacity="0.6">|</tspan> <tspan fill={ACCENT}>A · </tspan><tspan fill={AMBER}>col<tspan baseline-shift="sub" font-size="10">2</tspan>(B)</tspan> ]
		</text>

		<text x="370" y="60" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">column k of AB = A times column k of B</text>

		{/* left mini-panel: B's columns */}
		{(() => {
			const px = panelX(0);
			const cxP = px + PANEL_W / 2;
			const cyP = PANEL_Y + PANEL_H / 2;
			const sx = (gx: number) => cxP + gx * u;
			const sy = (gy: number) => cyP - gy * u;
			const ticks: number[] = [];
			for (let i = -RANGE_L; i < RANGE_L + 1; i++) ticks.push(i);
			return (
				<g>
					<rect x={px} y={PANEL_Y} width={PANEL_W} height={PANEL_H} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
					<text x={cxP} y={PANEL_Y - 8} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.85">columns of B</text>

					{ticks.map((i) => <line x1={sx(-RANGE_L)} y1={sy(i)} x2={sx(RANGE_L)} y2={sy(i)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
					{ticks.map((j) => <line x1={sx(j)} y1={sy(-RANGE_L)} x2={sx(j)} y2={sy(RANGE_L)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
					<line x1={sx(-RANGE_L)} y1={sy(0)} x2={sx(RANGE_L)} y2={sy(0)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />
					<line x1={sx(0)} y1={sy(-RANGE_L)} x2={sx(0)} y2={sy(RANGE_L)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />

					<line x1={sx(0)} y1={sy(0)} x2={sx(b1.x)} y2={sy(b1.y)} stroke={TEAL} stroke-width="2.8" marker-end="url(#la-prodcol-arrow-t)" />
					<line x1={sx(0)} y1={sy(0)} x2={sx(b2.x)} y2={sy(b2.y)} stroke={AMBER} stroke-width="2.8" marker-end="url(#la-prodcol-arrow-a)" />
					<circle cx={sx(0)} cy={sy(0)} r="2.6" fill="currentColor" />

					<text x={sx(b1.x) + 6} y={sy(b1.y) - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={TEAL}>col<tspan baseline-shift="sub" font-size="9">1</tspan> = [1, 1]</text>
					<text x={sx(b2.x) - 6} y={sy(b2.y) + 16} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={AMBER}>col<tspan baseline-shift="sub" font-size="9">2</tspan> = [0, 1]</text>
				</g>
			);
		})()}

		{/* right mini-panel: AB's columns */}
		{(() => {
			const px = panelX(1);
			const cxP = px + PANEL_W / 2;
			const cyP = PANEL_Y + PANEL_H / 2;
			const sx = (gx: number) => cxP + gx * u;
			const sy = (gy: number) => cyP - gy * u;
			const ticks: number[] = [];
			for (let i = -RANGE_R; i < RANGE_R + 1; i++) ticks.push(i);
			return (
				<g>
					<rect x={px} y={PANEL_Y} width={PANEL_W} height={PANEL_H} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
					<text x={cxP} y={PANEL_Y - 8} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>columns of AB</text>

					{ticks.map((i) => <line x1={sx(-RANGE_R)} y1={sy(i)} x2={sx(RANGE_R)} y2={sy(i)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
					{ticks.map((j) => <line x1={sx(j)} y1={sy(-RANGE_R)} x2={sx(j)} y2={sy(RANGE_R)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
					<line x1={sx(-RANGE_R)} y1={sy(0)} x2={sx(RANGE_R)} y2={sy(0)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />
					<line x1={sx(0)} y1={sy(-RANGE_R)} x2={sx(0)} y2={sy(RANGE_R)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />

					<line x1={sx(0)} y1={sy(0)} x2={sx(ab1.x)} y2={sy(ab1.y)} stroke={TEAL} stroke-width="2.8" marker-end="url(#la-prodcol-arrow-t)" />
					<line x1={sx(0)} y1={sy(0)} x2={sx(ab2.x)} y2={sy(ab2.y)} stroke={AMBER} stroke-width="2.8" marker-end="url(#la-prodcol-arrow-a)" />
					<circle cx={sx(0)} cy={sy(0)} r="2.6" fill="currentColor" />

					<text x={sx(ab1.x) + 6} y={sy(ab1.y) - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={TEAL}>A·col<tspan baseline-shift="sub" font-size="9">1</tspan> = [2, 1]</text>
					<text x={sx(ab2.x) - 6} y={sy(ab2.y) + 16} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={AMBER}>A·col<tspan baseline-shift="sub" font-size="9">2</tspan> = [0, 1]</text>
				</g>
			);
		})()}

		{/* connector arrow between mini-panels */}
		<line x1={panelX(0) + PANEL_W + 8} y1={PANEL_Y + PANEL_H / 2} x2={panelX(1) - 8} y2={PANEL_Y + PANEL_H / 2} stroke="currentColor" stroke-width="1.6" opacity="0.6" marker-end="url(#la-prodcol-arrow-step)" />
		<text x={(panelX(0) + PANEL_W + panelX(1)) / 2} y={PANEL_Y + PANEL_H / 2 - 10} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>apply A</text>
		<text x={(panelX(0) + PANEL_W + panelX(1)) / 2} y={PANEL_Y + PANEL_H / 2 + 24} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.6">[[2, 0], [0, 1]]</text>
	</svg>
	<figcaption>The product AB is not magic. Column by column: take each column of B, treat it as a vector, apply A, and the result is that column of AB. The first column of AB is what A does to the first column of B; the second is what A does to the second.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

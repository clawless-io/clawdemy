---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 10, illustration 1 of 2.
 *
 * The 2D cross product as the signed area of the parallelogram spanned by
 * v and w, with sign determined by the orientation. v = [3, 1], w = [1, 2].
 * Area = |3·2 - 1·1| = 5. The turn from v to w is counter-clockwise, so
 * the signed area is +5 (positive orientation). A curved arrow inside the
 * parallelogram marks the direction of the turn.
 */

const cx = 200;
const cy = 270;
const u = 55;

const X_MIN = -1;
const X_MAX = 5;
const Y_MIN = -1;
const Y_MAX = 4;

const sx = (gx: number) => cx + gx * u;
const sy = (gy: number) => cy - gy * u;

const xs: number[] = [];
for (let i = X_MIN; i < X_MAX + 1; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j < Y_MAX + 1; j++) ys.push(j);

const v = { x: 3, y: 1 };
const w = { x: 1, y: 2 };
const det = v.x * w.y - v.y * w.x;

// curve from a point on v to a point on w (CCW), for the orientation marker
const midV = { x: v.x * 0.45, y: v.y * 0.45 };
const midW = { x: w.x * 0.45, y: w.y * 0.45 };
const arcRadius = 28;

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-cross2d-title la-cross2d-desc">
		<title id="la-cross2d-title">The 2D cross product as the signed area of the parallelogram spanned by v and w</title>
		<desc id="la-cross2d-desc">A two-dimensional coordinate grid. A teal arrow shows v equals [3, 1] from the origin; an amber arrow shows w equals [1, 2] from the origin. Together they span a parallelogram with corners at the origin, [3, 1], [4, 3], and [1, 2], filled in light accent purple. A curved purple arrow inside the parallelogram traces a counter-clockwise turn from v toward w, indicating positive orientation. The area is labeled 5 in the parallelogram's center, equal to v cross w equals 3 times 2 minus 1 times 1.</desc>

		<defs>
			<marker id="la-cross2d-arrow-v" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-cross2d-arrow-w" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
			<marker id="la-cross2d-arrow-curve" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		{xs.map((i) => <line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		{ys.map((j) => <line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		{/* parallelogram */}
		<path d={`M ${sx(0)} ${sy(0)} L ${sx(v.x)} ${sy(v.y)} L ${sx(v.x + w.x)} ${sy(v.y + w.y)} L ${sx(w.x)} ${sy(w.y)} Z`} fill={ACCENT} fill-opacity="0.18" stroke={ACCENT} stroke-width="1.4" />

		{/* CCW orientation arc */}
		<path d={`M ${sx(midV.x)} ${sy(midV.y)} A ${arcRadius} ${arcRadius} 0 0 0 ${sx(midW.x)} ${sy(midW.y)}`} fill="none" stroke={ACCENT} stroke-width="2" marker-end="url(#la-cross2d-arrow-curve)" />

		{/* the two vectors */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(v.x)} y2={sy(v.y)} stroke={TEAL} stroke-width="2.8" marker-end="url(#la-cross2d-arrow-v)" />
		<line x1={sx(0)} y1={sy(0)} x2={sx(w.x)} y2={sy(w.y)} stroke={AMBER} stroke-width="2.8" marker-end="url(#la-cross2d-arrow-w)" />

		<circle cx={sx(0)} cy={sy(0)} r="3" fill="currentColor" />

		<text x={sx(v.x) + 8} y={sy(v.y) + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>v = [3, 1]</text>
		<text x={sx(w.x) - 8} y={sy(w.y) - 6} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={AMBER}>w = [1, 2]</text>

		<text x={sx((v.x + w.x) / 2)} y={sy((v.y + w.y) / 2) + 4} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="15" font-weight="700" fill={ACCENT}>area = {det}</text>

		{/* legend */}
		<g transform="translate(450, 80)">
			<rect x="0" y="0" width="260" height="120" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="260" height="120" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="130" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">2D cross product:</text>
			<text x="130" y="48" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor">
				v × w = v<tspan baseline-shift="sub" font-size="9">x</tspan>w<tspan baseline-shift="sub" font-size="9">y</tspan> - v<tspan baseline-shift="sub" font-size="9">y</tspan>w<tspan baseline-shift="sub" font-size="9">x</tspan>
			</text>
			<text x="130" y="72" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor" opacity="0.8">
				= 3·2 - 1·1 = {det}
			</text>
			<text x="130" y="100" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={ACCENT}>
				CCW turn from v to w → +
			</text>
		</g>
	</svg>
	<figcaption>Two vectors from the origin span a parallelogram; the 2D cross product v cross w is its signed area. The sign is positive when the turn from v to w goes counter-clockwise (as here) and negative when it goes clockwise. The number 5 is both the area and the cross product.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 6, illustration 3 of 3.
 *
 * Five worked-example panels showing the determinant of five small 2x2
 * matrices: a 3x2 axis-aligned stretch (det 6), a 30 degree rotation
 * (det 1), a collapse to a line (det 0), a reflection across x (det -1),
 * and a horizontal shear (det 1). Same source unit square in each; the
 * transformed shape is what differs, and its signed area is the det.
 */

const PANEL_W = 144;
const PANEL_GAP = 4;
const u = 18;
const cyP = 200;

type Example = {
	idx: number;
	label: string;
	det: string; // pre-rendered numeric string
	corners: { x: number; y: number }[];
	fill: string;
};

const cos30 = 0.8660254;
const sin30 = 0.5;

const examples: Example[] = [
	{
		idx: 0,
		label: 'L = [[3, 0], [0, 2]]',
		det: '6',
		corners: [
			{ x: 0, y: 0 },
			{ x: 3, y: 0 },
			{ x: 3, y: 2 },
			{ x: 0, y: 2 },
		],
		fill: '#7c3aed',
	},
	{
		idx: 1,
		label: 'rotation 30°',
		det: '1',
		corners: [
			{ x: 0, y: 0 },
			{ x: cos30, y: sin30 },
			{ x: cos30 - sin30, y: sin30 + cos30 },
			{ x: -sin30, y: cos30 },
		],
		fill: '#0d9488',
	},
	{
		idx: 2,
		label: 'collapsed (degenerate)',
		det: '0',
		corners: [
			{ x: 0, y: 0 },
			{ x: 2, y: 2 },
			{ x: 3, y: 3 },
			{ x: 1, y: 1 },
		],
		fill: '#ef4444', // red for the degenerate case
	},
	{
		idx: 3,
		label: 'reflected across x',
		det: '-1',
		corners: [
			{ x: 0, y: 0 },
			{ x: 1, y: 0 },
			{ x: 1, y: -1 },
			{ x: 0, y: -1 },
		],
		fill: '#d97706',
	},
	{
		idx: 4,
		label: 'sheared L = [[1, 1], [0, 1]]',
		det: '1',
		corners: [
			{ x: 0, y: 0 },
			{ x: 1, y: 0 },
			{ x: 2, y: 1 },
			{ x: 1, y: 1 },
		],
		fill: '#0284c7',
	},
];

const X_MIN = -2;
const X_MAX = 4;
const Y_MIN = -2;
const Y_MAX = 3;

const xs: number[] = [];
for (let i = X_MIN; i < X_MAX + 1; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j < Y_MAX + 1; j++) ys.push(j);
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-det5-title la-det5-desc">
		<title id="la-det5-title">Five worked examples of the determinant: stretch, rotation, collapse, reflection, shear</title>
		<desc id="la-det5-desc">Five small side-by-side panels, each showing what the unit square becomes under a different 2x2 matrix, with the determinant labeled below. Panel 1: a 3 by 2 axis-aligned rectangle, determinant 6 because area is 3 times 2. Panel 2: a unit square rotated 30 degrees, determinant 1 because rotations preserve area. Panel 3: the unit square collapsed to a line along y equals x because both columns are collinear, determinant 0 in red. Panel 4: the unit square reflected below the x axis, determinant negative 1 because the orientation flips. Panel 5: a sheared parallelogram, determinant 1 because the same base and height give the same area.</desc>

		{examples.map((e) => {
			const px = 20 + e.idx * (PANEL_W + PANEL_GAP);
			const cxP = px + PANEL_W / 2;
			const sx = (gx: number) => cxP + gx * u;
			const sy = (gy: number) => cyP - gy * u;
			return (
				<g>
					{/* panel frame */}
					<rect x={px + 2} y={42} width={PANEL_W - 4} height={296} rx="6" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.22" />

					{/* grid */}
					{xs.map((i) => <line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
					{ys.map((j) => <line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
					<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="0.8" opacity="0.45" />
					<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.8" opacity="0.45" />

					{/* shape */}
					<path d={`M ${sx(e.corners[0].x)} ${sy(e.corners[0].y)} L ${sx(e.corners[1].x)} ${sy(e.corners[1].y)} L ${sx(e.corners[2].x)} ${sy(e.corners[2].y)} L ${sx(e.corners[3].x)} ${sy(e.corners[3].y)} Z`} fill={e.fill} fill-opacity="0.22" stroke={e.fill} stroke-width="1.4" />

					{/* faint reference unit square */}
					<rect x={sx(0)} y={sy(1)} width={u} height={u} fill="none" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 2" opacity="0.35" />

					<circle cx={sx(0)} cy={sy(0)} r="2.2" fill="currentColor" />

					{/* label */}
					<text x={cxP} y={32} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="9" fill="currentColor" opacity="0.7">{e.label}</text>

					{/* det value */}
					<text x={cxP} y={335} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" font-weight="700" fill={e.fill}>det = {e.det}</text>
				</g>
			);
		})}
	</svg>
	<figcaption>Five matrices, five fates for the unit square. The determinant reports the signed area of the image: positive when orientation is preserved, negative when it flips, zero when the image collapses to a line or a point. Rotation and shear both leave area at 1 because they neither stretch nor flip.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

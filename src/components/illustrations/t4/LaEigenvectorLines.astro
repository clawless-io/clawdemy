---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 14, illustration 3 of 3.
 *
 * The two eigenvector lines for M = [[3, 1], [0, 2]]. The x-axis is one
 * eigenvector line, with eigenvalue 3 (vectors there get stretched by 3).
 * The line through (1, -1) is the other, with eigenvalue 2 (vectors there
 * get stretched by 2). Sample vectors on each line are drawn at input
 * length 1 and output length λ, making the stretch factor explicit.
 */

const cx = 380;
const cy = 200;
const u = 38;

const X_MIN = -3;
const X_MAX = 5;
const Y_MIN = -3;
const Y_MAX = 3;

const sx = (gx: number) => cx + gx * u;
const sy = (gy: number) => cy - gy * u;

const xs: number[] = [];
for (let i = X_MIN; i < X_MAX + 1; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j < Y_MAX + 1; j++) ys.push(j);

// Eigenvalue λ1 = 3, eigenvector direction [1, 0] (along x-axis).
// Eigenvalue λ2 = 2, eigenvector direction [1, -1].

const LINE_EXT = 4;
const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-eiglines-title la-eiglines-desc">
		<title id="la-eiglines-title">The two eigenvector lines for M = [[3, 1], [0, 2]]: x-axis with eigenvalue 3 and line through (1, -1) with eigenvalue 2</title>
		<desc id="la-eiglines-desc">A two-dimensional coordinate grid. A dashed teal line runs along the x-axis: this is the eigenvector line for eigenvalue 3. A dashed amber line runs through the origin at 45 degrees through (1, -1): this is the eigenvector line for eigenvalue 2. On each line, an input vector of length 1 (faint) and the matching output vector of length lambda (bold) are drawn: along x, input [1, 0] maps to output [3, 0]; along the diagonal, input [1, -1] maps to output [2, -2]. Legend explains M times v equals lambda times v at eigenvectors.</desc>

		<defs>
			<marker id="la-eigl-arrow-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-eigl-arrow-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
			<marker id="la-eigl-arrow-faint-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} opacity="0.5" />
			</marker>
			<marker id="la-eigl-arrow-faint-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} opacity="0.5" />
			</marker>
		</defs>

		{xs.map((i) => <line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		{ys.map((j) => <line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		{/* eigen-line 1: x-axis (teal dashed) */}
		<line x1={sx(-LINE_EXT)} y1={sy(0)} x2={sx(LINE_EXT)} y2={sy(0)} stroke={TEAL} stroke-width="1.6" stroke-dasharray="6 4" opacity="0.7" />

		{/* eigen-line 2: line through (1, -1), so y = -x. Amber dashed. */}
		<line x1={sx(-LINE_EXT)} y1={sy(LINE_EXT)} x2={sx(LINE_EXT)} y2={sy(-LINE_EXT)} stroke={AMBER} stroke-width="1.6" stroke-dasharray="6 4" opacity="0.7" />

		{/* sample on line 1: input [1, 0] (faint), output [3, 0] (bold) */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(1)} y2={sy(0)} stroke={TEAL} stroke-width="2" opacity="0.55" marker-end="url(#la-eigl-arrow-faint-t)" />
		<line x1={sx(0)} y1={sy(0)} x2={sx(3)} y2={sy(0)} stroke={TEAL} stroke-width="3" marker-end="url(#la-eigl-arrow-t)" />

		{/* sample on line 2: input [1, -1] (faint), output [2, -2] (bold) */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(1)} y2={sy(-1)} stroke={AMBER} stroke-width="2" opacity="0.55" marker-end="url(#la-eigl-arrow-faint-a)" />
		<line x1={sx(0)} y1={sy(0)} x2={sx(2)} y2={sy(-2)} stroke={AMBER} stroke-width="3" marker-end="url(#la-eigl-arrow-a)" />

		<circle cx={sx(0)} cy={sy(0)} r="3" fill="currentColor" />

		<text x={sx(3) + 6} y={sy(0) - 8} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={TEAL}>output [3, 0]</text>
		<text x={sx(1) + 6} y={sy(0) + 18} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={TEAL} opacity="0.7">input [1, 0]</text>

		<text x={sx(2) + 6} y={sy(-2) - 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={AMBER}>output [2, -2]</text>
		<text x={sx(1) + 6} y={sy(-1) - 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={AMBER} opacity="0.7">input [1, -1]</text>

		{/* line labels */}
		<text x={sx(LINE_EXT) - 4} y={sy(0) - 6} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={TEAL}>eigen line, λ = 3</text>
		<text x={sx(-LINE_EXT) + 4} y={sy(LINE_EXT) - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={AMBER}>eigen line, λ = 2</text>

		{/* legend */}
		<g transform="translate(40, 280)">
			<rect x="0" y="0" width="420" height="56" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="420" height="56" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="210" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.7">at eigenvectors, M acts like a scalar:</text>
			<text x="210" y="44" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>
				M · v = λ · v
			</text>
		</g>
	</svg>
	<figcaption>For M = [[3, 1], [0, 2]] the eigenvector lines are the x-axis (stretching by 3) and the line through (1, -1) (stretching by 2). On these two lines and only these two, M acts like a plain scalar: the output is the input rescaled, never rotated off its line.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 3, illustration 2 of 3.
 *
 * Why a linear transformation is determined by what it does to the basis.
 * Left panel: the source frame with v = [1, 2] = 1·i-hat + 2·j-hat. Right
 * panel: after L, the basis lands at L(i-hat) and L(j-hat); the same
 * arithmetic, 1·L(i-hat) + 2·L(j-hat), reassembles L(v). The transformed
 * grid sits behind so the geometry of where each basis went is visible.
 */

const PANEL_W = 340;
const PANEL_X1 = 20;
const PANEL_X2 = 380;
const cyP = 200;
const u = 32;

// Matrix L = [[2, 1], [-1, 1]] applied as L(x, y) = (2x + y, -x + y).
// L(i-hat) = (2, -1), L(j-hat) = (1, 1), L([1, 2]) = (4, 1).
const Lx = (x: number, y: number) => 2 * x + 1 * y;
const Ly = (x: number, y: number) => -1 * x + 1 * y;

const v = { x: 1, y: 2 };
const Li = { x: 2, y: -1 };
const Lj = { x: 1, y: 1 };
const Lv = { x: Lx(v.x, v.y), y: Ly(v.x, v.y) };

const RANGE_BEFORE = 3;

const ticksBefore: number[] = [];
for (let i = -RANGE_BEFORE; i <= RANGE_BEFORE; i++) ticksBefore.push(i);

// Center each panel.
function panelOrigin(idx: 0 | 1) {
	const px = idx === 0 ? PANEL_X1 : PANEL_X2;
	return { X: px + PANEL_W / 2 - 30, Y: cyP };
}

const o0 = panelOrigin(0);
const o1 = panelOrigin(1);
const sxP0 = (gx: number) => o0.X + gx * u;
const syP0 = (gy: number) => o0.Y - gy * u;
const sxP1 = (gx: number) => o1.X + gx * u * 0.78; // squeeze the after panel a bit so the bigger range fits
const syP1 = (gy: number) => o1.Y - gy * u * 0.78;

// Transformed-grid lines for the right panel. Each source line is straight
// under L (the linearity is the point), so endpoints suffice.
const afterHorz: string[] = [];
for (const i of ticksBefore) {
	const p1 = { x: Lx(-RANGE_BEFORE, i), y: Ly(-RANGE_BEFORE, i) };
	const p2 = { x: Lx(RANGE_BEFORE, i), y: Ly(RANGE_BEFORE, i) };
	afterHorz.push(`M ${sxP1(p1.x)} ${syP1(p1.y)} L ${sxP1(p2.x)} ${syP1(p2.y)}`);
}
const afterVert: string[] = [];
for (const j of ticksBefore) {
	const p1 = { x: Lx(j, -RANGE_BEFORE), y: Ly(j, -RANGE_BEFORE) };
	const p2 = { x: Lx(j, RANGE_BEFORE), y: Ly(j, RANGE_BEFORE) };
	afterVert.push(`M ${sxP1(p1.x)} ${syP1(p1.y)} L ${sxP1(p2.x)} ${syP1(p2.y)}`);
}

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-by-basis-title la-by-basis-desc">
		<title id="la-by-basis-title">A linear transformation is determined by what it does to the basis</title>
		<desc id="la-by-basis-desc">Two side-by-side panels showing the same vector v equals 1 times i-hat plus 2 times j-hat before and after a linear transformation L. The left panel shows the source frame with a teal i-hat, an amber j-hat, and a purple v at [1, 2]. The right panel shows the transformed frame, with L of i-hat landing at [2, negative 1], L of j-hat landing at [1, 1], and L of v landing at [4, 1], computed as 1 times L of i-hat plus 2 times L of j-hat. The transformed grid lines sit behind in faint color, showing where the source grid lands.</desc>

		<defs>
			<marker id="la-byb-arrow-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-byb-arrow-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
			<marker id="la-byb-arrow-p" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		{/* panel 1: before */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.85">BEFORE</text>

		{ticksBefore.map((i) => (
			<line x1={sxP0(-RANGE_BEFORE)} y1={syP0(i)} x2={sxP0(RANGE_BEFORE)} y2={syP0(i)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
		))}
		{ticksBefore.map((j) => (
			<line x1={sxP0(j)} y1={syP0(-RANGE_BEFORE)} x2={sxP0(j)} y2={syP0(RANGE_BEFORE)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
		))}
		<line x1={sxP0(-RANGE_BEFORE)} y1={syP0(0)} x2={sxP0(RANGE_BEFORE)} y2={syP0(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sxP0(0)} y1={syP0(-RANGE_BEFORE)} x2={sxP0(0)} y2={syP0(RANGE_BEFORE)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		<line x1={sxP0(0)} y1={syP0(0)} x2={sxP0(1)} y2={syP0(0)} stroke={TEAL} stroke-width="3" marker-end="url(#la-byb-arrow-t)" />
		<line x1={sxP0(0)} y1={syP0(0)} x2={sxP0(0)} y2={syP0(1)} stroke={AMBER} stroke-width="3" marker-end="url(#la-byb-arrow-a)" />
		<line x1={sxP0(0)} y1={syP0(0)} x2={sxP0(v.x)} y2={syP0(v.y)} stroke={ACCENT} stroke-width="2.6" marker-end="url(#la-byb-arrow-p)" />
		<circle cx={sxP0(0)} cy={syP0(0)} r="2.6" fill="currentColor" />

		<text x={sxP0(1) + 6} y={syP0(0) - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={TEAL}>î</text>
		<text x={sxP0(0) + 6} y={syP0(1) + 2} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={AMBER}>ĵ</text>
		<text x={sxP0(v.x) + 6} y={syP0(v.y) - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>v = î + 2ĵ</text>

		{/* panel 2: after */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>AFTER L</text>

		{/* transformed grid, faint */}
		{afterHorz.map((d) => <path d={d} fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.13" />)}
		{afterVert.map((d) => <path d={d} fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.13" />)}

		<circle cx={sxP1(0)} cy={syP1(0)} r="2.6" fill="currentColor" />

		<line x1={sxP1(0)} y1={syP1(0)} x2={sxP1(Li.x)} y2={syP1(Li.y)} stroke={TEAL} stroke-width="3" marker-end="url(#la-byb-arrow-t)" />
		<line x1={sxP1(0)} y1={syP1(0)} x2={sxP1(Lj.x)} y2={syP1(Lj.y)} stroke={AMBER} stroke-width="3" marker-end="url(#la-byb-arrow-a)" />
		<line x1={sxP1(0)} y1={syP1(0)} x2={sxP1(Lv.x)} y2={syP1(Lv.y)} stroke={ACCENT} stroke-width="2.6" marker-end="url(#la-byb-arrow-p)" />

		<text x={sxP1(Li.x) + 6} y={syP1(Li.y) + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={TEAL}>L(î) = [2, -1]</text>
		<text x={sxP1(Lj.x) + 6} y={syP1(Lj.y) - 8} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={AMBER}>L(ĵ) = [1, 1]</text>
		<text x={sxP1(Lv.x) - 4} y={syP1(Lv.y) - 10} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>L(v) = [4, 1]</text>

		{/* reassembly equation */}
		<text x={PANEL_X2 + PANEL_W / 2} y={325} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.75">L(v) = 1·L(î) + 2·L(ĵ)</text>
	</svg>
	<figcaption>The same arithmetic that built v from î and ĵ rebuilds L(v) from L(î) and L(ĵ). Track where the two basis vectors land, and the whole transformation follows. That is why a 2x2 matrix, just two columns naming L(î) and L(ĵ), is enough to encode any 2D linear transformation.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

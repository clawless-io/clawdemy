---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 9, illustration 1 of 3.
 *
 * Perpendicularity from the dot product. [1, 1] and [1, -1] are mutually
 * perpendicular; their dot product is 1·1 + 1·(-1) = 0. The right-angle
 * square at the origin where the two vectors meet makes the geometric
 * fact visible; the arithmetic in the legend confirms it numerically.
 */

const cx = 360;
const cy = 200;
const u = 50;

const X_MIN = -3;
const X_MAX = 3;
const Y_MIN = -3;
const Y_MAX = 3;

const sx = (gx: number) => cx + gx * u;
const sy = (gy: number) => cy - gy * u;

const xs: number[] = [];
for (let i = X_MIN; i < X_MAX + 1; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j < Y_MAX + 1; j++) ys.push(j);

const v = { x: 1, y: 1 };
const w = { x: 1, y: -1 };
const dot = v.x * w.x + v.y * w.y;

// right-angle marker at origin between v and w directions.
// Compute unit vectors along v and w, scale by 0.4, get inner square corners.
const lenV = Math.hypot(v.x, v.y);
const lenW = Math.hypot(w.x, w.y);
const k = 0.35;
const tickV = { x: (v.x / lenV) * k, y: (v.y / lenV) * k };
const tickW = { x: (w.x / lenW) * k, y: (w.y / lenW) * k };
const tickCorner = { x: tickV.x + tickW.x, y: tickV.y + tickW.y };
const rightAnglePath = `M ${sx(tickV.x)} ${sy(tickV.y)} L ${sx(tickCorner.x)} ${sy(tickCorner.y)} L ${sx(tickW.x)} ${sy(tickW.y)}`;

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-dot0-title la-dot0-desc">
		<title id="la-dot0-title">Two perpendicular vectors meet at a right angle and their dot product is zero</title>
		<desc id="la-dot0-desc">A two-dimensional coordinate grid. A teal arrow shows the vector [1, 1] from the origin pointing up and to the right; an amber arrow shows [1, -1] from the origin pointing down and to the right. The two arrows meet at the origin at a 90 degree angle, with a small right-angle square marker showing the perpendicularity. A legend computes [1, 1] dot [1, -1] equals 1 times 1 plus 1 times negative 1 equals 0, the arithmetic confirmation that perpendicular vectors dot to 0.</desc>

		<defs>
			<marker id="la-dot0-arrow-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-dot0-arrow-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
		</defs>

		{xs.map((i) => <line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		{ys.map((j) => <line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		<line x1={sx(0)} y1={sy(0)} x2={sx(2.2 * v.x)} y2={sy(2.2 * v.y)} stroke={TEAL} stroke-width="2.6" marker-end="url(#la-dot0-arrow-t)" />
		<line x1={sx(0)} y1={sy(0)} x2={sx(2.2 * w.x)} y2={sy(2.2 * w.y)} stroke={AMBER} stroke-width="2.6" marker-end="url(#la-dot0-arrow-a)" />

		<path d={rightAnglePath} fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.7" />

		<circle cx={sx(0)} cy={sy(0)} r="3" fill="currentColor" />

		<text x={sx(2.2 * v.x) + 6} y={sy(2.2 * v.y) - 8} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>v = [1, 1]</text>
		<text x={sx(2.2 * w.x) + 6} y={sy(2.2 * w.y) + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={AMBER}>w = [1, -1]</text>

		{/* legend */}
		<g transform="translate(60, 280)">
			<rect x="0" y="0" width="280" height="56" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="280" height="56" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="140" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">perpendicularity check:</text>
			<text x="140" y="44" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>
				<tspan fill={TEAL}>[1, 1]</tspan> · <tspan fill={AMBER}>[1, -1]</tspan> = 1·1 + 1·(-1) = {dot}
			</text>
		</g>
	</svg>
	<figcaption>Two vectors are perpendicular exactly when their dot product is zero. Here the angle is 90 degrees, and the arithmetic agrees: 1 times 1 plus 1 times negative 1 equals 0. The right-angle in the picture and the zero in the calculation are the same fact.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

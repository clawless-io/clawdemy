---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 15, illustration 1 of 2.
 *
 * A polynomial drawn as a curve, with its coordinate vector in the basis
 * {1, x, x², x³} shown alongside. f(x) = 2x² + 5x + 7 has coordinates
 * [7, 5, 2, 0]: a 7 in the 1-slot, a 5 in the x-slot, a 2 in the x²-slot,
 * and a 0 in the x³-slot. The curve and the column of numbers are the
 * same object in two representations.
 */

const PANEL_W = 320;
const PANEL_X1 = 40;
const PANEL_X2 = 420;
const cy0 = 215;
const u0 = 30;
const o0X = PANEL_X1 + 30;

const X_MIN = -5;
const X_MAX = 2;
const Y_MIN = -2;
const Y_MAX = 14;

const sx0 = (gx: number) => o0X + (gx - X_MIN) * u0;
const sy0 = (gy: number) => cy0 - (gy - (Y_MIN + Y_MAX) / 2) * (200 / (Y_MAX - Y_MIN));

// the polynomial f(x) = 2x² + 5x + 7
function f(x: number): number {
	return 2 * x * x + 5 * x + 7;
}

const SAMPLES = 50;
const points: { X: number; Y: number }[] = [];
for (let i = 0; i <= SAMPLES; i++) {
	const x = X_MIN + ((X_MAX - X_MIN) * i) / SAMPLES;
	const y = f(x);
	points.push({ X: sx0(x), Y: sy0(y) });
}
const polyPath = points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.X.toFixed(1)} ${p.Y.toFixed(1)}`).join(' ');

const xs: number[] = [];
for (let i = X_MIN; i < X_MAX + 1; i++) xs.push(i);
const ysGrid: number[] = [];
for (let j = Math.ceil(Y_MIN / 2) * 2; j <= Y_MAX; j += 2) ysGrid.push(j);

const coords = [7, 5, 2, 0];
const labels = ['1', 'x', 'x²', 'x³'];

const ACCENT = '#7c3aed';
const TEAL = '#0d9488';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-polyvec-title la-polyvec-desc">
		<title id="la-polyvec-title">A polynomial as a curve and as a coordinate vector in the basis 1, x, x², x³</title>
		<desc id="la-polyvec-desc">Two side-by-side panels showing the polynomial f equal to 2 x-squared plus 5 x plus 7. The left panel is a coordinate grid with the parabola drawn from x equals negative 5 to x equals 2; it is a U-shape opening upward, passing through about (0, 7) and dipping near x equals negative 1. The right panel shows the coordinate vector [7, 5, 2, 0] in a tall typeset column, with the basis labels "1", "x", "x squared", "x cubed" to the right of each entry. A double-headed arrow between the panels labeled "same object" links the two representations.</desc>

		<defs>
			<marker id="la-pv-arrow-s" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 10 0 L 0 5 L 10 10 z" fill={ACCENT} />
			</marker>
			<marker id="la-pv-arrow-e" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		{/* left panel: curve */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>f(x) = 2x² + 5x + 7</text>

		{xs.map((i) => <line x1={sx0(i)} y1={sy0(Y_MAX)} x2={sx0(i)} y2={sy0(Y_MIN)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
		{ysGrid.map((j) => <line x1={sx0(X_MIN)} y1={sy0(j)} x2={sx0(X_MAX)} y2={sy0(j)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
		<line x1={sx0(X_MIN)} y1={sy0(0)} x2={sx0(X_MAX)} y2={sy0(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx0(0)} y1={sy0(Y_MAX)} x2={sx0(0)} y2={sy0(Y_MIN)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		<path d={polyPath} fill="none" stroke={ACCENT} stroke-width="2.4" />

		<text x={sx0(X_MAX) + 4} y={sy0(0) + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.65">x</text>
		<text x={sx0(0) + 6} y={sy0(Y_MAX) + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.65">f(x)</text>

		{/* connector arrow */}
		<line x1={PANEL_X1 + PANEL_W + 8} y1={180} x2={PANEL_X2 - 8} y2={180} stroke={ACCENT} stroke-width="2" marker-start="url(#la-pv-arrow-s)" marker-end="url(#la-pv-arrow-e)" />
		<text x={(PANEL_X1 + PANEL_W + PANEL_X2) / 2} y={170} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>same object</text>
		<text x={(PANEL_X1 + PANEL_W + PANEL_X2) / 2} y={200} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.6">two notations</text>

		{/* right panel: coordinate vector */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>coordinate vector</text>

		{/* big square brackets */}
		<g transform={`translate(${PANEL_X2 + PANEL_W / 2 - 50}, 80)`}>
			<text x="0" y="120" font-family="ui-monospace, SFMono-Regular, monospace" font-size="160" font-weight="200" fill={ACCENT}>[</text>
			{coords.map((c, idx) => (
				<text x="36" y={50 + idx * 42} font-family="ui-monospace, SFMono-Regular, monospace" font-size="28" font-weight="700" fill={ACCENT}>{c}</text>
			))}
			{labels.map((lbl, idx) => (
				<text x="82" y={50 + idx * 42} font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" fill={TEAL}>← {lbl}</text>
			))}
			<text x="62" y="120" font-family="ui-monospace, SFMono-Regular, monospace" font-size="160" font-weight="200" fill={ACCENT} text-anchor="end" transform="translate(126, 0)">]</text>
		</g>

		<text x={PANEL_X2 + PANEL_W / 2} y={328} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.7">basis: 1, x, x², x³</text>
	</svg>
	<figcaption>Take the polynomial 2x² + 5x + 7 as one object. As a function it draws a parabola. As coordinates in the basis 1, x, x², x³, it is the column [7, 5, 2, 0]. Same object, two notations; the bridge is the chosen basis.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

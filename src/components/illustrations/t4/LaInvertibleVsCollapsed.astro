---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 7, illustration 1 of 2.
 *
 * Invertible versus collapsed. Left panel: an invertible transformation
 * (a shear-with-scale, det = 2), the full plane maps to the full plane,
 * every input has a unique output. Right panel: a collapsed transformation
 * with rank 1 (det = 0), the entire 2D plane is squashed onto a single
 * line. Two different vectors land on the same output; the transformation
 * cannot be undone.
 */

const PANEL_W = 340;
const PANEL_X1 = 20;
const PANEL_X2 = 380;
const cyP = 195;
const u = 30;

const RANGE = 3;
const SAMPLES = 1; // linear, so 1 sample per line is enough

// Left: invertible. L = [[1.4, 0.4], [0.2, 1.3]], det = 1.4*1.3 - 0.4*0.2 = 1.74.
function inv(x: number, y: number): { x: number; y: number } {
	return { x: 1.4 * x + 0.4 * y, y: 0.2 * x + 1.3 * y };
}
// Right: collapsed (rank 1). L = [[1, 2], [1, 2]], every output lands on y = x.
function col(x: number, y: number): { x: number; y: number } {
	return { x: x + 2 * y, y: x + 2 * y };
}

const ticks: number[] = [];
for (let i = -RANGE; i < RANGE + 1; i++) ticks.push(i);

function gridPaths(transform: (x: number, y: number) => { x: number; y: number }, cx: number, cyP_: number) {
	const horz: string[] = [];
	for (const i of ticks) {
		const a = transform(-RANGE, i);
		const b = transform(RANGE, i);
		horz.push(`M ${(cx + a.x * u).toFixed(1)} ${(cyP_ - a.y * u).toFixed(1)} L ${(cx + b.x * u).toFixed(1)} ${(cyP_ - b.y * u).toFixed(1)}`);
	}
	const vert: string[] = [];
	for (const j of ticks) {
		const a = transform(j, -RANGE);
		const b = transform(j, RANGE);
		vert.push(`M ${(cx + a.x * u).toFixed(1)} ${(cyP_ - a.y * u).toFixed(1)} L ${(cx + b.x * u).toFixed(1)} ${(cyP_ - b.y * u).toFixed(1)}`);
	}
	return { horz, vert };
}

const o0X = PANEL_X1 + PANEL_W / 2;
const o1X = PANEL_X2 + PANEL_W / 2;

const invGrid = gridPaths(inv, o0X, cyP);
const colGrid = gridPaths(col, o1X, cyP);

const TEAL = '#0d9488';
const RED = '#ef4444';

void SAMPLES;
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-invcol-title la-invcol-desc">
		<title id="la-invcol-title">Invertible versus collapsed: full plane to full plane versus plane to line</title>
		<desc id="la-invcol-desc">Two side-by-side panels. The left panel shows an invertible transformation: the source grid is mapped to a sheared, still-2D grid covering the full plane, with the determinant equal to 1.74. The right panel shows a collapsed rank-one transformation: the entire 2D source grid is squashed onto a single line through the origin, with determinant equal to 0. The right caption notes "many inputs land on the same output" because the transformation cannot be inverted.</desc>

		{/* panel 1: invertible */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>INVERTIBLE</text>
		<text x={PANEL_X1 + PANEL_W / 2} y={60} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.7">full plane → full plane (det ≠ 0)</text>

		{invGrid.horz.map((d) => <path d={d} fill="none" stroke={TEAL} stroke-width="1" opacity="0.7" />)}
		{invGrid.vert.map((d) => <path d={d} fill="none" stroke={TEAL} stroke-width="1" opacity="0.7" />)}

		<text x={PANEL_X1 + PANEL_W / 2} y={324} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={TEAL}>det = 1.74</text>

		{/* panel 2: collapsed */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={RED}>COLLAPSED</text>
		<text x={PANEL_X2 + PANEL_W / 2} y={60} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.7">plane → line (det = 0; many inputs land on the same output)</text>

		{colGrid.horz.map((d) => <path d={d} fill="none" stroke={RED} stroke-width="1.4" opacity="0.7" />)}
		{colGrid.vert.map((d) => <path d={d} fill="none" stroke={RED} stroke-width="1.4" opacity="0.7" />)}

		<text x={PANEL_X2 + PANEL_W / 2} y={324} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={RED}>det = 0, NOT invertible</text>
	</svg>
	<figcaption>If a transformation keeps the grid spread across the full plane, it is invertible: every output traces back to one input. If it crushes the plane onto a line, the transformation is collapsed: many different inputs land on the same output, and there is no way to undo it.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 12, illustration 2 of 2.
 *
 * After applying M = [[3, 1], [1, 2]], the parallelogram from the previous
 * lesson illustration (spanned by [x, y] = [2, 1] and j-hat) becomes the
 * parallelogram spanned by b = M·[x, y] = [7, 4] and L(j-hat) = column 2
 * of M = [1, 2]. Its area is det(M) · x = 5 · 2 = 10. The j-hat column
 * has been REPLACED by b; that is the column-replacement trick at the
 * heart of Cramer's rule.
 */

const cx = 220;
const cy = 285;
const u = 38;

const X_MIN = -1;
const X_MAX = 9;
const Y_MIN = -1;
const Y_MAX = 5;

const sx = (gx: number) => cx + gx * u;
const sy = (gy: number) => cy - gy * u;

const xs: number[] = [];
for (let i = X_MIN; i < X_MAX + 1; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j < Y_MAX + 1; j++) ys.push(j);

// M = [[3, 1], [1, 2]], det(M) = 5
// [x, y] = [2, 1], so x = 2.
// b = M · [2, 1] = [7, 4]
// col2(M) = [1, 2]
// parallelogram: by b and col2(M); area = 7·2 - 4·1 = 10 = det(M) · x = 5·2 = 10.
const b = { x: 7, y: 4 };
const col2 = { x: 1, y: 2 };
const detM = 5;
const xVal = 2;
const area = b.x * col2.y - b.y * col2.x;

const TEAL = '#0d9488';
const ACCENT = '#7c3aed';
const REPLACED = '#be185d';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-cramer2-title la-cramer2-desc">
		<title id="la-cramer2-title">After applying M, the parallelogram is spanned by b and the second column of M, with area det(M) times x</title>
		<desc id="la-cramer2-desc">A two-dimensional coordinate grid. A bold pink arrow shows b equal to M times [x, y] equals [7, 4] from the origin (the j-hat column has been REPLACED by b). A teal arrow shows the second column of M equal to [1, 2] from the origin. Together they span a parallelogram with corners at the origin, [7, 4], [8, 6], and [1, 2], filled in light pink. The label "area = det(M) times x equals 5 times 2 equals 10" sits centrally. The legend explains that this is the column-replacement step in Cramer's rule.</desc>

		<defs>
			<marker id="la-cramer2-arrow-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-cramer2-arrow-b" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={REPLACED} />
			</marker>
		</defs>

		{xs.map((i) => <line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		{ys.map((jj) => <line x1={sx(X_MIN)} y1={sy(jj)} x2={sx(X_MAX)} y2={sy(jj)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		{/* parallelogram */}
		<path d={`M ${sx(0)} ${sy(0)} L ${sx(b.x)} ${sy(b.y)} L ${sx(b.x + col2.x)} ${sy(b.y + col2.y)} L ${sx(col2.x)} ${sy(col2.y)} Z`} fill={REPLACED} fill-opacity="0.18" stroke={REPLACED} stroke-width="1.4" />

		<line x1={sx(0)} y1={sy(0)} x2={sx(b.x)} y2={sy(b.y)} stroke={REPLACED} stroke-width="2.8" marker-end="url(#la-cramer2-arrow-b)" />
		<line x1={sx(0)} y1={sy(0)} x2={sx(col2.x)} y2={sy(col2.y)} stroke={TEAL} stroke-width="3" marker-end="url(#la-cramer2-arrow-t)" />

		<circle cx={sx(0)} cy={sy(0)} r="3" fill="currentColor" />

		<text x={sx(b.x) + 6} y={sy(b.y) - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={REPLACED}>b = M·[x,y] = [7, 4]</text>
		<text x={sx(col2.x) - 6} y={sy(col2.y) - 8} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>col<tspan baseline-shift="sub" font-size="9">2</tspan>(M) = [1, 2]</text>

		<text x={sx((b.x + col2.x) / 2)} y={sy((b.y + col2.y) / 2) + 4} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" font-weight="700" fill={ACCENT}>area = {area}</text>

		{/* legend */}
		<g transform="translate(430, 80)">
			<rect x="0" y="0" width="290" height="160" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="290" height="160" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="145" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">Cramer's column replacement:</text>
			<text x="145" y="48" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor">
				M scales every area by det(M) = {detM}
			</text>
			<text x="145" y="72" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor">
				area_before · det(M) = area_after
			</text>
			<text x="145" y="92" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor" opacity="0.8">
				x · det(M) = {xVal} · {detM} = {area}
			</text>
			<text x="145" y="118" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>
				so x = area / det(M) = {area} / {detM} = {xVal}
			</text>
			<text x="145" y="144" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={REPLACED}>
				ĵ column REPLACED by b
			</text>
		</g>
	</svg>
	<figcaption>Apply M to the previous parallelogram. j-hat lands at column 2 of M, and [x, y] lands at b = M·[x, y]. The new parallelogram is spanned by b and column 2 of M, with area det(M) times x. Divide the new area by det(M), and you recover x. That ratio IS Cramer's rule.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 4, illustration 1 of 3.
 *
 * Matrix multiplication is function composition: AB·v means "apply B to v
 * first, then apply A to the result". Three panels, read right to left.
 * Right: v. Middle: Bv after B is applied. Left: A(Bv) after A is then
 * applied. Arrows between panels carry the matrix names.
 */

const PANEL_W = 220;
const PANEL_GAP = 18;
const PANEL_H = 240;
const PANEL_Y = 60;
const u = 26;

// B = 90 degree counter-clockwise rotation: [[0, -1], [1, 0]].
// A = horizontal stretch by 2: [[2, 0], [0, 1]].
// v = [1, 1]. Bv = [-1, 1]. A(Bv) = [-2, 1].
const v = { x: 1, y: 1 };
const Bv = { x: -1, y: 1 };
const ABv = { x: -2, y: 1 };

const RANGE_LEFT = 3;
const RANGE_MID = 3;
const RANGE_RIGHT = 2;

type PanelDef = {
	idx: 0 | 1 | 2;
	title: string;
	vec: { x: number; y: number };
	label: string;
	color: string;
	range: number;
};

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';

// Read right to left, so panel index 0 is leftmost (final result A(Bv)),
// panel 2 is rightmost (the original v).
const panels: PanelDef[] = [
	{ idx: 0, title: 'A · (B · v)', vec: ABv, label: '[-2, 1]', color: ACCENT, range: RANGE_LEFT },
	{ idx: 1, title: 'B · v', vec: Bv, label: '[-1, 1]', color: AMBER, range: RANGE_MID },
	{ idx: 2, title: 'v', vec: v, label: '[1, 1]', color: TEAL, range: RANGE_RIGHT },
];

function panelX(idx: 0 | 1 | 2) {
	return 20 + idx * (PANEL_W + PANEL_GAP);
}
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-comp-title la-comp-desc">
		<title id="la-comp-title">Matrix multiplication is composition: AB times v means apply B first, then A, reading right to left</title>
		<desc id="la-comp-desc">Three panels read right to left, showing successive stages of applying B then A to a vector v. The rightmost panel shows the original v equal to [1, 1] as a teal arrow. An arrow labeled B points to the middle panel, which shows B times v equal to [negative 1, 1] as an amber arrow, the result of a 90 degree counter-clockwise rotation. A second arrow labeled A points to the left panel, which shows A of B times v equal to [negative 2, 1] as a purple arrow, after a horizontal stretch by 2. The footer notes AB times v equals A times the quantity B times v, with composition reading right to left.</desc>

		<defs>
			<marker id="la-comp-arrow-step" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" opacity="0.7" />
			</marker>
			<marker id="la-comp-arrow-v" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-comp-arrow-bv" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
			<marker id="la-comp-arrow-abv" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		{panels.map((p) => {
			const px = panelX(p.idx);
			const cxP = px + PANEL_W / 2;
			const cyP = PANEL_Y + PANEL_H / 2;
			const sx = (gx: number) => cxP + gx * u;
			const sy = (gy: number) => cyP - gy * u;
			const ticks: number[] = [];
			for (let i = -p.range; i < p.range + 1; i++) ticks.push(i);
			const markerId = p.idx === 2 ? 'la-comp-arrow-v' : p.idx === 1 ? 'la-comp-arrow-bv' : 'la-comp-arrow-abv';
			return (
				<g>
					<rect x={px} y={PANEL_Y} width={PANEL_W} height={PANEL_H} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
					<text x={cxP} y={PANEL_Y - 8} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={p.color}>{p.title}</text>

					{ticks.map((i) => (
						<line x1={sx(-p.range)} y1={sy(i)} x2={sx(p.range)} y2={sy(i)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />
					))}
					{ticks.map((j) => (
						<line x1={sx(j)} y1={sy(-p.range)} x2={sx(j)} y2={sy(p.range)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />
					))}
					<line x1={sx(-p.range)} y1={sy(0)} x2={sx(p.range)} y2={sy(0)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />
					<line x1={sx(0)} y1={sy(-p.range)} x2={sx(0)} y2={sy(p.range)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />

					<line x1={sx(0)} y1={sy(0)} x2={sx(p.vec.x)} y2={sy(p.vec.y)} stroke={p.color} stroke-width="2.6" marker-end={`url(#${markerId})`} />
					<circle cx={sx(0)} cy={sy(0)} r="2.4" fill="currentColor" />
					<text x={cxP} y={PANEL_Y + PANEL_H + 16} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={p.color}>{p.label}</text>
				</g>
			);
		})}

		{/* between-panel labels (composition arrows point right-to-left from v to A(Bv)) */}
		<g>
			{/* arrow from panel 2 (right) to panel 1 (mid): labeled B */}
			<line x1={panelX(2)} y1={PANEL_Y + PANEL_H / 2} x2={panelX(1) + PANEL_W + 4} y2={PANEL_Y + PANEL_H / 2} stroke="currentColor" stroke-width="1.4" opacity="0.55" marker-end="url(#la-comp-arrow-step)" />
			<text x={(panelX(1) + PANEL_W + panelX(2)) / 2} y={PANEL_Y + PANEL_H / 2 - 8} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.8">B</text>
			{/* arrow from panel 1 (mid) to panel 0 (left): labeled A */}
			<line x1={panelX(1)} y1={PANEL_Y + PANEL_H / 2} x2={panelX(0) + PANEL_W + 4} y2={PANEL_Y + PANEL_H / 2} stroke="currentColor" stroke-width="1.4" opacity="0.55" marker-end="url(#la-comp-arrow-step)" />
			<text x={(panelX(0) + PANEL_W + panelX(1)) / 2} y={PANEL_Y + PANEL_H / 2 - 8} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.8">A</text>
		</g>

		{/* footer equation */}
		<text x="370" y="350" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor" opacity="0.85">
			AB · v = A · (B · v), apply <tspan fill={AMBER} font-weight="700">B</tspan> first, then <tspan fill={ACCENT} font-weight="700">A</tspan>
		</text>
	</svg>
	<figcaption>Read the product AB times v from right to left. The vector v meets B first; the result then meets A. That is matrix multiplication as composition. The order matters: A and B are functions and they get to act in turn.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

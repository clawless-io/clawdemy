---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 1, illustration 1 of 3.
 *
 * The canonical vector-as-arrow diagram. A 2D grid with labeled x and y
 * axes, the vector [3, 4] drawn as an arrow from the origin, and the two
 * components 3 and 4 read off the axes via dashed projection lines. This
 * is the visual the rest of the track refers back to whenever a number
 * pair gets called a vector.
 */

const cx = 220; // origin x in svg space
const cy = 285; // origin y in svg space (y goes down in svg)
const u = 48; // pixels per grid unit

const X_MIN = -2;
const X_MAX = 7;
const Y_MIN = -1;
const Y_MAX = 5;

// (gx, gy) in grid units -> svg (X, Y).
const sx = (gx: number) => cx + gx * u;
const sy = (gy: number) => cy - gy * u;

const xs: number[] = [];
for (let i = X_MIN; i <= X_MAX; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j <= Y_MAX; j++) ys.push(j);

// The vector to draw.
const vx = 3;
const vy = 4;

const tipX = sx(vx);
const tipY = sy(vy);
const projXend = { X: tipX, Y: sy(0) };
const projYend = { X: sx(0), Y: tipY };

const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-vec-title la-vec-desc">
		<title id="la-vec-title">The vector [3, 4] drawn as an arrow on a grid with x and y axes</title>
		<desc id="la-vec-desc">A two-dimensional coordinate grid with labeled x and y axes. An arrow starts at the origin and ends at the point (3, 4), drawn in a bold accent color. Dashed gray lines drop from the arrow's tip down to the x-axis at 3 and across to the y-axis at 4, showing how the two components are read off the grid. A label near the arrow's tip reads [3, 4].</desc>

		<defs>
			<marker id="la-vec-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		<!-- grid lines -->
		{xs.map((i) => (
			<line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.6" opacity="0.13" />
		))}
		{ys.map((j) => (
			<line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.6" opacity="0.13" />
		))}

		<!-- axes -->
		<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="1.2" opacity="0.55" />
		<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="1.2" opacity="0.55" />

		<!-- axis tick labels (skip 0) -->
		{xs.filter((i) => i !== 0).map((i) => (
			<text x={sx(i)} y={sy(0) + 16} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.55">{i}</text>
		))}
		{ys.filter((j) => j !== 0).map((j) => (
			<text x={sx(0) - 10} y={sy(j) + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.55">{j}</text>
		))}

		<!-- axis end labels -->
		<text x={sx(X_MAX) + 6} y={sy(0) + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.7">x</text>
		<text x={sx(0) + 6} y={sy(Y_MAX) - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.7">y</text>

		<!-- dashed projections -->
		<line x1={tipX} y1={tipY} x2={projXend.X} y2={projXend.Y} stroke={ACCENT} stroke-width="1.1" stroke-dasharray="4 4" opacity="0.65" />
		<line x1={tipX} y1={tipY} x2={projYend.X} y2={projYend.Y} stroke={ACCENT} stroke-width="1.1" stroke-dasharray="4 4" opacity="0.65" />

		<!-- component labels along axes (bold, in accent) -->
		<text x={sx(vx)} y={sy(0) + 30} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" font-weight="700" fill={ACCENT}>3</text>
		<text x={sx(0) - 26} y={sy(vy) + 5} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" font-weight="700" fill={ACCENT}>4</text>

		<!-- the vector arrow -->
		<line x1={sx(0)} y1={sy(0)} x2={tipX} y2={tipY} stroke={ACCENT} stroke-width="2.8" marker-end="url(#la-vec-arrow)" />

		<!-- origin dot -->
		<circle cx={sx(0)} cy={sy(0)} r="3" fill="currentColor" />

		<!-- tip label -->
		<rect x={tipX + 10} y={tipY - 22} width="58" height="26" rx="4" fill={ACCENT} opacity="0.10" />
		<rect x={tipX + 10} y={tipY - 22} width="58" height="26" rx="4" fill="none" stroke={ACCENT} stroke-width="1.1" />
		<text x={tipX + 39} y={tipY - 4} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>[3, 4]</text>
	</svg>
	<figcaption>A vector is two numbers, [3, 4]. On a grid that means an arrow from the origin to the point three over and four up. The two numbers are exactly the coordinates of the tip; they are also exactly the steps you take to get there.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

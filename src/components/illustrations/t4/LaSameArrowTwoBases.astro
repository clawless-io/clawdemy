---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 13, illustration 1 of 2.
 *
 * Same arrow, two coordinate readouts. The vector pointing from the origin
 * to (3, 1) in standard basis lands at coordinates [3, 1] there, but with
 * Jennifer's basis b1 = [1, 1], b2 = [-1, 1] the same arrow reads as [2, -1].
 * The grid for Jennifer's basis is drawn faintly on top of the standard
 * grid; the arrow is the same physical object, only the numbers change.
 */

const cx = 240;
const cy = 220;
const u = 44;

const X_MIN = -3;
const X_MAX = 5;
const Y_MIN = -2;
const Y_MAX = 4;

const sx = (gx: number) => cx + gx * u;
const sy = (gy: number) => cy - gy * u;

const xs: number[] = [];
for (let i = X_MIN; i < X_MAX + 1; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j < Y_MAX + 1; j++) ys.push(j);

// Jennifer's basis: b1 = (1, 1), b2 = (-1, 1).
const b1 = { x: 1, y: 1 };
const b2 = { x: -1, y: 1 };

// In our basis: vector (3, 1).
const v = { x: 3, y: 1 };
// In Jennifer's basis: [2, -1], i.e. 2 b1 + (-1) b2 = (2 - (-1), 2 + (-1)) wait: 2·(1, 1) + (-1)·(-1, 1) = (2 + 1, 2 - 1) = (3, 1). yes.
const jenCoords = { a: 2, b: -1 };

// Jennifer's grid lines (one in each direction, for -2 to 3).
const JEN_TICK_RANGE = 3;
const jenTicks: number[] = [];
for (let i = -JEN_TICK_RANGE; i < JEN_TICK_RANGE + 1; i++) jenTicks.push(i);

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-2bases-title la-2bases-desc">
		<title id="la-2bases-title">The same arrow has different coordinates in different bases</title>
		<desc id="la-2bases-desc">A two-dimensional coordinate grid. The standard horizontal-and-vertical grid is in faint gray. Overlaid in teal-amber is a tilted second grid for Jennifer's basis with b1 equal to [1, 1] in teal and b2 equal to [-1, 1] in amber. A single purple arrow runs from the origin to the point (3, 1) in standard coordinates. Two labels read: in our basis [3, 1], and in Jennifer's basis [2, -1]. The diagonal Jennifer-grid spacings step exactly one "Jennifer-unit" along each of b1 and b2.</desc>

		<defs>
			<marker id="la-2b-arrow-b1" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-2b-arrow-b2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
			<marker id="la-2b-arrow-v" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		{/* standard grid (very faint) */}
		{xs.map((i) => <line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.5" opacity="0.08" />)}
		{ys.map((j) => <line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.5" opacity="0.08" />)}
		<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="0.9" opacity="0.4" />
		<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.9" opacity="0.4" />

		{/* Jennifer's grid: lines parallel to b1 (passing through k·b2 points) */}
		{jenTicks.map((k) => {
			const ax = -JEN_TICK_RANGE * b1.x + k * b2.x;
			const ay = -JEN_TICK_RANGE * b1.y + k * b2.y;
			const bx = JEN_TICK_RANGE * b1.x + k * b2.x;
			const by = JEN_TICK_RANGE * b1.y + k * b2.y;
			return <line x1={sx(ax)} y1={sy(ay)} x2={sx(bx)} y2={sy(by)} stroke={TEAL} stroke-width="0.8" opacity="0.35" stroke-dasharray="4 3" />;
		})}
		{/* Jennifer's grid: lines parallel to b2 (passing through k·b1 points) */}
		{jenTicks.map((k) => {
			const ax = k * b1.x - JEN_TICK_RANGE * b2.x;
			const ay = k * b1.y - JEN_TICK_RANGE * b2.y;
			const bx = k * b1.x + JEN_TICK_RANGE * b2.x;
			const by = k * b1.y + JEN_TICK_RANGE * b2.y;
			return <line x1={sx(ax)} y1={sy(ay)} x2={sx(bx)} y2={sy(by)} stroke={AMBER} stroke-width="0.8" opacity="0.35" stroke-dasharray="4 3" />;
		})}

		{/* basis vectors b1, b2 (bold) */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(b1.x)} y2={sy(b1.y)} stroke={TEAL} stroke-width="2.6" marker-end="url(#la-2b-arrow-b1)" />
		<line x1={sx(0)} y1={sy(0)} x2={sx(b2.x)} y2={sy(b2.y)} stroke={AMBER} stroke-width="2.6" marker-end="url(#la-2b-arrow-b2)" />

		{/* the fixed arrow */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(v.x)} y2={sy(v.y)} stroke={ACCENT} stroke-width="2.8" marker-end="url(#la-2b-arrow-v)" />

		<circle cx={sx(0)} cy={sy(0)} r="3" fill="currentColor" />

		<text x={sx(b1.x) + 6} y={sy(b1.y) + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={TEAL}>b<tspan baseline-shift="sub" font-size="9">1</tspan> = [1, 1]</text>
		<text x={sx(b2.x) - 6} y={sy(b2.y) + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={AMBER}>b<tspan baseline-shift="sub" font-size="9">2</tspan> = [-1, 1]</text>
		<text x={sx(v.x) + 8} y={sy(v.y) - 8} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>same arrow</text>

		{/* legend */}
		<g transform="translate(490, 100)">
			<rect x="0" y="0" width="230" height="120" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="230" height="120" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="115" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">two coordinate readouts:</text>
			<text x="115" y="48" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor">
				in our basis: <tspan fill={ACCENT} font-weight="700">[{v.x}, {v.y}]</tspan>
			</text>
			<text x="115" y="72" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor">
				in Jennifer's: <tspan fill={ACCENT} font-weight="700">[{jenCoords.a}, {jenCoords.b}]</tspan>
			</text>
			<text x="115" y="100" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">
				the arrow is the same; only<tspan x="115" dy="14">the numbers differ</tspan>
			</text>
		</g>
	</svg>
	<figcaption>One arrow, two grids, two readouts. With our standard x and y the arrow's coordinates are [3, 1]. With Jennifer's diagonal grid the same arrow's coordinates are [2, -1]. The picture is identical; only the language changes.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 14, illustration 2 of 3.
 *
 * Three transformations contrasted by their eigenvector structure.
 * Left: stretch [[2, 0], [0, 3]], both i-hat and j-hat stay on their
 * own axes (two eigenvectors). Middle: rotation by 30°, every vector
 * rotates off its line (no real eigenvectors). Right: shear [[1, 1],
 * [0, 1]], i-hat stays on the x-axis (one eigenvector); j-hat tilts off.
 */

const PANEL_W = 230;
const PANEL_GAP = 10;
const PANEL_X = (i: number) => 20 + i * (PANEL_W + PANEL_GAP);
const PANEL_Y = 60;
const PANEL_H = 280;
const cyP = PANEL_Y + PANEL_H / 2;
const u = 28;

const X_MIN = -1;
const X_MAX = 4;
const Y_MIN = -2;
const Y_MAX = 4;

type Mat = (x: number, y: number) => { x: number; y: number };

const stretch: Mat = (x, y) => ({ x: 2 * x, y: 3 * y });
const rotate30: Mat = (x, y) => ({
	x: Math.cos(Math.PI / 6) * x - Math.sin(Math.PI / 6) * y,
	y: Math.sin(Math.PI / 6) * x + Math.cos(Math.PI / 6) * y,
});
const shear: Mat = (x, y) => ({ x: x + y, y: y });

type Panel = {
	idx: 0 | 1 | 2;
	title: string;
	subtitle: string;
	M: Mat;
};

const panels: Panel[] = [
	{ idx: 0, title: 'stretch', subtitle: 'î and ĵ both stay; 2 eigenvectors', M: stretch },
	{ idx: 1, title: 'rotation 30°', subtitle: 'every vector rotates off; no real eigenvectors', M: rotate30 },
	{ idx: 2, title: 'shear', subtitle: 'only î stays on x-axis; 1 eigenvector', M: shear },
];

const TEAL = '#0d9488';
const AMBER = '#d97706';
const RED = '#ef4444';

const xs: number[] = [];
for (let i = X_MIN; i < X_MAX + 1; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j < Y_MAX + 1; j++) ys.push(j);
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-3trans-title la-3trans-desc">
		<title id="la-3trans-title">Three transformations contrasted by eigenvector structure: stretch, rotation, shear</title>
		<desc id="la-3trans-desc">Three side-by-side panels showing how a stretch, a rotation, and a shear treat the basis vectors. In the left "stretch" panel, both i-hat and j-hat get scaled along their own axes and remain on those axes, so both are eigenvectors. In the middle "rotation 30 degrees" panel, both basis vectors rotate off their original directions, indicated by faded original arrows; no vector stays on its line, so there are no real eigenvectors. In the right "shear" panel, i-hat is unchanged (on the x-axis still), making it an eigenvector with eigenvalue 1, while j-hat tilts to (1, 1) off the y-axis.</desc>

		<defs>
			<marker id="la-3t-arrow-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-3t-arrow-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
		</defs>

		{panels.map((p) => {
			const px = PANEL_X(p.idx);
			const cxP = px + PANEL_W / 2;
			const sx = (gx: number) => cxP + gx * u;
			const sy = (gy: number) => cyP - gy * u;
			const Li = p.M(1, 0);
			const Lj = p.M(0, 1);
			const noEigen = p.idx === 1;
			return (
				<g>
					<rect x={px + 2} y={PANEL_Y - 30} width={PANEL_W - 4} height={PANEL_H + 30} rx="6" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.22" />
					<text x={cxP} y={PANEL_Y - 12} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={noEigen ? RED : TEAL}>{p.title}</text>

					{xs.map((i) => <line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
					{ys.map((j) => <line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
					<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />
					<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />

					{/* original i-hat, j-hat as faint reference */}
					<line x1={sx(0)} y1={sy(0)} x2={sx(1)} y2={sy(0)} stroke={TEAL} stroke-width="1.6" opacity="0.35" stroke-dasharray="3 2" />
					<line x1={sx(0)} y1={sy(0)} x2={sx(0)} y2={sy(1)} stroke={AMBER} stroke-width="1.6" opacity="0.35" stroke-dasharray="3 2" />

					{/* transformed L(i-hat), L(j-hat) as bold */}
					<line x1={sx(0)} y1={sy(0)} x2={sx(Li.x)} y2={sy(Li.y)} stroke={TEAL} stroke-width="2.6" marker-end="url(#la-3t-arrow-t)" />
					<line x1={sx(0)} y1={sy(0)} x2={sx(Lj.x)} y2={sy(Lj.y)} stroke={AMBER} stroke-width="2.6" marker-end="url(#la-3t-arrow-a)" />

					<circle cx={sx(0)} cy={sy(0)} r="2.4" fill="currentColor" />

					<text x={cxP} y={PANEL_Y + PANEL_H + 14} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.7">{p.subtitle}</text>
				</g>
			);
		})}
	</svg>
	<figcaption>Three transformations, three eigen-stories. A stretch keeps both basis vectors on their own axes, so it has two eigenvectors. A pure rotation rotates everything off its line, so it has none (over the reals). A shear keeps only one axis fixed, so it has one. The geometry tells you the count.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

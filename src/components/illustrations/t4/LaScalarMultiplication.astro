---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 1, illustration 3 of 3.
 *
 * Three side-by-side panels of the same source vector v = [2, 1], with the
 * scaled vector overlaid in each: 2·v stretches it to double length, 0.5·v
 * squishes it to half, (-1)·v flips it to point the opposite way. The
 * original v is drawn faintly so you can read the scaled version against it.
 */

// v = (2, 1). Each panel shows v faint + scaled vector bold.
const v = { x: 2, y: 1 };
const PANEL_W = 240;
const u = 22;

type Panel = {
	idx: 0 | 1 | 2;
	scalar: number;
	label: string;
	coords: string;
};
const panels: Panel[] = [
	{ idx: 0, scalar: 2, label: '2 · v', coords: '[4, 2]' },
	{ idx: 1, scalar: 0.5, label: '0.5 · v', coords: '[1, 0.5]' },
	{ idx: 2, scalar: -1, label: '(-1) · v', coords: '[-2, -1]' },
];

const cyBase = 215; // panel-local origin y
const cxOff = 120; // panel-local origin x

// per-panel origin in svg space
const O = (p: Panel) => ({ X: p.idx * PANEL_W + cxOff, Y: cyBase });

const X_MIN = -4;
const X_MAX = 5;
const Y_MIN = -2;
const Y_MAX = 3;

const xs: number[] = [];
for (let i = X_MIN; i <= X_MAX; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j <= Y_MAX; j++) ys.push(j);

const TEAL = '#0d9488';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-scalar-title la-scalar-desc">
		<title id="la-scalar-title">Scalar multiplication on a vector: stretching, squishing, and flipping</title>
		<desc id="la-scalar-desc">Three side-by-side panels showing the same source vector v equal to [2, 1] drawn in teal. In the left panel, a bold purple arrow shows 2 times v, twice as long in the same direction with tip at [4, 2]. In the middle panel, a bold purple arrow shows half v, half as long in the same direction with tip at [1, 0.5]. In the right panel, a bold purple arrow shows negative one times v, the same length but flipped to point in the opposite direction with tip at [negative 2, negative 1]. Each panel makes the same point: multiplying a vector by a number stretches, squishes, or flips it.</desc>

		<defs>
			<marker id="la-scalar-arrow-v" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-scalar-arrow-s" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		{panels.map((p) => {
			const o = O(p);
			const sx = (gx: number) => o.X + gx * u;
			const sy = (gy: number) => o.Y - gy * u;
			const tipVX = sx(v.x);
			const tipVY = sy(v.y);
			const tipSX = sx(v.x * p.scalar);
			const tipSY = sy(v.y * p.scalar);
			const panelLeft = p.idx * PANEL_W;
			return (
				<g>
					{/* panel border */}
					<rect x={panelLeft + 4} y={28} width={PANEL_W - 8} height={310} rx="6" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.18" />

					{/* panel title */}
					<text x={panelLeft + PANEL_W / 2} y={52} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" font-weight="700" fill={ACCENT}>{p.label}</text>

					{/* grid */}
					{xs.map((i) => (
						<line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
					))}
					{ys.map((j) => (
						<line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
					))}

					{/* axes */}
					<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
					<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="1" opacity="0.45" />

					{/* origin dot */}
					<circle cx={o.X} cy={o.Y} r="2.4" fill="currentColor" />

					{/* original v: faint teal */}
					<line x1={o.X} y1={o.Y} x2={tipVX} y2={tipVY} stroke={TEAL} stroke-width="1.8" opacity="0.5" marker-end="url(#la-scalar-arrow-v)" />

					{/* scaled vector: bold accent */}
					<line x1={o.X} y1={o.Y} x2={tipSX} y2={tipSY} stroke={ACCENT} stroke-width="2.8" marker-end="url(#la-scalar-arrow-s)" />

					{/* tip coord label */}
					<text x={tipSX + (p.scalar < 0 ? -6 : 6)} y={tipSY + (p.scalar < 0 ? 18 : -8)} text-anchor={p.scalar < 0 ? 'end' : 'start'} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>{p.coords}</text>

					{/* small v reference label in lower-left of panel */}
					<text x={panelLeft + PANEL_W / 2} y={325} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={TEAL} opacity="0.85">v = [2, 1]</text>
				</g>
			);
		})}
	</svg>
	<figcaption>Multiplying a vector by a number is geometric: 2 stretches it to twice as long, 0.5 squishes it to half, and (-1) flips it to point the other way. Same direction, new length, or opposite direction if the number is negative. That word, "scalar," is named for exactly this scaling job.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

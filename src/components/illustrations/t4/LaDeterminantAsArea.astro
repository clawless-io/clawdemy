---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 6, illustration 1 of 3.
 *
 * The determinant as scaled area. Left: the unit square (area 1). Right:
 * the parallelogram it becomes under L = [[2, 1], [0, 2]], spanned by the
 * two matrix columns; its area is the determinant, 4 in this case. The
 * area label is overlaid centrally so the reader links "the number in the
 * matrix box" to "the area of the parallelogram on the page".
 */

const PANEL_W = 340;
const PANEL_X1 = 20;
const PANEL_X2 = 380;
const cyP = 235;
const u = 50;

// L = [[2, 1], [0, 2]]; det = 2*2 - 1*0 = 4.
const Li = { x: 2, y: 0 };
const Lj = { x: 1, y: 2 };
const det = 2 * 2 - 1 * 0;

const X_MIN = -1;
const X_MAX_BEFORE = 3;
const X_MAX_AFTER = 4;
const Y_MIN = -1;
const Y_MAX_BEFORE = 3;
const Y_MAX_AFTER = 3;

const xsBefore: number[] = [];
for (let i = X_MIN; i < X_MAX_BEFORE + 1; i++) xsBefore.push(i);
const ysBefore: number[] = [];
for (let j = Y_MIN; j < Y_MAX_BEFORE + 1; j++) ysBefore.push(j);
const xsAfter: number[] = [];
for (let i = X_MIN; i < X_MAX_AFTER + 1; i++) xsAfter.push(i);
const ysAfter: number[] = [];
for (let j = Y_MIN; j < Y_MAX_AFTER + 1; j++) ysAfter.push(j);

function panelOrigin(idx: 0 | 1) {
	const px = idx === 0 ? PANEL_X1 : PANEL_X2;
	return { X: px + 60, Y: cyP };
}

const o0 = panelOrigin(0);
const o1 = panelOrigin(1);
const sx0 = (gx: number) => o0.X + gx * u;
const sy0 = (gy: number) => o0.Y - gy * u;
const sx1 = (gx: number) => o1.X + gx * u;
const sy1 = (gy: number) => o1.Y - gy * u;

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-detarea-title la-detarea-desc">
		<title id="la-detarea-title">The determinant as the area of the parallelogram</title>
		<desc id="la-detarea-desc">Two side-by-side panels. The left panel shows the unit square at the origin filled in light purple, labeled area equals 1. The right panel shows the parallelogram the unit square becomes under L = [[2, 1], [0, 2]], spanned by the two matrix columns [2, 0] and [1, 2]. The parallelogram is labeled area equals 4 in its center, which is the determinant of L. The teal L of i-hat and amber L of j-hat run along its bottom and left edges.</desc>

		<defs>
			<marker id="la-detarea-arrow-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-detarea-arrow-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
		</defs>

		{/* panel 1: unit square */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.85">unit square (area 1)</text>

		{ysBefore.map((j) => <line x1={sx0(X_MIN)} y1={sy0(j)} x2={sx0(X_MAX_BEFORE)} y2={sy0(j)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
		{xsBefore.map((i) => <line x1={sx0(i)} y1={sy0(Y_MIN)} x2={sx0(i)} y2={sy0(Y_MAX_BEFORE)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
		<line x1={sx0(X_MIN)} y1={sy0(0)} x2={sx0(X_MAX_BEFORE)} y2={sy0(0)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />
		<line x1={sx0(0)} y1={sy0(Y_MIN)} x2={sx0(0)} y2={sy0(Y_MAX_BEFORE)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />

		<rect x={sx0(0)} y={sy0(1)} width={u} height={u} fill={ACCENT} fill-opacity="0.16" stroke={ACCENT} stroke-width="1.2" />
		<text x={sx0(0.5)} y={sy0(0.5) + 4} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" font-weight="700" fill={ACCENT}>area = 1</text>

		<line x1={sx0(0)} y1={sy0(0)} x2={sx0(1)} y2={sy0(0)} stroke={TEAL} stroke-width="2.8" marker-end="url(#la-detarea-arrow-t)" />
		<line x1={sx0(0)} y1={sy0(0)} x2={sx0(0)} y2={sy0(1)} stroke={AMBER} stroke-width="2.8" marker-end="url(#la-detarea-arrow-a)" />
		<circle cx={sx0(0)} cy={sy0(0)} r="2.6" fill="currentColor" />

		{/* panel 2: parallelogram */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>parallelogram (area = det L = 4)</text>

		{ysAfter.map((j) => <line x1={sx1(X_MIN)} y1={sy1(j)} x2={sx1(X_MAX_AFTER)} y2={sy1(j)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
		{xsAfter.map((i) => <line x1={sx1(i)} y1={sy1(Y_MIN)} x2={sx1(i)} y2={sy1(Y_MAX_AFTER)} stroke="currentColor" stroke-width="0.4" opacity="0.10" />)}
		<line x1={sx1(X_MIN)} y1={sy1(0)} x2={sx1(X_MAX_AFTER)} y2={sy1(0)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />
		<line x1={sx1(0)} y1={sy1(Y_MIN)} x2={sx1(0)} y2={sy1(Y_MAX_AFTER)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />

		<path d={`M ${sx1(0)} ${sy1(0)} L ${sx1(Li.x)} ${sy1(Li.y)} L ${sx1(Li.x + Lj.x)} ${sy1(Li.y + Lj.y)} L ${sx1(Lj.x)} ${sy1(Lj.y)} Z`} fill={ACCENT} fill-opacity="0.18" stroke={ACCENT} stroke-width="1.4" />

		<text x={sx1((Li.x + Lj.x) / 2)} y={sy1((Li.y + Lj.y) / 2) + 4} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="14" font-weight="700" fill={ACCENT}>area = 4</text>

		<line x1={sx1(0)} y1={sy1(0)} x2={sx1(Li.x)} y2={sy1(Li.y)} stroke={TEAL} stroke-width="2.8" marker-end="url(#la-detarea-arrow-t)" />
		<line x1={sx1(0)} y1={sy1(0)} x2={sx1(Lj.x)} y2={sy1(Lj.y)} stroke={AMBER} stroke-width="2.8" marker-end="url(#la-detarea-arrow-a)" />
		<circle cx={sx1(0)} cy={sy1(0)} r="2.6" fill="currentColor" />

		<text x={PANEL_X2 + PANEL_W / 2} y={328} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.75">L = [[2, 1], [0, 2]] → det L = {det}</text>
	</svg>
	<figcaption>The unit square has area 1; under L it becomes a parallelogram whose area is the determinant. Here L stretches and shears, and the parallelogram comes out to area 4. The determinant is the number that says how much L scales every area.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

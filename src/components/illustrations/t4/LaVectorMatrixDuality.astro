---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 9, illustration 3 of 3.
 *
 * The vector-matrix duality. The vector [a, b] viewed as an arrow in the
 * plane and viewed as a 1 by 2 matrix [a b] (a row) are the same object;
 * each represents the linear function "dot with [a, b]". Left panel:
 * arrow form on a grid. Right panel: matrix form as a typeset row. A
 * bidirectional double-arrow between them carries the word "duality".
 */

const PANEL_W = 320;
const PANEL_X1 = 40;
const PANEL_X2 = 420;

const cy0 = 220;
const u0 = 50;
const o0X = PANEL_X1 + PANEL_W / 2;

const a = 3;
const b = 2;

const X_MIN = -1;
const X_MAX = 4;
const Y_MIN = -1;
const Y_MAX = 3;

const sx0 = (gx: number) => o0X + gx * u0;
const sy0 = (gy: number) => cy0 - gy * u0;

const xs: number[] = [];
for (let i = X_MIN; i < X_MAX + 1; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j < Y_MAX + 1; j++) ys.push(j);

const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-dual-title la-dual-desc">
		<title id="la-dual-title">The vector [a, b] is the same object as the 1 by 2 matrix [a b]</title>
		<desc id="la-dual-desc">Two side-by-side panels showing two representations of [a, b] equals [3, 2]. The left panel is a two-dimensional coordinate grid with a purple arrow from the origin to [3, 2]. The right panel shows the typeset 1 by 2 matrix [3 2] in purple, with the label "lying on its side". A double-headed accent-colored arrow between the two panels is labeled "duality", indicating that the two forms encode the same linear function v dot [3, 2].</desc>

		<defs>
			<marker id="la-dual-arrow-v" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
			<marker id="la-dual-arrow-d-start" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 10 0 L 0 5 L 10 10 z" fill={ACCENT} />
			</marker>
			<marker id="la-dual-arrow-d-end" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		{/* panel 1: arrow form */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>as an arrow</text>

		{xs.map((i) => <line x1={sx0(i)} y1={sy0(Y_MIN)} x2={sx0(i)} y2={sy0(Y_MAX)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		{ys.map((j) => <line x1={sx0(X_MIN)} y1={sy0(j)} x2={sx0(X_MAX)} y2={sy0(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		<line x1={sx0(X_MIN)} y1={sy0(0)} x2={sx0(X_MAX)} y2={sy0(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx0(0)} y1={sy0(Y_MIN)} x2={sx0(0)} y2={sy0(Y_MAX)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		<line x1={sx0(0)} y1={sy0(0)} x2={sx0(a)} y2={sy0(b)} stroke={ACCENT} stroke-width="2.8" marker-end="url(#la-dual-arrow-v)" />
		<circle cx={sx0(0)} cy={sy0(0)} r="2.6" fill="currentColor" />

		<text x={sx0(a) + 8} y={sy0(b) - 8} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>[{a}, {b}]</text>

		{/* panel 2: matrix form */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>as a 1×2 matrix (a row)</text>

		{/* big matrix typesetting in the middle of the right panel */}
		<g transform={`translate(${PANEL_X2 + PANEL_W / 2 - 90}, ${cy0 - 60})`}>
			<text x="0" y="60" font-family="ui-monospace, SFMono-Regular, monospace" font-size="72" font-weight="300" fill={ACCENT}>[</text>
			<text x="44" y="60" font-family="ui-monospace, SFMono-Regular, monospace" font-size="42" font-weight="700" fill={ACCENT}>{a}</text>
			<text x="92" y="60" font-family="ui-monospace, SFMono-Regular, monospace" font-size="42" font-weight="700" fill={ACCENT}>{b}</text>
			<text x="138" y="60" font-family="ui-monospace, SFMono-Regular, monospace" font-size="72" font-weight="300" fill={ACCENT}>]</text>
		</g>

		<text x={PANEL_X2 + PANEL_W / 2} y={290} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12" fill="currentColor" opacity="0.7">"the vector, lying on its side"</text>
		<text x={PANEL_X2 + PANEL_W / 2} y={312} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor" opacity="0.8">acts on v as: [{a} {b}]·v = {a}v<tspan baseline-shift="sub" font-size="9">x</tspan> + {b}v<tspan baseline-shift="sub" font-size="9">y</tspan> = v · [{a}, {b}]</text>

		{/* duality double-arrow between panels */}
		<line x1={PANEL_X1 + PANEL_W + 8} y1={cy0} x2={PANEL_X2 - 8} y2={cy0} stroke={ACCENT} stroke-width="2" marker-start="url(#la-dual-arrow-d-start)" marker-end="url(#la-dual-arrow-d-end)" />
		<text x={(PANEL_X1 + PANEL_W + PANEL_X2) / 2} y={cy0 - 10} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>duality</text>
	</svg>
	<figcaption>The vector [a, b] you can draw as an arrow IS the 1 by 2 matrix [a, b] that acts on other vectors by dot product. The arrow form and the row-matrix form are two views of the same object: a linear function from vectors to numbers.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 10, illustration 2 of 2.
 *
 * The matrix-and-parallelogram restatement: v cross w in 2D equals the
 * determinant of the 2x2 matrix [v | w]. With v = [3, 1] and w = [1, 2]:
 * the matrix is [[3, 1], [1, 2]], and det = 3·2 - 1·1 = 5, the same number
 * as the parallelogram's signed area.
 */

const PANEL_W = 320;
const PANEL_X1 = 30;
const PANEL_X2 = 410;

const cy0 = 245;
const u0 = 50;
const o0X = PANEL_X2 + PANEL_W / 2;

const v = { x: 3, y: 1 };
const w = { x: 1, y: 2 };
const det = v.x * w.y - v.y * w.x;

const X_MIN = -1;
const X_MAX = 5;
const Y_MIN = -1;
const Y_MAX = 4;

const sx0 = (gx: number) => o0X + gx * u0;
const sy0 = (gy: number) => cy0 - gy * u0;

const xs: number[] = [];
for (let i = X_MIN; i < X_MAX + 1; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j < Y_MAX + 1; j++) ys.push(j);

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-crossdet-title la-crossdet-desc">
		<title id="la-crossdet-title">v cross w equals det of the matrix whose columns are v and w</title>
		<desc id="la-crossdet-desc">Two side-by-side panels. The left panel shows the matrix [v | w] equal to [[3, 1], [1, 2]] in big typeset form, with the v column highlighted in teal and the w column highlighted in amber. Below, the determinant is computed as 3 times 2 minus 1 times 1 equals 5. The right panel shows the parallelogram spanned by v and w on a coordinate grid with area equal to 5 labeled inside it. An equality sign between the panels indicates that the matrix's determinant equals the parallelogram's signed area.</desc>

		<defs>
			<marker id="la-crossdet-arrow-v" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-crossdet-arrow-w" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
		</defs>

		{/* left panel: matrix */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>matrix [v | w]</text>

		<g transform={`translate(${PANEL_X1 + PANEL_W / 2 - 60}, 100)`}>
			<text x="0" y="60" font-family="ui-monospace, SFMono-Regular, monospace" font-size="80" font-weight="300" fill={ACCENT}>[</text>
			<text x="40" y="40" font-family="ui-monospace, SFMono-Regular, monospace" font-size="32" font-weight="700" fill={TEAL}>{v.x}</text>
			<text x="80" y="40" font-family="ui-monospace, SFMono-Regular, monospace" font-size="32" font-weight="700" fill={AMBER}>{w.x}</text>
			<text x="40" y="78" font-family="ui-monospace, SFMono-Regular, monospace" font-size="32" font-weight="700" fill={TEAL}>{v.y}</text>
			<text x="80" y="78" font-family="ui-monospace, SFMono-Regular, monospace" font-size="32" font-weight="700" fill={AMBER}>{w.y}</text>
			<text x="120" y="60" font-family="ui-monospace, SFMono-Regular, monospace" font-size="80" font-weight="300" fill={ACCENT}>]</text>
		</g>

		<text x={PANEL_X1 + PANEL_W / 2} y={240} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" fill="currentColor" opacity="0.8">
			columns: <tspan fill={TEAL} font-weight="700">v</tspan> and <tspan fill={AMBER} font-weight="700">w</tspan>
		</text>

		<text x={PANEL_X1 + PANEL_W / 2} y={278} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" fill="currentColor">
			det = {v.x}·{w.y} - {w.x}·{v.y}
		</text>
		<text x={PANEL_X1 + PANEL_W / 2} y={302} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="16" font-weight="700" fill={ACCENT}>
			= {det}
		</text>

		{/* equality sign between panels */}
		<text x={(PANEL_X1 + PANEL_W + PANEL_X2) / 2} y={180} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="44" font-weight="300" fill={ACCENT}>=</text>
		<text x={(PANEL_X1 + PANEL_W + PANEL_X2) / 2} y={220} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">det = area</text>

		{/* right panel: parallelogram */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>parallelogram [v | w]</text>

		{xs.map((i) => <line x1={sx0(i)} y1={sy0(Y_MIN)} x2={sx0(i)} y2={sy0(Y_MAX)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		{ys.map((j) => <line x1={sx0(X_MIN)} y1={sy0(j)} x2={sx0(X_MAX)} y2={sy0(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		<line x1={sx0(X_MIN)} y1={sy0(0)} x2={sx0(X_MAX)} y2={sy0(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx0(0)} y1={sy0(Y_MIN)} x2={sx0(0)} y2={sy0(Y_MAX)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		<path d={`M ${sx0(0)} ${sy0(0)} L ${sx0(v.x)} ${sy0(v.y)} L ${sx0(v.x + w.x)} ${sy0(v.y + w.y)} L ${sx0(w.x)} ${sy0(w.y)} Z`} fill={ACCENT} fill-opacity="0.18" stroke={ACCENT} stroke-width="1.4" />

		<line x1={sx0(0)} y1={sy0(0)} x2={sx0(v.x)} y2={sy0(v.y)} stroke={TEAL} stroke-width="2.8" marker-end="url(#la-crossdet-arrow-v)" />
		<line x1={sx0(0)} y1={sy0(0)} x2={sx0(w.x)} y2={sy0(w.y)} stroke={AMBER} stroke-width="2.8" marker-end="url(#la-crossdet-arrow-w)" />

		<circle cx={sx0(0)} cy={sy0(0)} r="2.6" fill="currentColor" />

		<text x={sx0((v.x + w.x) / 2)} y={sy0((v.y + w.y) / 2) + 4} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="15" font-weight="700" fill={ACCENT}>area = {det}</text>
	</svg>
	<figcaption>The 2D cross product is the determinant of the matrix whose columns are v and w. Same number on both sides: the algebra of the determinant and the geometry of the parallelogram's signed area are two ways to write the same thing.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

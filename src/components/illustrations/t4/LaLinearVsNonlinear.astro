---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 3, illustration 1 of 3.
 *
 * Linear versus non-linear, the visual contrast. Both panels take the same
 * source square grid and apply a transformation. Left panel: a linear
 * transformation (a shear-with-scale), the grid stays a tiling of
 * parallelograms because grid lines remain parallel and evenly spaced.
 * Right panel: a non-linear transformation (a sinusoidal bend), the grid
 * lines curve because the linearity rules are broken.
 */

const PANEL_W = 340;
const PANEL_X1 = 20;
const PANEL_X2 = 380;
const cy = 195;
const u = 30;

const RANGE = 3;
const ticks: number[] = [];
for (let i = -RANGE; i <= RANGE; i++) ticks.push(i);
const SAMPLES = 30;

// linear: a shear-with-scale matrix.
function linear(x: number, y: number): { x: number; y: number } {
	return { x: 1.25 * x + 0.45 * y, y: 0.18 * x + 1.05 * y };
}

// non-linear: sinusoidal warp. Linear-ish at small magnitudes, off at larger.
function nonlinear(x: number, y: number): { x: number; y: number } {
	return {
		x: x + 0.42 * Math.sin(y * 1.0),
		y: y + 0.38 * Math.sin(x * 0.9),
	};
}

// Render the transformed source grid as a set of polylines: one per source
// horizontal line, one per source vertical line.
function gridPaths(transform: (x: number, y: number) => { x: number; y: number }, cx: number): string[] {
	const paths: string[] = [];
	for (const i of ticks) {
		let d = '';
		for (let k = 0; k <= SAMPLES; k++) {
			const x = -RANGE + ((2 * RANGE) * k) / SAMPLES;
			const t = transform(x, i);
			const X = cx + t.x * u;
			const Y = cy - t.y * u;
			d += `${k === 0 ? 'M' : 'L'} ${X.toFixed(1)} ${Y.toFixed(1)} `;
		}
		paths.push(d.trim());
	}
	for (const j of ticks) {
		let d = '';
		for (let k = 0; k <= SAMPLES; k++) {
			const y = -RANGE + ((2 * RANGE) * k) / SAMPLES;
			const t = transform(j, y);
			const X = cx + t.x * u;
			const Y = cy - t.y * u;
			d += `${k === 0 ? 'M' : 'L'} ${X.toFixed(1)} ${Y.toFixed(1)} `;
		}
		paths.push(d.trim());
	}
	return paths;
}

const linearPaths = gridPaths(linear, PANEL_X1 + PANEL_W / 2);
const nonlinearPaths = gridPaths(nonlinear, PANEL_X2 + PANEL_W / 2);

const TEAL = '#0d9488';
const AMBER = '#d97706';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-linvsnon-title la-linvsnon-desc">
		<title id="la-linvsnon-title">Linear versus non-linear transformations: the grid stays a tiling of parallelograms in one case and curves in the other</title>
		<desc id="la-linvsnon-desc">Two side-by-side panels. The left panel shows a linear transformation applied to a square grid: the grid lines stay parallel and evenly spaced, tilted and stretched into a tiling of parallelograms. The right panel shows a non-linear transformation applied to the same grid: the grid lines curve, breaking the parallel and evenly-spaced rules. The labels above each panel mark "LINEAR" and "NON-LINEAR" and summarize the two linearity requirements.</desc>

		{/* panel 1: linear */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>LINEAR</text>
		<text x={PANEL_X1 + PANEL_W / 2} y={62} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.7">grid stays parallel + evenly spaced</text>

		{linearPaths.map((d) => (
			<path d={d} fill="none" stroke={TEAL} stroke-width="1.1" opacity="0.7" />
		))}

		{/* panel 2: non-linear */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={AMBER}>NON-LINEAR</text>
		<text x={PANEL_X2 + PANEL_W / 2} y={62} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.7">grid lines curve</text>

		{nonlinearPaths.map((d) => (
			<path d={d} fill="none" stroke={AMBER} stroke-width="1.1" opacity="0.7" />
		))}
	</svg>
	<figcaption>A linear transformation tilts and stretches the grid but the squares stay parallelograms: lines that were parallel before are still parallel after, and equally spaced steps stay equally spaced. The moment the grid curves, the transformation is non-linear.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

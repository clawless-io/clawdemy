---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 9, illustration 2 of 3.
 *
 * Geometric meaning of v · u-hat: the signed length of v's projection onto
 * the line spanned by u-hat. A unit vector u-hat at 30 degrees, a vector
 * v = [3, 1]. Drop a perpendicular from v's tip to the line through u-hat;
 * the foot of that perpendicular sits at distance v · u-hat from the
 * origin along the line. Here v · u-hat = 3·cos30 + 1·sin30 ≈ 3.10.
 */

const cx = 200;
const cy = 230;
const u = 60;

const X_MIN = -1;
const X_MAX = 5;
const Y_MIN = -1;
const Y_MAX = 3;

const sx = (gx: number) => cx + gx * u;
const sy = (gy: number) => cy - gy * u;

const xs: number[] = [];
for (let i = X_MIN; i < X_MAX + 1; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j < Y_MAX + 1; j++) ys.push(j);

const theta = (30 * Math.PI) / 180;
const uHat = { x: Math.cos(theta), y: Math.sin(theta) };
const v = { x: 3, y: 1 };

// projection scalar: v · u-hat
const proj = v.x * uHat.x + v.y * uHat.y;
const foot = { x: uHat.x * proj, y: uHat.y * proj };

// extend the u-hat line for the diagram
const lineExt = 4.2;
const lineStart = { X: sx(-1.2 * uHat.x), Y: sy(-1.2 * uHat.y) };
const lineEnd = { X: sx(lineExt * uHat.x), Y: sy(lineExt * uHat.y) };

const TEAL = '#0d9488';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-proj-title la-proj-desc">
		<title id="la-proj-title">The dot product v dot u-hat as the signed projection length of v onto the line through u-hat</title>
		<desc id="la-proj-desc">A two-dimensional coordinate grid. A teal unit vector u-hat at 30 degrees runs from the origin along a dashed accent-colored line that extends across the grid. A purple vector v equal to [3, 1] runs from the origin to its tip. A dashed perpendicular is dropped from v's tip to the line through u-hat, meeting the line at the foot of the projection. The signed length from the origin to that foot, marked along the line, is approximately 3.10, equal to v dot u-hat.</desc>

		<defs>
			<marker id="la-proj-arrow-u" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-proj-arrow-v" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		{xs.map((i) => <line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		{ys.map((j) => <line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		{/* u-hat extended line (dashed accent) */}
		<line x1={lineStart.X} y1={lineStart.Y} x2={lineEnd.X} y2={lineEnd.Y} stroke={ACCENT} stroke-width="1.2" stroke-dasharray="6 4" opacity="0.55" />

		{/* perpendicular drop from v's tip to the line */}
		<line x1={sx(v.x)} y1={sy(v.y)} x2={sx(foot.x)} y2={sy(foot.y)} stroke="currentColor" stroke-width="1.3" stroke-dasharray="4 4" opacity="0.6" />

		{/* signed projection length along the line, highlighted */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(foot.x)} y2={sy(foot.y)} stroke={ACCENT} stroke-width="3.4" opacity="0.85" />

		{/* u-hat (bold teal) */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(uHat.x)} y2={sy(uHat.y)} stroke={TEAL} stroke-width="3" marker-end="url(#la-proj-arrow-u)" />

		{/* v (bold accent) */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(v.x)} y2={sy(v.y)} stroke={ACCENT} stroke-width="2.6" marker-end="url(#la-proj-arrow-v)" />

		<circle cx={sx(0)} cy={sy(0)} r="3" fill="currentColor" />
		<circle cx={sx(foot.x)} cy={sy(foot.y)} r="3" fill={ACCENT} />

		<text x={sx(uHat.x) + 4} y={sy(uHat.y) - 8} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>û</text>
		<text x={sx(v.x) + 6} y={sy(v.y) - 8} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>v = [3, 1]</text>

		<text x={sx(foot.x / 2)} y={sy(foot.y / 2) - 14} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>v · û ≈ 3.10</text>

		{/* legend with the computation */}
		<g transform="translate(440, 70)">
			<rect x="0" y="0" width="270" height="100" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="270" height="100" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="135" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">geometric meaning:</text>
			<text x="135" y="46" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor">
				v · û = signed length of v on û
			</text>
			<text x="135" y="72" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" fill="currentColor" opacity="0.8">
				= 3·cos30° + 1·sin30°
			</text>
			<text x="135" y="92" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>
				≈ {proj.toFixed(2)}
			</text>
		</g>
	</svg>
	<figcaption>Take any vector v, drop a perpendicular from its tip onto the line through a unit vector û, and the distance from the origin to the foot is exactly v · û. The dot product is geometrically a signed projection length, made positive when v leans the same way as û and negative when it leans the other.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

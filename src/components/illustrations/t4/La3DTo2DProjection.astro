---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 8, illustration 2 of 2.
 *
 * A 2 by 3 matrix takes 3D input vectors and produces 2D outputs. The
 * canonical example is the projection [[1, 0, 0], [0, 1, 0]] that drops
 * the z component. Left panel: a 3D scene with the z-axis highlighted as
 * the null space (every vector along z gets crushed to the origin under
 * this projection). Right panel: the xy-plane (2D output) with a sample
 * vector landing where its z-was-dropped.
 */

const cos30 = 0.8660254;
const sin30 = 0.5;
const PANEL_W = 340;
const PANEL_X1 = 20;
const PANEL_X2 = 380;

// Left 3D panel
const cy1 = 215;
const sXY = 36;
const sZ = 38;
const c1X = PANEL_X1 + PANEL_W / 2 - 30;

function proj3(x: number, y: number, z: number): { X: number; Y: number } {
	return {
		X: c1X + (x - y) * cos30 * sXY,
		Y: cy1 + (x + y) * sin30 * sXY - z * sZ,
	};
}

const O3 = proj3(0, 0, 0);
const AX = proj3(2, 0, 0);
const AY = proj3(0, 2, 0);
const AZ = proj3(0, 0, 2.2);

// sample input vector v = [1.4, 0.8, 1.5]
const v = { x: 1.4, y: 0.8, z: 1.5 };
const V3 = proj3(v.x, v.y, v.z);
// project of v onto xy plane = (1.4, 0.8, 0)
const Vproj3 = proj3(v.x, v.y, 0);

// Right panel: 2D output
const cy0 = 215;
const u0 = 40;
const o0X = PANEL_X2 + PANEL_W / 2;

const X_MIN2 = -1;
const X_MAX2 = 3;
const Y_MIN2 = -1;
const Y_MAX2 = 3;

const sx0 = (gx: number) => o0X + gx * u0;
const sy0 = (gy: number) => cy0 - gy * u0;

const xs2: number[] = [];
for (let i = X_MIN2; i < X_MAX2 + 1; i++) xs2.push(i);
const ys2: number[] = [];
for (let j = Y_MIN2; j < Y_MAX2 + 1; j++) ys2.push(j);

// projected output: v's xy
const Mv = { x: v.x, y: v.y };

const TEAL = '#0d9488';
const AMBER = '#d97706';
const SKY = '#0284c7';
const ACCENT = '#7c3aed';
const RED = '#ef4444';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-3dto2d-title la-3dto2d-desc">
		<title id="la-3dto2d-title">A 2 by 3 matrix projects 3D space onto the 2D xy-plane, with the z-axis as its null space</title>
		<desc id="la-3dto2d-desc">Two side-by-side panels showing the projection M = [[1, 0, 0], [0, 1, 0]] from 3D to 2D. The left panel is a 3D scene with x, y, z axes in axonometric projection; the entire z axis is highlighted in red dashed, labeled "null space: all of z gets crushed to 0". A purple input vector at [1.4, 0.8, 1.5] is drawn from the origin, and its drop to the xy-plane at [1.4, 0.8, 0] is shown as a dashed projection line. The right panel is a flat 2D xy-plane showing the projected output vector [1.4, 0.8] in purple. The label "M ignores z; only (x, y) survive" sits at the bottom.</desc>

		<defs>
			<marker id="la-3dto2d-arrow-v" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
			<marker id="la-3dto2d-arrow-ax" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
			</marker>
		</defs>

		{/* left panel: 3D */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.85">3D input space</text>

		{/* xy plane patch (sky tint) */}
		{(() => {
			const c1 = proj3(2.5, -1.5, 0);
			const c2 = proj3(2.5, 2.5, 0);
			const c3 = proj3(-1.5, 2.5, 0);
			const c4 = proj3(-1.5, -1.5, 0);
			return <path d={`M ${c1.X} ${c1.Y} L ${c2.X} ${c2.Y} L ${c3.X} ${c3.Y} L ${c4.X} ${c4.Y} Z`} fill={SKY} fill-opacity="0.08" stroke={SKY} stroke-width="0.6" opacity="0.4" />;
		})()}

		{/* axes */}
		<line x1={O3.X} y1={O3.Y} x2={AX.X} y2={AX.Y} stroke="currentColor" stroke-width="1" opacity="0.32" marker-end="url(#la-3dto2d-arrow-ax)" />
		<line x1={O3.X} y1={O3.Y} x2={AY.X} y2={AY.Y} stroke="currentColor" stroke-width="1" opacity="0.32" marker-end="url(#la-3dto2d-arrow-ax)" />

		{/* z-axis highlighted as null space */}
		<line x1={O3.X} y1={O3.Y} x2={AZ.X} y2={AZ.Y} stroke={RED} stroke-width="2.4" stroke-dasharray="6 4" opacity="0.75" marker-end="url(#la-3dto2d-arrow-ax)" />

		<text x={AX.X + 4} y={AX.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.6">x</text>
		<text x={AY.X - 12} y={AY.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.6">y</text>
		<text x={AZ.X - 4} y={AZ.Y - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={RED}>z = null space</text>

		{/* input vector v */}
		<line x1={O3.X} y1={O3.Y} x2={V3.X} y2={V3.Y} stroke={ACCENT} stroke-width="2.8" marker-end="url(#la-3dto2d-arrow-v)" />
		<text x={V3.X + 6} y={V3.Y - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={ACCENT}>v = [1.4, 0.8, 1.5]</text>

		{/* drop from v to xy plane (dashed gray) */}
		<line x1={V3.X} y1={V3.Y} x2={Vproj3.X} y2={Vproj3.Y} stroke="currentColor" stroke-width="1.4" stroke-dasharray="4 4" opacity="0.55" />

		{/* the projected point on xy plane */}
		<circle cx={Vproj3.X} cy={Vproj3.Y} r="3.5" fill={ACCENT} />

		<circle cx={O3.X} cy={O3.Y} r="3" fill="currentColor" />

		{/* right panel: 2D output */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={SKY}>2D output (xy-plane only)</text>

		{xs2.map((i) => <line x1={sx0(i)} y1={sy0(Y_MIN2)} x2={sx0(i)} y2={sy0(Y_MAX2)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		{ys2.map((j) => <line x1={sx0(X_MIN2)} y1={sy0(j)} x2={sx0(X_MAX2)} y2={sy0(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		<line x1={sx0(X_MIN2)} y1={sy0(0)} x2={sx0(X_MAX2)} y2={sy0(0)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />
		<line x1={sx0(0)} y1={sy0(Y_MIN2)} x2={sx0(0)} y2={sy0(Y_MAX2)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />

		<line x1={sx0(0)} y1={sy0(0)} x2={sx0(Mv.x)} y2={sy0(Mv.y)} stroke={ACCENT} stroke-width="2.8" marker-end="url(#la-3dto2d-arrow-v)" />
		<text x={sx0(Mv.x) + 8} y={sy0(Mv.y) - 8} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={ACCENT}>M·v = [1.4, 0.8]</text>

		<circle cx={sx0(0)} cy={sy0(0)} r="2.6" fill="currentColor" />

		<text x={PANEL_X2 + PANEL_W / 2} y={328} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.75">M ignores z; only (x, y) survive</text>
	</svg>
	<figcaption>A 2 by 3 matrix takes 3D inputs and produces 2D outputs. The projection [[1, 0, 0], [0, 1, 0]] is the simplest example: drop the z. Every vector along the z-axis lands at the origin, making the z-axis the null space; the surviving xy data is the output.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 5, illustration 2 of 3.
 *
 * A unit cube under a 90 degree rotation about the z (vertical) axis.
 * Left panel: BEFORE. Right panel: AFTER. k-hat stays put through the
 * rotation; i-hat sweeps to where j-hat was, j-hat sweeps to the negative
 * x direction. The cube tilts in place; nothing changes height.
 */

const cos30 = 0.8660254;
const sin30 = 0.5;
const PANEL_W = 320;
const PANEL_X1 = 40;
const PANEL_X2 = 380;
const sXY = 36;
const sZ = 36;

// Per-panel local origin
function projAt(cx: number, cy: number, x: number, y: number, z: number): { X: number; Y: number } {
	return {
		X: cx + (x - y) * cos30 * sXY,
		Y: cy + (x + y) * sin30 * sXY - z * sZ,
	};
}

const cy = 220;
const c1 = PANEL_X1 + PANEL_W / 2 - 30;
const c2 = PANEL_X2 + PANEL_W / 2 - 30;

// BEFORE cube corners (unit cube at origin)
type C = { x: number; y: number; z: number };
const beforeCorners: C[] = [
	{ x: 0, y: 0, z: 0 }, // 0
	{ x: 1, y: 0, z: 0 }, // 1 = i-hat
	{ x: 1, y: 1, z: 0 }, // 2
	{ x: 0, y: 1, z: 0 }, // 3 = j-hat
	{ x: 0, y: 0, z: 1 }, // 4 = k-hat
	{ x: 1, y: 0, z: 1 }, // 5
	{ x: 1, y: 1, z: 1 }, // 6
	{ x: 0, y: 1, z: 1 }, // 7
];

// AFTER: rotate 90 deg counter-clockwise about z. R(x, y, z) = (-y, x, z).
function R(p: C): C {
	return { x: -p.y, y: p.x, z: p.z };
}
const afterCorners = beforeCorners.map(R);

// Edges by index pairs
const edges: [number, number][] = [
	[0, 1], [1, 2], [2, 3], [3, 0], // bottom face
	[4, 5], [5, 6], [6, 7], [7, 4], // top face
	[0, 4], [1, 5], [2, 6], [3, 7], // vertical edges
];

function projPanel(idx: 0 | 1, p: C) {
	const cxP = idx === 0 ? c1 : c2;
	return projAt(cxP, cy, p.x, p.y, p.z);
}

const TEAL = '#0d9488';
const AMBER = '#d97706';
const SKY = '#0284c7';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-cubez-title la-cubez-desc">
		<title id="la-cubez-title">A 90 degree rotation about z: k-hat stays put, i-hat and j-hat sweep around</title>
		<desc id="la-cubez-desc">Two side-by-side panels showing a unit cube before and after a 90 degree counter-clockwise rotation about the z axis. In the left panel, the cube sits at the origin with i-hat pointing along positive x in teal, j-hat along positive y in amber, and k-hat pointing up in sky blue. A circular arrow between the panels indicates the rotation. In the right panel, the cube has rotated about the vertical axis: i-hat now lies along positive y, j-hat now lies along negative x, and k-hat is unchanged because the rotation is around it.</desc>

		<defs>
			<marker id="la-cubez-arrow-i" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-cubez-arrow-j" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
			<marker id="la-cubez-arrow-k" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={SKY} />
			</marker>
			<marker id="la-cubez-arrow-rot" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		{/* panel 1 */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.85">BEFORE</text>

		{edges.map(([a, b]) => {
			const A = projPanel(0, beforeCorners[a]);
			const B = projPanel(0, beforeCorners[b]);
			return <line x1={A.X} y1={A.Y} x2={B.X} y2={B.Y} stroke={ACCENT} stroke-width="1" opacity="0.55" />;
		})}

		{/* basis arrows panel 1 */}
		{(() => {
			const O = projPanel(0, { x: 0, y: 0, z: 0 });
			const I = projPanel(0, { x: 1.2, y: 0, z: 0 });
			const J = projPanel(0, { x: 0, y: 1.2, z: 0 });
			const K = projPanel(0, { x: 0, y: 0, z: 1.2 });
			return (
				<g>
					<line x1={O.X} y1={O.Y} x2={I.X} y2={I.Y} stroke={TEAL} stroke-width="3" marker-end="url(#la-cubez-arrow-i)" />
					<line x1={O.X} y1={O.Y} x2={J.X} y2={J.Y} stroke={AMBER} stroke-width="3" marker-end="url(#la-cubez-arrow-j)" />
					<line x1={O.X} y1={O.Y} x2={K.X} y2={K.Y} stroke={SKY} stroke-width="3" marker-end="url(#la-cubez-arrow-k)" />
					<circle cx={O.X} cy={O.Y} r="2.6" fill="currentColor" />
					<text x={I.X + 6} y={I.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>î</text>
					<text x={J.X - 14} y={J.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={AMBER}>ĵ</text>
					<text x={K.X - 14} y={K.Y - 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={SKY}>k̂</text>
				</g>
			);
		})()}

		{/* panel 2 */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>AFTER (90° about z)</text>

		{edges.map(([a, b]) => {
			const A = projPanel(1, afterCorners[a]);
			const B = projPanel(1, afterCorners[b]);
			return <line x1={A.X} y1={A.Y} x2={B.X} y2={B.Y} stroke={ACCENT} stroke-width="1" opacity="0.55" />;
		})}

		{/* basis arrows panel 2 */}
		{(() => {
			const O = projPanel(1, { x: 0, y: 0, z: 0 });
			const I_after = projPanel(1, { x: 0, y: 1.2, z: 0 }); // R(i-hat scaled)
			const J_after = projPanel(1, { x: -1.2, y: 0, z: 0 }); // R(j-hat scaled)
			const K_after = projPanel(1, { x: 0, y: 0, z: 1.2 });
			return (
				<g>
					<line x1={O.X} y1={O.Y} x2={I_after.X} y2={I_after.Y} stroke={TEAL} stroke-width="3" marker-end="url(#la-cubez-arrow-i)" />
					<line x1={O.X} y1={O.Y} x2={J_after.X} y2={J_after.Y} stroke={AMBER} stroke-width="3" marker-end="url(#la-cubez-arrow-j)" />
					<line x1={O.X} y1={O.Y} x2={K_after.X} y2={K_after.Y} stroke={SKY} stroke-width="3" marker-end="url(#la-cubez-arrow-k)" />
					<circle cx={O.X} cy={O.Y} r="2.6" fill="currentColor" />
					<text x={I_after.X - 14} y={I_after.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>î'</text>
					<text x={J_after.X + 4} y={J_after.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={AMBER}>ĵ'</text>
					<text x={K_after.X - 14} y={K_after.Y - 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={SKY}>k̂' = k̂</text>
				</g>
			);
		})()}

		{/* rotation arc between panels */}
		<path d={`M ${PANEL_X1 + PANEL_W + 6} 180 A 18 18 0 0 1 ${PANEL_X1 + PANEL_W + 6} 220`} fill="none" stroke={ACCENT} stroke-width="2" marker-end="url(#la-cubez-arrow-rot)" />
		<text x={(PANEL_X1 + PANEL_W + PANEL_X2) / 2} y={155} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>R<tspan baseline-shift="sub" font-size="10">z</tspan>(90°)</text>
		<text x={(PANEL_X1 + PANEL_W + PANEL_X2) / 2} y={250} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.6">k̂ fixed</text>
	</svg>
	<figcaption>Rotation about z is the easiest 3D rotation: only the floor-level plane rotates, and the height direction k-hat is left alone. So the new k-hat is the same as the old; the new i-hat lands where j-hat used to be, and the new j-hat lands along negative x.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

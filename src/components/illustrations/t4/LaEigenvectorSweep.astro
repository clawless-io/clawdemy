---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 14, illustration 1 of 3.
 *
 * Sweep an input vector around the unit circle. For most angles, the
 * output (M·v in red) lies off the input's line through the origin. At
 * exactly two angles, the eigenvector directions, the output lands back
 * on the input's line. With M = [[2, 1], [1, 2]] the eigenvectors are
 * along [1, 1] (eigenvalue 3) and [1, -1] (eigenvalue 1).
 */

const cx = 220;
const cy = 200;
const u = 50;

const X_MIN = -3.5;
const X_MAX = 3.5;
const Y_MIN = -2.5;
const Y_MAX = 2.5;

const sx = (gx: number) => cx + gx * u;
const sy = (gy: number) => cy - gy * u;

// M = [[2, 1], [1, 2]]
function M(x: number, y: number): { x: number; y: number } {
	return { x: 2 * x + 1 * y, y: 1 * x + 2 * y };
}

// Sample 8 unit-circle angles for illustration.
const ANGLES = [0, 45, 90, 135, 180, 225, 270, 315];

const samples = ANGLES.map((deg) => {
	const a = (deg * Math.PI) / 180;
	const ix = Math.cos(a);
	const iy = Math.sin(a);
	const o = M(ix, iy);
	return { deg, ix, iy, ox: o.x, oy: o.y };
});

// Determine which samples are "aligned" with input (eigen direction).
function aligned(ix: number, iy: number, ox: number, oy: number): boolean {
	// cross product magnitude near 0 → parallel
	const cross = ix * oy - iy * ox;
	return Math.abs(cross) < 0.05;
}

const ACCENT = '#7c3aed';
const TEAL = '#0d9488';
const RED = '#ef4444';

void TEAL;
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-eigsweep-title la-eigsweep-desc">
		<title id="la-eigsweep-title">Sweep an input vector around the unit circle: at eigenvector directions the output is collinear with the input</title>
		<desc id="la-eigsweep-desc">A two-dimensional coordinate grid with a faint dashed unit circle around the origin. Eight purple input arrows of length 1 are drawn at 45 degree intervals around the circle. For each input, a red output arrow shows M times that input. For most input angles, the red output is in a different direction than the purple input. For two specific input angles, along [1, 1] and along [1, negative 1], the red output lies exactly on the same line through the origin as the input, indicating eigenvector directions.</desc>

		<defs>
			<marker id="la-eigsw-arrow-in" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
			<marker id="la-eigsw-arrow-out" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={RED} />
			</marker>
		</defs>

		{/* axes only (no grid; cleaner for the circle sweep) */}
		<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		{/* unit circle (dashed) */}
		<circle cx={sx(0)} cy={sy(0)} r={u} fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" stroke-dasharray="3 3" />

		{/* eigenvector lines (highlighted) */}
		<line x1={sx(-3)} y1={sy(-3)} x2={sx(3)} y2={sy(3)} stroke={ACCENT} stroke-width="1.4" stroke-dasharray="6 4" opacity="0.45" />
		<line x1={sx(-3)} y1={sy(3)} x2={sx(3)} y2={sy(-3)} stroke={ACCENT} stroke-width="1.4" stroke-dasharray="6 4" opacity="0.45" />

		{samples.map((s) => {
			const onEig = aligned(s.ix, s.iy, s.ox, s.oy);
			return (
				<g>
					{/* input arrow (short, on unit circle) */}
					<line x1={sx(0)} y1={sy(0)} x2={sx(s.ix)} y2={sy(s.iy)} stroke={ACCENT} stroke-width={onEig ? 2.8 : 1.8} opacity={onEig ? 0.95 : 0.55} marker-end="url(#la-eigsw-arrow-in)" />
					{/* output arrow (longer, may diverge) */}
					<line x1={sx(0)} y1={sy(0)} x2={sx(s.ox)} y2={sy(s.oy)} stroke={RED} stroke-width={onEig ? 2 : 1.2} stroke-dasharray={onEig ? '' : '4 3'} opacity={onEig ? 0.85 : 0.45} marker-end="url(#la-eigsw-arrow-out)" />
				</g>
			);
		})}

		<circle cx={sx(0)} cy={sy(0)} r="3" fill="currentColor" />

		{/* eigen labels at the corners */}
		<text x={sx(2.4)} y={sy(2.4) + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>eigen line: [1, 1], λ = 3</text>
		<text x={sx(2.4)} y={sy(-2.4) - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT}>eigen line: [1, -1], λ = 1</text>

		{/* legend */}
		<g transform="translate(440, 80)">
			<rect x="0" y="0" width="280" height="160" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="280" height="160" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="140" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">M = [[2, 1], [1, 2]]</text>
			<line x1="40" y1="48" x2="80" y2="48" stroke={ACCENT} stroke-width="2.5" marker-end="url(#la-eigsw-arrow-in)" />
			<text x="90" y="52" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={ACCENT}>unit input v</text>
			<line x1="40" y1="74" x2="80" y2="74" stroke={RED} stroke-width="1.8" stroke-dasharray="4 3" marker-end="url(#la-eigsw-arrow-out)" />
			<text x="90" y="78" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={RED}>M·v output</text>
			<text x="140" y="106" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">
				eigenvector = direction where
			</text>
			<text x="140" y="122" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.65">
				M·v lies on the same line as v
			</text>
			<text x="140" y="146" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={ACCENT}>
				M·v = λ·v at eigenvectors
			</text>
		</g>
	</svg>
	<figcaption>Sweep an input vector around the unit circle; for most directions, M sends the output off that direction's line. At exactly two directions (along [1, 1] and [1, -1] here), the output stays on the same line as the input. Those are the eigenvectors; the stretching factors 3 and 1 are the eigenvalues.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 2, illustration 1 of 5.
 *
 * The span of a single nonzero vector. v = [2, 1] from the origin, with
 * faint copies at 2v, 0.5v, and -3v showing that every scalar multiple
 * lands on the same straight line through the origin. The line itself
 * is drawn through the grid to make the point explicit: the span of one
 * vector is a line.
 */

const cx = 360;
const cy = 195;
const u = 38;

const X_MIN = -7;
const X_MAX = 6;
const Y_MIN = -3;
const Y_MAX = 3;

const sx = (gx: number) => cx + gx * u;
const sy = (gy: number) => cy - gy * u;

const xs: number[] = [];
for (let i = X_MIN; i <= X_MAX; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j <= Y_MAX; j++) ys.push(j);

const v = { x: 2, y: 1 };
const scales = [2, 0.5, -3];

// Span line endpoints: parametrize through origin at the steepest extent of
// the visible grid, t = scalar parameter.
const lineExt = 8;
const lineStart = { X: sx(-lineExt * v.x), Y: sy(-lineExt * v.y) };
const lineEnd = { X: sx(lineExt * v.x), Y: sy(lineExt * v.y) };

const TEAL = '#0d9488';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-span1-title la-span1-desc">
		<title id="la-span1-title">The span of one vector is a line: every scalar multiple lies on the same line through the origin</title>
		<desc id="la-span1-desc">A two-dimensional coordinate grid. A teal arrow shows the vector v equal to [2, 1] from the origin. Three faint copies of the arrow show 2 times v reaching [4, 2], half v reaching [1, 0.5], and negative three v reaching [negative 6, negative 3] on the opposite side. A dashed accent-colored line runs through the origin along the direction of v, extending across the full grid, indicating that the set of all scalar multiples of v traces out exactly this line.</desc>

		<defs>
			<marker id="la-span1-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-span1-arrow-faint" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} opacity="0.45" />
			</marker>
		</defs>

		{xs.map((i) => (
			<line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
		))}
		{ys.map((j) => (
			<line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
		))}

		<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		{/* the span line itself: drawn under the vectors so the arrows sit on top */}
		<line x1={lineStart.X} y1={lineStart.Y} x2={lineEnd.X} y2={lineEnd.Y} stroke={ACCENT} stroke-width="1.4" stroke-dasharray="6 4" opacity="0.55" />

		{/* faint scalar copies first */}
		{scales.map((s) => (
			<line x1={sx(0)} y1={sy(0)} x2={sx(v.x * s)} y2={sy(v.y * s)} stroke={TEAL} stroke-width="1.8" opacity="0.4" marker-end="url(#la-span1-arrow-faint)" />
		))}

		{/* the primary v arrow on top */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(v.x)} y2={sy(v.y)} stroke={TEAL} stroke-width="2.6" marker-end="url(#la-span1-arrow)" />

		<circle cx={sx(0)} cy={sy(0)} r="3" fill="currentColor" />

		{/* labels for v and the scalar copies */}
		<text x={sx(v.x) + 6} y={sy(v.y) - 8} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>v = [2, 1]</text>
		<text x={sx(2 * v.x) + 6} y={sy(2 * v.y) - 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={TEAL} opacity="0.7">2v</text>
		<text x={sx(0.5 * v.x) + 4} y={sy(0.5 * v.y) + 16} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={TEAL} opacity="0.7">0.5v</text>
		<text x={sx(-3 * v.x) - 6} y={sy(-3 * v.y) + 16} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={TEAL} opacity="0.7">-3v</text>

		{/* span label */}
		<text x={sx(X_MAX) - 8} y={sy(Y_MIN) + 28} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={ACCENT} opacity="0.85">span(v) = this line</text>
	</svg>
	<figcaption>Every scalar multiple of v lands somewhere on the same line through the origin. That line, all the scalar multiples taken together, is the span of v. The span of one nonzero vector is always a line.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

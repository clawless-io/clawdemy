---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 11, illustration 1 of 1.
 *
 * The 3D parallelepiped spanned by three vectors p, v, w from the origin,
 * with its volume labeled as det([p | v | w]). This is the central object of
 * the duality derivation of the cross product: f(p) = signed volume of the
 * box formed by p, v, w, viewed as a linear function of p. Isometric
 * projection, translucent fill to hint at volume, the three spanning vectors
 * drawn as colored arrows from the origin so you can read them off.
 */

const cos30 = 0.8660254;
const sin30 = 0.5;
const cx = 320;
const cy = 230;
const sXY = 78;
const sZ = 70;

// (x, y, z) -> screen. x goes down-right, y goes down-left, z points up.
function proj(x: number, y: number, z: number): { X: number; Y: number } {
	return {
		X: cx + (x - y) * cos30 * sXY,
		Y: cy + (x + y) * sin30 * sXY - z * sZ,
	};
}

// The three spanning vectors. Chosen so the box reads cleanly: v sweeps
// right along the floor, w sweeps left along the floor, p rises mostly up
// with a small forward tilt so it does not overlap the v/w base.
const p = { x: 0.25, y: 0.3, z: 1.45 };
const v = { x: 1.55, y: -0.25, z: 0.05 };
const w = { x: -0.2, y: 1.4, z: 0.1 };

const O = proj(0, 0, 0);
const P = proj(p.x, p.y, p.z);
const V = proj(v.x, v.y, v.z);
const W = proj(w.x, w.y, w.z);
const PV = proj(p.x + v.x, p.y + v.y, p.z + v.z);
const PW = proj(p.x + w.x, p.y + w.y, p.z + w.z);
const VW = proj(v.x + w.x, v.y + w.y, v.z + w.z);
const PVW = proj(p.x + v.x + w.x, p.y + v.y + w.y, p.z + v.z + w.z);

// Faces, in back-to-front draw order for honest occlusion. The "back" of
// the box (the V+W corner away from the viewer) and its two adjoining
// vertical faces get drawn first; the floor next; the visible top and the
// two front vertical faces last.
const back1 = `M ${V.X} ${V.Y} L ${VW.X} ${VW.Y} L ${PVW.X} ${PVW.Y} L ${PV.X} ${PV.Y} Z`;
const back2 = `M ${W.X} ${W.Y} L ${VW.X} ${VW.Y} L ${PVW.X} ${PVW.Y} L ${PW.X} ${PW.Y} Z`;
const floor = `M ${O.X} ${O.Y} L ${V.X} ${V.Y} L ${VW.X} ${VW.Y} L ${W.X} ${W.Y} Z`;
const front1 = `M ${O.X} ${O.Y} L ${V.X} ${V.Y} L ${PV.X} ${PV.Y} L ${P.X} ${P.Y} Z`;
const front2 = `M ${O.X} ${O.Y} L ${W.X} ${W.Y} L ${PW.X} ${PW.Y} L ${P.X} ${P.Y} Z`;
const top = `M ${P.X} ${P.Y} L ${PV.X} ${PV.Y} L ${PVW.X} ${PVW.Y} L ${PW.X} ${PW.Y} Z`;

// Axes for grounding. Short stubs from the origin, lower opacity.
const axEnd = (ax: number, ay: number, az: number) => proj(ax * 1.85, ay * 1.85, az * 1.85);
const AX = axEnd(1, 0, 0);
const AY = axEnd(0, 1, 0);
const AZ = axEnd(0, 0, 1);

// Label offsets a bit past each arrow tip so they read clearly.
const labelP = { X: P.X - 18, Y: P.Y - 6 };
const labelV = { X: V.X + 14, Y: V.Y + 14 };
const labelW = { X: W.X - 18, Y: W.Y + 14 };

const ACCENT = '#7c3aed'; // p: the variable vector, picked out in the accent
const TEAL = '#0d9488'; // v
const AMBER = '#d97706'; // w
---

<figure class="cw-illus">
	<svg viewBox="0 0 760 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-pp-det-title la-pp-det-desc">
		<title id="la-pp-det-title">A parallelepiped spanned by three vectors p, v, w from the origin, its volume equal to det([p | v | w])</title>
		<desc id="la-pp-det-desc">Three vectors p, v, w drawn as arrows from a common origin in 3D, drawn in axonometric projection. The vector v sweeps right along the floor, w sweeps left along the floor, p rises upward. Together they span a slanted box, a parallelepiped, drawn as a translucent solid with all twelve edges visible and the back face lightly tinted. A label at the bottom reads "Volume of the box = det([ p | v | w ])". The diagram visualizes the central object of the duality derivation, the signed volume of the box formed by p, v, w as a function of p.</desc>

		<defs>
			<marker id="la-pp-det-arrow-p" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
			<marker id="la-pp-det-arrow-v" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-pp-det-arrow-w" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
			<marker id="la-pp-det-arrow-ax" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
			</marker>
		</defs>

		<!-- axes (background scaffold) -->
		<line x1={O.X} y1={O.Y} x2={AX.X} y2={AX.Y} stroke="currentColor" stroke-width="1" opacity="0.25" marker-end="url(#la-pp-det-arrow-ax)" />
		<line x1={O.X} y1={O.Y} x2={AY.X} y2={AY.Y} stroke="currentColor" stroke-width="1" opacity="0.25" marker-end="url(#la-pp-det-arrow-ax)" />
		<line x1={O.X} y1={O.Y} x2={AZ.X} y2={AZ.Y} stroke="currentColor" stroke-width="1" opacity="0.25" marker-end="url(#la-pp-det-arrow-ax)" />
		<text x={AX.X + 6} y={AX.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.5">x</text>
		<text x={AY.X - 12} y={AY.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.5">y</text>
		<text x={AZ.X - 4} y={AZ.Y - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.5">z</text>

		<!-- parallelepiped: back faces and floor first, then front faces, then top.
		     translucent fills hint at the solid volume; edges sit on top. -->
		<path d={back1} fill={ACCENT} fill-opacity="0.06" stroke="currentColor" stroke-width="0.9" opacity="0.45" />
		<path d={back2} fill={ACCENT} fill-opacity="0.06" stroke="currentColor" stroke-width="0.9" opacity="0.45" />
		<path d={floor} fill={ACCENT} fill-opacity="0.08" stroke="currentColor" stroke-width="0.9" opacity="0.6" />
		<path d={front1} fill={ACCENT} fill-opacity="0.10" stroke="currentColor" stroke-width="1.1" opacity="0.85" />
		<path d={front2} fill={ACCENT} fill-opacity="0.10" stroke="currentColor" stroke-width="1.1" opacity="0.85" />
		<path d={top} fill={ACCENT} fill-opacity="0.14" stroke="currentColor" stroke-width="1.1" opacity="0.95" />

		<!-- the three spanning vectors as colored arrows from the origin -->
		<line x1={O.X} y1={O.Y} x2={V.X} y2={V.Y} stroke={TEAL} stroke-width="2.4" marker-end="url(#la-pp-det-arrow-v)" />
		<line x1={O.X} y1={O.Y} x2={W.X} y2={W.Y} stroke={AMBER} stroke-width="2.4" marker-end="url(#la-pp-det-arrow-w)" />
		<line x1={O.X} y1={O.Y} x2={P.X} y2={P.Y} stroke={ACCENT} stroke-width="2.6" marker-end="url(#la-pp-det-arrow-p)" />

		<!-- origin dot -->
		<circle cx={O.X} cy={O.Y} r="3" fill="currentColor" />

		<!-- vector labels -->
		<text x={labelP.X} y={labelP.Y} font-family="ui-monospace, SFMono-Regular, monospace" font-size="15" font-weight="700" fill={ACCENT}>p</text>
		<text x={labelV.X} y={labelV.Y} font-family="ui-monospace, SFMono-Regular, monospace" font-size="15" font-weight="700" fill={TEAL}>v</text>
		<text x={labelW.X} y={labelW.Y} font-family="ui-monospace, SFMono-Regular, monospace" font-size="15" font-weight="700" fill={AMBER}>w</text>

		<!-- volume label -->
		<text x="380" y="328" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="13" fill="currentColor" opacity="0.85">
			Volume of the box = <tspan font-family="ui-monospace, SFMono-Regular, monospace" font-weight="700">det( [ <tspan fill={ACCENT}>p</tspan> | <tspan fill={TEAL}>v</tspan> | <tspan fill={AMBER}>w</tspan> ] )</tspan>
		</text>
	</svg>
	<figcaption>Three vectors from the origin span a slanted box, a parallelepiped. Its signed volume is exactly the determinant of the matrix whose columns are those three vectors. Fix v and w, vary p, and the volume becomes a function of p alone, which is the function we are about to turn into a dot product.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 760px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 2, illustration 2 of 5.
 *
 * Two non-collinear vectors v and w from the origin. Because they point in
 * different directions, every point in the 2D plane can be reached as some
 * combination of v and w. The entire visible grid is tinted in the accent
 * color to make the point explicit: span(v, w) is all of 2D.
 */

const cx = 360;
const cy = 200;
const u = 38;

const X_MIN = -6;
const X_MAX = 6;
const Y_MIN = -3;
const Y_MAX = 3;

const sx = (gx: number) => cx + gx * u;
const sy = (gy: number) => cy - gy * u;

const xs: number[] = [];
for (let i = X_MIN; i <= X_MAX; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j <= Y_MAX; j++) ys.push(j);

const v = { x: 2, y: 1 };
const w = { x: -1, y: 2 };

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';

const tintX = sx(X_MIN);
const tintY = sy(Y_MAX);
const tintW = (X_MAX - X_MIN) * u;
const tintH = (Y_MAX - Y_MIN) * u;
---

<figure class="cw-illus">
	<svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-span2p-title la-span2p-desc">
		<title id="la-span2p-title">Two non-collinear vectors span the entire 2D plane</title>
		<desc id="la-span2p-desc">A two-dimensional coordinate grid tinted lightly in an accent purple to indicate the spanned region. A teal arrow shows the vector v from the origin and an amber arrow shows the vector w from the origin, pointing in clearly different directions. The label "span(v, w) = all of 2D" sits near the top of the grid, indicating that every point in the plane can be reached as some combination of v and w.</desc>

		<defs>
			<marker id="la-span2p-arrow-v" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-span2p-arrow-w" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
		</defs>

		{/* tinted span region: the whole visible plane */}
		<rect x={tintX} y={tintY} width={tintW} height={tintH} fill={ACCENT} opacity="0.07" />

		{xs.map((i) => (
			<line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
		))}
		{ys.map((j) => (
			<line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
		))}

		<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		{/* the two vectors */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(v.x)} y2={sy(v.y)} stroke={TEAL} stroke-width="2.6" marker-end="url(#la-span2p-arrow-v)" />
		<line x1={sx(0)} y1={sy(0)} x2={sx(w.x)} y2={sy(w.y)} stroke={AMBER} stroke-width="2.6" marker-end="url(#la-span2p-arrow-w)" />

		<circle cx={sx(0)} cy={sy(0)} r="3" fill="currentColor" />

		<text x={sx(v.x) + 6} y={sy(v.y) - 8} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>v</text>
		<text x={sx(w.x) - 10} y={sy(w.y) - 8} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={AMBER}>w</text>

		<text x={sx(X_MAX) - 10} y={sy(Y_MAX) + 22} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT} opacity="0.9">span(v, w) = all of 2D</text>
	</svg>
	<figcaption>Two vectors pointing in different directions: by scaling each and adding, you can land on any point in the plane. The span is the whole 2D plane, shown tinted behind the arrows.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

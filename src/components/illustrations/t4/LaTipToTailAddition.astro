---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 1, illustration 2 of 3.
 *
 * The geometric meaning of vector addition: tip-to-tail. [1, 2] starts at
 * the origin; [3, 1] starts at the tip of [1, 2]; the resultant [4, 3] is
 * the arrow from the origin straight to the final tip. The two component
 * sums (1+3=4, 2+1=3) are the arithmetic version of the same picture.
 */

const cx = 200;
const cy = 290;
const u = 48;

const X_MIN = -1;
const X_MAX = 6;
const Y_MIN = -1;
const Y_MAX = 5;

const sx = (gx: number) => cx + gx * u;
const sy = (gy: number) => cy - gy * u;

const xs: number[] = [];
for (let i = X_MIN; i <= X_MAX; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j <= Y_MAX; j++) ys.push(j);

// The three vectors. v1 from origin. v2 from tip of v1. sum from origin to
// tip of v2.
const v1 = { x: 1, y: 2 };
const v2 = { x: 3, y: 1 };
const sum = { x: v1.x + v2.x, y: v1.y + v2.y };

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-tiptail-title la-tiptail-desc">
		<title id="la-tiptail-title">Tip-to-tail vector addition: [1, 2] plus [3, 1] equals [4, 3]</title>
		<desc id="la-tiptail-desc">A two-dimensional coordinate grid showing three arrows. A teal arrow labeled [1, 2] goes from the origin to (1, 2). An amber arrow labeled [3, 1] starts at the tip of the teal arrow and ends at (4, 3). A bold purple arrow labeled [4, 3] goes straight from the origin to (4, 3), illustrating that adding two vectors tip-to-tail produces the same endpoint as adding their components.</desc>

		<defs>
			<marker id="la-tiptail-arrow-1" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-tiptail-arrow-2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
			<marker id="la-tiptail-arrow-sum" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		<!-- grid -->
		{xs.map((i) => (
			<line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.6" opacity="0.13" />
		))}
		{ys.map((j) => (
			<line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.6" opacity="0.13" />
		))}

		<!-- axes -->
		<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="1.2" opacity="0.55" />
		<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="1.2" opacity="0.55" />

		{xs.filter((i) => i !== 0).map((i) => (
			<text x={sx(i)} y={sy(0) + 16} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.55">{i}</text>
		))}
		{ys.filter((j) => j !== 0).map((j) => (
			<text x={sx(0) - 10} y={sy(j) + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.55">{j}</text>
		))}

		<text x={sx(X_MAX) + 6} y={sy(0) + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.7">x</text>
		<text x={sx(0) + 6} y={sy(Y_MAX) - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.7">y</text>

		<!-- v1 from origin -->
		<line x1={sx(0)} y1={sy(0)} x2={sx(v1.x)} y2={sy(v1.y)} stroke={TEAL} stroke-width="2.4" marker-end="url(#la-tiptail-arrow-1)" />

		<!-- v2 from tip of v1 -->
		<line x1={sx(v1.x)} y1={sy(v1.y)} x2={sx(sum.x)} y2={sy(sum.y)} stroke={AMBER} stroke-width="2.4" marker-end="url(#la-tiptail-arrow-2)" />

		<!-- sum: origin to final tip -->
		<line x1={sx(0)} y1={sy(0)} x2={sx(sum.x)} y2={sy(sum.y)} stroke={ACCENT} stroke-width="2.8" marker-end="url(#la-tiptail-arrow-sum)" />

		<!-- origin dot -->
		<circle cx={sx(0)} cy={sy(0)} r="3" fill="currentColor" />

		<!-- vector labels: place each near its midpoint, offset a bit so they
		     don't overlap the arrows themselves -->
		<text x={sx(v1.x / 2) - 22} y={sy(v1.y / 2) - 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>[1, 2]</text>
		<text x={sx(v1.x + v2.x / 2) + 8} y={sy(v1.y + v2.y / 2) - 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={AMBER}>[3, 1]</text>
		<text x={sx(sum.x / 2) + 6} y={sy(sum.y / 2) + 22} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>[4, 3]</text>

		<!-- arithmetic note in the upper right -->
		<g transform="translate(490, 70)">
			<rect x="0" y="0" width="190" height="64" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="190" height="64" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="95" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">component sum:</text>
			<text x="95" y="48" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor">
				<tspan fill={TEAL}>[1, 2]</tspan> + <tspan fill={AMBER}>[3, 1]</tspan> = <tspan fill={ACCENT}>[4, 3]</tspan>
			</text>
		</g>
	</svg>
	<figcaption>To add two vectors, walk along the first one, then walk along the second one starting from where you ended. The arrow straight from your start to your finish is the sum. The arithmetic (add the components) and the geometry (walk tip-to-tail) are the same picture.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 5, illustration 1 of 3.
 *
 * The 3D standard basis i-hat, j-hat, k-hat along x, y, z, with the vector
 * [3, 4, 5] reached by stepping 3 along i-hat, then 4 along j-hat, then 5
 * along k-hat. The three short bold unit arrows at the origin establish
 * the basis; the dashed step-path makes the decomposition visible.
 */

const cos30 = 0.8660254;
const sin30 = 0.5;
const cx = 220;
const cy = 250;
const sXY = 38;
const sZ = 32;

function proj(x: number, y: number, z: number): { X: number; Y: number } {
	return {
		X: cx + (x - y) * cos30 * sXY,
		Y: cy + (x + y) * sin30 * sXY - z * sZ,
	};
}

const O = proj(0, 0, 0);
const I = proj(1, 0, 0);
const J = proj(0, 1, 0);
const K = proj(0, 0, 1);

// step path: from origin, three steps along i-hat, then four along j-hat,
// then five along k-hat, ending at [3, 4, 5].
const stepPath: { X: number; Y: number }[] = [];
for (let i = 0; i < 4; i++) stepPath.push(proj(i, 0, 0));
for (let j = 0; j < 5; j++) stepPath.push(proj(3, j, 0));
for (let k = 0; k < 6; k++) stepPath.push(proj(3, 4, k));

const target = proj(3, 4, 5);

// scaffold axes a bit beyond the target so the bounding context is clear
const axEnd = (ax: number, ay: number, az: number) => proj(ax, ay, az);
const AX = axEnd(7, 0, 0);
const AY = axEnd(0, 6.5, 0);
const AZ = axEnd(0, 0, 7);

const TEAL = '#0d9488';
const AMBER = '#d97706';
const SKY = '#0284c7'; // k-hat color
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-3dbasis-title la-3dbasis-desc">
		<title id="la-3dbasis-title">The 3D standard basis i-hat, j-hat, k-hat decompose [3, 4, 5] as 3 i-hat plus 4 j-hat plus 5 k-hat</title>
		<desc id="la-3dbasis-desc">A three-dimensional coordinate scene in axonometric projection. Three short bold unit arrows at the origin: a teal i-hat along the x axis, an amber j-hat along the y axis, and a sky-blue k-hat along the z axis. A dashed path traces the decomposition: three steps along x, then four steps along y, then five steps upward along z, arriving at [3, 4, 5]. A bold purple arrow runs from the origin straight to the same point, labeled "[3, 4, 5] = 3 i-hat plus 4 j-hat plus 5 k-hat".</desc>

		<defs>
			<marker id="la-3db-arrow-i" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-3db-arrow-j" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
			<marker id="la-3db-arrow-k" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={SKY} />
			</marker>
			<marker id="la-3db-arrow-p" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
			<marker id="la-3db-arrow-ax" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
			</marker>
		</defs>

		{/* axes scaffold (long, faint) */}
		<line x1={O.X} y1={O.Y} x2={AX.X} y2={AX.Y} stroke="currentColor" stroke-width="1" opacity="0.22" marker-end="url(#la-3db-arrow-ax)" />
		<line x1={O.X} y1={O.Y} x2={AY.X} y2={AY.Y} stroke="currentColor" stroke-width="1" opacity="0.22" marker-end="url(#la-3db-arrow-ax)" />
		<line x1={O.X} y1={O.Y} x2={AZ.X} y2={AZ.Y} stroke="currentColor" stroke-width="1" opacity="0.22" marker-end="url(#la-3db-arrow-ax)" />
		<text x={AX.X + 6} y={AX.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.5">x</text>
		<text x={AY.X - 12} y={AY.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.5">y</text>
		<text x={AZ.X - 4} y={AZ.Y - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.5">z</text>

		{/* step path: dashed, layered by leg */}
		{stepPath.slice(0, stepPath.length - 1).map((pt, idx) => {
			const nxt = stepPath[idx + 1];
			let col: string;
			if (idx < 3) col = TEAL;
			else if (idx < 3 + 4) col = AMBER;
			else col = SKY;
			return <line x1={pt.X} y1={pt.Y} x2={nxt.X} y2={nxt.Y} stroke={col} stroke-width="1.4" opacity="0.55" stroke-dasharray="3 3" />;
		})}

		{/* basis arrows (bold) */}
		<line x1={O.X} y1={O.Y} x2={I.X} y2={I.Y} stroke={TEAL} stroke-width="3" marker-end="url(#la-3db-arrow-i)" />
		<line x1={O.X} y1={O.Y} x2={J.X} y2={J.Y} stroke={AMBER} stroke-width="3" marker-end="url(#la-3db-arrow-j)" />
		<line x1={O.X} y1={O.Y} x2={K.X} y2={K.Y} stroke={SKY} stroke-width="3" marker-end="url(#la-3db-arrow-k)" />

		{/* the resulting vector */}
		<line x1={O.X} y1={O.Y} x2={target.X} y2={target.Y} stroke={ACCENT} stroke-width="2.6" marker-end="url(#la-3db-arrow-p)" />

		<circle cx={O.X} cy={O.Y} r="3" fill="currentColor" />

		{/* labels */}
		<text x={I.X + 6} y={I.Y + 16} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>î</text>
		<text x={J.X - 16} y={J.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={AMBER}>ĵ</text>
		<text x={K.X - 16} y={K.Y - 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={SKY}>k̂</text>

		<text x={target.X + 10} y={target.Y - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>[3, 4, 5]</text>

		{/* legend */}
		<g transform="translate(450, 250)">
			<rect x="0" y="0" width="270" height="78" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="270" height="78" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="135" y="22" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">decomposition into basis:</text>
			<text x="135" y="46" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor">
				<tspan fill={ACCENT}>[3, 4, 5]</tspan> = 3 <tspan fill={TEAL}>î</tspan> + 4 <tspan fill={AMBER}>ĵ</tspan> + 5 <tspan fill={SKY}>k̂</tspan>
			</text>
			<text x="135" y="66" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="currentColor" opacity="0.55">three steps right, four back, five up</text>
		</g>
	</svg>
	<figcaption>The 3D standard basis adds one direction to the 2D one: k-hat points up along z. Any 3D vector is just so many î plus so many ĵ plus so many k̂. The triple [3, 4, 5] is the recipe for the walk: three right, four back, five up.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

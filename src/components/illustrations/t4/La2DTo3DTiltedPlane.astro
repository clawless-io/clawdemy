---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 8, illustration 1 of 2.
 *
 * A 3 by 2 matrix takes a 2D input plane and lands it as a tilted 2D plane
 * sitting inside 3D space. Left panel: the flat 2D source plane with its
 * i-hat and j-hat. Right panel: the same plane after L, now a tilted patch
 * embedded in 3D space, spanned by the two 3D column vectors L(i-hat) and
 * L(j-hat). The output is still 2D (a plane), but it lives in a bigger
 * room.
 */

const cos30 = 0.8660254;
const sin30 = 0.5;
const PANEL_W = 340;
const PANEL_X1 = 20;
const PANEL_X2 = 380;

// Left panel: 2D flat source
const cy0 = 220;
const u0 = 42;
const o0X = PANEL_X1 + PANEL_W / 2;

// Right panel: 3D isometric
const cy1 = 215;
const sXY = 36;
const sZ = 36;
const c1X = PANEL_X2 + PANEL_W / 2;

function proj3(x: number, y: number, z: number): { X: number; Y: number } {
	return {
		X: c1X + (x - y) * cos30 * sXY,
		Y: cy1 + (x + y) * sin30 * sXY - z * sZ,
	};
}

// L: 3 by 2. Columns L(i-hat) = (1, 0, 0.5), L(j-hat) = (0.4, 1, 0.7).
const Li3 = { x: 1, y: 0, z: 0.5 };
const Lj3 = { x: 0.4, y: 1, z: 0.7 };

const X_MIN2 = -1;
const X_MAX2 = 2;
const Y_MIN2 = -1;
const Y_MAX2 = 2;

const xs2: number[] = [];
for (let i = X_MIN2; i < X_MAX2 + 1; i++) xs2.push(i);
const ys2: number[] = [];
for (let j = Y_MIN2; j < Y_MAX2 + 1; j++) ys2.push(j);

const sx0 = (gx: number) => o0X + gx * u0;
const sy0 = (gy: number) => cy0 - gy * u0;

// The tilted patch corners in 3D: spanned by ±1.4 L(i-hat) and ±1.4 L(j-hat).
const ext = 1.4;
const P1 = proj3(ext * Li3.x + ext * Lj3.x, ext * Li3.y + ext * Lj3.y, ext * Li3.z + ext * Lj3.z);
const P2 = proj3(ext * Li3.x - ext * Lj3.x, ext * Li3.y - ext * Lj3.y, ext * Li3.z - ext * Lj3.z);
const P3 = proj3(-ext * Li3.x - ext * Lj3.x, -ext * Li3.y - ext * Lj3.y, -ext * Li3.z - ext * Lj3.z);
const P4 = proj3(-ext * Li3.x + ext * Lj3.x, -ext * Li3.y + ext * Lj3.y, -ext * Li3.z + ext * Lj3.z);
const tiltPath = `M ${P1.X} ${P1.Y} L ${P2.X} ${P2.Y} L ${P3.X} ${P3.Y} L ${P4.X} ${P4.Y} Z`;

const O3 = proj3(0, 0, 0);
const LI3 = proj3(Li3.x, Li3.y, Li3.z);
const LJ3 = proj3(Lj3.x, Lj3.y, Lj3.z);

// 3D scaffold axes
const AX = proj3(1.8, 0, 0);
const AY = proj3(0, 1.8, 0);
const AZ = proj3(0, 0, 1.8);

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-2dto3d-title la-2dto3d-desc">
		<title id="la-2dto3d-title">A 3 by 2 matrix maps a 2D input plane to a tilted 2D plane inside 3D space</title>
		<desc id="la-2dto3d-desc">Two side-by-side panels. The left panel shows a flat 2D source plane with the standard grid, a teal i-hat, and an amber j-hat. The right panel shows 3D space in isometric projection with faint x, y, z axes. A tilted translucent purple parallelogram sits in 3D, spanned by two 3D column vectors L of i-hat equals [1, 0, 0.5] in teal and L of j-hat equals [0.4, 1, 0.7] in amber, both originating at the origin. The label "image of L (a 2D plane inside 3D)" sits near the patch.</desc>

		<defs>
			<marker id="la-2dto3d-arrow-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-2dto3d-arrow-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
			<marker id="la-2dto3d-arrow-ax" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
			</marker>
		</defs>

		{/* left: source 2D */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.85">2D source plane</text>

		{xs2.map((i) => <line x1={sx0(i)} y1={sy0(Y_MIN2)} x2={sx0(i)} y2={sy0(Y_MAX2)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		{ys2.map((j) => <line x1={sx0(X_MIN2)} y1={sy0(j)} x2={sx0(X_MAX2)} y2={sy0(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		<line x1={sx0(X_MIN2)} y1={sy0(0)} x2={sx0(X_MAX2)} y2={sy0(0)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />
		<line x1={sx0(0)} y1={sy0(Y_MIN2)} x2={sx0(0)} y2={sy0(Y_MAX2)} stroke="currentColor" stroke-width="0.9" opacity="0.45" />

		<line x1={sx0(0)} y1={sy0(0)} x2={sx0(1)} y2={sy0(0)} stroke={TEAL} stroke-width="3" marker-end="url(#la-2dto3d-arrow-t)" />
		<line x1={sx0(0)} y1={sy0(0)} x2={sx0(0)} y2={sy0(1)} stroke={AMBER} stroke-width="3" marker-end="url(#la-2dto3d-arrow-a)" />
		<circle cx={sx0(0)} cy={sy0(0)} r="2.6" fill="currentColor" />

		<text x={sx0(1) + 4} y={sy0(0) + 16} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={TEAL}>î</text>
		<text x={sx0(0) - 16} y={sy0(1) + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={AMBER}>ĵ</text>

		{/* right: 3D output */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>3D output space</text>

		<line x1={O3.X} y1={O3.Y} x2={AX.X} y2={AX.Y} stroke="currentColor" stroke-width="1" opacity="0.22" marker-end="url(#la-2dto3d-arrow-ax)" />
		<line x1={O3.X} y1={O3.Y} x2={AY.X} y2={AY.Y} stroke="currentColor" stroke-width="1" opacity="0.22" marker-end="url(#la-2dto3d-arrow-ax)" />
		<line x1={O3.X} y1={O3.Y} x2={AZ.X} y2={AZ.Y} stroke="currentColor" stroke-width="1" opacity="0.22" marker-end="url(#la-2dto3d-arrow-ax)" />
		<text x={AX.X + 4} y={AX.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.5">x</text>
		<text x={AY.X - 12} y={AY.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.5">y</text>
		<text x={AZ.X - 4} y={AZ.Y - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.5">z</text>

		<path d={tiltPath} fill={ACCENT} fill-opacity="0.14" stroke={ACCENT} stroke-width="1" opacity="0.65" />

		<line x1={O3.X} y1={O3.Y} x2={LI3.X} y2={LI3.Y} stroke={TEAL} stroke-width="3" marker-end="url(#la-2dto3d-arrow-t)" />
		<line x1={O3.X} y1={O3.Y} x2={LJ3.X} y2={LJ3.Y} stroke={AMBER} stroke-width="3" marker-end="url(#la-2dto3d-arrow-a)" />

		<circle cx={O3.X} cy={O3.Y} r="2.6" fill="currentColor" />

		<text x={LI3.X + 4} y={LI3.Y + 16} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={TEAL}>L(î) = [1, 0, 0.5]</text>
		<text x={LJ3.X - 8} y={LJ3.Y - 6} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={AMBER}>L(ĵ) = [0.4, 1, 0.7]</text>

		<text x={PANEL_X2 + PANEL_W / 2} y={325} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={ACCENT}>image of L = a 2D plane inside 3D</text>
	</svg>
	<figcaption>A 3 by 2 matrix takes 2D input vectors and produces 3D output vectors. The image of the input plane is still a flat 2D plane; it just sits tilted inside the 3D output space, spanned by the matrix's two 3D column vectors.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

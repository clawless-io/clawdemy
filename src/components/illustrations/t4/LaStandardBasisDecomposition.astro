---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 2, illustration 4 of 5.
 *
 * The standard basis unpacked. i-hat is the unit vector along x, j-hat is
 * the unit vector along y. The vector [3, 4] is read as three steps along
 * i-hat then four steps along j-hat. The path is drawn as the sequence
 * 3·i-hat then 4·j-hat so the reader sees [3, 4] = 3·i-hat + 4·j-hat with
 * their own eyes.
 */

const cx = 200;
const cy = 290;
const u = 48;

const X_MIN = -1;
const X_MAX = 6;
const Y_MIN = -1;
const Y_MAX = 5;

const sx = (gx: number) => cx + gx * u;
const sy = (gy: number) => cy - gy * u;

const xs: number[] = [];
for (let i = X_MIN; i <= X_MAX; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j <= Y_MAX; j++) ys.push(j);

const target = { x: 3, y: 4 };

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-basis-title la-basis-desc">
		<title id="la-basis-title">The standard basis i-hat and j-hat decompose [3, 4] as 3 i-hat plus 4 j-hat</title>
		<desc id="la-basis-desc">A two-dimensional coordinate grid. Two short bold unit arrows at the origin: a teal i-hat pointing one unit along x, and an amber j-hat pointing one unit along y. The path to the point [3, 4] is drawn as a sequence: three short teal arrows along x to reach (3, 0), then four short amber arrows along y to reach (3, 4). A bold purple arrow runs from the origin straight to (3, 4), labeled "[3, 4] = 3 i-hat plus 4 j-hat". The diagram shows that every vector in 2D is a unique combination of the two basis directions.</desc>

		<defs>
			<marker id="la-basis-arrow-i" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-basis-arrow-j" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
			<marker id="la-basis-arrow-step-i" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} opacity="0.55" />
			</marker>
			<marker id="la-basis-arrow-step-j" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} opacity="0.55" />
			</marker>
			<marker id="la-basis-arrow-sum" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		{xs.map((i) => (
			<line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
		))}
		{ys.map((j) => (
			<line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
		))}

		<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="1.1" opacity="0.5" />
		<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="1.1" opacity="0.5" />

		{xs.filter((i) => i !== 0).map((i) => (
			<text x={sx(i)} y={sy(0) + 16} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.55">{i}</text>
		))}
		{ys.filter((j) => j !== 0).map((j) => (
			<text x={sx(0) - 10} y={sy(j) + 4} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="currentColor" opacity="0.55">{j}</text>
		))}

		{/* the 3 steps along i-hat (faint copies after the first bold one) */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(1)} y2={sy(0)} stroke={TEAL} stroke-width="3.4" marker-end="url(#la-basis-arrow-i)" />
		<line x1={sx(1)} y1={sy(0)} x2={sx(2)} y2={sy(0)} stroke={TEAL} stroke-width="2.2" opacity="0.6" marker-end="url(#la-basis-arrow-step-i)" />
		<line x1={sx(2)} y1={sy(0)} x2={sx(3)} y2={sy(0)} stroke={TEAL} stroke-width="2.2" opacity="0.6" marker-end="url(#la-basis-arrow-step-i)" />

		{/* the 4 steps along j-hat from (3, 0) up */}
		<line x1={sx(3)} y1={sy(0)} x2={sx(3)} y2={sy(1)} stroke={AMBER} stroke-width="3.4" marker-end="url(#la-basis-arrow-j)" />
		<line x1={sx(3)} y1={sy(1)} x2={sx(3)} y2={sy(2)} stroke={AMBER} stroke-width="2.2" opacity="0.6" marker-end="url(#la-basis-arrow-step-j)" />
		<line x1={sx(3)} y1={sy(2)} x2={sx(3)} y2={sy(3)} stroke={AMBER} stroke-width="2.2" opacity="0.6" marker-end="url(#la-basis-arrow-step-j)" />
		<line x1={sx(3)} y1={sy(3)} x2={sx(3)} y2={sy(4)} stroke={AMBER} stroke-width="2.2" opacity="0.6" marker-end="url(#la-basis-arrow-step-j)" />

		{/* the sum: origin to target */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(target.x)} y2={sy(target.y)} stroke={ACCENT} stroke-width="2.8" marker-end="url(#la-basis-arrow-sum)" />

		<circle cx={sx(0)} cy={sy(0)} r="3" fill="currentColor" />

		{/* basis labels */}
		<text x={sx(1) + 4} y={sy(0) - 8} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>î</text>
		<text x={sx(0) + 8} y={sy(1) + 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={AMBER}>ĵ</text>

		{/* combination label */}
		<rect x="455" y="42" width="240" height="52" rx="6" fill="currentColor" opacity="0.04" />
		<rect x="455" y="42" width="240" height="52" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
		<text x="575" y="64" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="currentColor" opacity="0.65">decomposition into basis:</text>
		<text x="575" y="86" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor">
			<tspan fill={ACCENT}>[3, 4]</tspan> = 3 <tspan fill={TEAL}>î</tspan> + 4 <tspan fill={AMBER}>ĵ</tspan>
		</text>
	</svg>
	<figcaption>The two unit arrows along the axes, î and ĵ, are the standard basis. Any 2D vector is just so many î plus so many ĵ. The vector [3, 4] is three rightward steps and four upward steps; the brackets and the arrow are the same thing in two notations.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

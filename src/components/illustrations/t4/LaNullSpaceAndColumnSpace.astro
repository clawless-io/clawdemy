---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 7, illustration 2 of 2.
 *
 * Two lines through the origin name a collapsed transformation's structure.
 * For M = [[1, 2], [1, 2]]: the null space is the line y = -x/2 (every
 * vector on it gets crushed to the origin); the column space is the line
 * y = x (every output, no exceptions, lies on this line). The diagram
 * shows both lines on one grid, with a sample vector on the null-space
 * line landing at the origin and a sample on the column-space line being
 * a valid output.
 */

const cx = 380;
const cy = 195;
const u = 36;

const X_MIN = -5;
const X_MAX = 5;
const Y_MIN = -3;
const Y_MAX = 3;

const sx = (gx: number) => cx + gx * u;
const sy = (gy: number) => cy - gy * u;

const xs: number[] = [];
for (let i = X_MIN; i < X_MAX + 1; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j < Y_MAX + 1; j++) ys.push(j);

// null-space line: y = -x/2, i.e. direction (2, -1)
const nullDir = { x: 2, y: -1 };
// column-space line: y = x, i.e. direction (1, 1)
const colDir = { x: 1, y: 1 };

const NULL_LEN = 4.5;
const COL_LEN = 4;

const TEAL = '#0d9488';
const ACCENT = '#7c3aed';
const RED = '#ef4444';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-nullcol-title la-nullcol-desc">
		<title id="la-nullcol-title">Null space and column space of a collapsed transformation</title>
		<desc id="la-nullcol-desc">A two-dimensional coordinate grid showing two lines through the origin. A red dashed line along y equals negative x over 2 is labeled "null space: every vector on this line is crushed to 0". A teal dashed line along y equals x is labeled "column space: every output of M lies on this line". A red sample arrow on the null-space line points to a vector at [2, negative 1] with an arrow showing it gets crushed to the origin under M. A teal sample arrow shows an output [3, 3] sitting on the column space line.</desc>

		<defs>
			<marker id="la-nullcol-arrow-r" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={RED} />
			</marker>
			<marker id="la-nullcol-arrow-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-nullcol-arrow-x" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={ACCENT} />
			</marker>
		</defs>

		{xs.map((i) => <line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		{ys.map((j) => <line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />)}
		<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		{/* null-space line (red dashed) */}
		<line x1={sx(-NULL_LEN * nullDir.x)} y1={sy(-NULL_LEN * nullDir.y)} x2={sx(NULL_LEN * nullDir.x)} y2={sy(NULL_LEN * nullDir.y)} stroke={RED} stroke-width="1.6" stroke-dasharray="6 4" opacity="0.7" />

		{/* column-space line (teal dashed) */}
		<line x1={sx(-COL_LEN * colDir.x)} y1={sy(-COL_LEN * colDir.y)} x2={sx(COL_LEN * colDir.x)} y2={sy(COL_LEN * colDir.y)} stroke={TEAL} stroke-width="1.6" stroke-dasharray="6 4" opacity="0.7" />

		{/* sample null-space vector + collapse arrow */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(2)} y2={sy(-1)} stroke={RED} stroke-width="2.6" marker-end="url(#la-nullcol-arrow-r)" />
		<text x={sx(2) + 6} y={sy(-1) + 18} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={RED}>v = [2, -1]</text>
		<path d={`M ${sx(2) + 4} ${sy(-1) - 4} Q ${sx(1.2)} ${sy(-1.4)} ${sx(0.2)} ${sy(-0.2)}`} fill="none" stroke={ACCENT} stroke-width="1.4" opacity="0.65" marker-end="url(#la-nullcol-arrow-x)" />
		<text x={sx(1) + 4} y={sy(-0.8) - 8} font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill={ACCENT} opacity="0.85">M·v = 0</text>

		{/* sample column-space output */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(3)} y2={sy(3)} stroke={TEAL} stroke-width="2.6" marker-end="url(#la-nullcol-arrow-t)" />
		<text x={sx(3) + 6} y={sy(3) - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={TEAL}>output [3, 3]</text>

		<circle cx={sx(0)} cy={sy(0)} r="3.4" fill={ACCENT} />

		{/* line labels at the ends */}
		<text x={sx(NULL_LEN * nullDir.x) + 6} y={sy(NULL_LEN * nullDir.y) + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={RED}>null space</text>
		<text x={sx(COL_LEN * colDir.x) + 6} y={sy(COL_LEN * colDir.y) - 6} font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" font-weight="700" fill={TEAL}>column space</text>

		{/* legend */}
		<g transform="translate(40, 270)">
			<rect x="0" y="0" width="350" height="64" rx="6" fill="currentColor" opacity="0.04" />
			<rect x="0" y="0" width="350" height="64" rx="6" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
			<text x="10" y="20" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={RED}>
				null space:
			</text>
			<text x="100" y="20" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.8">
				every v with M·v = 0 (the crushed-to-origin set)
			</text>
			<text x="10" y="44" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill={TEAL}>
				column space:
			</text>
			<text x="115" y="44" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.8">
				all outputs M·v across all v (the reachable set)
			</text>
		</g>
	</svg>
	<figcaption>A collapsed transformation has two lines that name what it does. The null space is the line of inputs that get crushed to the origin; the column space is the line that all outputs fall on. One says "what disappears"; the other says "what survives".</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

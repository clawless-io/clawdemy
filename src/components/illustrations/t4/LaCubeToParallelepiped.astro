---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 5, illustration 3 of 3.
 *
 * The 3D analog of the unit square to parallelogram visual. The unit cube
 * at the origin (left panel) becomes a slanted parallelepiped under a
 * linear transformation (right panel); its three edges from the origin
 * are the three columns of the matrix.
 */

const cos30 = 0.8660254;
const sin30 = 0.5;
const PANEL_W = 320;
const PANEL_X1 = 40;
const PANEL_X2 = 380;
const sXY = 36;
const sZ = 36;

function projAt(cx: number, cy: number, x: number, y: number, z: number): { X: number; Y: number } {
	return {
		X: cx + (x - y) * cos30 * sXY,
		Y: cy + (x + y) * sin30 * sXY - z * sZ,
	};
}

const cy = 220;
const c1 = PANEL_X1 + PANEL_W / 2 - 30;
const c2 = PANEL_X2 + PANEL_W / 2 - 30;

type C = { x: number; y: number; z: number };

// Unit cube corners
const cubeCorners: C[] = [
	{ x: 0, y: 0, z: 0 }, // 0
	{ x: 1, y: 0, z: 0 }, // 1
	{ x: 1, y: 1, z: 0 }, // 2
	{ x: 0, y: 1, z: 0 }, // 3
	{ x: 0, y: 0, z: 1 }, // 4
	{ x: 1, y: 0, z: 1 }, // 5
	{ x: 1, y: 1, z: 1 }, // 6
	{ x: 0, y: 1, z: 1 }, // 7
];

const edges: [number, number][] = [
	[0, 1], [1, 2], [2, 3], [3, 0],
	[4, 5], [5, 6], [6, 7], [7, 4],
	[0, 4], [1, 5], [2, 6], [3, 7],
];

// Matrix L (columns visible after transformation)
const Li = { x: 1.4, y: -0.1, z: 0.2 };
const Lj = { x: 0.3, y: 1.2, z: 0.1 };
const Lk = { x: 0.2, y: 0.3, z: 1.4 };

function Lapply(p: C): C {
	return {
		x: Li.x * p.x + Lj.x * p.y + Lk.x * p.z,
		y: Li.y * p.x + Lj.y * p.y + Lk.y * p.z,
		z: Li.z * p.x + Lj.z * p.y + Lk.z * p.z,
	};
}

const ppCorners = cubeCorners.map(Lapply);

function projPanel(idx: 0 | 1, p: C) {
	const cxP = idx === 0 ? c1 : c2;
	return projAt(cxP, cy, p.x, p.y, p.z);
}

const TEAL = '#0d9488';
const AMBER = '#d97706';
const SKY = '#0284c7';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 740 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-c2pp-title la-c2pp-desc">
		<title id="la-c2pp-title">The unit cube becomes a slanted parallelepiped under a 3D linear transformation</title>
		<desc id="la-c2pp-desc">Two side-by-side panels. The left panel shows the unit cube at the origin with i-hat, j-hat, k-hat as the three short bold arrows along the cube's three edges from the origin. The right panel shows the parallelepiped that the cube becomes under a linear transformation L. The parallelepiped's three edges from the origin are the three columns of the matrix L: teal L of i-hat, amber L of j-hat, and sky-blue L of k-hat. The matrix and the parallelepiped carry the same information in two notations.</desc>

		<defs>
			<marker id="la-c2pp-arrow-i" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-c2pp-arrow-j" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
			<marker id="la-c2pp-arrow-k" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={SKY} />
			</marker>
		</defs>

		{/* panel 1: cube */}
		<rect x={PANEL_X1} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X1 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill="currentColor" opacity="0.85">BEFORE: unit cube</text>

		{edges.map(([a, b]) => {
			const A = projPanel(0, cubeCorners[a]);
			const B = projPanel(0, cubeCorners[b]);
			return <line x1={A.X} y1={A.Y} x2={B.X} y2={B.Y} stroke={ACCENT} stroke-width="1" opacity="0.5" />;
		})}

		{(() => {
			const O = projPanel(0, { x: 0, y: 0, z: 0 });
			const I = projPanel(0, { x: 1, y: 0, z: 0 });
			const J = projPanel(0, { x: 0, y: 1, z: 0 });
			const K = projPanel(0, { x: 0, y: 0, z: 1 });
			return (
				<g>
					<line x1={O.X} y1={O.Y} x2={I.X} y2={I.Y} stroke={TEAL} stroke-width="3" marker-end="url(#la-c2pp-arrow-i)" />
					<line x1={O.X} y1={O.Y} x2={J.X} y2={J.Y} stroke={AMBER} stroke-width="3" marker-end="url(#la-c2pp-arrow-j)" />
					<line x1={O.X} y1={O.Y} x2={K.X} y2={K.Y} stroke={SKY} stroke-width="3" marker-end="url(#la-c2pp-arrow-k)" />
					<circle cx={O.X} cy={O.Y} r="2.6" fill="currentColor" />
					<text x={I.X + 4} y={I.Y + 16} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={TEAL}>î</text>
					<text x={J.X - 14} y={J.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={AMBER}>ĵ</text>
					<text x={K.X - 12} y={K.Y - 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={SKY}>k̂</text>
				</g>
			);
		})()}

		{/* panel 2: parallelepiped */}
		<rect x={PANEL_X2} y={20} width={PANEL_W} height={320} rx="6" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.22" />
		<text x={PANEL_X2 + PANEL_W / 2} y={42} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT}>AFTER L: parallelepiped</text>

		{edges.map(([a, b]) => {
			const A = projPanel(1, ppCorners[a]);
			const B = projPanel(1, ppCorners[b]);
			return <line x1={A.X} y1={A.Y} x2={B.X} y2={B.Y} stroke={ACCENT} stroke-width="1" opacity="0.55" />;
		})}

		{(() => {
			const O = projPanel(1, { x: 0, y: 0, z: 0 });
			const LI = projPanel(1, Li);
			const LJ = projPanel(1, Lj);
			const LK = projPanel(1, Lk);
			return (
				<g>
					<line x1={O.X} y1={O.Y} x2={LI.X} y2={LI.Y} stroke={TEAL} stroke-width="3" marker-end="url(#la-c2pp-arrow-i)" />
					<line x1={O.X} y1={O.Y} x2={LJ.X} y2={LJ.Y} stroke={AMBER} stroke-width="3" marker-end="url(#la-c2pp-arrow-j)" />
					<line x1={O.X} y1={O.Y} x2={LK.X} y2={LK.Y} stroke={SKY} stroke-width="3" marker-end="url(#la-c2pp-arrow-k)" />
					<circle cx={O.X} cy={O.Y} r="2.6" fill="currentColor" />
					<text x={LI.X + 4} y={LI.Y + 16} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={TEAL}>L(î)</text>
					<text x={LJ.X - 14} y={LJ.Y + 14} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={AMBER}>L(ĵ)</text>
					<text x={LK.X - 12} y={LK.Y - 4} font-family="ui-monospace, SFMono-Regular, monospace" font-size="12" font-weight="700" fill={SKY}>L(k̂)</text>
				</g>
			);
		})()}

		<text x={PANEL_X2 + PANEL_W / 2} y={328} text-anchor="middle" font-family="ui-monospace, SFMono-Regular, monospace" font-size="11" fill="currentColor" opacity="0.75">columns of L = [ <tspan fill={TEAL}>L(î)</tspan> <tspan opacity="0.6">|</tspan> <tspan fill={AMBER}>L(ĵ)</tspan> <tspan opacity="0.6">|</tspan> <tspan fill={SKY}>L(k̂)</tspan> ]</text>
	</svg>
	<figcaption>In 3D, the unit cube takes the place of the unit square. Under any 3D linear transformation, the cube becomes a slanted parallelepiped, and its three edges from the origin are the three columns of the 3x3 matrix. Same story as 2D, one dimension up.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 740px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

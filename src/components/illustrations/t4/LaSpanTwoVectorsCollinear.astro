---
/**
 * Track 4 (Visual Math: Linear Algebra), Lesson 2, illustration 3 of 5.
 *
 * The degenerate case: two collinear vectors v and w. They point in the
 * same direction (or opposite), so w is just a scalar multiple of v. Their
 * span is still only the line through the origin, not a plane. The second
 * vector adds no new direction.
 */

const cx = 360;
const cy = 200;
const u = 38;

const X_MIN = -7;
const X_MAX = 6;
const Y_MIN = -3;
const Y_MAX = 3;

const sx = (gx: number) => cx + gx * u;
const sy = (gy: number) => cy - gy * u;

const xs: number[] = [];
for (let i = X_MIN; i <= X_MAX; i++) xs.push(i);
const ys: number[] = [];
for (let j = Y_MIN; j <= Y_MAX; j++) ys.push(j);

// Two collinear vectors: w is 2v with a small kink to keep them visually
// distinguishable. Wait, no, they must be exactly collinear to make the
// point. Draw w slightly thinner and offset visually via dash so the eye
// can separate them while still reading colinearity.
const v = { x: 2, y: 1 };
const w = { x: -3, y: -1.5 }; // = -1.5 * v, opposite direction

const lineExt = 7;
const lineStart = { X: sx(-lineExt * v.x / 2), Y: sy(-lineExt * v.y / 2) };
const lineEnd = { X: sx(lineExt * v.x / 2), Y: sy(lineExt * v.y / 2) };

const TEAL = '#0d9488';
const AMBER = '#d97706';
const ACCENT = '#7c3aed';
---

<figure class="cw-illus">
	<svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="la-span2c-title la-span2c-desc">
		<title id="la-span2c-title">Two collinear vectors span only a line, not a plane</title>
		<desc id="la-span2c-desc">A two-dimensional coordinate grid. A teal arrow shows the vector v from the origin and an amber arrow shows a second vector w from the origin, pointing along the same line as v (in the opposite direction in this example). A dashed accent-colored line runs through both vectors and the origin, extending across the grid. The label "span(v, w) = the line" sits near the top: because w is a scalar multiple of v, it adds no new direction, and the span of both together is still just one line.</desc>

		<defs>
			<marker id="la-span2c-arrow-v" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={TEAL} />
			</marker>
			<marker id="la-span2c-arrow-w" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
				<path d="M 0 0 L 10 5 L 0 10 z" fill={AMBER} />
			</marker>
		</defs>

		{xs.map((i) => (
			<line x1={sx(i)} y1={sy(Y_MIN)} x2={sx(i)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
		))}
		{ys.map((j) => (
			<line x1={sx(X_MIN)} y1={sy(j)} x2={sx(X_MAX)} y2={sy(j)} stroke="currentColor" stroke-width="0.5" opacity="0.10" />
		))}

		<line x1={sx(X_MIN)} y1={sy(0)} x2={sx(X_MAX)} y2={sy(0)} stroke="currentColor" stroke-width="1" opacity="0.45" />
		<line x1={sx(0)} y1={sy(Y_MIN)} x2={sx(0)} y2={sy(Y_MAX)} stroke="currentColor" stroke-width="1" opacity="0.45" />

		{/* the span line */}
		<line x1={lineStart.X} y1={lineStart.Y} x2={lineEnd.X} y2={lineEnd.Y} stroke={ACCENT} stroke-width="1.4" stroke-dasharray="6 4" opacity="0.55" />

		{/* v on top */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(v.x)} y2={sy(v.y)} stroke={TEAL} stroke-width="2.6" marker-end="url(#la-span2c-arrow-v)" />

		{/* w on the opposite side */}
		<line x1={sx(0)} y1={sy(0)} x2={sx(w.x)} y2={sy(w.y)} stroke={AMBER} stroke-width="2.6" marker-end="url(#la-span2c-arrow-w)" />

		<circle cx={sx(0)} cy={sy(0)} r="3" fill="currentColor" />

		<text x={sx(v.x) + 6} y={sy(v.y) - 8} font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={TEAL}>v</text>
		<text x={sx(w.x) - 10} y={sy(w.y) + 20} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={AMBER}>w = -1.5 v</text>

		<text x={sx(X_MAX) - 10} y={sy(Y_MAX) + 22} text-anchor="end" font-family="ui-monospace, SFMono-Regular, monospace" font-size="13" font-weight="700" fill={ACCENT} opacity="0.9">span(v, w) = the line</text>
	</svg>
	<figcaption>If w lies on the same line as v, the two vectors are collinear, and w adds no new direction. The span is still just one line; the second vector is redundant. This is the failure mode the basis idea is built to avoid.</figcaption>
</figure>

<style>
	.cw-illus { margin: 1.75rem auto; max-width: 100%; }
	.cw-illus svg { display: block; width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
	.cw-illus figcaption { text-align: center; font-size: 0.85rem; opacity: 0.75; margin-top: 0.5rem; font-style: italic; }
</style>

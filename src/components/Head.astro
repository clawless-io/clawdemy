---
/**
 * Head override for Starlight.
 *
 * Starlight 0.38 already emits og:title, og:type, og:url, og:locale,
 * og:description, og:site_name, and twitter:card automatically from page
 * frontmatter. We add og:image and twitter:image (which Starlight does NOT
 * emit by default) so social-share previews render with a branded card
 * instead of plain text.
 *
 * Default OG image: /og-default.png (1200x630). Generated by
 * scripts/generate-og-image.ts. Replace with a designed asset whenever ready;
 * no code change needed here.
 *
 * Per-page OG image override is a future enhancement: when individual lessons
 * want their own preview card, we'll add an `og_image` frontmatter field and
 * conditionally use it here.
 */

import Default from '@astrojs/starlight/components/Head.astro';

const ogImage = new URL('/og-default.png', Astro.site).toString();
const ogImageAlt = 'Clawdemy: From zero to autonomous, one lesson at a time.';

// Organization + WebSite JSON-LD, homepage only. Brand-entity disambiguation
// for the coined word "Clawdemy" (one letter off from "academy"): sameAs
// binds it to the Clawdemy LinkedIn Page + GitHub so Google treats it as a
// distinct entity. Scoped to the homepage via the pathname guard below.
// Guard assumes the default directory build format (no trailingSlash set in
// astro.config); the homepage is the only route served at "/".
const isHome = Astro.url.pathname === '/';
const orgDescription =
	'Free AI literacy for everyday users. From zero to autonomous, one lesson at a time.';
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': 'https://clawdemy.org/#organization',
			name: 'Clawdemy',
			url: 'https://clawdemy.org/',
			logo: 'https://clawdemy.org/Clawdemy_Logo.jpg',
			description: orgDescription,
			sameAs: [
				'https://www.linkedin.com/company/clawdemy',
				'https://github.com/clawless-io/clawdemy',
			],
		},
		{
			'@type': 'WebSite',
			'@id': 'https://clawdemy.org/#website',
			name: 'Clawdemy',
			url: 'https://clawdemy.org/',
			description: orgDescription,
			publisher: { '@id': 'https://clawdemy.org/#organization' },
		},
	],
};

// Per-lesson LearningResource JSON-LD. Entity/content-type clarity for AI search
// + AEO discoverability (NOT a ranking lever, and lessons do not get a visible
// Google rich result; this is correctness, not a ranking play). Single node,
// refs into the homepage Organization + WebSite graph by @id (no duplication).
//
// Scoped to artifact === 'lesson' ONLY: the supplementary artifacts do not get
// LearningResource (avoids duplicate entities for one lesson; GSD-confirmed
// 2026-06-26). Indexing posture (2026-06-27, GSC-data-driven, founder-approved):
// /brief/ + /cheatsheet/ STAY indexed (they pull unique long-tail traffic, more
// combined impressions than /lesson/) but carry no schema; /summary/ + /practice/
// + /references/ are noindex,follow (thin / zero-click; see robots meta below).
//
// LearningResource, not Course (Course needs hasCourseInstance or it is an
// invalid rich-result attempt) and not Article/TechArticle (Article wants
// headline+image+datePublished+author and we have no reliable per-lesson date
// or image, so those would just generate GSC warnings).
//
// author = the Organization @id ref, NOT a Person: the human-authorship claim
// is an open accuracy question; org-as-author is safe and true. educationalLevel
// / datePublished / image are deliberately OMITTED (no reliable per-lesson data;
// a wrong constant is worse than absent).
const lessonEntry = Astro.locals.starlightRoute.entry;
const isLesson = lessonEntry?.data?.artifact === 'lesson';
// Thin / zero-click supplementary artifacts get robots=noindex,follow so they
// stop competing in search (GSC-data-driven, founder-approved 2026-06-27).
// /brief/ + /cheatsheet/ are deliberately NOT here: they earn unique long-tail.
const NOINDEX_ARTIFACTS = new Set(['summary', 'practice', 'references']);
const isNoindex = NOINDEX_ARTIFACTS.has(lessonEntry?.data?.artifact);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const lessonStructuredData = isLesson
	? {
			'@context': 'https://schema.org',
			'@type': 'LearningResource',
			'@id': `${canonicalUrl}#lesson`,
			name: lessonEntry.data.title,
			description: lessonEntry.data.description ?? '',
			url: canonicalUrl,
			inLanguage: 'en',
			isAccessibleForFree: true,
			learningResourceType: 'lesson',
			isPartOf: { '@id': 'https://clawdemy.org/#website' },
			publisher: { '@id': 'https://clawdemy.org/#organization' },
			author: { '@id': 'https://clawdemy.org/#organization' },
		}
	: null;
---

<Default><slot /></Default>

{isNoindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
<link rel="alternate" type="application/rss+xml" title="Clawdemy Lessons (Podcast)" href="/podcast/feed.xml" />
{/* Brand favicons + Apple touch icon, derived from the logo (brand-integration spec 2026-06-07). */}
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
{/* set:html is safe here because structuredData is fully hardcoded. If any
    field ever becomes dynamic/user-derived, escape "</script>" first
    (e.g. .replace(/</g, '\\u003c')) to prevent a script breakout. */}
{isHome && (
	<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
)}
{/* Per-lesson LearningResource. name/description come from frontmatter, so escape
    "<" as the JSON unicode escape < (NOT the HTML entity &lt;, which a JSON-LD
    parser does not decode and would corrupt a field value) to prevent a
    </script> breakout if any title/description ever contains "<". */}
{isLesson && lessonStructuredData && (
	<script type="application/ld+json" is:inline set:html={JSON.stringify(lessonStructuredData).replace(/</g, '\\u003c')} />
)}

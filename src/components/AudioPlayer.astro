---
/**
 * AudioPlayer — premium AI-narrated audio for a lesson.
 *
 * Embeds an HTML5 audio player styled to match the Clawdemy palette.
 * The MP3 is a static asset under `public/audio/`, generated by
 * `scripts/generate-audio.ts` via the ElevenLabs API. No runtime API
 * calls; listeners stream the file from the site's own domain.
 *
 * Browser audio controls already include playback speed (most browsers
 * via the kebab menu), so no custom rate UI here. Download link is
 * explicit because some readers want to listen offline (driving, gym,
 * treadmill) where the page may not be reachable.
 *
 * Usage in MDX:
 *   <AudioPlayer src="/audio/how-words-become-vectors-lesson.mp3" />
 */

interface Props {
	src: string;
	title?: string;
	approxMinutes?: number;
}

const { src, title = 'Listen to this lesson', approxMinutes } = Astro.props;
---

<aside class="cw-audio">
	<div class="cw-audio-header">
		<span class="cw-audio-label">
			<svg
				width="14"
				height="14"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
				<path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"></path>
				<path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
			</svg>
			<strong>{title}</strong>
			{approxMinutes && <span class="cw-audio-duration">about {approxMinutes} min</span>}
		</span>
	</div>
	<audio controls preload="metadata" src={src}>
		<a href={src}>Download the MP3</a>
	</audio>
	<div class="cw-audio-footer">
		<a href={src} download class="cw-audio-download">
			Download for offline listening
		</a>
		<span class="cw-audio-note">AI-narrated. Voice may pronounce technical terms differently than you do.</span>
	</div>
</aside>

<style>
	.cw-audio {
		border: 1px solid var(--sl-color-gray-5, rgba(127, 127, 127, 0.25));
		border-radius: 10px;
		padding: 1rem 1.125rem;
		margin: 1.5rem 0;
		background: var(--sl-color-bg-sidebar, transparent);
	}
	.cw-audio-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.625rem;
	}
	.cw-audio-label {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.95rem;
		color: var(--sl-color-text);
	}
	.cw-audio-label svg {
		color: var(--sl-color-accent, #7c3aed);
		flex-shrink: 0;
	}
	.cw-audio-duration {
		opacity: 0.6;
		font-size: 0.85rem;
		font-weight: 400;
		margin-left: 0.5rem;
	}
	.cw-audio audio {
		width: 100%;
		display: block;
	}
	.cw-audio-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-top: 0.625rem;
		font-size: 0.78rem;
		opacity: 0.75;
		flex-wrap: wrap;
	}
	.cw-audio-download {
		color: var(--sl-color-accent, #7c3aed);
		text-decoration: none;
		font-weight: 500;
	}
	.cw-audio-download:hover {
		text-decoration: underline;
	}
	.cw-audio-note {
		font-style: italic;
	}
</style>

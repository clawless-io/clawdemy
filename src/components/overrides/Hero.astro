---
/**
 * Hero override: the homepage gets the marketing hero, every other hero page
 * keeps Starlight's exactly.
 *
 * WHY AN OVERRIDE AND NOT A COMPONENT IN THE PAGE BODY
 *
 * The obvious alternative was to drop `hero:` from index.mdx and render our
 * own hero in the body, which needs no override at all. Starlight's
 * Page.astro settles it: with a hero it renders one ContentPanel holding
 * Hero, the content and the Footer; WITHOUT one it renders its own PageTitle,
 * an `h1 id="_top"` built from the frontmatter `title:`, in a ContentPanel of
 * its own. So dropping the hero would put two h1 elements on the homepage,
 * both claiming #_top, one of them reading "Free AI Literacy for Everyone".
 * The site is in the middle of an open indexing investigation; a second h1
 * there would confound the read.
 *
 * THE VERBATIM RULE
 *
 * Overriding a Starlight component also stops that component's own <style>
 * from shipping. /tracks/ is the other page with a hero, so the stock markup
 * and the stock styles below are reproduced exactly, including the
 * `@layer starlight.core` wrapper, and must stay that way. On a Starlight
 * upgrade, re-diff against
 * node_modules/@astrojs/starlight/components/Hero.astro and port the changes.
 *
 * The marketing layout is used only when the page opts in with
 * `full_bleed: true`, which already means "this route is a marketing canvas,
 * not a reading column". Today that is index.mdx alone. When /tracks/ gets
 * the same treatment, decide then whether it also wants the catalog wall
 * beside its copy; it is a deliberate choice, not an automatic one.
 *
 * COPY IS NOT CHANGED HERE. Title, tagline and actions are read from the
 * page's own frontmatter, exactly as the stock component reads them, so the
 * headline and its animated span stay what the founder approved. The kicker
 * and the free line are additive design elements from the mock.
 */
import { Image } from 'astro:assets';
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice';
import { LinkButton } from '@astrojs/starlight/components';
import CatalogWall from '../home/CatalogWall.astro';

/**
 * Stock imports this from '../constants', which does not resolve from here,
 * and the package exports no subpath for it. Value copied from
 * node_modules/@astrojs/starlight/constants.ts:4.
 */
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;

/**
 * `full_bleed` is ours, declared in src/content.config.ts. Starlight types
 * `entry.data` from its own schema and does not thread user extensions
 * through, so it is read through a narrow local cast rather than by widening
 * anything global.
 */
const pageData = data as typeof data & { full_bleed?: boolean };
const marketing = pageData.full_bleed === true;

const { title = data.title, tagline, image, actions = [] } = data.hero || {};

const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	width: 400,
	height: 400,
	alt: image?.alt || '',
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}
---

{
	marketing ? (
		<div class="v2-hero">
			<div class="v2-hero__inner">
				<div class="v2-hero__copy">
					<p class="v2-kicker">Free AI curriculum</p>
					<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
					{data.draft && <DraftContentNotice />}
					{tagline && <div class="v2-hero__lead" set:html={tagline} />}
					{actions.length > 0 && (
						<div class="actions">
							{actions.map(
								({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
									<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
										{text}
										{icon?.html && <Fragment set:html={icon.html} />}
									</LinkButton>
								),
							)}
						</div>
					)}
					<p class="v2-hero__free">
						<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
							<circle cx="8" cy="8" r="8" fill="currentColor" />
							<path
								d="M4.5 8.3l2.2 2.2 4.8-4.8"
								fill="none"
								stroke="#fff"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
						Free, no signup, no paywall, no ads
					</p>
				</div>
				<CatalogWall />
			</div>
		</div>
	) : (
		<div class="hero">
			{darkImage && (
				<Image
					src={darkImage}
					{...imageAttrs}
					class:list={{ 'light:sl-hidden': Boolean(lightImage) }}
				/>
			)}
			{lightImage && <Image src={lightImage} {...imageAttrs} class="dark:sl-hidden" />}
			{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
			<div class="sl-flex stack">
				<div class="sl-flex copy">
					<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
					{data.draft && <DraftContentNotice />}
					{tagline && <div class="tagline" set:html={tagline} />}
				</div>
				{actions.length > 0 && (
					<div class="sl-flex actions">
						{actions.map(
							({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
								<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
									{text}
									{icon?.html && <Fragment set:html={icon.html} />}
								</LinkButton>
							),
						)}
					</div>
				)}
			</div>
		</div>
	)
}

<style>
	/* ===================================================================
	 * STOCK STARLIGHT HERO STYLES, REPRODUCED VERBATIM.
	 * Overriding the component stops its own styles shipping, and /tracks/
	 * depends on these. Do not edit; re-diff on upgrade.
	 * =================================================================== */
	@layer starlight.core {
		.hero {
			display: grid;
			grid-template-columns: 100%;
			align-items: center;
			gap: 1rem;
			padding-bottom: 1rem;
		}

		.hero > img,
		.hero > .hero-html {
			object-fit: contain;
			width: min(70%, 20rem);
			height: auto;
			margin-inline: auto;
		}

		.stack {
			flex-direction: column;
			gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
			text-align: center;
		}

		.copy {
			flex-direction: column;
			gap: 1rem;
			align-items: center;
		}

		.copy > * {
			max-width: 50ch;
		}

		h1 {
			font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.tagline {
			font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
			color: var(--sl-color-gray-2);
		}

		.actions {
			gap: 1rem 2rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		@media (min-width: 50rem) {
			.hero {
				grid-template-columns: 7fr 4fr;
				gap: 3%;
				padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
			}

			.hero > img,
			.hero > .hero-html {
				order: 2;
				width: min(100%, 25rem);
			}

			.stack {
				text-align: start;
			}

			.copy {
				align-items: flex-start;
			}

			.actions {
				justify-content: flex-start;
			}
		}
	}
</style>

<style>
	/* ===================================================================
	 * The marketing hero. GSD's mock, reproduced here because the mock
	 * stylesheet is an audit artifact and not part of this build. Every
	 * colour is an existing token.
	 * =================================================================== */
	.v2-hero {
		position: relative;
	}

	/* A faint dot field, fading out downward, so the first screen reads as a
	   designed surface rather than a blank page. Decorative and inert. */
	.v2-hero::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image: radial-gradient(
			color-mix(in srgb, var(--sl-color-gray-4) 35%, transparent) 1px,
			transparent 1.2px
		);
		background-size: 22px 22px;
		mask-image: linear-gradient(180deg, #000 0%, transparent 90%);
		-webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 90%);
		opacity: 0.5;
	}

	.v2-hero__inner {
		position: relative;
		max-width: var(--v2-wrap, 90rem);
		margin-inline: auto;
		padding-inline: var(--fl-gutter);
		padding-block: 2rem 2.25rem;
		display: grid;
		grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
		gap: clamp(2rem, 4vw, 3.5rem);
		align-items: center;
	}

	.v2-hero__copy {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.v2-kicker {
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		align-self: flex-start;
		padding: 0.3rem 0.75rem;
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--clawdemy-blue);
		background: var(--sl-color-accent-low);
	}

	.v2-hero h1 {
		margin: 0;
		font-family: var(--fl-display);
		font-weight: 800;
		letter-spacing: -0.025em;
		font-size: clamp(2.2rem, 3.7vw, 3.25rem);
		line-height: 1.06;
		color: var(--fl-ink);
	}

	.v2-hero__lead {
		margin: 0;
		font-size: clamp(1.05rem, 1.4vw, 1.2rem);
		line-height: 1.6;
		color: var(--sl-color-gray-2);
		/* The lead is prose: it keeps a readable measure even though the band
		   around it is full width. */
		max-width: 34rem;
	}

	.v2-hero .actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.v2-hero__free {
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--sl-color-gray-2);
	}

	.v2-hero__free svg {
		color: var(--lp-teal);
		flex: none;
	}

	/* Below this the two columns stop fitting side by side, so the copy sits
	   above the wall and the wall becomes its scrolling strip. */
	@media (max-width: 64rem) {
		.v2-hero__inner {
			grid-template-columns: 1fr;
			padding-block: 2rem 2rem;
		}

		.v2-hero__copy {
			gap: 0.9rem;
		}
	}

	@media (max-width: 40rem) {
		.v2-hero .actions {
			flex-wrap: nowrap;
			gap: 0.5rem;
		}
	}
</style>

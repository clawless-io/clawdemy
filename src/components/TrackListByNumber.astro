---
// TrackListByNumber: a compact flat list of all tracks ordered by stable track
// number (Track 1 -> Track N). Complements the themed TrackGrid for users who
// want to browse the curriculum linearly rather than by theme.
//
// Why this exists: mobile UAT feedback (2026-06-11) showed users wanting "all
// tracks at a glance, in order" without going through theme categorization
// first. The themed grid stays as the primary surface; this list lives ABOVE it
// so it's the first thing on the page.
//
// Single source of truth: reads from src/data/tracks.ts (same manifest the
// homepage rails and TrackGrid use). Sorted by track.id.
//
// Mobile-first: stacks vertically on narrow screens. No JS required.
//
import { TRACKS, THEMES } from '../data/tracks';

const ordered = [...TRACKS].sort((a, b) => a.id - b.id);
---

<section class="track-list-by-number" aria-labelledby="all-tracks-by-number">
	<h2 id="all-tracks-by-number" class="track-list-by-number__title">All tracks at a glance</h2>
	<p class="track-list-by-number__lede">
		The full catalog, in track-number order. Tap any live track to start its first
		lesson. Themed groupings are below for users who prefer a guided path.
	</p>
	<ol class="track-list-by-number__list" role="list">
		{ordered.map((t) => {
			const theme = THEMES[t.theme];
			const isLive = t.status === 'live';
			const content = (
				<>
					<span class="track-list-by-number__num" aria-hidden="true">
						{String(t.id).padStart(2, '0')}
					</span>
					<span class="track-list-by-number__body">
						<span class="track-list-by-number__name">{t.title}</span>
						<span class="track-list-by-number__meta">
							<span class="track-list-by-number__theme" style={`--theme-accent: ${theme.accent}`}>
								{theme.label}
							</span>
							{isLive ? (
								<span class="track-list-by-number__count">{t.lessons} {t.lessons === 1 ? 'lesson' : 'lessons'}</span>
							) : (
								<span class="track-list-by-number__count track-list-by-number__count--planned">Coming soon</span>
							)}
						</span>
					</span>
				</>
			);

			return (
				<li class="track-list-by-number__item">
					{isLive ? (
						<a class="track-list-by-number__link" href={t.href}>
							{content}
						</a>
					) : (
						<span class="track-list-by-number__link track-list-by-number__link--planned" aria-disabled="true">
							{content}
						</span>
					)}
				</li>
			);
		})}
	</ol>
</section>

<style>
	.track-list-by-number {
		margin: 0 0 3rem;
	}
	.track-list-by-number__title {
		margin: 0 0 0.4rem;
		font-size: 1.4rem;
		font-weight: 700;
	}
	.track-list-by-number__lede {
		margin: 0 0 1rem;
		font-size: 0.92rem;
		color: var(--sl-color-gray-3, #64748b);
		max-width: 60ch;
	}
	.track-list-by-number__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.4rem;
	}
	@media (min-width: 720px) {
		.track-list-by-number__list {
			grid-template-columns: repeat(2, 1fr);
			gap: 0.4rem 1rem;
		}
	}
	.track-list-by-number__item {
		margin: 0;
		padding: 0;
	}
	.track-list-by-number__link {
		display: grid;
		grid-template-columns: 2.4rem 1fr;
		gap: 0.7rem;
		align-items: center;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5, #e5e7eb);
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition: border-color 120ms ease, background-color 120ms ease;
	}
	.track-list-by-number__link:hover {
		border-color: var(--clawdemy-blue, #2563eb);
		background-color: var(--sl-color-gray-6, #f8fafc);
	}
	.track-list-by-number__link:focus-visible {
		outline: 2px solid var(--clawdemy-blue, #2563eb);
		outline-offset: 2px;
	}
	.track-list-by-number__link--planned {
		cursor: default;
		opacity: 0.7;
	}
	.track-list-by-number__link--planned:hover {
		border-color: var(--sl-color-gray-5, #e5e7eb);
		background-color: transparent;
	}
	.track-list-by-number__num {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.4rem;
		height: 1.9rem;
		padding: 0 0.45rem;
		border-radius: 6px;
		font-variant-numeric: tabular-nums;
		font-weight: 700;
		font-size: 0.82rem;
		letter-spacing: 0.02em;
		background: var(--sl-color-gray-6, #f3f4f6);
		color: var(--sl-color-gray-2, #4b5563);
	}
	.track-list-by-number__body {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}
	.track-list-by-number__name {
		font-weight: 600;
		line-height: 1.25;
		font-size: 0.98rem;
	}
	.track-list-by-number__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.6rem;
		font-size: 0.78rem;
		color: var(--sl-color-gray-3, #6b7280);
	}
	.track-list-by-number__theme {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
	}
	.track-list-by-number__theme::before {
		content: '';
		display: inline-block;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--theme-accent, #6b7280);
	}
	.track-list-by-number__count--planned {
		font-style: italic;
	}
</style>

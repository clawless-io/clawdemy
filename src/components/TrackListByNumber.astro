---
// TrackListByNumber: a compact flat list of all tracks ordered by stable track
// number (Track 1 -> Track N). Complements the themed TrackGrid for users who
// want to browse the curriculum linearly rather than by theme.
//
// Why this exists: mobile UAT feedback (2026-06-11) showed users wanting "all
// tracks at a glance, in order" without going through theme categorization
// first. The themed grid stays as the primary surface; this list lives ABOVE it
// so it's the first thing on the page.
//
// Single source of truth: reads from src/data/tracks.ts (same manifest the
// homepage rails and TrackGrid use). Sorted by track.id.
//
// Mobile-first: stacks vertically on narrow screens. No JS required.
//
import { TRACKS, THEMES } from '../data/tracks';

const ordered = [...TRACKS].sort((a, b) => a.id - b.id);
---

<section class="track-list-by-number not-content" aria-labelledby="all-tracks-by-number">
	<h2 id="all-tracks-by-number" class="track-list-by-number__title">All tracks at a glance</h2>
	<p class="track-list-by-number__lede">
		The full catalog, in track-number order. Tap any live track to start its first
		lesson. Themed groupings are below for users who prefer a guided path.
	</p>
	<ol class="track-list-by-number__list" role="list">
		{ordered.map((t) => {
			const theme = THEMES[t.theme];
			const isLive = t.status === 'live';
			const content = (
				<>
					<span class="track-list-by-number__num" aria-hidden="true">
						{String(t.id).padStart(2, '0')}
					</span>
					<span class="track-list-by-number__body">
						<span class="track-list-by-number__name">{t.title}</span>
						<span class="track-list-by-number__meta">
							<span class="track-list-by-number__theme">
								{theme.label}
							</span>
							{isLive ? (
								<span class="track-list-by-number__count">{t.lessons} {t.lessons === 1 ? 'lesson' : 'lessons'}</span>
							) : (
								<span class="track-list-by-number__count track-list-by-number__count--planned">Coming soon</span>
							)}
						</span>
					</span>
				</>
			);

			return (
				<li class="track-list-by-number__item cw-themed" style={`--accent-base: ${theme.accent}`}>
					{isLive ? (
						<a class="track-list-by-number__link" href={t.href}>
							{content}
						</a>
					) : (
						<span class="track-list-by-number__link track-list-by-number__link--planned" aria-disabled="true">
							{content}
						</span>
					)}
				</li>
			);
		})}
	</ol>
</section>

<style>
	/*
	 * GSD's mock, section 8, on the facelift surfaces. The founder reviewed
	 * the mock and asked for its colour coding on today's paper background
	 * (2026-11-09): "nicely colored and distinguishes the tracks... while
	 * keeping the same background we have today."
	 *
	 * The section root carries class="not-content", so the prose list rules
	 * in global.css leave this <ol> alone. Each item carries .cw-themed and
	 * its path's --accent-base, which gives it --accent for the bar and
	 * --accent-ink for the number.
	 */
	.track-list-by-number {
		margin: 0 0 3rem;
	}
	.track-list-by-number__title {
		margin: 0 0 0.4rem;
		font-family: var(--fl-display, inherit);
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		font-weight: 800;
		letter-spacing: -0.01em;
		color: var(--fl-ink, inherit);
	}
	.track-list-by-number__lede {
		margin: 0 0 1.5rem;
		font-size: 0.95rem;
		color: var(--sl-color-gray-3, #64748b);
		max-width: 46rem;
	}
	.track-list-by-number__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.5rem 1rem;
	}
	@media (max-width: 60rem) {
		.track-list-by-number__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 36rem) {
		.track-list-by-number__list {
			grid-template-columns: 1fr;
		}
	}
	.track-list-by-number__item {
		margin: 0;
		padding: 0;
	}
	.track-list-by-number__link {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		height: 100%;
		box-sizing: border-box;
		padding: 0.6rem 0.75rem;
		border-radius: 10px;
		border: 1px solid transparent;
		/* The path colour as a 3px bar on the left edge, and a faint wash of
		   it over the panel surface. */
		box-shadow: inset 3px 0 0 var(--accent);
		background: color-mix(in srgb, var(--accent) 5%, var(--fl-card, transparent));
		text-decoration: none;
		color: inherit;
		transition: border-color 120ms ease, background-color 120ms ease;
	}
	a.track-list-by-number__link:hover {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--accent) 10%, var(--fl-card, transparent));
	}
	.track-list-by-number__link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.track-list-by-number__link--planned {
		cursor: default;
		opacity: 0.65;
		border-style: dashed;
		border-color: var(--fl-line, var(--sl-color-gray-5));
		box-shadow: inset 3px 0 0 var(--sl-color-gray-5);
		background: transparent;
	}
	.track-list-by-number__num {
		min-width: 1.6rem;
		font: 700 0.85rem var(--sl-font-mono);
		font-variant-numeric: tabular-nums;
		/* Text, so --accent-ink rather than the raw path colour. */
		color: var(--accent-ink);
	}
	.track-list-by-number__body {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}
	.track-list-by-number__name {
		font-weight: 700;
		font-size: 0.93rem;
		line-height: 1.3;
		color: var(--fl-ink, inherit);
	}
	.track-list-by-number__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.6rem;
		font-size: 0.76rem;
		color: var(--sl-color-gray-3, #6b7280);
	}
	.track-list-by-number__theme {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
	}
	.track-list-by-number__theme::before {
		content: '';
		display: inline-block;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--accent);
	}
	.track-list-by-number__count--planned {
		font-weight: 700;
	}
</style>

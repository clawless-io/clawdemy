---
// PathJump: one chip per learning path at the top of /tracks/, each jumping
// to that path's section further down the page.
//
// From GSD's mock, section 8. The page is long (27 tracks listed twice, once
// by number and once by path), and a reader who already knows they want, say,
// Transformers should not have to scroll past four other paths to get there.
//
// Generated from THEME_ORDER, the same list TrackGrid uses to emit the
// section ids, so a chip cannot point at an anchor that does not exist.
import { THEME_ORDER } from '../data/tracks';
---

<nav class="path-jump-wrap not-content" aria-label="Jump to a learning path">
	<ul class="path-jump">
		{THEME_ORDER.map((theme) => (
			<li class="cw-themed" style={`--accent-base: ${theme.accent}`}>
				<a href={`#${theme.key}`}>{theme.label}</a>
			</li>
		))}
	</ul>
</nav>

<style>
	.path-jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin: 0 0 2.5rem;
		padding: 0;
		list-style: none;
	}
	.path-jump li {
		margin: 0;
	}
	.path-jump a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 0.85rem 0.45rem 0.6rem;
		border-radius: 999px;
		background: var(--fl-card, transparent);
		border: 1px solid var(--fl-line, var(--sl-color-gray-5));
		text-decoration: none;
		color: var(--fl-ink, inherit);
		font-weight: 600;
		font-size: 0.88rem;
		transition: border-color 120ms ease;
	}
	.path-jump a::before {
		content: '';
		flex: none;
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: var(--accent);
	}
	.path-jump a:hover {
		border-color: var(--accent);
	}
	.path-jump a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
</style>

---
/**
 * Legal-notice callout for Track 6 lessons that cite regulatory texts.
 *
 * Required (by Doc/curriculum/track-6/philosophy.md governance addendum 3)
 * on any Track 6 lesson that cites GDPR, CCPA/CPRA, HIPAA, the EU AI Act,
 * or comparable regulatory provisions. The Stage 3 SME critic enforces.
 *
 * Why this is its own component:
 *   Privacy lessons that paraphrase consumer-rights statutes risk being
 *   read as legal advice. A consistent, visible disclaimer near every
 *   such citation routes the reader to a lawyer for their own situation.
 *   Centralized in one component so the wording is uniform across
 *   lessons and stays maintainable as legal phrasing evolves.
 *
 * Voice:
 *   Calm, plain, no superlatives. Matches the rest of the catalog. The
 *   founder-voice anchor for privacy copy is "AI should make people more
 *   powerful, not more harvested" — the disclaimer protects that posture
 *   by being honest about what a lesson does and does not do.
 */

import { Aside } from '@astrojs/starlight/components';

interface Props {
	/**
	 * The regulatory framework being cited. Pass the canonical short name
	 * (GDPR, CCPA, CPRA, HIPAA, EU AI Act). The component formats the
	 * disclaimer text around it.
	 */
	framework: string;
	/**
	 * Optional jurisdiction note. When the framework's applicability is
	 * region-specific (CCPA: California residents; GDPR: EU residents and
	 * adjacent), surface that so the reader can match her own situation.
	 * Leave undefined for frameworks where the lesson body already
	 * provides the jurisdictional framing inline.
	 */
	jurisdiction?: string;
}

const { framework, jurisdiction } = Astro.props;
---

<Aside type="caution" title="Not legal advice">
	This describes <strong>{framework}</strong> as it is written{jurisdiction ? `, applicable to ${jurisdiction}` : ''}. It is not legal advice for your specific situation. For legal questions about your own data, consult a lawyer in your jurisdiction.
</Aside>

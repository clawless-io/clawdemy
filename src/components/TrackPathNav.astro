---
// In-track learning-path continuity (enhancement Part B, 2026-06-07).
// On a lesson page, shows which curriculum path the current track belongs to
// and points to the NEXT track in that path — so a learner who finishes a
// track keeps moving through the sequence (Foundations: T4 -> T8 -> T9 -> T10)
// instead of dropping off. Complements Starlight's per-lesson Pagination
// (which handles next LESSON); this handles next TRACK.
//
// No accounts / no state: the path is derived statically from the manifest
// (the track's theme + its position among that theme's live tracks). Rendered
// via the Footer override, gated to lesson pages, so no per-lesson MDX edits.
import { TRACKS, THEMES, tracksByTheme } from '../data/tracks';

// Current track from the lesson URL: /lessons/<trackSlug>/<lesson>/lesson/
const matched = Astro.url.pathname.match(/^\/lessons\/([^/]+)\//);
const trackSlug = matched?.[1];
const track = trackSlug
	? TRACKS.find((t) => t.slug === trackSlug && t.status === 'live')
	: undefined;

let path: {
	themeLabel: string;
	themeHref: string;
	index: number;
	total: number;
	next: (typeof TRACKS)[number] | null;
} | null = null;

if (track) {
	const peers = tracksByTheme(track.theme); // live tracks in this theme, in order
	const idx = peers.findIndex((t) => t.id === track.id);
	if (idx !== -1) {
		path = {
			themeLabel: THEMES[track.theme].label,
			themeHref: `/tracks/${track.theme}/`,
			index: idx,
			total: peers.length,
			next: peers[idx + 1] ?? null,
		};
	}
}
---

{
	path && (
		<nav class="cw-pathnav" aria-label="Learning path">
			<a class="cw-pathnav__theme" href={path.themeHref}>
				<span class="cw-pathnav__themelabel">{path.themeLabel} path</span>
				<span class="cw-pathnav__pos">Track {path.index + 1} of {path.total}</span>
			</a>
			{path.next ? (
				<a class="cw-pathnav__next" href={path.next.href}>
					<span class="cw-pathnav__nextlabel">Next track</span>
					<span class="cw-pathnav__nexttitle">{path.next.title} &rarr;</span>
				</a>
			) : (
				<span class="cw-pathnav__end">
					End of the {path.themeLabel} path. <a href={path.themeHref}>Review the path &rarr;</a>
				</span>
			)}
		</nav>
	)
}

<style>
	.cw-pathnav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		margin-top: 2rem;
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-left: 3px solid var(--clawdemy-blue, #2783d4);
		border-radius: 8px;
		background: var(--sl-color-gray-7, transparent);
		font-size: var(--sl-text-sm);
	}
	.cw-pathnav__theme {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		text-decoration: none;
		color: var(--sl-color-gray-2);
	}
	.cw-pathnav__themelabel {
		font-weight: 600;
		color: var(--clawdemy-blue, #2783d4);
	}
	.cw-pathnav__pos {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.cw-pathnav__next {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		text-align: right;
		text-decoration: none;
		margin-inline-start: auto;
		color: var(--sl-color-gray-2);
	}
	.cw-pathnav__nextlabel {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.cw-pathnav__nexttitle {
		font-weight: 600;
		color: var(--clawdemy-blue, #2783d4);
	}
	.cw-pathnav__next:hover .cw-pathnav__nexttitle,
	.cw-pathnav__theme:hover .cw-pathnav__themelabel {
		text-decoration: underline;
	}
	.cw-pathnav__end {
		margin-inline-start: auto;
		color: var(--sl-color-gray-3);
	}
</style>

---
// HomeTrackRails — the homepage's track-discovery section (redesign plan §6):
// a curated "Start here" rail followed by one rail per theme, then a
// "Browse all" link to /tracks. Reads the manifest (single source of truth)
// and composes TrackRail. Keeps index.mdx trivial.
import TrackRail from './TrackRail.astro';
import { THEME_ORDER, tracksByTheme, startHereTracks } from '../data/tracks';

const start = startHereTracks();
const themeRails = THEME_ORDER.map((theme) => ({
	theme,
	tracks: tracksByTheme(theme.key),
})).filter((r) => r.tracks.length > 0);
---

<div class="home-rails">
	<TrackRail
		title="Start here"
		tagline="New to all this? These are the best places to begin."
		tracks={start}
		id="start-here"
		viewAllHref="/tracks/"
	/>

	{themeRails.map(({ theme, tracks }) => (
		<TrackRail
			title={theme.label}
			tagline={theme.tagline}
			tracks={tracks}
			viewAllHref={`/tracks/${theme.key}/`}
		/>
	))}

	<p class="home-rails__browse">
		<a href="/tracks/">Browse all tracks &rarr;</a>
	</p>
</div>

<style>
	.home-rails {
		margin: 1.5rem 0 0;
	}
	.home-rails__browse {
		margin: 1rem 0 0;
		text-align: center;
		font-size: 1.02rem;
		font-weight: 600;
	}
	.home-rails__browse a {
		text-decoration: none;
	}
</style>

---
// Track hub / landing page for Track 26, "Engineering Agentic Systems".
// Built 2026-07-07 to the Global Sites Developer's spec (SEO handoff for the
// T26 launch), mirroring the T25 hub pattern (tracks/ai-agent-teams.astro).
//
// HARD CONSTRAINT (compliance, do not relax): this page is part of the track
// side and must stay grep-provably clean of the restricted vocabulary listed
// in the internal compliance sheet (section 9, amendments A1-A4), in copy AND
// in structured data. One-way linking only: the explainer page named in that
// sheet may link here; this page never links back or uses that page's
// subject-matter vocabulary.
//
// SEO spec applied (GSD, 2026-07-07): skill-intent keyword cluster
// ("engineering agentic systems", "multi-agent orchestration", Claude Code
// agent architecture phrasing); front-loaded ~140-word self-contained
// description in the first 30% of the page; links to all 8 lessons; Course
// schema WITH hasCourseInstance (Head.astro warns Course without it is an
// invalid rich-result attempt); BreadcrumbList.
//
// Static route: `engineering-agentic-systems` is not a ThemeKey, so
// /tracks/[theme].astro's getStaticPaths never emits it and Astro prefers
// this static route.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { TRACKS, trackHours } from '../../data/tracks';

const track = TRACKS.find((t) => t.slug === 'engineering-agentic-systems')!;
const hours = trackHours(track);

// The 8 lessons in track order (mirrors the astro.config.mjs sidebar). Titles
// and descriptions are the frontmatter of each lesson.mdx, kept in sync here.
const LESSONS = [
	{
		slug: 'thinking-like-an-architect',
		title: 'Thinking like an architect',
		description:
			'Architecture is deciding where judgment lives. Learn the three trade-offs behind every agentic system before reading a single line of code.',
	},
	{
		slug: 'claude-md-at-team-scale',
		title: 'CLAUDE.md at team scale',
		description:
			'Configuration is how an architect\'s decisions become durable for a team. Read the CLAUDE.md hierarchy, scoped rules, shared commands, and plan mode.',
	},
	{
		slug: 'schemas-that-refuse-to-lie',
		title: 'Schemas that refuse to lie',
		description:
			'A required field on a document that lacks the answer pressures the model to invent one. Learn to design schemas where the truth always fits.',
	},
	{
		slug: 'tools-other-agents-can-trust',
		title: 'Tools other agents can trust',
		description:
			'An agent chooses tools by reading your descriptions. Learn to write tools, name them, design errors agents can recover from, and build an MCP server.',
	},
	{
		slug: 'orchestration-that-survives-contact',
		title: 'Orchestration that survives contact',
		description:
			'One coordinator, many subagents, real failures. Learn to brief agents that inherit none of your context, split work, and keep sources attached.',
	},
	{
		slug: 'reliability-is-a-design-choice',
		title: 'Reliability is a design choice',
		description:
			'Escalation criteria that work, human review where it pays, and independent multi-pass checking. Design when a person decides, not if.',
	},
	{
		slug: 'agents-in-the-pipeline',
		title: 'Agents in the pipeline',
		description:
			'Run Claude Code with nobody at the keyboard: headless mode, JSON output for CI, the generator-reviewer split, and review checks teams trust.',
	},
	{
		slug: 'design-build-defend',
		title: 'The capstone: design, build, defend',
		description:
			'Design a small agentic system, build it in Claude Code with every pattern from this track, and write the defense that makes you an architect.',
	},
];

const lessonUrl = (slug: string) =>
	`/lessons/engineering-agentic-systems/${slug}/lesson/`;

const pageUrl = new URL('/tracks/engineering-agentic-systems/', Astro.site).toString();

// --- Course JSON-LD (GSD-approved schema shape, 2026-07-07) ---------------
const courseSchema = {
	'@context': 'https://schema.org',
	'@type': 'Course',
	'@id': `${pageUrl}#course`,
	name: 'Engineering Agentic Systems',
	description:
		'A free, eight-lesson advanced course on engineering production agentic systems: Claude Code configuration at team scale, structured output, tool and MCP server design, multi-agent orchestration, reliability, and headless CI/CD.',
	url: pageUrl,
	inLanguage: 'en',
	isAccessibleForFree: true,
	provider: { '@id': 'https://clawdemy.org/#organization' },
	publisher: { '@id': 'https://clawdemy.org/#organization' },
	teaches: 'how to design, build, and defend production agentic systems',
	educationalLevel: track.level,
	keywords:
		'engineering agentic systems, multi-agent orchestration, Claude Code configuration, MCP server design, structured output, AI agent reliability, agents in CI/CD',
	hasCourseInstance: {
		'@type': 'CourseInstance',
		courseMode: 'online',
		courseWorkload: `PT${hours}H`,
		isAccessibleForFree: true,
	},
	hasPart: LESSONS.map((l) => ({
		'@id': `${new URL(lessonUrl(l.slug), Astro.site).toString()}#lesson`,
	})),
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	'@id': `${pageUrl}#breadcrumb`,
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Clawdemy',
			item: new URL('/', Astro.site).toString(),
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Tracks',
			item: new URL('/tracks/', Astro.site).toString(),
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: 'Engineering Agentic Systems',
			item: pageUrl,
		},
	],
};
---

<StarlightPage
	frontmatter={{
		title: 'Engineering Agentic Systems',
		description:
			'Free eight-lesson advanced track on engineering agentic systems: Claude Code at team scale, tool and MCP design, orchestration, reliability, CI/CD.',
		template: 'splash',
		tableOfContents: false,
	}}
>
	<p class="hub-intro">
		Anyone can wire a language model to a tool and call it an agent. This free,
		eight-lesson advanced track is about everything that separates that demo
		from a production system a team can trust: engineering agentic systems, not
		just assembling them. You will learn to decide when a task needs an agent
		at all, make team standards durable in Claude Code configuration, design
		structured output schemas that stay honest about missing data, build tools
		and MCP servers other agents can use correctly, run multi-agent
		orchestration that survives real failures, place escalation and human
		review where they pay, and put agents to work headless inside CI/CD
		pipelines. The capstone has you design, build, and defend a small agentic
		system of your own. Every lesson is narrated, cited, and free.
		<strong>{track.lessons} lessons, about {hours} hours, no signup.</strong>
	</p>

	<h2>What you will learn</h2>
	<ul class="hub-points">
		<li>
			The architect's first question: does this task need an agent at all, and
			what does choosing one trade away?
		</li>
		<li>
			How Claude Code configuration (CLAUDE.md, scoped rules, shared skills)
			turns one person's judgment into a whole team's standard.
		</li>
		<li>
			How to design structured output schemas where "not in the document" is
			always a legal answer, so the model never has to invent.
		</li>
		<li>
			Tool and MCP server design an agent can actually use: descriptions that
			drive selection, errors an agent can recover from, least privilege.
		</li>
		<li>
			Multi-agent orchestration under real failure: briefing subagents that
			inherit nothing, splitting work without gaps, keeping sources attached.
		</li>
		<li>
			Reliability as design: escalation criteria that survive an audit, human
			review budgeted where it changes outcomes, independent multi-pass checks.
		</li>
		<li>
			Headless Claude Code in CI/CD: machine-readable output, inherited project
			config, and the generator-reviewer split teams trust.
		</li>
	</ul>

	<h2>Where this track sits</h2>
	<p class="hub-arch">
		This is the third step of a ladder. In
		<a href="/lessons/building-with-claude/your-first-claude-api-call/lesson/">Building with Claude</a>
		you built the parts: API calls, tool use, the agent loop. In
		<a href="/tracks/ai-agent-teams/">Anatomy of an AI Agent Team</a>
		you read a real multi-agent system end to end. Here you become the one
		making the decisions: what the model decides, what the code guarantees,
		and what waits for a human. The track is concept-first and code-light;
		if you can follow an argument about who should decide what, lesson 1
		needs nothing else from you.
	</p>

	<h2>The lessons, in order</h2>
	<ol class="hub-lessons">
		{LESSONS.map((l, i) => (
			<li class="hub-lesson">
				<a href={lessonUrl(l.slug)} class="hub-lesson__link">
					<span class="hub-lesson__num" aria-hidden="true">{i + 1}</span>
					<span class="hub-lesson__body">
						<span class="hub-lesson__title">{l.title}</span>
						<span class="hub-lesson__desc">{l.description}</span>
					</span>
				</a>
			</li>
		))}
	</ol>

	<h2>Sources and depth</h2>
	<p class="hub-source">
		Every lesson cites its sources: Anthropic's public engineering essays on
		building effective agents, its multi-agent research system, and tool
		design, plus the official Claude Code, Claude Agent SDK, and Model Context
		Protocol documentation. When you finish, those same sources are your next
		layer of depth, and the free courses in the Anthropic Academy catalog go
		further on every surface this track touches.
	</p>

	<p class="hub-start">
		<a href={lessonUrl(LESSONS[0].slug)} class="hub-start__cta">
			Start with lesson 1
		</a>
	</p>

	<p class="hub-back">
		<a href="/tracks/">&larr; Browse all tracks</a>
	</p>

	{/* set:html is safe: both schema objects are fully built from hardcoded
	    values (no user input); "<" escaped as in Head.astro's lesson block. */}
	<script
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify(courseSchema).replace(/</g, '\\u003c')}
	/>
	<script
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify(breadcrumbSchema).replace(/</g, '\\u003c')}
	/>
</StarlightPage>

<style>
	.hub-intro {
		font-size: 1.1rem;
		line-height: 1.6;
		color: var(--sl-color-gray-1, #334155);
	}
	.hub-points {
		line-height: 1.55;
	}
	.hub-points li {
		margin: 0.35rem 0;
	}
	.hub-arch {
		line-height: 1.65;
		color: var(--sl-color-gray-1, #334155);
	}
	.hub-source {
		line-height: 1.65;
		color: var(--sl-color-gray-1, #334155);
	}
	.hub-lessons {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
		display: grid;
		gap: 0.75rem;
	}
	.hub-lesson__link {
		display: grid;
		grid-template-columns: 2.25rem 1fr;
		align-items: start;
		gap: 0.85rem;
		padding: 0.9rem 1rem;
		border: 1px solid var(--sl-color-gray-5, #e2e8f0);
		border-radius: 10px;
		background: var(--sl-color-bg, #fff);
		text-decoration: none;
		color: inherit;
		transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
	}
	.hub-lesson__link:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
		border-color: var(--clawdemy-blue);
	}
	.hub-lesson__link:focus-visible {
		outline: 2px solid var(--clawdemy-blue);
		outline-offset: 2px;
	}
	.hub-lesson__num {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1rem;
		font-weight: 700;
		color: var(--clawdemy-blue);
		background: color-mix(in srgb, var(--clawdemy-blue) 12%, transparent);
		border-radius: 999px;
		width: 2.25rem;
		height: 2.25rem;
	}
	.hub-lesson__body {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.hub-lesson__title {
		font-size: 1.08rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.hub-lesson__desc {
		font-size: 0.9rem;
		line-height: 1.45;
		color: var(--sl-color-gray-2, #475569);
	}
	.hub-start {
		margin-top: 2rem;
	}
	.hub-start__cta {
		display: inline-block;
		padding: 0.7rem 1.4rem;
		border-radius: 999px;
		background: var(--clawdemy-blue);
		color: #fff;
		font-weight: 600;
		text-decoration: none;
	}
	.hub-start__cta:hover {
		filter: brightness(1.06);
	}
	.hub-back {
		margin-top: 1.75rem;
		font-weight: 600;
	}
	.hub-back a {
		text-decoration: none;
	}
</style>

---
// Per-theme "learning path" page (enhancement Part A, 2026-06-07).
// Picking a theme (from a homepage rail's "View all" or a /tracks heading)
// lands here: just that theme's tracks, in recommended order, so a learner
// can stay inside one curriculum instead of bouncing to the full catalog.
// One page per theme, generated from the manifest (single source of truth),
// rendered inside the Starlight layout via <StarlightPage>.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import TrackCard from '../../components/TrackCard.astro';
import { THEME_ORDER, THEMES, tracksByTheme } from '../../data/tracks';
import type { ThemeKey } from '../../data/tracks';

export function getStaticPaths() {
	return THEME_ORDER.filter((t) => tracksByTheme(t.key).length > 0).map((t) => ({
		params: { theme: t.key },
		props: { themeKey: t.key },
	}));
}

const { themeKey } = Astro.props as { themeKey: ThemeKey };
const theme = THEMES[themeKey];
const tracks = tracksByTheme(themeKey);
const totalLessons = tracks.reduce((sum, t) => sum + t.lessons, 0);
const trackWord = tracks.length === 1 ? 'track' : 'tracks';
---

<StarlightPage
	frontmatter={{
		title: theme.label,
		description: theme.tagline,
		template: 'splash',
		tableOfContents: false,
	}}
>
	<p class="path-intro">
		{theme.tagline} <strong>{tracks.length} {trackWord} · {totalLessons} lessons</strong>, in recommended order.
	</p>

	<ol class="path-list">
		{tracks.map((t, i) => (
			<li class="path-step">
				<span class="path-step__num" aria-hidden="true">{i + 1}</span>
				<TrackCard track={t} />
			</li>
		))}
	</ol>

	<p class="path-back">
		<a href="/tracks/">&larr; Browse all tracks</a>
	</p>
</StarlightPage>

<style>
	.path-intro {
		font-size: 1.05rem;
		color: var(--sl-color-gray-2, #475569);
	}
	.path-list {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 0;
		display: grid;
		gap: 1rem;
	}
	.path-step {
		display: grid;
		grid-template-columns: 2.25rem 1fr;
		align-items: stretch;
		gap: 0.85rem;
	}
	.path-step__num {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--clawdemy-blue);
		background: color-mix(in srgb, var(--clawdemy-blue) 12%, transparent);
		border-radius: 999px;
		width: 2.25rem;
		height: 2.25rem;
		align-self: start;
		margin-top: 0.5rem;
	}
	.path-back {
		margin-top: 2rem;
		font-weight: 600;
	}
	.path-back a {
		text-decoration: none;
	}
	@media (min-width: 880px) {
		.path-list {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>

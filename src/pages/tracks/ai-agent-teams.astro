---
// Track hub / landing page for Track 25, "Anatomy of an AI Agent Team"
// (founder-approved 2026-06-30).
//
// Why a dedicated hub page (and not just the per-theme /tracks/[theme] page):
//   - SEO hub: one substantive, indexable page that gathers all 8 lessons and
//     earns its own authority (thin link-lists get noindex'd site-wide; this
//     page carries unique overview copy so it does not read as thin).
//   - Track landing: the one place the education-only / not-investment-advice
//     track notice lives above the fold, for a track whose worked example is
//     stock analysis.
//   - Funnel target: the marketing articles (Clawdemy -> tradingagentslab.ai)
//     point here.
//
// Static route. `ai-agent-teams` is not a ThemeKey, so /tracks/[theme].astro's
// getStaticPaths never emits it, and Astro prioritizes this static route over
// the dynamic one. Rendered inside the Starlight layout via <StarlightPage>,
// mirroring /tracks/[theme].astro for layout/style/Head consistency.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { TRACKS, trackHours } from '../../data/tracks';

const track = TRACKS.find((t) => t.slug === 'ai-agent-teams')!;
const hours = trackHours(track);

// The 8 lessons in track order (mirrors the astro.config.mjs sidebar). Titles
// and descriptions are the frontmatter of each lesson.mdx, kept in sync here so
// this page is the single at-a-glance view of the arc.
const LESSONS = [
	{
		slug: 'why-split-one-ai-into-many',
		title: 'Why split one AI into many',
		description:
			'Meet a real, free multi-agent AI system as a team of specialists, and learn why splitting one AI into many roles makes it work better.',
	},
	{
		slug: 'how-an-agent-fetches-its-own-data',
		title: 'How an agent fetches its own data',
		description:
			'Watch a real analyst agent decide what data it needs, fetch it with tools, and stop on its own. The tool-use loop that turns a model into an agent.',
	},
	{
		slug: 'the-bull-and-the-bear',
		title: 'Arguing on purpose: the bull and the bear',
		description:
			'Two agents argue the same evidence at full strength, one for and one against, then a separate judge decides. The structured-disagreement pattern, in real code.',
	},
	{
		slug: 'the-trader',
		title: 'From verdict to plan: the trader',
		description:
			"A decision is not yet an action. Watch a real agent turn the judge's verdict into a concrete plan, on the cheaper model, without reopening the debate.",
	},
	{
		slug: 'the-risk-gate',
		title: 'What could go wrong: the risk gate',
		description:
			'Before the plan is final, three risk voices stress-test it and a separate manager makes the last call. The review-and-veto gate, in real code.',
	},
	{
		slug: 'orchestration-and-shared-state',
		title: 'How a team of agents becomes one system',
		description:
			'The last five lessons met the agents one by one. Now see the two things that turn them into one system: who runs next, and the shared state they all use.',
	},
	{
		slug: 'memory-and-reflection',
		title: 'How the system learns from its past calls',
		description:
			'A team that never reviews its past calls repeats its mistakes. See how the system records each decision and, once the outcome is known, reflects on it.',
	},
	{
		slug: 'the-capstone',
		title: 'Capstone: run the agent team yourself',
		description:
			'You have read every part of the team. Now watch them run together end to end, in a safe simulation you run yourself, and see the architecture come alive.',
	},
];

const lessonUrl = (slug: string) =>
	`/lessons/ai-agent-teams/${slug}/lesson/`;

// --- Course JSON-LD ------------------------------------------------------
// PENDING: coordinated with the Global Sites Developer (schema authority) on
// 2026-06-30. Course WITH hasCourseInstance so it is a valid rich-result
// attempt (Head.astro warns that Course without hasCourseInstance is invalid).
// hasPart refs the per-lesson LearningResource @ids that Head.astro already
// emits (`<lesson-url>#lesson`), so no entity is duplicated; provider/publisher
// ref the homepage #organization graph by @id. If GSD prefers CollectionPage/
// ItemList to match /tracks/, this single block swaps out.
const pageUrl = new URL('/tracks/ai-agent-teams/', Astro.site).toString();
const courseSchema = {
	'@context': 'https://schema.org',
	'@type': 'Course',
	'@id': `${pageUrl}#course`,
	name: 'Anatomy of an AI Agent Team',
	description:
		'A free, eight-lesson course that reads a real open-source multi-agent AI system end to end, then shows how to build one. Education only, not investment advice.',
	url: pageUrl,
	inLanguage: 'en',
	isAccessibleForFree: true,
	provider: { '@id': 'https://clawdemy.org/#organization' },
	publisher: { '@id': 'https://clawdemy.org/#organization' },
	teaches: 'how a multi-agent AI system is structured and coordinated',
	educationalLevel: track.level,
	keywords:
		'multi-agent AI, LLM agents, agent orchestration, TradingAgents framework, AI agent teams',
	// The subject of study: the open-source framework read across the track.
	about: {
		'@type': 'SoftwareSourceCode',
		name: 'TradingAgents (multi-agent LLM framework)',
		sameAs: [
			'https://github.com/TauricResearch/TradingAgents',
			'https://arxiv.org/abs/2412.20138',
		],
	},
	// Author list + title verified against the arXiv abstract (2412.20138).
	citation: {
		'@type': 'ScholarlyArticle',
		name: 'TradingAgents: Multi-Agents LLM Financial Trading Framework',
		identifier: 'arXiv:2412.20138',
		url: 'https://arxiv.org/abs/2412.20138',
		author: [
			{ '@type': 'Person', name: 'Yijia Xiao' },
			{ '@type': 'Person', name: 'Edward Sun' },
			{ '@type': 'Person', name: 'Di Luo' },
			{ '@type': 'Person', name: 'Wei Wang' },
		],
	},
	hasCourseInstance: {
		'@type': 'CourseInstance',
		courseMode: 'online',
		courseWorkload: `PT${hours}H`,
		isAccessibleForFree: true,
	},
	hasPart: LESSONS.map((l) => ({
		'@id': `${new URL(lessonUrl(l.slug), Astro.site).toString()}#lesson`,
	})),
};
---

<StarlightPage
	frontmatter={{
		title: 'Anatomy of an AI Agent Team',
		description:
			'Read a real, free, open-source multi-agent AI system end to end, and learn to build your own. Eight lessons on how a team of AI agents is wired to work as one.',
		template: 'splash',
		tableOfContents: false,
	}}
>
	<p class="hub-intro">
		Most explanations of AI agents stop at one clever model in a loop. This
		track goes further: it opens the source code of a real, working system in
		which many AI agents divide the work, argue with each other, review the
		result, and commit to a decision together. You read the actual code, in your
		browser, with no account, no Git, and no programming background needed.
		<strong>{track.lessons} lessons, about {hours} hours, free.</strong>
	</p>

	<blockquote class="hub-notice">
		This track teaches how a multi-agent AI system is built and coordinated. It
		uses stock analysis as the worked example. It is for education only. It is
		not investment, financial, or trading advice, and nothing here is a
		recommendation to buy or sell anything.
	</blockquote>

	<h2>What you will learn</h2>
	<ul class="hub-points">
		<li>
			Why real systems split one AI into a team of specialists, and when that
			actually helps rather than adds noise.
		</li>
		<li>
			The tool-use loop that turns a plain model into an agent that fetches its
			own data and knows when to stop.
		</li>
		<li>
			How to make agents disagree on purpose, and why a separate judge, not the
			debaters, should decide.
		</li>
		<li>
			The two things that turn separate agents into one system: orchestration
			(who runs next) and shared state (what they pass along).
		</li>
		<li>
			How a careful system reviews its own plan with a gate that can overrule it,
			and how it learns from how its past calls turned out.
		</li>
	</ul>

	<h2>The team, at a glance</h2>
	<p class="hub-arch">
		The system you read is a small organization. Analysts gather the evidence. A
		bull and a bear argue it at full strength, and a judge rules. A trader turns
		that ruling into a concrete plan. Three risk voices with different
		temperaments stress-test the plan, and a separate manager holds the final
		gate. Orchestration decides who runs next; a shared workspace carries each
		agent's work to the one after it; and a memory layer lets the team reflect on
		how its past decisions turned out. The last lesson runs the whole team end to
		end, as a safe simulation you run yourself.
	</p>

	<h2>The lessons, in order</h2>
	<ol class="hub-lessons">
		{LESSONS.map((l, i) => (
			<li class="hub-lesson">
				<a href={lessonUrl(l.slug)} class="hub-lesson__link">
					<span class="hub-lesson__num" aria-hidden="true">{i + 1}</span>
					<span class="hub-lesson__body">
						<span class="hub-lesson__title">{l.title}</span>
						<span class="hub-lesson__desc">{l.description}</span>
					</span>
				</a>
			</li>
		))}
	</ol>

	<h2>About the system you will read</h2>
	<p class="hub-source">
		The worked example is <strong>TradingAgents</strong>, an open-source
		multi-agent framework from Tauric Research, released under the Apache 2.0
		license and described in the paper <em>TradingAgents: Multi-Agents LLM
		Financial Trading Framework</em> (arXiv:2412.20138). Every lesson reads from
		one frozen snapshot of the project (pinned commit 7e9e7b8) so the code you
		see never shifts under you. You can browse that snapshot here:
		{' '}
		<a
			href="https://github.com/TauricResearch/TradingAgents/tree/7e9e7b8"
			rel="noopener"
		>
			github.com/TauricResearch/TradingAgents
		</a>. We teach its architecture as a case study; we are not affiliated with
		the project, and the code is used here for education, not as a trading tool.
	</p>

	<p class="hub-start">
		<a href={lessonUrl(LESSONS[0].slug)} class="hub-start__cta">
			Start with lesson 1
		</a>
	</p>

	<p class="hub-back">
		<a href="/tracks/">&larr; Browse all tracks</a>
	</p>

	{/* set:html is safe: courseSchema is fully built from hardcoded/manifest
	    values (no user input), but we still escape "<" as the JSON unicode
	    escape to be consistent with Head.astro's lesson block. */}
	<script
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify(courseSchema).replace(/</g, '\\u003c')}
	/>
</StarlightPage>

<style>
	.hub-intro {
		font-size: 1.1rem;
		line-height: 1.6;
		color: var(--sl-color-gray-1, #334155);
	}
	.hub-notice {
		margin: 1.4rem 0 0;
		padding: 0.9rem 1.1rem;
		border-left: 4px solid var(--clawdemy-blue);
		background: color-mix(in srgb, var(--clawdemy-blue) 7%, transparent);
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--sl-color-gray-2, #475569);
	}
	.hub-points {
		line-height: 1.55;
	}
	.hub-points li {
		margin: 0.35rem 0;
	}
	.hub-arch {
		line-height: 1.65;
		color: var(--sl-color-gray-1, #334155);
	}
	.hub-lessons {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
		display: grid;
		gap: 0.75rem;
		counter-reset: none;
	}
	.hub-lesson__link {
		display: grid;
		grid-template-columns: 2.25rem 1fr;
		align-items: start;
		gap: 0.85rem;
		padding: 0.9rem 1rem;
		border: 1px solid var(--sl-color-gray-5, #e2e8f0);
		border-radius: 10px;
		background: var(--sl-color-bg, #fff);
		text-decoration: none;
		color: inherit;
		transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
	}
	.hub-lesson__link:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
		border-color: var(--clawdemy-blue);
	}
	.hub-lesson__link:focus-visible {
		outline: 2px solid var(--clawdemy-blue);
		outline-offset: 2px;
	}
	.hub-lesson__num {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1rem;
		font-weight: 700;
		color: var(--clawdemy-blue);
		background: color-mix(in srgb, var(--clawdemy-blue) 12%, transparent);
		border-radius: 999px;
		width: 2.25rem;
		height: 2.25rem;
	}
	.hub-lesson__body {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.hub-lesson__title {
		font-size: 1.08rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.hub-lesson__desc {
		font-size: 0.9rem;
		line-height: 1.45;
		color: var(--sl-color-gray-2, #475569);
	}
	.hub-start {
		margin-top: 2rem;
	}
	.hub-start__cta {
		display: inline-block;
		padding: 0.7rem 1.4rem;
		border-radius: 999px;
		background: var(--clawdemy-blue);
		color: #fff;
		font-weight: 600;
		text-decoration: none;
	}
	.hub-start__cta:hover {
		filter: brightness(1.06);
	}
	.hub-back {
		margin-top: 1.75rem;
		font-weight: 600;
	}
	.hub-back a {
		text-decoration: none;
	}
</style>

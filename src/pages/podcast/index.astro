---
// Podcast aggregator / "listen here" page (founder-approved 2026-06-10).
// One canonical place that lists every platform Clawdemy's podcast is on, so
// off-site links (rbjglobal + clawless /family) can point at a single URL that
// never churns when a platform is added. Platform URLs are the ones the Global
// Sites Developer verified live (HTTP 200); Overcast has no direct URL (it
// auto-syncs from Apple) so the RSS fallback covers it.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const LESSONS_PLATFORMS = [
	{ name: 'Apple Podcasts', url: 'https://podcasts.apple.com/us/podcast/clawdemy-lessons/id1896899400' },
	{ name: 'Spotify', url: 'https://open.spotify.com/show/033vdJgNzscIwUF9vPJQAd' },
	{ name: 'Amazon Music', url: 'https://music.amazon.com/podcasts/90b9b28d-82fa-4a57-b34e-1f6f7e285226' },
	{ name: 'iHeartRadio', url: 'https://www.iheart.com/podcast/269-clawdemy-lessons-336436834/' },
	{ name: 'Pocket Casts', url: 'https://pocketcasts.com/podcast/clawdemy-lessons/115ecf40-4688-013f-1f75-0e98e27f20d9' },
];
// Foundations show: live on Apple + Amazon (approved 2026-06-10); more
// platforms roll out as they approve. URLs founder-provided + verified 200.
const FOUNDATIONS_PLATFORMS = [
	{ name: 'Apple Podcasts', url: 'https://podcasts.apple.com/us/podcast/clawdemy-foundations/id1896903560' },
	{ name: 'Amazon Music', url: 'https://music.amazon.com/podcasts/6551c461-0042-40af-9b92-656e98b253b0/clawdemy-foundations' },
];
const RSS_LESSONS = '/podcast/feed.xml';
const RSS_FOUNDATIONS = '/podcast/foundations/feed.xml';
---

<StarlightPage
	frontmatter={{
		title: 'The Clawdemy Podcast',
		description: 'Listen to every Clawdemy lesson, narrated. Free on Apple Podcasts, Spotify, Amazon Music, iHeartRadio, Pocket Casts, or any app via RSS.',
		template: 'splash',
		tableOfContents: false,
	}}
>
	<p class="pod-intro">
		Every Clawdemy lesson, narrated and free. Listen on the app you already use, or subscribe by RSS in any podcast player.
	</p>

	<section class="pod-show">
		<h2 class="pod-show__title">Clawdemy Lessons</h2>
		<p class="pod-show__desc">The full catalog: foundational math, neural networks, transformers, agents, and production patterns, one lesson at a time.</p>
		<ul class="pod-grid">
			{LESSONS_PLATFORMS.map((p) => (
				<li>
					<a class="pod-link" href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a>
				</li>
			))}
			<li>
				<a class="pod-link pod-link--rss" href={RSS_LESSONS}>RSS feed</a>
			</li>
		</ul>
	</section>

	<section class="pod-show">
		<h2 class="pod-show__title">Clawdemy: Foundations</h2>
		<p class="pod-show__desc">A focused series on the math under the models, linear algebra, calculus, statistics, and classical machine learning. More platforms roll out as they approve; subscribe anywhere below.</p>
		<ul class="pod-grid">
			{FOUNDATIONS_PLATFORMS.map((p) => (
				<li>
					<a class="pod-link" href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a>
				</li>
			))}
			<li>
				<a class="pod-link pod-link--rss" href={RSS_FOUNDATIONS}>RSS feed</a>
			</li>
		</ul>
	</section>

	<p class="pod-note">
		Using a different app? Most players let you add a show by URL, paste the RSS link above. New platforms will appear here as they go live.
	</p>
</StarlightPage>

<style>
	.pod-intro {
		font-size: 1.1rem;
		line-height: 1.55;
		color: var(--sl-color-gray-2);
		max-width: 46rem;
	}
	.pod-show {
		margin-top: 2.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--sl-color-gray-5);
	}
	.pod-show:first-of-type {
		border-top: none;
		padding-top: 0;
	}
	.pod-show__title {
		margin: 0 0 0.4rem;
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--clawdemy-blue, #2783d4);
	}
	.pod-show__desc {
		margin: 0 0 1.25rem;
		color: var(--sl-color-gray-2);
		line-height: 1.55;
		max-width: 46rem;
	}
	.pod-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.pod-link {
		display: inline-flex;
		align-items: center;
		padding: 0.65rem 1.3rem;
		border: 1px solid color-mix(in srgb, var(--clawdemy-blue, #2783d4) 35%, var(--sl-color-gray-5));
		border-radius: 999px;
		font-weight: 600;
		text-decoration: none;
		color: var(--sl-color-white);
		background: color-mix(in srgb, var(--clawdemy-blue, #2783d4) 8%, transparent);
		transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
	}
	.pod-link:hover {
		border-color: var(--clawdemy-blue, #2783d4);
		background: color-mix(in srgb, var(--clawdemy-blue, #2783d4) 16%, transparent);
		transform: translateY(-1px);
	}
	.pod-link--rss {
		color: var(--sl-color-gray-2);
		background: transparent;
	}
	.pod-note {
		margin-top: 2.5rem;
		font-size: 0.95rem;
		color: var(--sl-color-gray-3);
		max-width: 46rem;
	}
</style>

---
import ReadAlongPlayer from '../../../components/ReadAlongPlayer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Read-along trial: How models know word order — Clawdemy</title>
    <style>
      :root {
        --sl-color-bg: #ffffff;
        --sl-color-text: #0a0a0a;
        --sl-color-gray-3: #6b7280;
        --sl-color-gray-5: #e5e7eb;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --sl-color-bg: #0a0a0a;
          --sl-color-text: #f5f5f5;
          --sl-color-gray-3: #9ca3af;
          --sl-color-gray-5: #1f2937;
        }
      }
      body {
        margin: 0;
        background: var(--sl-color-bg);
        color: var(--sl-color-text);
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif;
      }
      .trial-banner {
        background: rgb(34, 211, 238);
        color: #0a0a0a;
        padding: 0.75rem 1rem;
        text-align: center;
        font-size: 0.9rem;
        font-weight: 500;
      }
      .trial-banner a {
        color: #0a0a0a;
        text-decoration: underline;
      }
      header.trial-header {
        max-width: 70ch;
        margin: 1.5rem auto 0;
        padding: 0 1rem;
      }
      header.trial-header h1 {
        font-size: 1.5rem;
        margin: 0 0 0.5rem;
      }
      header.trial-header p {
        margin: 0;
        color: var(--sl-color-gray-3);
        font-size: 0.95rem;
      }
    </style>
  </head>
  <body>
    <div class="trial-banner">
      Read-along trial. Press play; the highlight follows the audio. To restart, refresh the page.
      <a href="/lessons/ai-foundations/how-models-know-word-order/lesson/">View regular lesson</a>
    </div>
    <header class="trial-header">
      <h1>How models know word order</h1>
      <p>Phase 1 lesson 3 of Track 5 (AI Foundations). This trial uses WhisperX forced alignment on the existing narration. The text below was reconstructed from the alignment, so contractions and numerals may render slightly differently from the lesson body.</p>
    </header>
    <ReadAlongPlayer
      audioSrc="https://audio.clawdemy.org/lessons/how-models-know-word-order-lesson.mp3"
      timingSrc="/read-along/how-models-know-word-order.timing.json"
    />
  </body>
</html>

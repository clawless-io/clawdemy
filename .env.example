# Copy this file to .env and fill in real values.
# .env is gitignored; never commit real keys.

# ElevenLabs Text-to-Speech API key.
# Sign up at elevenlabs.io, then Profile -> API Keys.
# Used by scripts/generate-audio.ts to render lesson MP3s at build time.
ELEVENLABS_API_KEY=

# ElevenLabs voice ID (20-character alphanumeric, format like
# AbCdEfGhIjKlMnOpQrSt).
#
# This env var is the script-level fallback default for any track not
# explicitly mapped in TRACK_VOICE_MAP inside scripts/generate-audio.ts.
# In practice the per-track map is the canonical source of truth; this
# var is a safety net for tracks not yet routed.
#
# Setting this to an actual voice ID locally is fine — your .env is
# gitignored. The .env.example file (committed) carries a placeholder
# format only, never the real ID. Per Doc/brand.md voice-ID-handling
# rule (custom PVC voice IDs are private-repo-only).
ELEVENLABS_VOICE_ID=__your_pvc_or_stock_voice_id_here__

# Cloudflare R2 credentials for `audio:generate` to sync MP3s to the
# clawdemy-audio bucket (custom domain audio.clawdemy.org).
# Create an R2 API token in Cloudflare Dashboard → R2 → "Manage R2 API
# Tokens" with read+write scope on clawdemy-audio. The token issuance
# screen shows three values; copy them into the variables below.
#
# CLOUDFLARE_ACCOUNT_ID is the hex string at the start of the S3
# endpoint URL: https://<this-hex>.r2.cloudflarestorage.com
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

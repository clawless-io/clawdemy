# build output
dist/
# generated types
.astro/

# dependencies (no trailing slash so a node_modules SYMLINK is ignored too,
# not just the directory — a committed absolute-path symlink breaks CF builds)
node_modules

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# Internal operational documentation lives in a nested private repo at
# clawdemy/internal/ (gitignored below). The public CLAUDE.md in the repo
# root is editorial-discipline only; content-secret governance, Doc/*
# reference material, drafts/, and HANDOVER.md all live inside internal/.

# Playwright artifacts
test-results/
playwright-report/
playwright/.cache/

# Generated audio: regenerated from lesson MDX via scripts/generate-audio.ts.
# Master files will live in R2 once Phase 9.5 ships; for now we do not bloat
# the repo with binary MP3s that change every time a lesson is edited.
public/audio/

# MCP server configuration: local agent-link config, not part of the site.
.mcp.json

# Private internal repo (nested, gitignored)
internal/
